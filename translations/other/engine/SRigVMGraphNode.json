    {
      "record_id": "switch:locres:set-01:SRigVMGraphNode:NodeDurationToolTip:befd5fc8",
      "source": {
        "set": "set-02",
        "namespace": "SRigVMGraphNode",
        "key": "NodeDurationToolTip",
        "jp_record_id": "switch:locres:set-01:SRigVMGraphNode:NodeDurationToolTip:befd5fc8",
        "official_en_record_id": "switch:locres:set-01:SRigVMGraphNode:NodeDurationToolTip:befd5fc8",
        "jp_sha256": "d5522dabe34b591ca8a57bdee3351e7c030728a4ff1f662f9a7173f30609037a",
        "official_en_sha256": "abd14c8cb352111d73c5c35005fe3ff5fadf1ab0634ee3a1e446f9ececc2e7ac"
      },
      "text": {
        "jp": "この数値はノードの持続時間 (マイクロ秒単位) を表します。関数/折りたたみノードでは、含まれるノードの累積時間を表します。複数のノードを選択している場合は、選択項目全体の合計時間も表示されます。クラス設定で数値の表示/非表示を切り替えることができます\n([VMランタイム設定] -> [プロファイリングの有効化])",
        "official_en": "This number represents the duration in microseconds for a node.\nFor functions / collapse nodes it represents the accumulated time of contained nodes.\n\nIf you have more than one node selected you'll see also the overall summed up time of the selection.\n\nYou can enable / disable the display of the number in the Class Settings\n(VM Runtime Settings -> Enable Profiling)",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
        "sequence": null,
        "speaker": {
          "applicability": "NOT_APPLICABLE",
          "label_jp": null,
          "label_status": "NOT_APPLICABLE",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": []
        },
