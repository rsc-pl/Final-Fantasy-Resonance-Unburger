      }
    },
    {
      "record_id": "switch:locres:set-01:SRigVMGraphNode:NodeHitCountToolTip:31dfab93",
      "source": {
        "set": "set-02",
        "namespace": "SRigVMGraphNode",
        "key": "NodeHitCountToolTip",
        "jp_record_id": "switch:locres:set-01:SRigVMGraphNode:NodeHitCountToolTip:31dfab93",
        "official_en_record_id": "switch:locres:set-01:SRigVMGraphNode:NodeHitCountToolTip:31dfab93",
        "jp_sha256": "23f2eebbca01c84347509cb1c6bd23d9dc8400de6d50b4465edf470d9267ed5d",
        "official_en_sha256": "c7f8e9e6110d71a6f593bcaf98349e860c926ebaa687618247a592a1ead532b5"
      },
      "text": {
        "jp": "この数値はノードの命令ヒット数を表します。ノードに補助命令 (コピーなど) がある場合、主な命令の後に全体の命令が中括弧で囲まれて表示されます。関数/折りたたみノードでは、含まれるノードのすべての命令ヒット数の合計を表します。クラス設定で数値の表示/非表示を切り替えられます\n(リググラフ表示設定 -> ノード実行カウントを表示)",
        "official_en": "This number represents the number of instructions hit for a node.\nIf the node has auxiliary instructions (such as Copies) you'll first see the primary instructions followed by the overall instructions in braces.\nFor functions / collapse nodes it represents the sum of all hit instructions of contained nodes.\n\nYou can enable / disable the display of the number in the Class Settings\n(Rig Graph Display Settings -> Show Node Run Counts)",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
