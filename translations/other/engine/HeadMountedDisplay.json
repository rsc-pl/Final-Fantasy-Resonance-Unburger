        "official_en_sha256": "eed7ffdd5c6ee77eaf83845b39df5e8de183dc630fecc5a32247443eed7cda35"
      },
      "text": {
        "jp": "HMD プラグインでサポートされていれば、観戦者の外観を変更します。\n 0：ミラーリングを無効にします\n 1：単眼\n 2：ステレオ ペア\n2 より大きい数値では、HMD プラグイン特有のバリエーションを指定できます。\n負の値は、0 と同じように扱われます。",
        "official_en": "Changes the look of the spectator if supported by the HMD plugin.\n 0: disable mirroring\n 1: single eye\n 2: stereo pair\nNumbers larger than 2 may be possible and specify HMD plugin-specific variations.\nNegative values are treated the same as 0.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
