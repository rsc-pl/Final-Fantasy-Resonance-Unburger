    {
      "record_id": "switch:locres:set-01:CameraNodalOffsetAlgoOpticalAxis:Focus-or-Zoom-has-changed:f1655162",
      "source": {
        "set": "set-02",
        "namespace": "CameraNodalOffsetAlgoOpticalAxis",
        "key": "Focus",
        "jp_record_id": "switch:locres:set-01:CameraNodalOffsetAlgoOpticalAxis:Focus-or-Zoom-has-changed:f1655162",
        "official_en_record_id": "switch:locres:set-01:CameraNodalOffsetAlgoOpticalAxis:Focus-or-Zoom-has-changed:f1655162",
        "jp_sha256": "5e65aefb47e090a6cc941e4bc9e6b3b4887e66ce235a77405ed5958e836ce577",
        "official_en_sha256": "3abff83928a43bef7385e7d4a504f295e7bec61b2864fb140346929b63523db1"
      },
      "text": {
        "jp": "フォーカス入力またはズーム入力が変更されました。入射瞳位置の変更を続けることはできますが、この変更は、以前の値である、「フォーカス = {0}、ズーム = {1}」での節点オフセットに影響を与えます。新しいポイントをキャプチャし、[Add To Nodal Offset Calibration (節点オフセットキャリブレーションへ追加)] をクリックして、新しいフォーカス値とズーム値をキャリブレーションすることができます。",
        "official_en": "The focus or zoom input has changed. You may continue to modify the entrance pupil position, but note that those modifications will affect the nodal offset at the previous values of Focus = {0}, Zoom = {1}. You may calibrate at the new focus and zoom values by capturing new points and clicking 'Add To Nodal Offset Calibration'.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
