    {
      "record_id": "switch:locres:set-01:ExampleLayoutTest:ExampleLayout-TextLabel10:5d066f2a",
      "source": {
        "set": "set-02",
        "namespace": "ExampleLayoutTest",
        "key": "ExampleLayout-TextLabel10",
        "jp_record_id": "switch:locres:set-01:ExampleLayoutTest:ExampleLayout-TextLabel10:5d066f2a",
        "official_en_record_id": "switch:locres:set-01:ExampleLayoutTest:ExampleLayout-TextLabel10:5d066f2a",
