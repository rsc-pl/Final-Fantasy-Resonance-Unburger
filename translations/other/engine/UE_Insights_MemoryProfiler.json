    {
      "record_id": "switch:locres:set-01:UE-Insights-MemoryProfiler:MemInvestigationViewTabToolTip:27625c48",
      "source": {
        "set": "set-02",
        "namespace": "UE::Insights::MemoryProfiler",
        "key": "MemInvestigationViewTabToolTip",
        "jp_record_id": "switch:locres:set-01:UE-Insights-MemoryProfiler:MemInvestigationViewTabToolTip:27625c48",
        "official_en_record_id": "switch:locres:set-01:UE-Insights-MemoryProfiler:MemInvestigationViewTabToolTip:27625c48",
        "jp_sha256": "fa7dd7af6fa7cdbaee43ef19b0b7535ac20ca1211012a659bcaad4272b37b7a0",
        "official_en_sha256": "92911aefa11035ff6a6905760fb0930eb3d1be4b22245cf8edfcacb03088169e"
      },
      "text": {
        "jp": "メモリ調査パネルを開きます。\n\nメモリの割り当てに関する詳細トレースデータを分析します。\n「-trace=memalloc」や「-trace=memory」については、ドキュメントを参照してください",
        "official_en": "Opens the Memory Investigation panel.\n\nIt analyses the detailed trace data about memory allocations.\nSee documentation about \"-trace=memalloc\" or \"-trace=memory\".",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
        "sequence": null,
