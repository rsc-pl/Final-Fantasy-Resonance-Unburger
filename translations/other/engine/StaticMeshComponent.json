    {
      "record_id": "switch:locres:set-01:StaticMeshComponent:MapCheck_Message_NaniteNoVSM:8b237407",
      "source": {
        "set": "set-02",
        "namespace": "StaticMeshComponent",
        "key": "MapCheck_Message_NaniteNoVSM",
        "jp_record_id": "switch:locres:set-01:StaticMeshComponent:MapCheck_Message_NaniteNoVSM:8b237407",
