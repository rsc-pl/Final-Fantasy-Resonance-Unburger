    {
      "record_id": "switch:locres:set-01:NiagaraFilter:EmitterBehaviorExampleTabTooltip:c8e77213",
      "source": {
        "set": "set-02",
        "namespace": "NiagaraFilter",
        "key": "EmitterBehaviorExampleTabTooltip",
        "jp_record_id": "switch:locres:set-01:NiagaraFilter:EmitterBehaviorExampleTabTooltip:c8e77213",
        "official_en_record_id": "switch:locres:set-01:NiagaraFilter:EmitterBehaviorExampleTabTooltip:c8e77213",
        "jp_sha256": "751a9b83849d32f272b595ce676afbc79d2166a9bc96eed5c5883eacf9ad36db",
        "official_en_sha256": "08f9d20ccd151004bcb6b50e43f77d66aafba8d3d0c9fbc2d6942695c07664a5"
      },
      "text": {
        "jp": "学習例は、Niagara が機能レベルでどのように動作するかに関するガイドとしてお使いください。各例は、特定の効果を得るために使用する簡単なセットアップを示し、開始点、構成要素、または単純に参考となることを目的としています。学習例エミッタは継承のない一意のエミッタとしてシステムにコピーされます",
        "official_en": "Learning Examples are intended to serve as a guide to how Niagara works at a feature level.\nEach example shows a simplified setup used to achieve specific outcomes and are intended as starting points, building blocks, or simply as reference.\nLearning Example emitters are copied into a system as a unique emitter with no inheritance",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
