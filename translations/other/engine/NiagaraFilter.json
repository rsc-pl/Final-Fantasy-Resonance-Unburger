    {
      "record_id": "switch:locres:set-01:NiagaraFilter:EmitterNoneTabTooltip:7c61a035",
      "source": {
        "set": "set-02",
        "namespace": "NiagaraFilter",
        "key": "EmitterNoneTabTooltip",
        "jp_record_id": "switch:locres:set-01:NiagaraFilter:EmitterNoneTabTooltip:7c61a035",
        "official_en_record_id": "switch:locres:set-01:NiagaraFilter:EmitterNoneTabTooltip:7c61a035",
        "jp_sha256": "8ac7ff27a0a1ad4c5320d4682ba87f78391c3936773407680fb30499e5988dc7",
        "official_en_sha256": "c039da8dbd735bf72a0232aced09a6d4838e18220791378223d0c3c71c421303"
      },
      "text": {
        "jp": "親エミッタは子として継承され、親エミッタからの変更内容を受け取り、\nプロジェクト全体に素早く簡単に伝播できる、アートディレクションの初期動作として機能するものです。\n長期的には、親エミッタのライブラリを使用することで、自分のプロジェクトに特化した複雑なエフェクトの構築をスピードアップできます。",
        "official_en": "Parent Emitters are inherited as children and will receive changes from the parent emitter,\nand are meant to serve as art directed initial behaviors which can be propagated throughout a project quickly and easily.\nOver time, a library of parent emitters can be used to speed up the construction of complex effects specific to your project.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
