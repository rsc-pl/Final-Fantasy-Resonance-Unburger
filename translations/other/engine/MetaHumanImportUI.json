      "record_id": "switch:locres:set-01:MetaHumanImportUI:BulkImportWarningBody:7eacdd94",
      "source": {
        "set": "set-02",
        "namespace": "MetaHumanImportUI",
        "key": "BulkImportWarningBody",
        "jp_record_id": "switch:locres:set-01:MetaHumanImportUI:BulkImportWarningBody:7eacdd94",
        "official_en_record_id": "switch:locres:set-01:MetaHumanImportUI:BulkImportWarningBody:7eacdd94",
