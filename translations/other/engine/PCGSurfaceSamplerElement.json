        "jp_sha256": "ddd87cbc5252a28da87bf06fcedebe4956b7382d350962c6638b1da91b83e017",
        "official_en_sha256": "c610b2fde39d422a7a4607f372ff8045d9d138324405fec184c605da586bdbce"
      },
      "text": {
        "jp": "サンプリングされたすべてのポイントはこの形状内に含まれる必要があります。\n          この入力を省略すると、境界がアクタから取られ、ポイントがアクタの境界内に含まれます。\n          Unbounded プロパティではこれを無効化し、代わりにサーフェスの全体の境界で生成します",
        "official_en": "All sampled points must be contained within this shape. If this input is omitted then bounds will be taken from the actor so that points are contained within actor bounds. The Unbounded property disables this and instead generates over the entire bounds of Surface.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
        "sequence": null,
