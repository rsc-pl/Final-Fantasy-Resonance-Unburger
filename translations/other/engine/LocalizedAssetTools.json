    {
      "record_id": "switch:locres:set-01:LocalizedAssetTools:HowToFixRevisionControlIsRequiredToManageLocalizableAssets:afd10225",
      "source": {
        "set": "set-02",
        "namespace": "LocalizedAssetTools",
        "key": "HowToFixRevisionControlIsRequiredToManageLocalizableAssets",
        "jp_record_id": "switch:locres:set-01:LocalizedAssetTools:HowToFixRevisionControlIsRequiredToManageLocalizableAssets:afd10225",
