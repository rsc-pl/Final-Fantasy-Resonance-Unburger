    {
      "record_id": "switch:locres:set-01:MetaHumanIdentityPose:IdentityTreePoseBaseTooltip:e06df639",
      "source": {
        "set": "set-02",
        "namespace": "MetaHumanIdentityPose",
        "key": "IdentityTreePoseBaseTooltip",
        "jp_record_id": "switch:locres:set-01:MetaHumanIdentityPose:IdentityTreePoseBaseTooltip:e06df639",
        "official_en_record_id": "switch:locres:set-01:MetaHumanIdentityPose:IdentityTreePoseBaseTooltip:e06df639",
        "jp_sha256": "6f03398fb9587336c224cb80906ad88a7c8cb44ccbf8e201d7a3ab0e34b16bff",
        "official_en_sha256": "2772c46812087dde236dc45f30becafa5ace6844894d39e2b07888f3963941da"
      },
      "text": {
        "jp": "歯のポーズ\n歯の登録に使用されるキャプチャ データを保持し、歯のマーカーを追跡するためのツールを提供します。\n結果は Fit Teeth コマンドで使用され、スケルタルメッシュの歯を調整します。\n顔の表情は、顎を閉じた状態の歯を示す必要があります。\n注：Fit Teeth コマンドを使用する前に、まず Mesh to MetaHuman コマンドを使用してスケルタルメッシュを取得します。\nMesh to MetaHuman コマンドを使用する前に歯を追跡すると、Fit Teeth が自動的に実行されます",
        "official_en": "Teeth Pose\nHolds Capture Data used for teeth registration and provides tools for tracking the Markers for teeth.\nThe results are used by the Fit Teeth command to adjust the teeth of Skeletal Mesh.\nThe facial expression should show teeth with the jaw closed.\nNOTE: Before using Fit Teeth command, first use Mesh to MetaHuman command to obtain Skeletal Mesh.\nIf teeth are tracked before Mesh to MetaHuman command is used, Fit Teeth will be done automatically",
        "real_en": null
      },
