    {
      "record_id": "switch:locres:set-01:SNiagaraStackRowPerfWidget:ModuleEntryTooltip:7d967ba5",
      "source": {
        "set": "set-02",
        "namespace": "SNiagaraStackRowPerfWidget",
        "key": "ModuleEntryTooltip",
        "jp_record_id": "switch:locres:set-01:SNiagaraStackRowPerfWidget:ModuleEntryTooltip:7d967ba5",
        "official_en_record_id": "switch:locres:set-01:SNiagaraStackRowPerfWidget:ModuleEntryTooltip:7d967ba5",
        "jp_sha256": "070aae8189d880892fd3d7ff02d74c9fdf89c6299b91fa59e3b6c5444935dd27",
        "official_en_sha256": "e94251a1044cead16961e24842523e752d4bb13881427026a71b0ef94f28cd0c"
      },
      "text": {
        "jp": "これは、モジュールのランタイム コストをパーセントで表示します。\n表示されるパーセンテージは、エミッタ全体に対するものではなく、親スクリプトのみに対するものです。\nモジュール コストには、非同期コリジョン トレースなど、DI 呼び出しから他のスレッドへの作業は含まれません。",
        "official_en": "This shows the module runtime cost in percent.\nThe displayed percentage relates only to the parent script, not the whole emitter.\nThe module cost does not include work from DI calls to other threads, e.g. async collision traces.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
