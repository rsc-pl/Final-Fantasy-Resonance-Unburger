    {
      "record_id": "switch:locres:set-01:SNiagaraStackRowPerfWidget:GroupHeaderSystemTooltip:1c9df9d8",
      "source": {
        "set": "set-02",
        "namespace": "SNiagaraStackRowPerfWidget",
        "key": "GroupHeaderSystemTooltip",
        "jp_record_id": "switch:locres:set-01:SNiagaraStackRowPerfWidget:GroupHeaderSystemTooltip:1c9df9d8",
        "official_en_record_id": "switch:locres:set-01:SNiagaraStackRowPerfWidget:GroupHeaderSystemTooltip:1c9df9d8",
        "jp_sha256": "503352aff208c4cbfecbc0af362c526749ea6ef798561c89f503619fe6fdf1db",
        "official_en_sha256": "5a318efd368b6aa23f2cc48dab35b974349072c383d012fe646b3f48adc9841f"
      },
      "text": {
        "jp": "これは、システム スクリプトとそのモジュール呼び出しにかかるランタイム コストの合計です。\nエミッタ スクリプトはシステム スクリプトに埋め込まれているため、これらもこのコストに含まれており、異なる色で表示されます。\nシステム スクリプト自体にもオーバーヘッドがあるため、モジュール呼び出しの合計が 100% にならないことに注意してください。",
        "official_en": "This is the total runtime cost of the system script and its module calls.\nSince the emitter scripts are embedded in the system scripts, they are part of this cost as well and visualized in a different color.\nNote that the module calls do not add up to 100% because the system script itself has some overhead as well.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
