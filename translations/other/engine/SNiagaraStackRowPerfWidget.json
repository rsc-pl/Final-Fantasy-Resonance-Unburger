        "official_en_sha256": "899bf3288d48a151b5a506329c26ab1976f711ece5bd6f4209bedbf29822ef94"
      },
      "text": {
        "jp": "これは、スポーン スクリプト呼び出しと更新スクリプト呼び出しを組み合わせた GPU ランタイム コストの合計です。\nGPU 統計はそのレベルで測定できないため、個々のモジュールにかかるコストはありません。",
        "official_en": "This is the total GPU runtime cost of the combined spawn and update script call.\nThere are no individual module costs because the gpu stats cannot be measured on that level.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
