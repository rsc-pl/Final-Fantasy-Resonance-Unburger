          "evidence_refs": []
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-01:MLDeformerMorphModelDetails:FinalizeMorphsWarningMessage:89941484",
      "source": {
        "set": "set-02",
        "namespace": "MLDeformerMorphModelDetails",
        "key": "FinalizeMorphsWarningMessage",
        "jp_record_id": "switch:locres:set-01:MLDeformerMorphModelDetails:FinalizeMorphsWarningMessage:89941484",
        "official_en_record_id": "switch:locres:set-01:MLDeformerMorphModelDetails:FinalizeMorphsWarningMessage:89941484",
        "jp_sha256": "e0357736850d73b750fb98babce1ba7bafe40ac159b844dce9900162cd78fa96",
        "official_en_sha256": "5768b482645b6335b576775d7c6d13ce951187a9aca3f6b670cadc8bebe2348d"
      },
      "text": {
        "jp": "これにより、アセットのクック時と同様に、未加工の未圧縮のトレーニング済みモーフ ターゲットのデルタが削除されます。これを実行すると、ソース コントロールに送信する未クックのアセットがはるかに小さくなります。\n\nただし、その実行後は、モーフ ターゲット カテゴリで設定を変更しても、モデルを再度トレーニングするまで効果がありません。これは、ランタイム時の変形に影響を及ぼしません。\n\n続行すると、この操作を元に戻すことはできません。未圧縮のデルタを元に戻すには、モデルを再トレーニングする必要があります。\n\nこのまま続けますか？",
        "official_en": "This will remove the raw uncompressed trained morph target deltas, just like when cooking the asset. Doing this will make the uncooked asset that you submit to source control a lot smaller.\n\nHowever, after doing this, changing settings in the morph target category will not have an effect until you retrain the model again. It does not impact how the deformation performs at runtime.\n\nIf you proceed, you cannot undo this operation. To get the uncompressed deltas back you have to train the model again.\n\nWould you like to continue?",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
