    {
      "record_id": "switch:locres:set-01:MLDeformerMorphModelDetails:FinalizeMorphTargetsButtonTooltip:a2bab117",
      "source": {
        "set": "set-02",
        "namespace": "MLDeformerMorphModelDetails",
        "key": "FinalizeMorphTargetsButtonTooltip",
        "jp_record_id": "switch:locres:set-01:MLDeformerMorphModelDetails:FinalizeMorphTargetsButtonTooltip:a2bab117",
        "official_en_record_id": "switch:locres:set-01:MLDeformerMorphModelDetails:FinalizeMorphTargetsButtonTooltip:a2bab117",
        "jp_sha256": "7aa4c633b4d96c8cf634a106617eb55f7a1b135fc400f277b303b3e16c4cf951",
        "official_en_sha256": "e93a56986e7af7668e12563d97c056834b863d8e90ac5681350ba4663cd892f1"
      },
      "text": {
        "jp": "主にエディタ アセットをクック済みアセットに変換することで、未加工の頂点デルタを削除します。\nこれによって、クック済みでないアセットのディスク サイズが減少しますが、モデルの再トレーニングが完了するまでモーフィング ターゲットのマスクと圧縮設定が編集できなくなります。\nファイナライズは必須ではありませんが、ソース コントロールに送信するファイルのサイズを削減するために利用できます",
        "official_en": "Delete the raw vertex deltas, basically turning the editor asset into a cooked asset.\nThis will reduce the disk size of the uncooked asset, but will make morph target mask and compression settings uneditable until the model is retrained again.\nFinalizing isn't required, but can be used to reduce the size of the files you submit to source control.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
        "sequence": null,
        "speaker": {
