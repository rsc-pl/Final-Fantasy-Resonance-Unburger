    {
      "record_id": "switch:locres:set-01:SObjectMixerEditorList:SyncSelectionButton_Tooltip:5345e094",
      "source": {
        "set": "set-02",
        "namespace": "SObjectMixerEditorList",
        "key": "SyncSelectionButton_Tooltip",
        "jp_record_id": "switch:locres:set-01:SObjectMixerEditorList:SyncSelectionButton_Tooltip:5345e094",
        "official_en_record_id": "switch:locres:set-01:SObjectMixerEditorList:SyncSelectionButton_Tooltip:5345e094",
        "jp_sha256": "c636a1ff8d5c2ed6e1060cc28bc8b972dbfa48416a608d7d66901bce6ec0d063",
        "official_en_sha256": "5f9992d5f70ed36c89695922087d0f3987d4a611f8d0546c1b8dff07d9337fa4"
      },
      "text": {
        "jp": "選択を同期\n有効にした場合、ミキサー リストで項目をクリックするとシーン アウトライナーでもその項目が選択されます\nAlt キーを押しながらクリックしてミキサーの項目を選択すると、シーン アウトライナーでは項目が選択されません\n無効にされている場合は、Alt キーを押さない限り選択は同期されません。これは、実質的には逆の動作です",
        "official_en": "Sync Selection\nIf enabled, clicking an item in the mixer list will also select the item in the Scene Outliner.\nAlt + Click to select items in mixer without selecting the item in the Scene outliner.\nIf disabled, selections will not sync unless Alt is held. Effectively, this is the opposite behavior.",
        "real_en": null
      },
