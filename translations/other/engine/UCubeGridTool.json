    {
      "record_id": "switch:locres:set-01:UCubeGridTool:AcceptChangesQuestion:baa047d9",
      "source": {
        "set": "set-02",
        "namespace": "UCubeGridTool",
        "key": "AcceptChangesQuestion",
        "jp_record_id": "switch:locres:set-01:UCubeGridTool:AcceptChangesQuestion:baa047d9",
        "official_en_record_id": "switch:locres:set-01:UCubeGridTool:AcceptChangesQuestion:baa047d9",
        "jp_sha256": "84ed897569d78e07302e3aa4c23357558b7d55f2fa0d4b764518fd7a8ba65416",
        "official_en_sha256": "1e7d36958360bce4891d0a6ebca7dadd0a2332eae11315a9a2a021dd9e1c22e9"
      },
      "text": {
        "jp": "このツールをキャンセルしようとしています。これにより、通常は変更内容がすべて破棄されます。代わりに変更内容を適用しますか？\n\n[いいえ] を選択するか、このウィンドウを閉じると、このツールの現在の作業内容は破棄されます",
        "official_en": "The tool is being cancelled, which normally discards all changes. Would you like to apply the changes instead?\n\n Selecting \"No\" or closing this window will discard the tool's current work.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
