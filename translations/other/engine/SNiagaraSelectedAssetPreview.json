    {
      "record_id": "switch:locres:set-01:SNiagaraSelectedAssetPreview:GeneralTagsLabelTooltip:e3f816fc",
      "source": {
        "set": "set-02",
        "namespace": "SNiagaraSelectedAssetPreview",
        "key": "GeneralTagsLabelTooltip",
        "jp_record_id": "switch:locres:set-01:SNiagaraSelectedAssetPreview:GeneralTagsLabelTooltip:e3f816fc",
        "official_en_record_id": "switch:locres:set-01:SNiagaraSelectedAssetPreview:GeneralTagsLabelTooltip:e3f816fc",
        "jp_sha256": "ffb0f115fc818e379533c688f2bae10d1e42a638cf5c7690ababa5cf07f4ef9f",
        "official_en_sha256": "4c97f88f54026d9ccd3623e248e6199bfdaf4aab9b1253aa5f8889b2496244c5"
      },
      "text": {
        "jp": "アセットは割り当て済みのプライマリ タグにすることもセカンダリ タグにすることもできます。\nこれらのタグは、Niagara アセット タグ定義で定義されており、コンテンツ ブラウザで右クリックし、[タグを管理] でアセットに割り当てることができます",
        "official_en": "Assets can be assigned primary and secondary tags.\nThese tags are defined in an Niagara Asset Tag Definitions asset and can be assigned to an asset by right-clicking it in the Content Browser under 'Manage Tags'.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
