    {
      "record_id": "switch:locres:set-01:DMXMVRSceneActorDetails:WriteTransformsToDMXLibraryTooltip:371e6112",
      "source": {
        "set": "set-02",
        "namespace": "DMXMVRSceneActorDetails",
        "key": "WriteTransformsToDMXLibraryTooltip",
        "jp_record_id": "switch:locres:set-01:DMXMVRSceneActorDetails:WriteTransformsToDMXLibraryTooltip:371e6112",
