        "jp_sha256": "edbd5a30671f2f7c7bfadfcf5331aff01490ee6e3fb2848553bd34835e2d4b69",
        "official_en_sha256": "5c715b143d9d81b5d30195558f40b74ee961cdec21f4a2b228139822c11720e7"
      },
      "text": {
        "jp": "オンスクリーンのサンプル数に応じて、有効な 0..1 を返します。\nたとえば、有効な 0.3 は、サンプルの 70% がオフ オフスクリーンであり 30% がオンスクリーンであることを意味します",
        "official_en": "Returns a valid 0..1 depending on how may of the samples are on screen.\nFor example, a valid of 0.3 means 70% of the samples are off screen and 30% are on screen.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
        "sequence": null,
        "speaker": {
          "applicability": "NOT_APPLICABLE",
          "label_jp": null,
          "label_status": "NOT_APPLICABLE",
