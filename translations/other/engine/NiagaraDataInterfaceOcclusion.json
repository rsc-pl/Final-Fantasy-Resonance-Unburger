    {
      "record_id": "switch:locres:set-01:NiagaraDataInterfaceOcclusion:VisibilityFractionDescription:a559881a",
      "source": {
        "set": "set-02",
        "namespace": "NiagaraDataInterfaceOcclusion",
        "key": "VisibilityFractionDescription",
        "jp_record_id": "switch:locres:set-01:NiagaraDataInterfaceOcclusion:VisibilityFractionDescription:a559881a",
        "official_en_record_id": "switch:locres:set-01:NiagaraDataInterfaceOcclusion:VisibilityFractionDescription:a559881a",
        "jp_sha256": "2f23500c5409d6614c99d0d5dd460d96878f56cc2d5959afcb4c02eb99ccda9b",
        "official_en_sha256": "c5d26f4072a9877dccec35cba5085abe857d937fc5c98014977ee84554333bbf"
      },
      "text": {
        "jp": "画面上のオクルージョンされているサンプルの数に応じて、0 から 1 の値を返します。\n例えば、値が 0.3 の場合、表示されているサンプルの 70% がオクルージョンされていることを表します。\nSampleFractionが 0 の場合は、これも 0 を返します。",
        "official_en": "Returns a value 0..1 depending on how many of the samples on the screen were occluded.\nFor example, a value of 0.3 means that 70% of visible samples were occluded.\nIf the sample fraction is 0 then this also returns 0.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
        "sequence": null,
        "speaker": {
          "applicability": "NOT_APPLICABLE",
          "label_jp": null,
          "label_status": "NOT_APPLICABLE",
