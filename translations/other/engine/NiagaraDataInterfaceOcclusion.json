    {
      "record_id": "switch:locres:set-01:NiagaraDataInterfaceOcclusion:DepthPassFractionDescription:201a109c",
      "source": {
        "set": "set-02",
        "namespace": "NiagaraDataInterfaceOcclusion",
        "key": "DepthPassFractionDescription",
        "jp_record_id": "switch:locres:set-01:NiagaraDataInterfaceOcclusion:DepthPassFractionDescription:201a109c",
