        "key": "OnStartPlaneCutTool",
        "jp_record_id": "switch:locres:set-01:UPlaneCutTool:OnStartPlaneCutTool:0797efcc",
        "official_en_record_id": "switch:locres:set-01:UPlaneCutTool:OnStartPlaneCutTool:0797efcc",
