    {
      "record_id": "switch:locres:set-01:UPlaneCutTool:PlaneCutMultipleAssetWithSameSource:e55f79df",
      "source": {
        "set": "set-02",
        "namespace": "UPlaneCutTool",
        "key": "PlaneCutMultipleAssetWithSameSource",
        "jp_record_id": "switch:locres:set-01:UPlaneCutTool:PlaneCutMultipleAssetWithSameSource:e55f79df",
        "official_en_record_id": "switch:locres:set-01:UPlaneCutTool:PlaneCutMultipleAssetWithSameSource:e55f79df",
        "jp_sha256": "81aa292ea047b9beaf444c4a60e87ceeecc5aa6d341c11c7568f3863cdce7cfa",
        "official_en_sha256": "e2d408ddda4d6096485b4982fdedb4417b0f967d075352dd1511c86e0377c54b"
      },
      "text": {
        "jp": "警告:選択した複数のメッシュが同一のソースアセットを使用しています!平面カットをソースアセットに適用しても、このツールではアセットの複製を行わないため、通常、今回のケースではこのツールは正しい結果を返すことはできません。ツールを終了し、ソースアセットの複製を検討してください。",
        "official_en": "WARNING: Multiple meshes in your selection use the same source asset!  Plane cuts apply to the source asset, and this tool will not duplicate assets for you, so the tool typically cannot give a correct result in this case.  Please consider exiting the tool and duplicating the source assets.",
        "real_en": null
      },
