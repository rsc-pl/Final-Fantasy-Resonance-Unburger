    {
      "record_id": "switch:locres:set-01:UPlaneCutTool:PlaneCutDestroyQuestion:75d92be2",
      "source": {
        "set": "set-02",
        "namespace": "UPlaneCutTool",
        "key": "PlaneCutDestroyQuestion",
        "jp_record_id": "switch:locres:set-01:UPlaneCutTool:PlaneCutDestroyQuestion:75d92be2",
        "official_en_record_id": "switch:locres:set-01:UPlaneCutTool:PlaneCutDestroyQuestion:75d92be2",
        "jp_sha256": "854fd65b981f486d2dba42f206d85192983f669c39fef8bfc9abab2b46320983",
        "official_en_sha256": "456bf750c0253bc62cd563fac55b2b8921f8c297631e95c41908c5f7ac0a3f56"
      },
      "text": {
        "jp": "平面カットは少なくとも1つのメッシュを完全に切り取りました。これらのメッシュ コンポーネントを削除してよろしいですか?いずれにしろすべてのアクタはそのままで、完全に切り取られていないメッシュは通常どおりカットされることに注意してください。",
        "official_en": "Plane cuts have entirely cut away at least one mesh. Do you actually want to delete these mesh components? Note that either way all actors will remain, and meshes that are not fully cut away will still be cut as normal.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
