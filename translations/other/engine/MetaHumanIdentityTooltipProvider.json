    {
      "record_id": "switch:locres:set-01:MetaHumanIdentityTooltipProvider:FitTeethToolbarButtonNoTeethPoseTooltip:6dab8940",
      "source": {
        "set": "set-02",
        "namespace": "MetaHumanIdentityTooltipProvider",
        "key": "FitTeethToolbarButtonNoTeethPoseTooltip",
        "jp_record_id": "switch:locres:set-01:MetaHumanIdentityTooltipProvider:FitTeethToolbarButtonNoTeethPoseTooltip:6dab8940",
        "official_en_record_id": "switch:locres:set-01:MetaHumanIdentityTooltipProvider:FitTeethToolbarButtonNoTeethPoseTooltip:6dab8940",
