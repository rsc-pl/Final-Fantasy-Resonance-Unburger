    {
      "record_id": "switch:locres:set-01:MetaHumanIdentityTooltipProvider:FitTeethToolbarButtonCannotFitTeethTooltip:d1c75ce0",
      "source": {
        "set": "set-02",
        "namespace": "MetaHumanIdentityTooltipProvider",
        "key": "FitTeethToolbarButtonCannotFitTeethTooltip",
        "jp_record_id": "switch:locres:set-01:MetaHumanIdentityTooltipProvider:FitTeethToolbarButtonCannotFitTeethTooltip:d1c75ce0",
