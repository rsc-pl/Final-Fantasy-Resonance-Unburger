    {
      "record_id": "switch:locres:set-01:EditorSysConfigAssistant:USNJournalAssistantDescription:9e21bf4e",
      "source": {
        "set": "set-02",
        "namespace": "EditorSysConfigAssistant",
        "key": "USNJournalAssistantDescription",
        "jp_record_id": "switch:locres:set-01:EditorSysConfigAssistant:USNJournalAssistantDescription:9e21bf4e",
        "official_en_record_id": "switch:locres:set-01:EditorSysConfigAssistant:USNJournalAssistantDescription:9e21bf4e",
        "jp_sha256": "d54e0b538c46aa9750c8b6e99c202d761b1b4b2488eeeda91abd0d5e72c9776f",
        "official_en_sha256": "885bca8d196488c86595031c5183730bd5109441a5ab44ad00b0b8f0e309b5bb"
      },
      "text": {
        "jp": "更新シーケンス番号 (USN) ジャーナルは、プロジェクトが格納されているドライブでは正しく構成されていません。そのため、アセット ディスカバリー操作に時間がかかり、エディタの起動時間が長くなります。プロジェクト ファイルを格納する予定の各ドライブで 1 GiB の USN ジャーナルを作成することをお勧めします",
        "official_en": "The Update Sequence Number (USN) Journal is not configured correctly for the drive your project is stored on. This will result in slower asset discovery operations slowing down your Editor startup time. It is recommended that you create a 1 GiB USN journal on each drive you plan to store project files on.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
