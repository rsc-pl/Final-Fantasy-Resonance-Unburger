    {
      "record_id": "switch:locres:set-01:UICommands.SNiagaraGraphNodeInput:ToggleRequired_ToolTip:3700bef1",
      "source": {
        "set": "set-02",
        "namespace": "UICommands.SNiagaraGraphNodeInput",
        "key": "ToggleRequired_ToolTip",
        "jp_record_id": "switch:locres:set-01:UICommands.SNiagaraGraphNodeInput:ToggleRequired_ToolTip:3700bef1",
        "official_en_record_id": "switch:locres:set-01:UICommands.SNiagaraGraphNodeInput:ToggleRequired_ToolTip:3700bef1",
