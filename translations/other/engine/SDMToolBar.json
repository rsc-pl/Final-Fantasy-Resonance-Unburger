        "official_en_sha256": "afdd3c444492c1562e7f296e628173f15706376bc3349aadadf6a6c3c476702e"
      },
      "text": {
        "jp": "ソースに自動適用\n\n有効にした場合にプレビュー マテリアルが再コンパイルされると、ソース アセットに変更を自動的に適用します。\n\n[Auto Apply to Source (ソースに自動適用)] をオンに切り替えると、コンパイルされた変更内容がソースに直ちに適用されます",
        "official_en": "Auto Apply to Source\n\nWhen enabled, and when the preview material is recompiled, it will automatically apply the changes to the source asset.\n\nToggling on Auto Apply to Source will cause any compiled changes to apply to the source immediately.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
        "sequence": null,
