    {
      "record_id": "switch:locres:set-01:SDMToolBar:MaterialDesignerCombinedAutoApplyTooltip:da4d5ae2",
      "source": {
        "set": "set-02",
        "namespace": "SDMToolBar",
        "key": "MaterialDesignerCombinedAutoApplyTooltip",
        "jp_record_id": "switch:locres:set-01:SDMToolBar:MaterialDesignerCombinedAutoApplyTooltip:da4d5ae2",
        "official_en_record_id": "switch:locres:set-01:SDMToolBar:MaterialDesignerCombinedAutoApplyTooltip:da4d5ae2",
        "jp_sha256": "4841a8ba4145add817018b36a21a7a5a050f7ef240be870550fd229be19449d9",
        "official_en_sha256": "2daa6a0ed2aec19819df6564c82fbd06b55b600cc236e0a5f08f51972c17d202"
      },
      "text": {
        "jp": "ライブ編集\n\n有効になっていれば、マテリアルの構造が変更される (新しいレイヤーの追加、レイヤー タイプの変更など) ごとにプレビューとソース マテリアルが再コンパイルされます。\n\n無効になっていれば、マテリアルは自由に編集可能であり、このオプションが有効になるまで、マテリアルのコンパイルはトリガーされません",
        "official_en": "Live Edit\n\nWhen enabled the preview and source material will recompile for every structural change made to the material (such as adding new layers or changing layer types).\n\nWhen disabled the material is freely editable and will not trigger any material compiles until this option is enabled.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
        "sequence": null,
        "speaker": {
          "applicability": "NOT_APPLICABLE",
          "label_jp": null,
          "label_status": "NOT_APPLICABLE",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
