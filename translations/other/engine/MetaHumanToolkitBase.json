    {
      "record_id": "switch:locres:set-01:MetaHumanToolkitBase:ABViewportTabTooltip:b98de5b4",
      "source": {
        "set": "set-02",
        "namespace": "MetaHumanToolkitBase",
        "key": "ABViewportTabTooltip",
        "jp_record_id": "switch:locres:set-01:MetaHumanToolkitBase:ABViewportTabTooltip:b98de5b4",
        "official_en_record_id": "switch:locres:set-01:MetaHumanToolkitBase:ABViewportTabTooltip:b98de5b4",
        "jp_sha256": "29f84d76ac0d501ed4f7ad22a638eda8be34ff3cbe34c9e2cfa95bf207552234",
        "official_en_sha256": "b3d5bff4be214417343ad1b71ff6ab74454e1f62197b1fabc3ea5131a2b906b3"
      },
      "text": {
        "jp": "AB ビューポート\nシングル ビュー ミックス モード、ワイプ ビュー ミックス モード、デュアル ビュー ミックス モードを切り替えて、シーンの 2D および 3D コンポーネントを検査します。\nシングル ビュー ミックス モードでは、[A|B] ボタンで A ビューと B ビューを切り替えできます。\nワイプ モードでは、分割線をドラッグしてワイパーの位置と向きを調整したり、レバー ギズモを使用して A ビューと B ビューの\n透明度を制御したりできます。\n各ビューのライティングとビジュアライゼーションの設定を調整するには、ビューポート ツールバーの隅にある [A] か [B] ボタン\nまたは [View Mode (表示モード)] ボタンを使用します。\n注：トラッキング カーブは、シングル ビュー ミックス モードでのみ表示および編集できます",
        "official_en": "AB Viewport\nInspect 2D and 3D components of the scene by switching between Single, Wipe and Dual View Mix Mode.\nIn Single View Mix mode, use A|B button to toggle between A and B view.\nIn Wipe mode, drag the splitting line to adjust the wiper position and orientation, and use the lever gizmo\nto control the transparency of A over B view.\nUse A or B button and/or View Mode buttons in the viewport toolbar corners to adjust the lighting and\nvisualization settings for each view.\nNOTE: Tracking curves can be viewed and edited in Single View Mix mode only.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
