    {
      "record_id": "switch:locres:set-01:UTransformMeshesTool:OnStartTransformMeshesTool:45885821",
      "source": {
        "set": "set-02",
        "namespace": "UTransformMeshesTool",
        "key": "OnStartTransformMeshesTool",
        "jp_record_id": "switch:locres:set-01:UTransformMeshesTool:OnStartTransformMeshesTool:45885821",
        "official_en_record_id": "switch:locres:set-01:UTransformMeshesTool:OnStartTransformMeshesTool:45885821",
        "jp_sha256": "613b23488ac47f3ad637505827323e04d55b2ef2f926191e78a0e42d7ae62080",
        "official_en_sha256": "17b9993a527fc2c5da91c42b1f91da3679714adc335b416e28d6a51894cb1b00"
      },
      "text": {
        "jp": "選択したオブジェクトをトランスフォームします。ギズモで中マウスボタンをクリックしてドラッグし、再配置します。Ctrlを押したままドラッグして、スナップ/整列します。[A]ではトランスフォームモードを切り替えます。[S]ではピボット設定モードのオン/オフを切り替えます。[D]ではスナップドラッグモードのオン/オフを切り替えます。[W]と[E]ではスナップドラッグソースタイプと回転タイプを切り替えます。",
        "official_en": "Transform the selected objects. Middle-mouse-drag on gizmo to reposition it. Hold Ctrl while dragging to snap/align. [A] cycles through Transform modes. [S] toggles Set Pivot Mode. [D] Toggles Snap Drag Mode. [W] and [E] cycle through Snap Drag Source and Rotation types.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
