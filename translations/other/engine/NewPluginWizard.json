    {
      "record_id": "switch:locres:set-01:NewPluginWizard:BlankTemplateDesc:bc8f9892",
      "source": {
        "set": "set-02",
        "namespace": "NewPluginWizard",
        "key": "BlankTemplateDesc",
        "jp_record_id": "switch:locres:set-01:NewPluginWizard:BlankTemplateDesc:bc8f9892",
        "official_en_record_id": "switch:locres:set-01:NewPluginWizard:BlankTemplateDesc:bc8f9892",
        "jp_sha256": "706eff1f4294dcc1d0fefb1efc9ce29e67989335fc1ba1bd75c75a3ffa6e71d3",
        "official_en_sha256": "98acb1c775d3913c6067831b9b91825b07f4c66b22bf55f4d5c6545b0e0b3a92"
      },
      "text": {
        "jp": "最小限のコードで空のプラグインを作成します\n\nこれは、すべてを一から設定する場合、または非視覚的なプラグインを作成する場合に選択します。\nこのテンプレートで作成されたプラグインはエディタのプラグイン リストに表示されますが、ボタンやメニュー項目は登録されません。",
        "official_en": "Create a blank plugin with a minimal amount of code.\n\nChoose this if you want to set everything up from scratch or are making a non-visual plugin.\nA plugin created with this template will appear in the Editor's plugin list but will not register any buttons or menu entries.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
        "sequence": null,
        "speaker": {
          "applicability": "NOT_APPLICABLE",
          "label_jp": null,
          "label_status": "NOT_APPLICABLE",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": []
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-01:NewPluginWizard:ThirdPartyDesc:ac1a35a3",
      "source": {
        "set": "set-02",
        "namespace": "NewPluginWizard",
        "key": "ThirdPartyDesc",
        "jp_record_id": "switch:locres:set-01:NewPluginWizard:ThirdPartyDesc:ac1a35a3",
        "official_en_record_id": "switch:locres:set-01:NewPluginWizard:ThirdPartyDesc:ac1a35a3",
