    {
      "record_id": "switch:locres:set-01:NewPluginWizard:EditorModeDesc:d83b4dfb",
      "source": {
        "set": "set-02",
        "namespace": "NewPluginWizard",
        "key": "EditorModeDesc",
        "jp_record_id": "switch:locres:set-01:NewPluginWizard:EditorModeDesc:d83b4dfb",
        "official_en_record_id": "switch:locres:set-01:NewPluginWizard:EditorModeDesc:d83b4dfb",
        "jp_sha256": "9a21f737a44cb09176abf0ca0573042fbf79e3039e8870689aa1d3b9e341a797",
        "official_en_sha256": "48db44fddfc67f68519d4a0411ec7b4e1b687891c29118a0767f155d6ae9fe28"
      },
      "text": {
        "jp": "エディタ モードを備えるプラグインを作成します。\n\nこれには、\"Modes\" タブ(フォリッジ、ランドスケープなどの隣)に表示される UI を指定するツールキットの例が含まれます。\nまた、エディタの操作や元に戻す/やり直す機能の使用方法を示す、ごく基本的な UI も含まれます。",
        "official_en": "Create a plugin that will have an editor mode.\n\nThis will include a toolkit example to specify UI that will appear in \"Modes\" tab (next to Foliage, Landscape etc).\nIt will also include very basic UI that demonstrates editor interaction and undo/redo functions usage.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
        "sequence": null,
        "speaker": {
