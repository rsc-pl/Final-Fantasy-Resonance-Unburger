    {
      "record_id": "switch:locres:set-01:NewPluginWizard:AdvancedTemplateDesc:9da5d21c",
      "source": {
        "set": "set-02",
        "namespace": "NewPluginWizard",
        "key": "AdvancedTemplateDesc",
        "jp_record_id": "switch:locres:set-01:NewPluginWizard:AdvancedTemplateDesc:9da5d21c",
        "official_en_record_id": "switch:locres:set-01:NewPluginWizard:AdvancedTemplateDesc:9da5d21c",
