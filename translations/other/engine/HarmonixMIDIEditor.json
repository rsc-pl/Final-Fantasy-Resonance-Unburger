    {
      "record_id": "switch:locres:set-01:HarmonixMIDIEditor:ImporterFactory_GrossConformExplanation:11933bdd",
      "source": {
        "set": "set-02",
        "namespace": "HarmonixMIDIEditor",
        "key": "ImporterFactory_GrossConformExplanation",
        "jp_record_id": "switch:locres:set-01:HarmonixMIDIEditor:ImporterFactory_GrossConformExplanation:11933bdd",
        "official_en_record_id": "switch:locres:set-01:HarmonixMIDIEditor:ImporterFactory_GrossConformExplanation:11933bdd",
        "jp_sha256": "5a518d502bc77c980e3a7903be1889db1906c2e771f567116ba7d7984a78c615",
        "official_en_sha256": "0483fc187f3b54f9f57db94d16d09350a86d54af1704ff3d5a22f7186ea8dde4"
      },
      "text": {
        "jp": "インポートしようとしている MIDI ファイルの一部またはすべての長さは\n標準のミュージカル サブディビジョンで割り切れません。\n\nMIDI ファイルの長さをミュージカル サブディビジョンに合わせて、\nMIDI ファイルをエンドツーエンドでループまたはシーケンシング (つなげる) 時に\n同期がドリフトしないようにすることを強くお勧めします",
        "official_en": "Some or all of the MIDI files you are importing have a length\nThat is not evenly divisible by any standard musical subdivision.\n\nIt is highly recommended that you conform MIDI file lengths to a\nmusical subdivision so that synchronization doesn't drift when looping\nor sequencing (stiching) midi files end-to-end.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "engine_or_editor",
      "context": {
        "scene_ref": null,
        "sequence": null,
        "speaker": {
          "applicability": "NOT_APPLICABLE",
          "label_jp": null,
          "label_status": "NOT_APPLICABLE",
