    {
      "record_id": "switch:locres:set-01:NiagaraEmitterVersionWidget:NiagaraManageVersionWrongAsset:f2dee4a6",
      "source": {
        "set": "set-02",
        "namespace": "NiagaraEmitterVersionWidget",
        "key": "NiagaraManageVersionWrongAsset",
        "jp_record_id": "switch:locres:set-01:NiagaraEmitterVersionWidget:NiagaraManageVersionWrongAsset:f2dee4a6",
        "official_en_record_id": "switch:locres:set-01:NiagaraEmitterVersionWidget:NiagaraManageVersionWrongAsset:f2dee4a6",
        "jp_sha256": "a822fa39398d70eeca99895fd9635820d1936553cc308ab089d6128e304b60a5",
        "official_en_sha256": "ca637cd2d834276af1c91f4ebc972f81e0ba21023c13950ba1cdb4b7acdbe27b"
      },
      "text": {
        "jp": "選択されているアセット タイプではバージョン管理は利用できません。現在、Niagara ではスタンドアロンのエミッタ アセットまたはスクリプト アセットに対してのみバージョン管理がサポートされています\nこのウィンドウが表示されているのは、おそらく以前に他のアセットで開き、開いたタブの選択肢をエディタが覚えているためです",
        "official_en": "Versioning is not available for the selected asset type. Currently, Niagara only supports versioning for standalone emitter or script assets.\nYou probably see this window because you opened it in another asset and the editor remembers you choice of opened tabs.",
        "real_en": null
      },
