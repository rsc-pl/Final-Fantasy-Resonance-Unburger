        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_040:7015cfcc",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_42",
        "key": "FEV_Dng_07Mys_42_040",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_040:7015cfcc",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_040:7015cfcc",
        "jp_sha256": "48ab7527250d115558b131259e32dd430895d06e20cab345dbab2fdc9be7c120",
        "official_en_sha256": "32205e90279624f2dec14f9669e2483ce147febfea59b901f60184739ee6331f"
      },
      "text": {
        "jp": "さっきね、見ちゃったの！\r\nこのネコが本を読んでるとこ！",
        "official_en": "I saw it, I swear! This little kitty was reading a book!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
