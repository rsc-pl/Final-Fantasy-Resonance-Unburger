    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_016:21da90ee",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_42",
        "key": "FEV_Dng_07Mys_42_016",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_016:21da90ee",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_016:21da90ee",
        "jp_sha256": "f616e02db394f35929473cdb110d7cb5f354e8d185d10f9416dae8d6ad6cba9b",
        "official_en_sha256": "470ebaca4f82f788d58686cc3342d80ace78e0175cc8d0307efd1b358428a0dc"
      },
      "text": {
        "jp": "いまが何階なのかもわからないよぉ。\r\n魔道図書館は迷いやすいからね。\r\nお兄さんも気をつけて。",
        "official_en": "I don’t even know what floor I’m on right now... This place is a maze, mister. You should be careful, too.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Dng_07Mys_42",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "魔法使いの少年",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0227",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_FEV_Dng_07Mys_42/FEV_Dng_07Mys_42_016"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_046:b7f032d6",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_42",
        "key": "FEV_Dng_07Mys_42_046",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_046:b7f032d6",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_046:b7f032d6",
        "jp_sha256": "e5694b980c18c810e8e612f10b2c175c731d21795f651d184473f4c412c157b6",
        "official_en_sha256": "c91854029694d647fc3b823b70ae91c432d89363c116f7deb609ba97b1d2c5e9"
      },
      "text": {
        "jp": "いや、“Ⅵ”で間違いないわ！\r\n間違いない、はずよ？",
        "official_en": "No, it was “VI”! I’m almost positive that is the correct one.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
