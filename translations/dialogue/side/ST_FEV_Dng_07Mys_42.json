      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_020:df9da17c",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_42",
        "key": "FEV_Dng_07Mys_42_020",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_020:df9da17c",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_42:FEV_Dng_07Mys_42_020:df9da17c",
        "jp_sha256": "ca1f370fc1a00ccc9b6b3181116b4ef3d039f2dccd4f32cad8cd0bc45a999a01",
        "official_en_sha256": "9b1c4a2065072e830d2c7c51e9a794773703d53ae025cc1633c793969d02d5f2"
      },
      "text": {
        "jp": "この書物に書かれている魔導心臓だが……。\r\nこんなものを作り出せる天才がいるとは\r\nいやはや、世界は広いな。",
        "official_en": "The one who designed the magitek heart in this book is a genius! Just when I thought I had seen everything, I find myself humbled once more.",
        "real_en": "That teleportation device is for reaching the forbidden library."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Dng_07Mys_42",
