    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_011:058834c6",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_20",
        "key": "FEV_Town_06Zol_20_011",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_011:058834c6",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_011:058834c6",
        "jp_sha256": "af3c1aca2b317c0030dd079cbbd44bbd2be217ea980f4c3963951f3aa92c65c7",
        "official_en_sha256": "6036cbe15ae0bcf568fa674e40c8e75281eb4f1ec9b35bed76a7a373611afd2d"
      },
      "text": {
        "jp": "だけど、この鉄道ができてから様変わりしたんだ。\r\nこれぞ、まさにゾルダードの文明の魂だよ。",
        "official_en": "But the railroad changed everything. It’s allowed Zoldaad to thrive.",
        "real_en": "But once the railway was built, everything changed. It's the very soul of Zoldaad's civilization."
      },
      "review": {
        "status": "CHANGE"
      },
