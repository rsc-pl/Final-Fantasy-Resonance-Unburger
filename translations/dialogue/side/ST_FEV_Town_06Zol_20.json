        "jp_sha256": "a236a1772cf6026e10d6b02646953d7f2055027336c8f08a1f4683fc8ec53034",
        "official_en_sha256": "b4c73c54d21d174bf5d6e4e9b556228170fdae94d150bbb037a679ff95c70f7a"
      },
      "text": {
        "jp": "……戦争にならなくて、本当によかった。",
        "official_en": "Can’t tell you how glad I am that we didn’t go to war.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
