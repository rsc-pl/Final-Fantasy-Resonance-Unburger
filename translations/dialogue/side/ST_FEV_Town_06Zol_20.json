    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_055:92d3d480",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_20",
        "key": "FEV_Town_06Zol_20_055",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_055:92d3d480",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_055:92d3d480",
        "jp_sha256": "e2eb90b51060a5e1a2a9b3e7b9ed9c7ed75702f19599bec2328a6ecd1aced1e8",
        "official_en_sha256": "26aedb541d97512773a39b7a50cc75dd90a1673461c4d80594bdf697ca7c7d33"
      },
      "text": {
        "jp": "まさか旅行中に皇帝が代わるなんてな……！",
        "official_en": "Holy moly! Didn’t expect the emperor to change while I was on vacation here!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
