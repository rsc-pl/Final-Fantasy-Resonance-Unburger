    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_066:c10f6183",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_20",
        "key": "FEV_Town_06Zol_20_066",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_066:c10f6183",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_066:c10f6183",
        "jp_sha256": "287b8c656f89ea65c045288346e5c15f2cf4c6407e0a24616e501996ab4c1490",
        "official_en_sha256": "506c8ba5c7cd557a0a9bd2f9335a2e78644952d7adde07444f062467c46ec513"
      },
      "text": {
        "jp": "……鎧を着ていたときはさ、\r\n任務や使命の重さに潰されそうになっていたんだ。",
        "official_en": "That armor weighed heavily on me—both physically and mentally. The pressure of missions, the burden of duty... It all took its toll.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
