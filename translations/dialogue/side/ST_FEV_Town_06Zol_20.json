      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_060:57f2835d",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_20",
        "key": "FEV_Town_06Zol_20_060",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_060:57f2835d",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_060:57f2835d",
        "jp_sha256": "ea331811111276c869631f04d37c7e12db92de94825d6fd2e67266ce49094468",
        "official_en_sha256": "7d5405c55ca8f3b46eca620799d8ef9624d6c63554000df3098dbd9a3de0caf1"
      },
      "text": {
        "jp": "あの反乱軍の連中なら、\r\n必ずやってくれるって俺は信じてたよ。",
        "official_en": "Ha! I knew those rebels would change things around here.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_06Zol_20",
