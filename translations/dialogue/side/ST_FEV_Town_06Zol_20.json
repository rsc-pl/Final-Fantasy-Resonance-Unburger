        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "屈強な男性",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0183",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_FEV_Town_06Zol_20/FEV_Town_06Zol_20_060"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_016:de10d170",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_20",
        "key": "FEV_Town_06Zol_20_016",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_016:de10d170",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_016:de10d170",
        "jp_sha256": "53d0b9921ce6d9d838b2988af1098e3298d9ef870f12548c7e06e3164bc8601a",
        "official_en_sha256": "588130b27ae7353c2e3caaa33584bfbdd0aba1db00243a9cdff08801fbbc9c6e"
      },
      "text": {
        "jp": "いや、なんでもない。\r\nこうして目を光らせるのが任務なんだ。\r\nわかったら、さっさとあっちに行ってくれ。",
        "official_en": "Sorry, didn’t mean anything by it. Just doing my job and keeping watch. Now that you know, you can keep moving. Go on.",
        "real_en": "No, it's nothing. Keeping an eye out like this is my job. Now move along, will you?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
