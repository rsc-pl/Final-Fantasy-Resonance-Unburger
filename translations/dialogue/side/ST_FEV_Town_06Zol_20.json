    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_030:3759ac03",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_20",
        "key": "FEV_Town_06Zol_20_030",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_030:3759ac03",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_030:3759ac03",
        "jp_sha256": "dc06afce25cf34398f616967c8e09c1a2c02c89c2dfad5e63dc721bc0669456c",
        "official_en_sha256": "fb317ae5aa2cdd9027f831c26ed41670b8c7415587b934ae1f7009f84257e9a6"
      },
      "text": {
        "jp": "この列車は、帝都前駅行きです。\r\nお乗りになりますか？",
        "official_en": "This is the train bound for Capital Station. Will you be boarding?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
