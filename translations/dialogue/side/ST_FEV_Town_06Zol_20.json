    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_046:d7d48a33",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_20",
        "key": "FEV_Town_06Zol_20_046",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_046:d7d48a33",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_20:FEV_Town_06Zol_20_046:d7d48a33",
