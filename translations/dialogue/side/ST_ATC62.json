    {
      "record_id": "switch:locres:set-02:ST_ATC62:ATC62_005:0141d29d",
      "source": {
        "set": "set-02",
        "namespace": "ST_ATC62",
        "key": "ATC62_005",
        "jp_record_id": "switch:locres:set-02:ST_ATC62:ATC62_005:0141d29d",
