          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_04:FEV_Town_06Zol_04_011:82bfdd5d",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_04",
        "key": "FEV_Town_06Zol_04_011",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_04:FEV_Town_06Zol_04_011:82bfdd5d",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_04:FEV_Town_06Zol_04_011:82bfdd5d",
