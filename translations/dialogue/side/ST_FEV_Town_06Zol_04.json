    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_04:FEV_Town_06Zol_04_010:2c047377",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_04",
        "key": "FEV_Town_06Zol_04_010",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_04:FEV_Town_06Zol_04_010:2c047377",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_04:FEV_Town_06Zol_04_010:2c047377",
        "jp_sha256": "2279efc5a1c7cd5cb24da866eb2eddcc8120fe1f246b17ea70f65b480db8299c",
        "official_en_sha256": "f4d1e70009a6f8048c685dd7d8f9ee19af1efd5f3940b1757a3378a1e51c1295"
      },
      "text": {
        "jp": "いいかい？　外は危ないからね。\r\n遊びに行くのは我慢するんだよ。",
        "official_en": "It’s dangerous outside, you hear? So you have to stay inside.",
        "real_en": "Listen, it's dangerous outside, so you'll have to wait before going out to play."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_06Zol_04",
