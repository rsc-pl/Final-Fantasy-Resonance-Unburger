    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_020:28b0b3fd",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_43",
        "key": "FEV_Town_06Zol_43_020",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_020:28b0b3fd",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_020:28b0b3fd",
