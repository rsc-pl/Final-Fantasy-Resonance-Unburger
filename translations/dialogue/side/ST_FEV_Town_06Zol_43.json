    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_056:62c6aeb9",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_43",
        "key": "FEV_Town_06Zol_43_056",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_056:62c6aeb9",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_056:62c6aeb9",
