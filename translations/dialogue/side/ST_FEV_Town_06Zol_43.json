    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_001:5570587e",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_43",
        "key": "FEV_Town_06Zol_43_001",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_001:5570587e",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_001:5570587e",
