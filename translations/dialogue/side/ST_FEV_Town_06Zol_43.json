    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_008:f44d63c4",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_43",
        "key": "FEV_Town_06Zol_43_008",
