        "key": "FEV_Town_06Zol_43_006",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_006:d14cb4e5",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_43:FEV_Town_06Zol_43_006:d14cb4e5",
