          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_FEV_Town_06Zol_43/FEV_Town_06Zol_43_056"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
