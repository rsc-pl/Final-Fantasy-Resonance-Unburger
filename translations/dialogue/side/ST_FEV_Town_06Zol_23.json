    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_010:84a8c10a",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_23",
        "key": "FEV_Town_06Zol_23_010",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_010:84a8c10a",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_010:84a8c10a",
        "jp_sha256": "7686fb98c34d26b3bc78d9b7c0a561b4490b66c1276955d7c57fd8949686f49c",
        "official_en_sha256": "ac5739c017bb90a80594aed7d9d7eb4b023c3cb6d82235cad915f15c557bc321"
      },
      "text": {
        "jp": "反乱軍騒ぎの影響につき\r\nただいまこの鉄道は安全点検中です。",
        "official_en": "I’m sorry, sir, but due to rebel activity, the line is currently closed for safety inspections.",
        "real_en": "Due to the trouble with the rebels, the railway is currently undergoing safety inspections."
      },
      "review": {
