    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_001:0c6446c6",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_23",
        "key": "FEV_Town_06Zol_23_001",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_001:0c6446c6",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_001:0c6446c6",
        "jp_sha256": "05b52792bdbaf3054820fcd31be69fd536b4a29129fe13767e7dddcfcbe88ac8",
        "official_en_sha256": "fb0e373e21a1b70b3cdbfa9cfeb33b55893feaf2dcac41b959f8999a12f39c2e"
      },
      "text": {
        "jp": "ここも、街中も兵士だらけ……\r\nずっと監視されているみたいで\r\n息が詰まるわ……。",
        "official_en": "Soldiers everywhere I look! Goodness gracious, I can’t even scratch my nose without them watching me—it’s terribly suffocating...",
        "real_en": "Soldiers here, soldiers in the city... It feels as if we're constantly being watched. I can hardly breathe..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
