    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_026:05596fdd",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_23",
        "key": "FEV_Town_06Zol_23_026",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_026:05596fdd",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_026:05596fdd",
