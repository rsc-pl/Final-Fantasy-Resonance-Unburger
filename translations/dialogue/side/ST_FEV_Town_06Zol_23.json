    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_020:c59d0c85",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_23",
        "key": "FEV_Town_06Zol_23_020",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_020:c59d0c85",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_020:c59d0c85",
        "jp_sha256": "a6670d38d5697deadb389378c1ea53247e68f15b208b75e0e5cb7daa8def6779",
        "official_en_sha256": "22673223605586178c69eb68ae4737d2c752ec06cc9fe966d2ef4b95a69c8a7a"
      },
      "text": {
        "jp": "なあ、知ってる？\r\nこの鉄道を作るためにさ、ディルマギアの技師を\r\n何人か引き抜いたんだってよ。",
        "official_en": "Bet you didn’t know that they recruited a bunch of engineers from Dilmagia to build this railway.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_06Zol_23",
