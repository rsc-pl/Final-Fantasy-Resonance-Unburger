          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_021:a72af61d",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_23",
        "key": "FEV_Town_06Zol_23_021",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_021:a72af61d",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_021:a72af61d",
        "jp_sha256": "ea3fcb0aeca7d5f883822c88a24f9f3813b3de9cb6f68ffec80ae9c12f46e0e8",
        "official_en_sha256": "9ebb4d72f9fff28f303882a594158f8630ad8e952fd09c836b91fc9af77d5c99"
      },
      "text": {
        "jp": "へー、そーなんだー！\r\nさすが！　物知りだねー！",
        "official_en": "Really? No way! You really do know everything about everything!",
        "real_en": null
      },
      "review": {
