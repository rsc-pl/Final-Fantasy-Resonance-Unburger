    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_039:b3d083b8",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_23",
        "key": "FEV_Town_06Zol_23_039",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_039:b3d083b8",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_039:b3d083b8",
        "jp_sha256": "930665db12a7f12db725602d2af56a58a6eddffa8e5f77339170ee0151a61d91",
        "official_en_sha256": "ff4e8e657313315848a0ceff1b39d64a8de9e380a8c4b45a6fc0fa54a6c8e98e"
      },
      "text": {
        "jp": "この列車は、モズール駅行きです。\r\nお乗りになりますか？",
        "official_en": "This is the train bound for Mozul Station. Will you be boarding?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
