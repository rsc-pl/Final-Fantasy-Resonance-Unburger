    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_022:2db6850f",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_23",
        "key": "FEV_Town_06Zol_23_022",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_022:2db6850f",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_23:FEV_Town_06Zol_23_022:2db6850f",
        "jp_sha256": "d62ce2b4726c5f044947b3354b32d2a87acd1d7e7ad647b71160f17ed0865717",
        "official_en_sha256": "59088e073008e52c17080ff00136934488da6ac75a6634e1e3b83d8987651e14"
      },
      "text": {
        "jp": "だろー？",
        "official_en": "What can I say? I’m a self-professed genius.",
        "real_en": "Right?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_06Zol_23",
