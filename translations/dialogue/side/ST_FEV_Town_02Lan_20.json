    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_02Lan_20:FEV_Town_02Lan_20_001:e8378a75",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_02Lan_20",
        "key": "FEV_Town_02Lan_20_001",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_02Lan_20:FEV_Town_02Lan_20_001:e8378a75",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_02Lan_20:FEV_Town_02Lan_20_001:e8378a75",
