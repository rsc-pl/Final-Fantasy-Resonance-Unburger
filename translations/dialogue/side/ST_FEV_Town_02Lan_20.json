    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_02Lan_20:FEV_Town_02Lan_20_025:e95af3bb",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_02Lan_20",
        "key": "FEV_Town_02Lan_20_025",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_02Lan_20:FEV_Town_02Lan_20_025:e95af3bb",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_02Lan_20:FEV_Town_02Lan_20_025:e95af3bb",
