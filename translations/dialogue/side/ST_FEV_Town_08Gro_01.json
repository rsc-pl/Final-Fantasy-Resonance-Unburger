    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_032:6c3fa6fe",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_01",
