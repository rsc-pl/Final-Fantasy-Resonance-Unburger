      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_002:e8c7abc2",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_01",
        "key": "FEV_Town_08Gro_01_002",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_002:e8c7abc2",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_002:e8c7abc2",
        "jp_sha256": "2b40c5fba028781485742d31b91d220532072308ae73c4360572bbcfbc24ee15",
        "official_en_sha256": "ef033f357953d302977989b2b48c2bd5202188a57cf9b71ef105438ed1dc6f97"
      },
      "text": {
        "jp": "このガベラダから東に廃墟があってな。\r\nそこにある白輝石を持ってくるのじゃ。",
        "official_en": "There are ruins east of this town. Bring me a white jade stone that you’ll find there.",
        "real_en": "There are ruins east of Gaberada. Bring me a white shining stone from there."
      },
      "review": {
        "status": "CHANGE"
      },
