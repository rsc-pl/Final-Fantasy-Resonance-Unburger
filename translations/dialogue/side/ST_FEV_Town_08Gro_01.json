    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_026:0d51d4b0",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_01",
        "key": "FEV_Town_08Gro_01_026",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_026:0d51d4b0",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_026:0d51d4b0",
        "jp_sha256": "b70f70985208697d5f4f31ffa03886712342ddad961214f553d7abb62335b827",
        "official_en_sha256": "0e7ff3d8578f4d719b3df4f9414f8996399689179d8f77c3c0e9963fe6552058"
      },
      "text": {
        "jp": "おっと、きみきみ。\r\n盗み聞きはいかんよ。",
        "official_en": "Hm? Excuse me, but I don’t much appreciate being eavesdropped on.",
        "real_en": null
      },
      "review": {
