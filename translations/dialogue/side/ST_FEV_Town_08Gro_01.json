    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_015:f9dcdf5a",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_01",
        "key": "FEV_Town_08Gro_01_015",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_015:f9dcdf5a",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_015:f9dcdf5a",
        "jp_sha256": "d476c99cad802072a2c3b1dbe44ab760c88c91d77f45bb110162c08dd072f5c9",
        "official_en_sha256": "3ee511dee8674c4d01a28cf7932509ccbc789657fe7cc1a6144fa74132c4c51e"
      },
      "text": {
        "jp": "おや、お客人。\r\nこのガベラダになにか用事かい？",
        "official_en": "Hello there, traveler. What brings you to Gaberada?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_08Gro_01",
