    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_031:359fc4ed",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_01",
        "key": "FEV_Town_08Gro_01_031",
