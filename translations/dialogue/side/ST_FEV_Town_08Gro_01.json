        "jp_sha256": "b01bea2aa61c9485f86c47bd3b6d76f5f250c2125be5033ecb6fb00ef437f553",
        "official_en_sha256": "01376f6e367abbf82f5515d16bf8a7c8b78db02d2f8cc93e9d5913594b54bf64"
      },
      "text": {
        "jp": "それも当然だな。\r\n我々はこの大陸に生まれ\r\nこの大陸で生き、そして死ぬ。",
        "official_en": "The reason is quite simple really. We are born on this continent and spend our lives here until our final days.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
