    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_016:fcf93941",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_01",
        "key": "FEV_Town_08Gro_01_016",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_016:fcf93941",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_01:FEV_Town_08Gro_01_016:fcf93941",
        "jp_sha256": "07153b54cc7ce6ae353ccffd7776fe7fe94d1456b8768d3f5015beb4d4404e13",
        "official_en_sha256": "32bdb32ef798a5009882e30c4e72bf853a399ecce2d052229df7310fce8a0b20"
      },
      "text": {
        "jp": "あんまり長居しないほうがいいぞ。\r\n外の瘴気は命をむしばむ類のものだ。",
        "official_en": "Not to scare you off, but I’d advise against staying here too long. That miasma can outright kill outsiders like you.",
        "real_en": "You shouldn't stay long. The miasma outside is the kind that eats away at your life."
      },
      "review": {
        "status": "CHANGE"
      },
