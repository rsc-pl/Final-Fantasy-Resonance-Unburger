    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_035:e4a3fb36",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_03",
        "key": "FEV_Town_06Zol_03_035",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_035:e4a3fb36",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_035:e4a3fb36",
        "jp_sha256": "1d69b14ef0838d20e50deb7f57112de35c49664c223e7e8d473d1887d5ac5511",
        "official_en_sha256": "79cc273de431d4657824ec94e8abd1d6e0478681e7b082a4f7f14f3276f7f729"
      },
      "text": {
        "jp": "きみ、グランシェルトの騎士だろう？\r\nシエラ皇帝の戴冠式には\r\nグランシェルト王もきてくれるんだよな。",
        "official_en": "Hey there, you’re a knight of Grandshelt, aren’t you? I heard your king is coming to Emperor Shera’s coronation.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_06Zol_03",
