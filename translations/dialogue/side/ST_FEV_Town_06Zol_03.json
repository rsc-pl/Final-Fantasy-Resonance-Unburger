          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_001:790c4e87",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_03",
        "key": "FEV_Town_06Zol_03_001",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_001:790c4e87",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_001:790c4e87",
        "jp_sha256": "d88c22e73d1fd7e7c7013e67529064a8d82b7fb1392adfe602331ad806d14ee3",
        "official_en_sha256": "9233adb0e04c19ce60f44a016d38367e2119061407fc9a0ed65f7e8a9117267d"
      },
      "text": {
        "jp": "そこの店には、行くだけ無駄だよ。\r\n品ぞろえも値段も微妙だからな。",
        "official_en": "I wouldn’t buy anything from the shop over there. Their stuff’s awful and much too overpriced.",
        "real_en": "Don't bother going to that shop. Their selection and prices aren't much to write home about."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_06Zol_03",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "屈強な男性",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0183",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_FEV_Town_06Zol_03/FEV_Town_06Zol_03_001"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_030:531875a0",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_03",
        "key": "FEV_Town_06Zol_03_030",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_030:531875a0",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_030:531875a0",
        "jp_sha256": "0e9441ea493f7d22473e5f6307b97a2d76fe8d4b2dda463ac92c0e2541808b3a",
        "official_en_sha256": "054cf0e5b056884c30cd9c90f0750fd85891983ed2bfa06d8d0c0fa914a4e874"
      },
      "text": {
        "jp": "そこの店にはもう行ったかい？\r\n品ぞろえ良し！値段も適正！\r\nオススメだよ。",
        "official_en": "Have you been to the shop there? They have a great selection of wares all reasonably priced! Definitely worth taking a look.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
