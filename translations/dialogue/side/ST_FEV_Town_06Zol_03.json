    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_011:c1baade6",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_03",
        "key": "FEV_Town_06Zol_03_011",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_011:c1baade6",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_011:c1baade6",
        "jp_sha256": "a70b167c52e7c008a0043156301317fbc79b93697b2103e584c95cb71bb87593",
        "official_en_sha256": "2b5c794daabcf2e1b120553db30997de1f455d2b6ef0577987a884af41c7c7ba"
      },
      "text": {
        "jp": "わかるよ、僕も昔グランシェルトに住んでいたから。\r\nわるいが、話しかけないでくれ。\r\nあそこにいる兵士に見つかると面倒だ。",
        "official_en": "I can tell—I used to live there. I’m sorry, but I can’t be seen talking to you. You see that soldier over there? If he spots us, I’ll be in a world of trouble, and I don’t wanna risk it.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
