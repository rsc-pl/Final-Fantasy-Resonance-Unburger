    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_040:e28e9b99",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_03",
        "key": "FEV_Town_06Zol_03_040",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_040:e28e9b99",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_040:e28e9b99",
        "jp_sha256": "81883fc3500167e3a3c6118ded25274493c11b4ac1c8af46f5f7a7962cda87c1",
        "official_en_sha256": "bb30959dfe12057549477ed940f3dda898a8176020e50f5b34d88b164d1e4597"
      },
      "text": {
        "jp": "俺にも商人の誇りがあってね。\r\nいまなら、自信を持って販売できるよ。\r\nおおいに見ていってくれ！",
        "official_en": "I take great pride in my trade, and now that those taxes are gone, you’ll see what I mean! Come, have a look!",
        "real_en": null
      },
      "review": {
