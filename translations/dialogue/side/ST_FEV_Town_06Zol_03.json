        "key": "FEV_Town_06Zol_03_006",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_006:9fd3a1c8",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_006:9fd3a1c8",
        "jp_sha256": "534903065e8bf1413e5578f193d0c8ac712610a0781117f5c5e76f0ecbeffcc2",
        "official_en_sha256": "7c00aca37264622f6c8c0d9be7d781fc65f1576d34afc76c29e8109466f0d78d"
      },
      "text": {
        "jp": "もともと空気がキレイとは言えない街だったけど\r\n最近は輪をかけて酷いねぇ。",
        "official_en": "The air in this city has never been great, but it’s gotten even worse recently, if you can believe it...",
        "real_en": null
      },
