    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_025:6a6ed441",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_03",
        "key": "FEV_Town_06Zol_03_025",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_025:6a6ed441",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_025:6a6ed441",
        "jp_sha256": "f3992435c678735a037a83c81bd2a79dabe19f8f26ceaa51f1175917c7c7373d",
        "official_en_sha256": "b163ee104a5ef50ee449de2fca762b4ef15940032b2e2e619b5424a72908915b"
      },
      "text": {
        "jp": "どうにかやっていくためにはさ\r\n商品の値段をあげるしかないんだ。\r\nそれでも良ければ、見て行ってくれ。",
        "official_en": "Look, I’ll be honest, I had to up the cost of my wares in order to make ends meet. If you’re okay with that, then be my guest and take a look at what I’ve got.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
