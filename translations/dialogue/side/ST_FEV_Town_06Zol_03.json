    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_015:13ba88f5",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_03",
        "key": "FEV_Town_06Zol_03_015",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_015:13ba88f5",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_03:FEV_Town_06Zol_03_015:13ba88f5",
        "jp_sha256": "d7b64666589d234508da84237e742872ee858d5b7dc5611db7f57d5332df750d",
        "official_en_sha256": "261c7381e249c22841bb0f1945fdbe216b92c5f63c5c2c4a8d69854bd0e46d40"
      },
      "text": {
        "jp": "まともな買い物をしたいなら\r\nスラムにでも行った方がマシさ。\r\n商品を見れば、言ってることがわかるだろうよ。",
        "official_en": "I know, don’t say it...my hands are tied. If you’re hoping for more variety and competitive prices, you should head to the slums. You’ll know what I’m talking about when you see their wares.",
        "real_en": "If you want to do some proper shopping, you'd be better off going to the slums. You'll see what I mean when you look at the goods."
      },
      "review": {
        "status": "CHANGE"
      },
