        "official_en_sha256": "86141364757897cf27ed4dd3c31a7544206041449e2a83f077907f2c2fac0784"
      },
      "text": {
        "jp": "もうお前に話すことはない。\r\n早くシモンに手紙を渡せ。",
        "official_en": "I’d hurry up and give that letter to Simon. I’ve got nothing more to say to you.",
        "real_en": null
      },
