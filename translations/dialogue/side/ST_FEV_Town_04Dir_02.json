        "key": "FEV_Town_04Dir_02_040",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_02:FEV_Town_04Dir_02_040:b7c49509",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_02:FEV_Town_04Dir_02_040:b7c49509",
