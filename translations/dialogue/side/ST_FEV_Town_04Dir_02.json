        "key": "FEV_Town_04Dir_02_041",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_02:FEV_Town_04Dir_02_041:e04b13ac",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_02:FEV_Town_04Dir_02_041:e04b13ac",
