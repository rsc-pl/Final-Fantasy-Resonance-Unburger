        "official_en_sha256": "72b1e70b96657477299b520bcf71a540f897b9d3ce5f87bafddd5b7277ad4394"
      },
      "text": {
        "jp": "俺たちは軍のために\r\n飛空艇を作っているわけじゃない！",
        "official_en": "Don’t think for a second that we build airships to make you military folk happy!",
        "real_en": "We don't build airships for the military!"
      },
