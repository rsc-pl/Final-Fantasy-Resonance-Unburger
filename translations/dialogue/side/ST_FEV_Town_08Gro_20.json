        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_005:e2672700",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_20",
        "key": "FEV_Town_08Gro_20_005",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_005:e2672700",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_005:e2672700",
