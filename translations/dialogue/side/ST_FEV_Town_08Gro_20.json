        "official_en_sha256": "19c76e01ddec967f2ea8707ea89775cf91c96b71e6906246d951b975cc39b4e8"
      },
      "text": {
        "jp": "ん……？　なに見てんだよ……？\r\nこの肉は絶対やらないぞ。",
        "official_en": "Huh? What are <text style=\"italic\">you</> looking at, bucko? This meat’s mine.",
        "real_en": null
      },
      "review": {
