          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_015:745298d0",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_20",
        "key": "FEV_Town_08Gro_20_015",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_015:745298d0",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_015:745298d0",
        "jp_sha256": "27f9e3ecd7325611c7ea11aaf14faf9f1e479541ce87047f1d15bccd772c9a26",
        "official_en_sha256": "8aa2cc31b3a9d82e3ff886f63983e76fb0d7d0e35a107a2bcb130d65c1d04940"
      },
      "text": {
        "jp": "ここにいるってことは\r\n瘴気に耐える手段を持っているんだな。\r\nとはいえ、山道は危ない。うちで備えていきな。",
        "official_en": "If you’re here, I guess it means you have a way to get through the miasma. But even so, the mountain path’s a rough one. You’ll need some supplies in preparation for your trek.",
        "real_en": "If you're here, you must have some way of withstanding the miasma. But the mountain roads are dangerous. Stock up here before you go."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_08Gro_20",
        "sequence": null,
        "speaker": {
