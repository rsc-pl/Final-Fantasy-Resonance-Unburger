    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_002:754d4ef4",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_20",
