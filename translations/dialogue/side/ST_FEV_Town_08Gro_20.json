    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_006:7cdeb0de",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_20",
        "key": "FEV_Town_08Gro_20_006",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_006:7cdeb0de",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_006:7cdeb0de",
