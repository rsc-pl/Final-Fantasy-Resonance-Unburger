    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_011:97b1528b",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_20",
        "key": "FEV_Town_08Gro_20_011",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_011:97b1528b",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_011:97b1528b",
        "jp_sha256": "42b3ec4e394f6703876354cc92ef04caf6207cd21e5b90c7128825566eb217ce",
        "official_en_sha256": "80766e6b4ca8314ff2dabce4ab782cc15d045ce326ec388ddf9e8def1a538753"
      },
      "text": {
        "jp": "干し肉じゃない肉なんて\r\nめったに手に入らないからな……。\r\n大事に大事にひとりで食べるんだ。",
        "official_en": "It ain’t every day you find meat that isn’t dried...so I’m gonna eat it slowly, savoring it one piece at a time.",
        "real_en": "You hardly ever get meat that isn't dried... I'm going to eat it all by myself and treasure every bite."
      },
      "review": {
