    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_010:fc0f02a1",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_20",
        "key": "FEV_Town_08Gro_20_010",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_010:fc0f02a1",
