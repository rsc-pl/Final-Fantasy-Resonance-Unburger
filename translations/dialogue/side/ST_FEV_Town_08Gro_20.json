    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_001:86bbee6a",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_08Gro_20",
        "key": "FEV_Town_08Gro_20_001",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_001:86bbee6a",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_08Gro_20:FEV_Town_08Gro_20_001:86bbee6a",
        "jp_sha256": "7657bd12c0184a0b82e40025cb8c29692ed65154e8c718987ee268357bb64a39",
        "official_en_sha256": "49b2715145074708296762a9cdb2692f83e3c9fe34dad88e7596ea1b4eb0fbf1"
      },
      "text": {
        "jp": "お前たち、ガベラダの町人じゃないよな？\r\n瘴気の耐性もないのに、 この町に来るなんて……。",
        "official_en": "Say, you’re not from Gaberada, are you? How’d you even get here through the miasma?",
        "real_en": "You're not from Gaberada, are you? Coming here without any resistance to the miasma..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_08Gro_20",
        "sequence": null,
        "speaker": {
