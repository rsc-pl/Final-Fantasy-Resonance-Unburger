      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_01",
        "key": "FEV_Town_06Zol_01_025",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_025:95d99f18",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_025:95d99f18",
