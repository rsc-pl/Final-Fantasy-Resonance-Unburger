    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_042:b20dd844",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_01",
        "key": "FEV_Town_06Zol_01_042",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_042:b20dd844",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_042:b20dd844",
        "jp_sha256": "c60bc4f2f5a5fd22218ac1cf234e0d73d4836069d8f2b723945bd2c626f8770c",
        "official_en_sha256": "5a3aeb253f90bb844931331a7003975de3f35abf0941a29bba478edac238bac9"
      },
      "text": {
        "jp": "えぇ！？\r\nじゃあまず、王冠に似合うドレス買いに行かなきゃ！！",
        "official_en": "Omigosh, you’re totally right. Then I’ll need to buy a dress that’ll go nicely with my crown!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
