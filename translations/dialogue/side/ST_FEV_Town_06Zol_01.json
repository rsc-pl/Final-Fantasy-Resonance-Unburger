    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_055:59b03074",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_01",
        "key": "FEV_Town_06Zol_01_055",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_055:59b03074",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_055:59b03074",
        "jp_sha256": "223d008df26e0b08143b6bc85e53f324d84f600fd3abbb85907abd1d95455074",
        "official_en_sha256": "1450a2cc4aab2c28000776f2ad1f9b48935c0e276a83008bdf4c20d9041219bd"
      },
      "text": {
        "jp": "おじいさまからホテルを受け継いだ時には\r\nなぜ隠し通路が？と思ったものです。",
        "official_en": "When I inherited this establishment from my grandfather, I failed to see why a hidden pathway would ever be necessary in a hotel...",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
