          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_032:829bcd7c",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_01",
        "key": "FEV_Town_06Zol_01_032",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_032:829bcd7c",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_032:829bcd7c",
        "jp_sha256": "305a3aa535f2f7f3029dcd99a54b84474dfdc0c7a9cb25a52bac3a284e681bc6",
        "official_en_sha256": "d74dff73a5df68d05632b44c93947882c3b57aa282e9022c0d95c8870e8263f4"
      },
      "text": {
        "jp": "おかげで皆が涙にくれずに\r\nこの革命を祝えるってわけだね。",
        "official_en": "And it means we all get to celebrate the revolution without the usual pain of so much loss.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
