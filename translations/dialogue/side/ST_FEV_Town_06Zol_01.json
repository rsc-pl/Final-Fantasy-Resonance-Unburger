    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_016:771f4248",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_01",
        "key": "FEV_Town_06Zol_01_016",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_016:771f4248",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_016:771f4248",
        "jp_sha256": "9ff20609b8f68cd057590336d3d60d2bd40c291828ab4fdcde20cfce1540b415",
        "official_en_sha256": "40bcea2006929dff0fe2fde5b2f5fc06f9cfd22a11acbd0e1aae844727fba9b9"
      },
      "text": {
        "jp": "うーん、外出しても息子が楽しめなそうだし\r\nこのままホテルで過ごすことにしようかな。",
        "official_en": "Honestly, I’m not sure my son and I would even enjoy going out. Maybe we should just stay in our hotel room.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
