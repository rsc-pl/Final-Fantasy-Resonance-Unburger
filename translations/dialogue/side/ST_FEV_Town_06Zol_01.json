        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_020:821b6b39",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_01",
        "key": "FEV_Town_06Zol_01_020",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_020:821b6b39",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_020:821b6b39",
        "jp_sha256": "833c98191b01aa3a3689b84298f85077eb0c430eab4869b37157dae81046cfed",
        "official_en_sha256": "69e399f4075db3f28def6cc2b16d2ce777857570a47eb7751f5d15abb8a6d92f"
      },
      "text": {
        "jp": "なんだか街が騒がしいな。\r\n兵士もぞろぞろ出てきたし……。",
        "official_en": "What’s with all the soldiers? Is something about to go down?",
        "real_en": "The city's getting restless... And all those soldiers have come out..."
      },
      "review": {
        "status": "CHANGE"
      },
