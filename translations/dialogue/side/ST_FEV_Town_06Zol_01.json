    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_056:4cd2ee6b",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_01",
        "key": "FEV_Town_06Zol_01_056",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_056:4cd2ee6b",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_056:4cd2ee6b",
        "jp_sha256": "5ac87736950d730561ad0d665cd5c121b372d1a8e4293ef32d18b7558d940f5a",
        "official_en_sha256": "8273b993dae7843d9a347f23a3b487a547d76467cb781833a2b6ae16fc21fbe3"
      },
      "text": {
        "jp": "ですが、こうしてジェイクさんのお役に立てて\r\nきっとこの時のためのものだったのだと\r\n合点がいったのですよ。",
        "official_en": "But seeing how it helped Jake...I understand now that it was built with this exact situation in mind.",
        "real_en": "But seeing that it helped Jake-san...\r\nI realized it must have been made\r\nfor this very moment."
      },
      "review": {
        "status": "CHANGE"
      },
