    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_066:4c9a10f0",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_01",
        "key": "FEV_Town_06Zol_01_066",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_066:4c9a10f0",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_066:4c9a10f0",
        "jp_sha256": "603327ab5367d9f6e7fdc91903a97e424dd4e852f5961fdb2e802d86c911861b",
        "official_en_sha256": "61b0b82a858061af5fb7d5b7dccebfedd676ca7fd91e74f5c8d362c30e9f9a68"
      },
      "text": {
        "jp": "ちゃんと取材をするのが私のポリシー。\r\nでも、それだけじゃ駄目。",
        "official_en": "It’s my policy to do as much legwork as possible. But sometimes that’s not enough.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
