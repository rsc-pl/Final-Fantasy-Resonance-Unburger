        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_006:2d733ece",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_01",
        "key": "FEV_Town_06Zol_01_006",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_006:2d733ece",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_006:2d733ece",
        "jp_sha256": "2d6b560e717743ab56f09602d70139c3b76967dc44da2fc982ec9414f1bc9110",
        "official_en_sha256": "c0880fc5ef55259c7ceb21e58d13d6e3cacd06a8fcd431b3aba7caf4110afce0"
      },
      "text": {
        "jp": "すまない。仕事中は私語厳禁なんだ。\r\nどこで兵士が見ているかわからないからね。",
        "official_en": "Sorry, but I’m working right now—can’t be seen to be chatting. You never know when the soldiers are watching.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
