    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_002:c94065e5",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_01",
        "key": "FEV_Town_06Zol_01_002",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_002:c94065e5",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_01:FEV_Town_06Zol_01_002:c94065e5",
        "jp_sha256": "518918c5bf0b95979976d19d3ce1c8704b01145140c4acaf706bb685bf7925da",
        "official_en_sha256": "208436f35d7fdf1bf42070aef2094a221aea74d9e9dd993a9904610de19230d8"
      },
      "text": {
        "jp": "だけどさ、最近の力の入れようは\r\n正直言って怖いほどだよ。",
        "official_en": "But the pace they’ve been churning them out recently? Honestly, it’s quite terrifying.",
        "real_en": "But honestly, the emphasis they've been putting on it lately is frightening."
      },
      "review": {
        "status": "CHANGE"
      },
