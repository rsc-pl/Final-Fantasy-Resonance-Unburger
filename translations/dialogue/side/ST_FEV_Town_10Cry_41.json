        "official_en_sha256": "49587c4fe5f0881646cabf07c431e56e74feafec03c6ef237f26dbea5d6d2203"
      },
      "text": {
        "jp": "あんたは一人じゃないんだ。\r\n大丈夫、私はずっと見てきたからさ。",
        "official_en": "Besides, you’ve also got friends that have your back. Trust me, I’ve been watching you throughout your travels.",
        "real_en": "You're not alone. It's all right. I've been watching you all this time."
      },
      "review": {
        "status": "CHANGE"
      },
