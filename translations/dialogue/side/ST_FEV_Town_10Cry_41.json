    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_10Cry_41:FEV_Town_10Cry_41_006:8303ba18",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_10Cry_41",
        "key": "FEV_Town_10Cry_41_006",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_10Cry_41:FEV_Town_10Cry_41_006:8303ba18",
