    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_035:c62da31b",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_035",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_035:c62da31b",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_035:c62da31b",
        "jp_sha256": "76ed93386f83a08cfce8f112743b49ff4017889dee2be947b46f4400bab2557d",
        "official_en_sha256": "66c00067b7e7a6519701a75cc3009aa5e45ed18a8ba9c8b79053600f1d128c3f"
      },
      "text": {
        "jp": "これが最後の戦いになる！\r\n俺たち兵站部隊が反乱軍を支えるんだ！",
        "official_en": "This is it, people—our last fight! As the logistics team, we are to do everything we can to support the other teams!",
        "real_en": "This will be the final battle! It's up to us in the logistics unit to support the rebel army!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_06Zol_21",
