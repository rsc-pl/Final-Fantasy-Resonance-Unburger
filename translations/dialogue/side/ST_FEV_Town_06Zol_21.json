    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_012:cc1b3489",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_012",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_012:cc1b3489",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_012:cc1b3489",
        "jp_sha256": "be4ee00b1adf4782b5e7d0a4264ba8948f1fcb8bc5f503f9781b2db6e524fb7f",
        "official_en_sha256": "602920bc1852fe5960a080600c294c938d2b02dec47451cca5e7b0778b80ba6e"
      },
      "text": {
        "jp": "俺の夢は、ゾルダードの古き良き鍛冶の技術を\r\n後世に繋ぐことなんだ。",
        "official_en": "My dream is to preserve Zoldaad’s proud smithing tradition and pass it down to future generations.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
