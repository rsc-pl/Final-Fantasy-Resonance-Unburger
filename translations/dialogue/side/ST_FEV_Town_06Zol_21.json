      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_011:ea79f330",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_011",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_011:ea79f330",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_011:ea79f330",
        "jp_sha256": "2c3c9954ae3e20f6a640fb6f13471f1e7cdbd2ea3ae3977659344745e77dd61e",
        "official_en_sha256": "769056a023cccfb22db6bfb2010721854abfe6913011e1bf69dd658d89f5ab43"
      },
      "text": {
        "jp": "でもな、より効率的な破壊を求める兵器からは\r\n美学が感じられない。",
        "official_en": "But if you ask me, there’s no honor in chasing ever more efficient means of destruction.",
        "real_en": "But I can't see any beauty in weapons designed for ever more efficient destruction."
      },
      "review": {
        "status": "CHANGE"
      },
