    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_003:201ea562",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_003",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_003:201ea562",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_003:201ea562",
        "jp_sha256": "539caa2db7d406b201f94ec0e2a85c94c0f109504686ddfa33fc357acd37e072",
        "official_en_sha256": "a2c6a934684e6e9b7b51f2df86981aea9ec7f59ba8f421b5aff195b7a1e982f2"
      },
      "text": {
        "jp": "俺達が勝てば、今度は俺達が\r\n正規の取引相手になるんだってな。\r\n商人ってのは、そういう現実に敏感なのさ。",
        "official_en": "Because if we win, those merchants get to be the main suppliers for the new military. It’s nothing personal; it’s just business for them.",
        "real_en": "If we win, we'll become their official trading partners. Merchants are quick to see how things really stand."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
