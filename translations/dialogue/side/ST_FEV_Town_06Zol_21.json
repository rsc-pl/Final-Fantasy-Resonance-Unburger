    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_020:8cf5b723",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_020",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_020:8cf5b723",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_020:8cf5b723",
        "jp_sha256": "45b642881bb5490de4f999f11a530ba3b401de0099ddc15b19f249059dd6b846",
        "official_en_sha256": "36662ce1258968b2967bdd586c5090d99e9db3c4bac514b08a2bc2a4fce0b06b"
      },
      "text": {
        "jp": "どこで仕入れてるかって？\r\n詳しくは言えないが、外にも協力者はいるってことだ。\r\nさ、なんか買っていくかい？",
        "official_en": "Where do I get my wares? Now that’s a trade secret...though I will say that I have outside help. Now, come see what I’ve got.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
