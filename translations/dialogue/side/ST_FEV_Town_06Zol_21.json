        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_115:1bfb5d67",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_115",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_115:1bfb5d67",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_115:1bfb5d67",
        "jp_sha256": "bd6cb2fb80519e00ba7fb0e6a6ca4934877972ed567e7f3830eddcb48eee411c",
        "official_en_sha256": "ed0ad08951c5d0cf4894602afa9618409d87a2f324f45c600ee6d1d7c5952ed3"
      },
      "text": {
        "jp": "さっきは無理言ってすまねぇな。\r\nあんまりお前たちが強いから\r\n期待しちまった。",
        "official_en": "Sorry about earlier. Figured it wouldn’t hurt to ask, especially with the way you all handle yourselves in a fight.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_06Zol_21",
