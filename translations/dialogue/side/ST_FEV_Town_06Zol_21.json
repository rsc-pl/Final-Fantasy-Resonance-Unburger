    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_055:20322817",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_055",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_055:20322817",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_055:20322817",
        "jp_sha256": "4cc399dcff04b9b9ffb8ca33f2d9d560ef859db93282d942fdc51c162c0070aa",
        "official_en_sha256": "36662ce1258968b2967bdd586c5090d99e9db3c4bac514b08a2bc2a4fce0b06b"
      },
      "text": {
        "jp": "どこで仕入れたかって？\r\n詳しくは言えないが、外にも協力者はいたってことだ。\r\nさ、なんか買っていくかい？",
        "official_en": "Where do I get my wares? Now that’s a trade secret...though I will say that I have outside help. Now, come see what I’ve got.",
        "real_en": "Where did I get my stock? I can't say much, but we had help from outside. Now, want to buy something?"
      },
      "review": {
        "status": "CHANGE"
      },
