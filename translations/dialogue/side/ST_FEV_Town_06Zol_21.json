        "key": "FEV_Town_06Zol_21_025",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_025:bb7b1dc6",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_025:bb7b1dc6",
