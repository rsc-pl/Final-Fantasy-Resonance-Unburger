    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_010:b768f70c",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_010",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_010:b768f70c",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_010:b768f70c",
        "jp_sha256": "f4f8633d718d06efba583bc8914bcf0f2ce735e455f4762e6919a38656bc5f55",
        "official_en_sha256": "dcca7d9dcefcdc8c890a247505c2a76cff96820e9636fcdcb5094d7f3356ce52"
      },
      "text": {
        "jp": "この国は昔、鍛冶が栄えていてな。\r\nそいつが発展して、兵器産業が確立したんだ。",
        "official_en": "This country made a name for itself with the quality of its smithing. That evolved into the weapons industry we have now.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_06Zol_21",
