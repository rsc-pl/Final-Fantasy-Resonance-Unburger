    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_045:845a2cb5",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_045",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_045:845a2cb5",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_045:845a2cb5",
        "jp_sha256": "b25a708a2588600ebc8416a313ca40766090576c7fe4e5073cda49beacfe1932",
        "official_en_sha256": "426faa9ec68935756be4fe44db191fee8ce2e3f258baa715f5cb7dddf1a75be1"
      },
      "text": {
        "jp": "ここはもう用済みなんだよな……\r\n寂しいなんて言ったら\r\nおかしいのはわかってるんだけどさ。",
        "official_en": "I know it sounds weird saying this, but...it feels bittersweet knowing we won’t be needing this place anymore.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
