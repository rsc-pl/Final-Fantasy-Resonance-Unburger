        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_060:88a452cd",
        "jp_sha256": "7a5ee313f0bedf3ca4cef0e3b30ec63050fa0c4471f7136ed12e7a498bf3b4e1",
        "official_en_sha256": "c6d7c0697584b7e6fc65b51829e73fd59423ec7ad86ed6b65a2ecaf5842dabbc"
      },
      "text": {
        "jp": "「のばら」の旗が城に掲げられたのを見たかい？\r\n俺たちの信念が国中に届いたんだ！",
        "official_en": "Did you see the flag of the Wild Rose hoisted high above the castle? Our conviction has reached people all over the nation!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
