        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_040:c23a7487",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_040",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_040:c23a7487",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_040:c23a7487",
        "jp_sha256": "38ceddcc8c953395002a24a2234a8d001643cbe670b52903941efe37c7c6cc3c",
        "official_en_sha256": "6a4257b1522bddb1a0bab0a45ef9fcd468f4a49a33425aed8e4a2eca101e7217"
      },
      "text": {
        "jp": "ついにこの時が来たな……！\r\nシエラ皇太子のためにも、死力を尽くすぞ！",
        "official_en": "It’s finally happening! I’ll fight tooth and nail for Prince Shera!",
        "real_en": "It’s finally happening! I’ll fight tooth and nail for Crown Prince Shera!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
