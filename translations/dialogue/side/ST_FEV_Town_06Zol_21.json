    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_116:ad785dc7",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_116",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_116:ad785dc7",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_116:ad785dc7",
        "jp_sha256": "2a0e5c1a96a8d6979b14f8b36f98f46adcc16ba5b9a3c090daeec36d53b9114c",
        "official_en_sha256": "456414cb809d9ad989f8988b90c4858df2192118cea8c6be28132456e19322c2"
      },
      "text": {
        "jp": "ここの店や宿を使ってくれてかまわない。\r\nゆっくり休んでいってくれ。",
        "official_en": "You’re welcome to lay low here as long as you need. The inn and shops are yours to use, too.",
        "real_en": "You can use the shops and the inn here. Take your time and rest up."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
