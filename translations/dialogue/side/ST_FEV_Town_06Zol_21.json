        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_031:e2a5bddc",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_031",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_031:e2a5bddc",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_031:e2a5bddc",
        "jp_sha256": "7c9e431dd80e3f2076bdc516f10bc9ea815edd1abfc4e8fa935559938f8cb0bd",
        "official_en_sha256": "b39a25e3b97c3fb05c76f19b366b067b8fabde8b0697707d54ca62b52786e1fe"
      },
      "text": {
        "jp": "この旗は、俺たちの信念の証なのさ。",
        "official_en": "It represents all that we stand for.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_06Zol_21",
