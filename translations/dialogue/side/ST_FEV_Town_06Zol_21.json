          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": []
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_002:7aa1b8fd",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_002",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_002:7aa1b8fd",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_002:7aa1b8fd",
        "jp_sha256": "54eb5ac93d352c1ee900b0c266b61c78f99ad1287e3fcda26b7fa6b967debb80",
        "official_en_sha256": "afbc5dddd9e509e8a517731ebb8c99f63287aa86bfee320e93b41a7d5f1c10f4"
      },
      "text": {
        "jp": "ただ、正規軍じゃないからな。\r\n取引相手を見つけるだけでも一苦労だ。\r\nだから、少しでも勝算があると思わせなきゃならん。",
        "official_en": "Let me tell you, we’re not an actual military, so it’s tough finding suppliers willing to do business with us. The trick is to make them believe we actually have a winning chance.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_06Zol_21",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": null,
          "label_status": "UNKNOWN",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": []
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_061:1d672fd8",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_061",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_061:1d672fd8",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_061:1d672fd8",
        "jp_sha256": "d418ead62275e96361dbcb3ffdb5d10eb996f444450758a8ab5dc4e23081718c",
        "official_en_sha256": "d60393a93d7832c8ece1a935b7f299eb9d8676b66e46af962c286535c3fe0fb8"
      },
      "text": {
        "jp": "だけど、これで終わりじゃない。\r\nこれからはシエラ皇帝のもとで\r\n国の再建に尽力するんだ！",
        "official_en": "But this is just the beginning. Under Emperor Shera, we’re going to restore Zoldaad to its former glory!",
        "real_en": "But it doesn't end here. From now on, we'll work hard to rebuild the country under Emperor Shera!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
