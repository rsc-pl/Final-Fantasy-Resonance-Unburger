    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_036:3dfcfb2c",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_036",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_036:3dfcfb2c",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_036:3dfcfb2c",
        "jp_sha256": "6f51a77a776846884ccae463884c1398cd806946d7a2494a6513cabdfc7ffb00",
        "official_en_sha256": "9b744647208052f1f5b5538be5e671339cd0ef8a1a81ced995ed9457cba26c87"
      },
      "text": {
        "jp": "俺たちが変えるぞ、この国を！",
        "official_en": "Let’s change Zoldaad... <text style=\"italic\">Our</> Zoldaad!",
        "real_en": "We're going to change this country!"
      },
      "review": {
        "status": "CHANGE"
      },
