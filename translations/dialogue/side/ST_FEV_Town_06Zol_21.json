    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_001:f3e0b1a5",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_001",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_001:f3e0b1a5",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_001:f3e0b1a5",
        "jp_sha256": "9dbdc6ab630738148d5d271460600b903be038af84d36976ac4af0657f14e3f6",
        "official_en_sha256": "056b8dfb0ca42c6a681b999052eaa9f903e89f8e50ff9d6679c7c58841422443"
      },
      "text": {
        "jp": "俺は反乱軍の兵站を担っている。\r\n戦をするには武器だけじゃなく、\r\n金や飯も必要だ。",
        "official_en": "I’m the quartermaster. Weapons aren’t the only thing you fight a war with—you also need money, provisions, and other supplies, too. I oversee them all.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
