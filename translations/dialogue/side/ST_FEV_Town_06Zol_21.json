      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_015:0b24c56f",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_06Zol_21",
        "key": "FEV_Town_06Zol_21_015",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_015:0b24c56f",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_06Zol_21:FEV_Town_06Zol_21_015:0b24c56f",
        "jp_sha256": "39d74830711f4216c440282569c546b8e402c0dec26114fdd322d30287e9a9e9",
        "official_en_sha256": "75849028a6ecd0bae1ae651a4345042f2b4da39d4dd557624979237d5a70423e"
      },
      "text": {
        "jp": "国を相手取るんだ。\r\n準備し過ぎってこともないだろう？\r\n見て行ってくれ。",
        "official_en": "We’re going up against a literal army. Can’t hurt to be prepared, right? Take a look.",
        "real_en": "We're up against the state. There's no such thing as being too prepared, right? Take a look."
      },
      "review": {
        "status": "CHANGE"
      },
