          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_002:d496f6d3",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_06Zol_40",
        "key": "FEV_Dng_06Zol_40_002",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_002:d496f6d3",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_002:d496f6d3",
        "jp_sha256": "08a9d22434bf8ef729ca3537250e0d2409a9fb1e74e8437436adb145f0c9fb96",
        "official_en_sha256": "a946d0ef5fc9d671cdea664524b6cb4dcf078cb76a824e29017b9b97bc35427b"
      },
      "text": {
        "jp": "……あの頃は楽しかった。\r\n技術立国を謳って、新しい技術が\r\n続々と現れてのう。",
        "official_en": "’Twas a marvelous era... It was when Zoldaad started to emerge as a technological powerhouse and new inventions were being rolled out daily.",
        "real_en": "Those were good times... We prided ourselves on being a technological nation, and new inventions kept appearing one after another."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
