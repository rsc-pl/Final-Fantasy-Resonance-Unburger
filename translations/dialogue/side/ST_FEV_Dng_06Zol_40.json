          "applicability": "REQUIRED",
          "label_jp": "老人",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0029",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_FEV_Dng_06Zol_40/FEV_Dng_06Zol_40_002"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_018:b5212069",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_06Zol_40",
        "key": "FEV_Dng_06Zol_40_018",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_018:b5212069",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_018:b5212069",
        "jp_sha256": "20bdc99365cb5ebd24bfc09ae552abb39b9a43e0c5e7ce3e69f2c5ae37c21606",
        "official_en_sha256": "d03d681e5b9244cdeef8c72ff1113f2959b0c5dc9ba21088b94348942045df96"
      },
      "text": {
        "jp": "……それは無理じゃないか。",
        "official_en": "Son, that’s probably a little too much for her.",
        "real_en": "...I don't think that's possible."
      },
      "review": {
        "status": "CHANGE"
      },
