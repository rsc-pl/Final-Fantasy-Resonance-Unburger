          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_FEV_Dng_06Zol_40/FEV_Dng_06Zol_40_012"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_005:7b88e011",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_06Zol_40",
        "key": "FEV_Dng_06Zol_40_005",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_005:7b88e011",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_005:7b88e011",
        "jp_sha256": "eb7d4d73be4e8e704c5f6f2621a9ab84a605ad9932e329029a281442e52ea3ea",
        "official_en_sha256": "d735c8c67e9ea5361381631d4f6b42c6d0982cd957a2055f25a2d50b074e9698"
      },
      "text": {
        "jp": " 火山の活動が、\r\n ここ数年で一番激しくなっているようです。",
        "official_en": "The volcano has become extremely active these past few years.",
        "real_en": "The volcano seems more active now than at any time in the last few years."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Dng_06Zol_40",
