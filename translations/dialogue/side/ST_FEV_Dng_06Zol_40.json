          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_012:4859e0b2",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_06Zol_40",
        "key": "FEV_Dng_06Zol_40_012",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_012:4859e0b2",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_012:4859e0b2",
        "jp_sha256": "bc881d591d34388b0ecf15262bd4f512e2ef7d05e105d50af7747033a363d3c6",
        "official_en_sha256": "a6377c17966d37aa2067824c4b1e2269ba76c8b4689b8c289b8367a2647b6293"
      },
      "text": {
        "jp": " 帝国についてはあまり詳しくないので、\r\n 聞くなら別の人がいいと思いますよ。",
        "official_en": "If you’re looking for information on Zoldaad, I’m afraid I can’t help you. You’re better off asking someone else.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
