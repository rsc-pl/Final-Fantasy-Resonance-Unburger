    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_001:e8aa88f3",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_06Zol_40",
        "key": "FEV_Dng_06Zol_40_001",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_001:e8aa88f3",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_06Zol_40:FEV_Dng_06Zol_40_001:e8aa88f3",
        "jp_sha256": "399edb4f94d02c852fa54419c6746933498c52059a8a2a1e6a2917607738181f",
        "official_en_sha256": "6c25b58fefd8b90e00c7ba021a443e8d4d3ee10558fee039c56cab3c4a85e8e2"
      },
      "text": {
        "jp": "ゾルダードの技術は世界一じゃ。\r\nこの鉄道もワシの若い頃にできてのう。",
        "official_en": "Zoldaad’s technology is the best in the world. This railway was built when I was still a whippersnapper.",
        "real_en": "Zoldaad's technology is the best in the world. This railway was built when I was young."
      },
      "review": {
