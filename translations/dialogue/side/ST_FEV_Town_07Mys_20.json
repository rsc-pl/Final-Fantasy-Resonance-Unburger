        "official_en_sha256": "1367eff3418c092ba648a85095b4f2fc7b3480d0f73ea2a4ccc10d7290072267"
      },
      "text": {
        "jp": "ここに泊まるのが好きでね。\r\nちょくちょく遊びに来てるの。",
        "official_en": "I enjoy spending my nights here, so I like to visit from time to time.",
        "real_en": "I like staying here, so I come to visit pretty often."
      },
      "review": {
        "status": "CHANGE"
      },
