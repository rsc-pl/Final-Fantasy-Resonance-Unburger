    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_07Mys_20:FEV_Town_07Mys_20_003:f1f18641",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_07Mys_20",
        "key": "FEV_Town_07Mys_20_003",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_07Mys_20:FEV_Town_07Mys_20_003:f1f18641",
