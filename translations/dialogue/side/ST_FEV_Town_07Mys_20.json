    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_07Mys_20:FEV_Town_07Mys_20_001:2f62eb65",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_07Mys_20",
        "key": "FEV_Town_07Mys_20_001",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_07Mys_20:FEV_Town_07Mys_20_001:2f62eb65",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_07Mys_20:FEV_Town_07Mys_20_001:2f62eb65",
        "jp_sha256": "a3fcc5cdf785427b35e90f75b8c9a7364d1d75f8b8d3ae07c02bf44c05d73531",
        "official_en_sha256": "47a35e511a4db267050894d8bbabbd172aa050a86bb419b0dde02b78d4c0ae5d"
      },
      "text": {
        "jp": "ここはスニウ村……。\r\n外からのお客さんなんて、何年ぶりかしら。",
        "official_en": "Why, hello. Welcome to the village of Sunioo. It’s been years since we’ve had visitors.",
        "real_en": "This is Sunioo Village... How many years has it been since we last had a visitor from outside?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
