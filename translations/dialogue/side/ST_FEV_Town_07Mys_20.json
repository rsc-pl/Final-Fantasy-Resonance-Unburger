    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_07Mys_20:FEV_Town_07Mys_20_045:ac7ee160",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_07Mys_20",
        "key": "FEV_Town_07Mys_20_045",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_07Mys_20:FEV_Town_07Mys_20_045:ac7ee160",
