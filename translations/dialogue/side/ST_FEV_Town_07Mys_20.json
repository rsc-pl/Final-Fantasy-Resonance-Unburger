    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_07Mys_20:FEV_Town_07Mys_20_016:9f4c7f0d",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_07Mys_20",
        "key": "FEV_Town_07Mys_20_016",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_07Mys_20:FEV_Town_07Mys_20_016:9f4c7f0d",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_07Mys_20:FEV_Town_07Mys_20_016:9f4c7f0d",
