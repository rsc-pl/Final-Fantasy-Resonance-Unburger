        "jp_sha256": "643c45453c78d4e3229ca95821c259570c87add235bed4acac280dc51ea44a8d",
        "official_en_sha256": "972ce00bd105c9fc01d5acc54cb6a1b0929939b46ebf53272161995606660345"
      },
      "text": {
        "jp": "あんたってバカねぇ。\r\nあれは、子どもが勝手に入らないように\r\n大人がつくった迷信よ。",
        "official_en": "You dummy, that’s just something adults made up to keep kids away.",
        "real_en": "You're such a dummy. Adults made that story up so children wouldn't go inside on their own."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_FEV_Town_07Mys_20",
        "sequence": null,
        "speaker": {
