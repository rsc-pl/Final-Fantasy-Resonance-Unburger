        "official_en_sha256": "3d1a3a96bd582f482fc80d3cb5372be6d7516bfcf1a4400b181fa03b80ef7220"
      },
      "text": {
        "jp": "この村では\r\nミシディアからの物資が頼りでして……\r\n本当に助かりました。",
        "official_en": "We rely on Mysidia for most—if not all—of our supplies, and your help has been invaluable.",
        "real_en": "Our village relies on supplies from Mysidia... You really helped us."
      },
