        "key": "FEV_Town_04Dir_01_060",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_01:FEV_Town_04Dir_01_060:17003e7d",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_01:FEV_Town_04Dir_01_060:17003e7d",
        "jp_sha256": "550c002ce6cb37473c02781c7c5a605214ae90324c3ec95f824c6786caf36bfe",
        "official_en_sha256": "c355004dec73999312df2dd1f9bc655e0a820661f1c79688dbaa45ea7f1b450b"
      },
      "text": {
        "jp": "この都市のマニア共も唸る防具の数々！\r\nとくと見て行ってくれ！",
        "official_en": "I’ve got armor that’ll make even the pickiest gearheads in this city weep! See for yourself!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
