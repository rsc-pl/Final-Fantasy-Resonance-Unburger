    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_01:FEV_Town_04Dir_01_032:8e79babb",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_04Dir_01",
        "key": "FEV_Town_04Dir_01_032",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_01:FEV_Town_04Dir_01_032:8e79babb",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_01:FEV_Town_04Dir_01_032:8e79babb",
