    {
      "record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_01:FEV_Town_04Dir_01_002:d47b14b6",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Town_04Dir_01",
        "key": "FEV_Town_04Dir_01_002",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_01:FEV_Town_04Dir_01_002:d47b14b6",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Town_04Dir_01:FEV_Town_04Dir_01_002:d47b14b6",
        "jp_sha256": "9c57fa415c86455a97c098f24be7df1972af749eba40108b5b59e8f395bef53e",
        "official_en_sha256": "60b2ce6eceadd1f49c0e621d29f12fd732a07ff8a424ea7b1e56b2ca0bac09f4"
      },
      "text": {
        "jp": "そんな君を、\r\nこのディルマギアは歓迎するぜ！",
        "official_en": "If you appreciate the grit, the grind, and the growl of machines as much as I do, Dilmagia welcomes ya with open arms!",
        "real_en": "If you feel that way, Dilmagia welcomes you!"
      },
      "review": {
        "status": "CHANGE"
      },
