        "official_en_sha256": "dc0f44a128fdc0c634453d8dff770a1adbe503b77998e4d40cfa070ab08a9e77"
      },
      "text": {
        "jp": "この都市は建て替えに増築と\r\n忙しくなく様相を変えおる。",
        "official_en": "This city constantly changes in shape and size, with all the renovations, demolitions, and construction going on.",
        "real_en": "This city is constantly changing as buildings are rebuilt and expanded."
      },
