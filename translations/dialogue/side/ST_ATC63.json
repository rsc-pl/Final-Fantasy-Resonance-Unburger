      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ATC63:ATC63_009:516826fa",
      "source": {
        "set": "set-02",
        "namespace": "ST_ATC63",
        "key": "ATC63_009",
        "jp_record_id": "switch:locres:set-02:ST_ATC63:ATC63_009:516826fa",
        "official_en_record_id": "switch:locres:set-02:ST_ATC63:ATC63_009:516826fa",
        "jp_sha256": "e92ea7c5c8a029c1e5c96e8ed32c1be7c8ecdeb87e2879c62e95dcb996a2f22e",
        "official_en_sha256": "9749c547acdc460303a697837eb9b9f7213aa0590f6b4274e18955d9835a4a03"
      },
      "text": {
        "jp": "お前たちなら\r\nあれを使うことができる。",
        "official_en": "I firmly believe that you two are capable of using visions—the power of human will—for good.",
        "real_en": "I believed you two could use that power."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
