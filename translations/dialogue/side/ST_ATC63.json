        "official_en_sha256": "4e0173077d55376b2d9553b08866f753cb44e621b0596e4d375e10ac521a2755"
      },
      "text": {
        "jp": "じゃ、なんで鍵を残していったんだ？",
        "official_en": "That doesn’t explain why you kept the key, though.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
