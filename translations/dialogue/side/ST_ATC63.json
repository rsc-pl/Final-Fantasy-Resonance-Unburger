        "official_en_sha256": "25d90bc0745ba523e598f0a7d468497c4edc4756049ea9f0e90a1983a41f4da5"
      },
      "text": {
        "jp": "それで地下室に隠したんですね。",
        "official_en": "And so that’s why you hid them behind the door...",
        "real_en": "So that's why you hid them in the basement."
      },
      "review": {
        "status": "CHANGE"
