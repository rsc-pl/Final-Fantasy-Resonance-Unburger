        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ATC63:ATC63_008:8ab12f88",
      "source": {
        "set": "set-02",
        "namespace": "ST_ATC63",
        "key": "ATC63_008",
        "jp_record_id": "switch:locres:set-02:ST_ATC63:ATC63_008:8ab12f88",
        "official_en_record_id": "switch:locres:set-02:ST_ATC63:ATC63_008:8ab12f88",
        "jp_sha256": "520872febe8f442616eda388e95b2a59c93e13f47282ad74276bd3d86903bf6b",
        "official_en_sha256": "d6972926e7804e8473fcb789d0f8c38f628fd9bfdbe847cd50b598aabc3e3853"
      },
      "text": {
        "jp": "過去への復讐ではなく\r\n未来への希望として。",
        "official_en": "I kept them so that they would serve as a symbol of hope for the future, and not a vessel for vengeance from a bygone era.",
        "real_en": "Not as vengeance for the past, but as hope for the future."
      },
