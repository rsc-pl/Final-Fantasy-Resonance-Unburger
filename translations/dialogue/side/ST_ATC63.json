    {
      "record_id": "switch:locres:set-02:ST_ATC63:ATC63_005:994e3fad",
      "source": {
        "set": "set-02",
        "namespace": "ST_ATC63",
        "key": "ATC63_005",
        "jp_record_id": "switch:locres:set-02:ST_ATC63:ATC63_005:994e3fad",
        "official_en_record_id": "switch:locres:set-02:ST_ATC63:ATC63_005:994e3fad",
        "jp_sha256": "57ea845bdc18fcfeacd488582fb23d6788cc17c1a26e0b2121ab05e5c75bb78b",
        "official_en_sha256": "ccee98f13cd773b10bd2f168b1033aa979f971368e8b180742f864f9adbe4079"
      },
      "text": {
        "jp": "だが、ソフィアと出会い、復讐を捨て\r\n俺にこの力は必要ないと思った。",
        "official_en": "However, after meeting Sophia and deciding to forgo revenge, I no longer needed them.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
