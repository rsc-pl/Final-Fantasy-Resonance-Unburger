    {
      "record_id": "switch:locres:set-02:ST_ATC63:ATC63_001:3f80635d",
      "source": {
        "set": "set-02",
        "namespace": "ST_ATC63",
        "key": "ATC63_001",
        "jp_record_id": "switch:locres:set-02:ST_ATC63:ATC63_001:3f80635d",
        "official_en_record_id": "switch:locres:set-02:ST_ATC63:ATC63_001:3f80635d",
        "jp_sha256": "40f1f3c444cac34bc65070460596130e9e0e0a33e847c7a7253146cbb46a22e2",
        "official_en_sha256": "25861e5febd45a2371b33876d0dac57d42167e172338f31f29367b6a14222857"
      },
      "text": {
        "jp": "レーゲンさん、家の地下にあった\r\nビジョンのことなんですが……。",
        "official_en": "Sir Raegen, about the vision crystals that were at our house...",
        "real_en": "Raegen-san, about the vision crystals we found beneath our house..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
