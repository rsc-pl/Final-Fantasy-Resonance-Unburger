          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ATC63:ATC63_007:46e92964",
      "source": {
        "set": "set-02",
        "namespace": "ST_ATC63",
        "key": "ATC63_007",
        "jp_record_id": "switch:locres:set-02:ST_ATC63:ATC63_007:46e92964",
        "official_en_record_id": "switch:locres:set-02:ST_ATC63:ATC63_007:46e92964",
