        "official_en_sha256": "bf99edbb26513391d9f085292a7ff9b2340960269e795ef256352cb02517e588"
      },
      "text": {
        "jp": "そう信じたから……。\r\n思いの力を託したんだ。",
        "official_en": "That is why.",
        "real_en": "That's why... I entrusted you with the power of human will."
      },
      "review": {
        "status": "CHANGE"
      },
