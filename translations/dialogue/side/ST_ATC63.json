          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ATC63:ATC63_004:a14caa93",
      "source": {
        "set": "set-02",
        "namespace": "ST_ATC63",
        "key": "ATC63_004",
        "jp_record_id": "switch:locres:set-02:ST_ATC63:ATC63_004:a14caa93",
        "official_en_record_id": "switch:locres:set-02:ST_ATC63:ATC63_004:a14caa93",
        "jp_sha256": "0f86df4dec2219b9ecb112e7b89c3e248820465b0511a9d186dc3410290f4a0d",
        "official_en_sha256": "09e37d63cb2e3d5db33d1ea7e2a806b5b787200b40c2dfcc97f63a3acffe40c6"
      },
      "text": {
        "jp": "俺は、あのビジョンの力を\r\n復讐に使うつもりでいた。",
        "official_en": "At the time, I intended to use the visions as a tool for exacting my vengeance.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
