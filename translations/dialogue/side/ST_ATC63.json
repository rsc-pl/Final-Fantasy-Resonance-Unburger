    {
      "record_id": "switch:locres:set-02:ST_ATC63:ATC63_010:3b76b80f",
      "source": {
        "set": "set-02",
        "namespace": "ST_ATC63",
        "key": "ATC63_010",
        "jp_record_id": "switch:locres:set-02:ST_ATC63:ATC63_010:3b76b80f",
        "official_en_record_id": "switch:locres:set-02:ST_ATC63:ATC63_010:3b76b80f",
