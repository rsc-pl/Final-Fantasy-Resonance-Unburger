    {
      "record_id": "switch:locres:set-02:ST_ATC63:ATC63_006:7fac0afb",
      "source": {
        "set": "set-02",
        "namespace": "ST_ATC63",
        "key": "ATC63_006",
        "jp_record_id": "switch:locres:set-02:ST_ATC63:ATC63_006:7fac0afb",
        "official_en_record_id": "switch:locres:set-02:ST_ATC63:ATC63_006:7fac0afb",
