    {
      "record_id": "switch:locres:set-02:ST_SubEv_Dng08Gro43_Theme:SubEv_Dng08Gro43_Theme_010:4040e6c2",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_Dng08Gro43_Theme",
        "key": "SubEv_Dng08Gro43_Theme_010",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_Dng08Gro43_Theme:SubEv_Dng08Gro43_Theme_010:4040e6c2",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_Dng08Gro43_Theme:SubEv_Dng08Gro43_Theme_010:4040e6c2",
        "jp_sha256": "977aab1f9c19562786aad462e1f546022af6864c47c5757cd87f8e92c9eba84f",
        "official_en_sha256": "fb5daf5280256230dbcd5a0aa73b985d70df3ffe877018d89a91f01670a1c72c"
      },
      "text": {
        "jp": "怒りと鎮静は交互に訪れる。感情を見極めよ",
        "official_en": "Serene in one turn, but in another its fury does burn. Its mercurial emotion you shall discern.",
        "real_en": "Fury and calm come in turns. Watch its moods carefully."
      },
      "review": {
        "status": "CHANGE"
