        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_Dng08Gro43_Theme:SubEv_Dng08Gro43_Theme_001:e15dc105",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_Dng08Gro43_Theme",
        "key": "SubEv_Dng08Gro43_Theme_001",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_Dng08Gro43_Theme:SubEv_Dng08Gro43_Theme_001:e15dc105",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_Dng08Gro43_Theme:SubEv_Dng08Gro43_Theme_001:e15dc105",
        "jp_sha256": "60d7c4e42536e8aa9fd4ca6a6325b0e38fa3b815a7606da442d53542c3493b99",
        "official_en_sha256": "8b6f02a13055bcfec14acaa58747220132d5f8c224f28b8547177bc4ae97a438"
      },
      "text": {
        "jp": "変幻自在な敵と渡り合い、弱みを貫け",
        "official_en": "An ever-shifting foe blocks your path; strike its weakness, and unleash your wrath.",
        "real_en": "Face the ever-changing foe and strike at its weakness."
      },
      "review": {
