        "official_en_record_id": "switch:locres:set-02:ST_SubEv_Dng08Gro43_Theme:SubEv_Dng08Gro43_Theme_020:ebc297f2",
        "jp_sha256": "e8b24d03e38ff3b3021dc99c688503b2e04b3c44c6cd9d9bb8a2bdd1c8c7d126",
        "official_en_sha256": "b2aef323e9876a98f573db319cdc9418dcb312a92649715ff65886aaf4348d7a"
      },
      "text": {
        "jp": "その者たちは一人残れば永遠の命を持つ",
        "official_en": "If even one endures the strife, know that they shall have eternal life.",
        "real_en": "If even one of them survives, they will have eternal life."
      },
      "review": {
