    {
      "record_id": "switch:locres:set-02:ST_SubEv_Dng08Gro43_Theme:SubEv_Dng08Gro43_Theme_025:a68e00eb",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_Dng08Gro43_Theme",
        "key": "SubEv_Dng08Gro43_Theme_025",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_Dng08Gro43_Theme:SubEv_Dng08Gro43_Theme_025:a68e00eb",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_Dng08Gro43_Theme:SubEv_Dng08Gro43_Theme_025:a68e00eb",
        "jp_sha256": "ac47f0a230f36a0f067ef6086958db45b885d3eede65829a9e3025bf024c3e94",
        "official_en_sha256": "2c2ff6391169a2878c8f7b283e364873d43924320a91da78648dae4674d31751"
      },
      "text": {
        "jp": "大いなる息吹に備え、限られた時間の中で戦いを組み立てよ",
        "official_en": "Impending is a breath most immense—use your time wisely, and prepare your defense.",
        "real_en": "Prepare for the mighty breath and plan your fight within the time you have."
      },
      "review": {
