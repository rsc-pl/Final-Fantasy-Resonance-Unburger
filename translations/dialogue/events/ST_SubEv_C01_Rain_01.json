        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_01",
        "key": "SubEv_C01_Rain_01_015",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_015:17c59381",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_015:17c59381",
