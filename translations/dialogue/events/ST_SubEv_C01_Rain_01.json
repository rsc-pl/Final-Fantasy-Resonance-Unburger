    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_007:4b599dca",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_01",
        "key": "SubEv_C01_Rain_01_007",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_007:4b599dca",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_007:4b599dca",
        "jp_sha256": "c5968a5ab8c23e2da08c89e1c6195b0bc664687df4b4d4dfb56d16dbf90ef4e4",
        "official_en_sha256": "9819c60d204ea5400529261914b4e9aa67730ba5eacfc2d87c316557995e72bc"
      },
      "text": {
        "jp": "みんなが不安に思うのもわかる。\r\n心配をかけてすまない。",
        "official_en": "I understand your concern. I know that the loss of our airships is causing a lot of worry, and for that, I’m sorry.",
        "real_en": "I understand why everyone's worried. I'm sorry for causing you so much concern."
      },
