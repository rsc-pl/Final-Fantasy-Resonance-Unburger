        "official_en_sha256": "266f92c3212fc41a5d5a692da1f13ddcab332f6a5808442cdb4722712f2b7872"
      },
      "text": {
        "jp": "レイン隊長、実は……。",
        "official_en": "Commander Rain. You better listen for yourself...",
        "real_en": "Commander Rain, actually..."
      },
      "review": {
