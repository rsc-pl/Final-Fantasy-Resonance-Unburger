    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_003:b21a8b89",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_01",
        "key": "SubEv_C01_Rain_01_003",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_003:b21a8b89",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_003:b21a8b89",
        "jp_sha256": "ee0cedf2d3e83fcdd1e14b7ec26a683fbde60e244408a1b3f5616266f1ad613f",
        "official_en_sha256": "2ee8cc989838eb21c6025b77028402e6d5e2356ffe8ab9747e79af99efb24916"
      },
      "text": {
        "jp": "レインさん、飛空艇の話は聞きました……。\r\nなんでも、ほとんど壊されてしまったとか……。",
        "official_en": "Sir Rain, I heard about the airships... They’re saying most of them were ruined?",
        "real_en": "Rain-san, I heard about the airships... They say nearly all of them were destroyed..."
      },
      "review": {
