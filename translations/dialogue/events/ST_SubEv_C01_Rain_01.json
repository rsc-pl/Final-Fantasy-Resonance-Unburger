    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_011:a3625938",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_01",
        "key": "SubEv_C01_Rain_01_011",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_011:a3625938",
