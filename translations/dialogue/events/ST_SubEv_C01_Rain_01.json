    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_010:f471bec7",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_01",
        "key": "SubEv_C01_Rain_01_010",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_010:f471bec7",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_01:SubEv_C01_Rain_01_010:f471bec7",
        "jp_sha256": "f55bf21cac9ba55623bbe1d09512988871b53fb033d05ef21e8163cfd58cf8eb",
        "official_en_sha256": "177e3b8bed17267cfac6fa139d093bba03f8935c5018bfc8e271e39cd91a87f1"
      },
      "text": {
        "jp": "俺にとっても飛空艇部隊は大事なものだ。\r\nこのままにしておくわけにはいかない。",
        "official_en": "The airship squadron means just as much to me as it does to anyone else. I won’t just leave it a smoking pile of scrap.",
        "real_en": "The airship squadron means a lot to me, too. I can't leave things like this."
      },
      "review": {
        "status": "CHANGE"
      },
