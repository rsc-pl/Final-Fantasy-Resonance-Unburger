        "official_en_sha256": "6be83c1e45e749bc8b63afb96f39b1c16676454bba0f3be0a726b27d547d9d66"
      },
      "text": {
        "jp": "今、各所で起きていている問題は、\r\nお前たちに対応を任せてもいいか？",
        "official_en": "You mind if I leave the other incidents in the area to you soldiers for the time being?",
        "real_en": "Can I leave the problems cropping up elsewhere to you?"
      },
      "review": {
        "status": "CHANGE"
      },
