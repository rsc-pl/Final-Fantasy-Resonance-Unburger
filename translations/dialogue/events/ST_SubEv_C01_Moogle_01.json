    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_004:ab041050",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_01",
        "key": "SubEv_C01_Moogle_01_004",
