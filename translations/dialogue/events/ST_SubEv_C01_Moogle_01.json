    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_012:cfc886fe",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_01",
        "key": "SubEv_C01_Moogle_01_012",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_012:cfc886fe",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_012:cfc886fe",
        "jp_sha256": "5fe2f71600f120adc87aed9ac73d9397bf2f26ec95866c88a702fac6668443d7",
        "official_en_sha256": "6eb16751a906808e14cff7f6d0b3159ff78d498e72788e744e20b6b710c732ac"
      },
      "text": {
        "jp": "かわりに、キミタチのビジョンを強化してやるクポ。\r\nビジョンを強化したかったら\r\nボクのところに魔石を持ってきてほしいクポ。",
        "official_en": "<text style=\"italic\">Buuut</>, I can help by enhancing your visions, kupo. Bring me magicites if you want me to work my magic, kupo.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
