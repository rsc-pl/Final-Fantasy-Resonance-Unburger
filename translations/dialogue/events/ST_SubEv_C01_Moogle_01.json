    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_001:837bf48d",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_01",
        "key": "SubEv_C01_Moogle_01_001",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_001:837bf48d",
