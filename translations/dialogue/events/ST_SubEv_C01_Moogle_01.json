        "official_en_sha256": "217e190072545b65a183c7f00c1d325b81c2bfb62ccd7d4f2c67ed8e55a0fad0"
      },
      "text": {
        "jp": "お前みたいなモーグリは\r\n出会ったことも置いていったこともないが……？",
        "official_en": "I don’t believe we’ve ever met, let alone “ditched,” a moogle like you before...",
        "real_en": null
      },
