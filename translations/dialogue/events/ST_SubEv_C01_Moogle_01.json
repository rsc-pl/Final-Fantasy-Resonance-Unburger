        "official_en_sha256": "b239dcbaab501cb76cd01e07edd25d344cf86fce2582e4ea0ac54b7235f51519"
      },
      "text": {
        "jp": "な、なんだお前は！",
        "official_en": "Wh-whoa, what the heck!?",
        "real_en": null
      },
      "review": {
