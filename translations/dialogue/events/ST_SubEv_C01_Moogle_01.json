    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_016:39efcc92",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_01",
        "key": "SubEv_C01_Moogle_01_016",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_016:39efcc92",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_016:39efcc92",
        "jp_sha256": "a64b2919ac958b64436d14e97fc80bf8cf1578df2e999dc556f541f73d3b77f8",
        "official_en_sha256": "6a63e1b04c8ec280a3e6564b74c80c64f3e2c413fef381d4d7a306f00cd8c643"
      },
      "text": {
        "jp": "ボクが頼りになるからって、甘えないでほしいクポ。\r\n魔石はこの世界のいろんなところに\r\n散らばっているんだクポ。",
        "official_en": "Whoa there, I know I’m reliable, but don’t go expecting me to hold your hand for every little thing, kupo. You can find them scattered all over this world, kupo.",
        "real_en": "Just because you can count on me doesn't mean you should depend on me for everything, kupo. Magicite is scattered all over this world, kupo."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Moogle_01",
        "sequence": null,
        "speaker": {
