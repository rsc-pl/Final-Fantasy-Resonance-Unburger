    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_011:f30aa5f6",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_01",
        "key": "SubEv_C01_Moogle_01_011",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_011:f30aa5f6",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_011:f30aa5f6",
        "jp_sha256": "b1bf0d72d26617ae6f1b79bf75486759139eaa602f3cfe4509a18225ad98e763",
        "official_en_sha256": "d8f05fe76099b14b04986c4bed57124d7c084af898a3f191d3d2cbafcbe54b46"
      },
      "text": {
        "jp": "ふふん喜べクポ！\r\n……と言いたいところだけど\r\n最近おなかが痛いので戦うのは勘弁クポ……。",
        "official_en": "Oh, you betcha, kupo!\r\n...Would be what I’d be saying if I didn’t have this chronic tummy ache...so no fighting for me, unfortunately, kupo.",
        "real_en": "Heh, rejoice, kupo! ...Is what I'd like to say, but I've had a stomachache lately, so spare me the fighting, kupo..."
      },
      "review": {
        "status": "CHANGE"
