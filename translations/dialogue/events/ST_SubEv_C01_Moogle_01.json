    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_003:3cb7a9a9",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_01",
        "key": "SubEv_C01_Moogle_01_003",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_003:3cb7a9a9",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_003:3cb7a9a9",
        "jp_sha256": "0b111f0d75efb3c8c87082b1581a1089ac0eda20ca7173551796c2c411843130",
        "official_en_sha256": "0027d1f58ffeaa24bb129105f79b154178bea8c89e27a764d51823280fc22f5f"
      },
      "text": {
        "jp": "なんだじゃないクポ！\r\nボクを置いていくなんてひどいクポ！",
        "official_en": "I could say the same thing to you, kupo! Why’d you go and ditch me like that, kupo!?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
