    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_014:c282b577",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_01",
        "key": "SubEv_C01_Moogle_01_014",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_014:c282b577",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_01:SubEv_C01_Moogle_01_014:c282b577",
