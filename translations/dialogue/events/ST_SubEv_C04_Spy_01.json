      },
      "text": {
        "jp": "ジェイクさん……。\r\nずっと気になっていることがあって……。",
        "official_en": "Oh, Jake... Actually, there’s something that’s been bothering me for a while...",
        "real_en": "Jake-san... There's something that's been bothering me for a while..."
      },
      "review": {
        "status": "CHANGE"
