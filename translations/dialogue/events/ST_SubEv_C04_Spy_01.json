      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C04_Spy_01",
        "key": "SubEv_C04_Spy_01_006",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_01:SubEv_C04_Spy_01_006:e23dc146",
