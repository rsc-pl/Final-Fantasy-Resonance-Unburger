    {
      "record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_01:SubEv_C04_Spy_01_005:55f692ef",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C04_Spy_01",
        "key": "SubEv_C04_Spy_01_005",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_01:SubEv_C04_Spy_01_005:55f692ef",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_01:SubEv_C04_Spy_01_005:55f692ef",
