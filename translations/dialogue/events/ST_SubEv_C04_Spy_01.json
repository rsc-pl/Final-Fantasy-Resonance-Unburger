        "official_en_sha256": "1ed1a31bbce81ca7013d617cb68f9c2761cf7d298c5afe9710867d7a9aae8609"
      },
      "text": {
        "jp": "今更かもしれませんが、俺は真相が知りたいんです。",
        "official_en": "It’s been a while since he disappeared, but I need to know the truth.",
        "real_en": "Maybe it's too late now, but I want to know the truth."
      },
      "review": {
        "status": "CHANGE"
