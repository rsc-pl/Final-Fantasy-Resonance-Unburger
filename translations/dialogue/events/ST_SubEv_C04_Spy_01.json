    {
      "record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_01:SubEv_C04_Spy_01_008:10158092",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C04_Spy_01",
        "key": "SubEv_C04_Spy_01_008",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_01:SubEv_C04_Spy_01_008:10158092",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_01:SubEv_C04_Spy_01_008:10158092",
