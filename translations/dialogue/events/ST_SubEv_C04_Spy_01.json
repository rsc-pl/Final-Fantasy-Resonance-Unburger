    {
      "record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_01:SubEv_C04_Spy_01_002:20745fc5",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C04_Spy_01",
        "key": "SubEv_C04_Spy_01_002",
