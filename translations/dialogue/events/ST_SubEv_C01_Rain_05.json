    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_025:71f3344e",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_05",
        "key": "SubEv_C01_Rain_05_025",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_025:71f3344e",
