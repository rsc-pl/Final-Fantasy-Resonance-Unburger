        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_014:45218e02",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_05",
        "key": "SubEv_C01_Rain_05_014",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_014:45218e02",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_014:45218e02",
        "jp_sha256": "b785f73a3bea0e197c578c78f3e5410d5e6e7a904fc62039760be9f536cf0e00",
        "official_en_sha256": "ec7f347ef550aa31a95339f94f3e89c68203f381262feb3100bf85c966bf2cfe"
      },
      "text": {
        "jp": "俺は今、特別な任務についているが……\r\nやはり、飛空艇部隊は必要だ。\r\nだから、飛空艇再建の指揮をスコットに頼みたいんだ。",
        "official_en": "I’m on an equally important mission right now...but Grandshelt needs the airship squadron. Which is why I want to leave you in charge of rebuilding it.",
        "real_en": "I'm on a special mission right now, but we still need the airship squadron. So I'd like you to lead the rebuilding effort, Scott."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Rain_05",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "レイン",
