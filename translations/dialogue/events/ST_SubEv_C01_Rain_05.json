      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_012:567cc149",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_05",
        "key": "SubEv_C01_Rain_05_012",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_012:567cc149",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_012:567cc149",
        "jp_sha256": "a02330c9914a52b69c96dfdd07485719647cc78227ce968476a7b75d5f50720c",
        "official_en_sha256": "d14a4b82b9f684195a988444bb9dcbfa72653502fd670f8b8bfd7ee44fdc7f46"
      },
      "text": {
        "jp": "寛解の雫を使っても視力が元に戻るわけじゃない。\r\n飛空艇技師として前みたいに働くのは、\r\n難しいかもしれない……。",
        "official_en": "The Dew of Reprieve won’t reverse the damage that’s already been done to your eyes. In fact, you probably won’t be able to work at the capacity that you used to.",
        "real_en": "The Dew of Remission won't restore your eyesight. You might not be able to work as an airship engineer the way you used to..."
      },
