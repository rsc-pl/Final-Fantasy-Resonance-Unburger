    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_010:c612340d",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_05",
        "key": "SubEv_C01_Rain_05_010",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_010:c612340d",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_010:c612340d",
        "jp_sha256": "b62ca6007f9717349de6d597010532e4c11535ee93414d4567e8112a68f96c5b",
        "official_en_sha256": "675ddb6299593f75241f20a0502c765c465352d9437fd77914685dca348306a2"
      },
      "text": {
        "jp": "一人のことでも放っておかない。\r\nそれがみんなを救うことになるからな。",
        "official_en": "I told you: I don’t choose between helping one person or one hundred. Besides, helping you will lead to saving others.",
        "real_en": "I won't abandon even one person. Helping one person can lead to saving everyone."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Rain_05",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "レイン",
          "label_status": "VERIFIED",
