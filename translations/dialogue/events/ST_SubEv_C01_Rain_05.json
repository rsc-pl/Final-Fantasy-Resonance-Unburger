    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_004:8b3c81ad",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_05",
        "key": "SubEv_C01_Rain_05_004",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_004:8b3c81ad",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_004:8b3c81ad",
        "jp_sha256": "c1b94012a78296880e8c3a1d30b6dc34e0ab8a2f3078bb8afeb6562df12de882",
        "official_en_sha256": "b0838ae0de41e9b1e6b917ea7dec5738db3ae7e76280ca18caf993f76e082a03"
      },
      "text": {
        "jp": "寛解の雫っていうんだ。\r\n病状の進行を抑える効能があるらしい。",
        "official_en": "It’s Dew of Reprieve. It can stop the progress of certain illnesses.",
        "real_en": "It's called Dew of Remission. Apparently, it can slow the progression of illnesses."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Rain_05",
