    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_001:f3bf5081",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_05",
        "key": "SubEv_C01_Rain_05_001",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_001:f3bf5081",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_001:f3bf5081",
        "jp_sha256": "6959022e91abfa66edaac38faa7ba9017d83f82e36b2148e8efcec53e45187a5",
        "official_en_sha256": "15c94e2c97435817857afa61da14488af7b16defdddb25e345ef80aea027aafb"
      },
      "text": {
        "jp": "レイン……。\r\n言ったはずだぞ。\r\nもうこないでくれと……。",
        "official_en": "Rain... I thought I told you to leave me alone...",
        "real_en": null
      },
      "review": {
