        "official_en_sha256": "025bf0c6def25baa1bc7d4803c9780886a9fc133fbd72cdaa2a216ee26441bd1"
      },
      "text": {
        "jp": "きれいごとも成し遂げたら現実……。\r\nそういうことか……。",
        "official_en": "You’re not an idealist if you can make it happen...\r\nI get it now.",
        "real_en": "Even a nice-sounding ideal becomes reality if you make it happen... Is that what you mean...?"
      },
      "review": {
