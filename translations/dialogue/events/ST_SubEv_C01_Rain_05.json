          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Rain_05/SubEv_C01_Rain_05_010"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_011:fbd5e1a2",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_05",
        "key": "SubEv_C01_Rain_05_011",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_011:fbd5e1a2",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_011:fbd5e1a2",
        "jp_sha256": "54c2181a03cda3e7d88fce9c1957f504078f934926345d0fe151e3e22e88336a",
        "official_en_sha256": "218e7b34378afe62bd98a1ebb345d218b49c49546666ac7567743857c8a6aec3"
      },
      "text": {
        "jp": "俺が飛空艇部隊に戻れば、\r\nみんなを救うことができると言いたいのか？",
        "official_en": "You really believe me working on airships again will save folks?",
        "real_en": "You mean if I return to the squadron, I could save everyone?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Rain_05",
