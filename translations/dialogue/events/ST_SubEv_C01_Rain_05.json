    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_027:b1972f3f",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_05",
