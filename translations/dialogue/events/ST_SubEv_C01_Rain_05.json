          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Rain_05/SubEv_C01_Rain_05_014"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_019:b479745e",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_05",
        "key": "SubEv_C01_Rain_05_019",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_019:b479745e",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_019:b479745e",
        "jp_sha256": "9b0a7fdf0da2793def8af2b4d30ea6513da664e3939d0511ffec71813bb0a2e6",
        "official_en_sha256": "ba552b4e96b8af8001e915596e10f07fbbbae3e4cec962682bfe8eff81a1bad0"
      },
      "text": {
        "jp": "兵士たちが納得して、俺も満足する……。\r\nそんな簡単にいくわけがない。\r\n必ずどこかで問題が起きる。",
        "official_en": "So everything will be dandy, and the soldiers and I will work together happily ever after...? I still don’t think it’ll work, not as it stands.",
        "real_en": "The soldiers would be satisfied, and so would I...? It can't be that simple. Something is bound to go wrong."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Rain_05",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "スコット",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0177",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Rain_05/SubEv_C01_Rain_05_019"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_018:ca4f3deb",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_05",
        "key": "SubEv_C01_Rain_05_018",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_018:ca4f3deb",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_05:SubEv_C01_Rain_05_018:ca4f3deb",
        "jp_sha256": "7ff486654dc035f636b628af833d9c1eafbb7f0dc79194c1f3a9d088c2c0c985",
        "official_en_sha256": "c6f3f156d8f06876ab3d05a91dbadf9ceafdc66e6272e76048813c71bd1521f6"
      },
      "text": {
        "jp": "兵士たちはきっとスコットを必要とする。\r\nスコットだってやりがいを見つけられるはずだ。",
        "official_en": "The soldiers will need you, Scott. I’m sure you can find your place again.",
        "real_en": "The soldiers will need you, Scott. I'm sure you'll find a sense of purpose in the work, too."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
