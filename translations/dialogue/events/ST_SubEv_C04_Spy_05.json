    {
      "record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_05:SubEv_C04_Spy_05_014:69664e02",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C04_Spy_05",
        "key": "SubEv_C04_Spy_05_014",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_05:SubEv_C04_Spy_05_014:69664e02",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_05:SubEv_C04_Spy_05_014:69664e02",
        "jp_sha256": "6ba5f4bf6668563bf503e63ac9625e963e22b108b8c614c287ac2919601c22ae",
        "official_en_sha256": "05cabb5c3c15002402983b433a684f2af831df9ca5cb8d351086963eed992e90"
      },
      "text": {
        "jp": "反乱軍の危機は去った。\r\n俺は帝国兵の追手を引き付け、ゾルダードの街を出る。",
        "official_en": "<text style=\"italic\">They’re on to us, but not to worry, for I have a plan. I’m going to lure the imperial soldiers outside of the capital.</>",
        "real_en": "The threat to the rebels is over. I'll draw the imperial soldiers pursuing us away from the city of Zoldaad."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C04_Spy_05",
