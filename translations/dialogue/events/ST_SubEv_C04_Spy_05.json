    {
      "record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_05:SubEv_C04_Spy_05_026:6c84cd5a",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C04_Spy_05",
        "key": "SubEv_C04_Spy_05_026",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_05:SubEv_C04_Spy_05_026:6c84cd5a",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_05:SubEv_C04_Spy_05_026:6c84cd5a",
        "jp_sha256": "8ee612bc5d730861a3f0325d86f18657f3057a1a4efa2c9350060b695354f502",
        "official_en_sha256": "7e2d2d1ff909e6394b0e4fdb813263a177f6fce9995c648840b9582b2c31246a"
      },
      "text": {
        "jp": "俺とダリオの思い出の紅薔薇のサークレットです。\r\n役立ててください。",
        "official_en": "It’s called a Rose Circlet. It’s a little memento that Dario and I shared.",
        "real_en": "This is the Red Rose Circlet, a memento of my friendship with Dario. I hope you can put it to good use."
      },
