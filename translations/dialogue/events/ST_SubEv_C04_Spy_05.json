    {
      "record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_05:SubEv_C04_Spy_05_010:af356b13",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C04_Spy_05",
        "key": "SubEv_C04_Spy_05_010",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_05:SubEv_C04_Spy_05_010:af356b13",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C04_Spy_05:SubEv_C04_Spy_05_010:af356b13",
