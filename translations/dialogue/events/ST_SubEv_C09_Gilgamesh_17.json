        "namespace": "ST_SubEv_C09_Gilgamesh_17",
        "key": "SubEv_C09_Gilgamesh_17_003",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_17:SubEv_C09_Gilgamesh_17_003:0fad51ec",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_17:SubEv_C09_Gilgamesh_17_003:0fad51ec",
