        "key": "SubEv_C09_Gilgamesh_17_005",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_17:SubEv_C09_Gilgamesh_17_005:f4b42d1b",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_17:SubEv_C09_Gilgamesh_17_005:f4b42d1b",
