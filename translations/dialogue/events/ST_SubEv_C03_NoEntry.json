        "jp_sha256": "91f921f8da670af56745ea3171793f9743d4f77bb462250c5a0269bc427293b5",
        "official_en_sha256": "009e3fee845963b5caf866ca484926e087a8b930814304334d345ca1efe899ed"
      },
      "text": {
        "jp": "ここから先は、旧い市街地になります。\r\n現在水の淀みが確認されており、調査中です。",
        "official_en": "Old Town is just ahead, but it’s under inspection for flooding at the moment.",
        "real_en": "Beyond here is the old town. We've found stagnant water there and are investigating."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
