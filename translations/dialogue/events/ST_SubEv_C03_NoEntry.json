        "jp_sha256": "f136eac25d66b77f736142e5ded722844f4004e33eaec7d73863592e7fbf4e9f",
        "official_en_sha256": "6b2061be799a520a00202d869e4ac5fc3f4320951a14e45a37042f3b3eaf1b42"
      },
      "text": {
        "jp": "おっきな滝ねぇ……。\r\n神聖な場所かもしれないし\r\n勝手に入るのはやめておきましょ。",
        "official_en": "Those are some big waterfalls... Seems like the sort of sacred place we shouldn’t just go barging into, eh?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
