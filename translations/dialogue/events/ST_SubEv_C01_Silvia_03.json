        "official_en_sha256": "84d34eedf7df72d86408035ea77c9f66c12d479eec0cf7fddbf6e26fbf1b728e"
      },
      "text": {
        "jp": "だが、なぜ俺にそこまでしてくれるんだ？",
        "official_en": "However, I can’t help but wonder—why are you trying so hard to help me?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
