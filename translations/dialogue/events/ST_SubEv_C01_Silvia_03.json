    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Silvia_03:SubEv_C01_Silvia_03_021:da3bf56c",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Silvia_03",
        "key": "SubEv_C01_Silvia_03_021",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Silvia_03:SubEv_C01_Silvia_03_021:da3bf56c",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Silvia_03:SubEv_C01_Silvia_03_021:da3bf56c",
        "jp_sha256": "f9b50715ddadb0d13cd100206033d5ecfd42083b05c22759e882d8d72e35956d",
        "official_en_sha256": "3ec348db005c2ea8990fd0fbe92e3847c008c7f735dc95d251790a3738943110"
      },
      "text": {
        "jp": "ただ、偶然出会った生き残りの一人が\r\n私を後継者に選んだ。",
        "official_en": "Fate must’ve taken pity on me, since I was able to find one survivor, and was chosen to carry on their legacy.",
        "real_en": "But then I happened to meet one of the survivors, who chose me as their successor."
      },
      "review": {
        "status": "CHANGE"
      },
