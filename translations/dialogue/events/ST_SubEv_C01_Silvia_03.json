    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Silvia_03:SubEv_C01_Silvia_03_003:d91d351d",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Silvia_03",
        "key": "SubEv_C01_Silvia_03_003",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Silvia_03:SubEv_C01_Silvia_03_003:d91d351d",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Silvia_03:SubEv_C01_Silvia_03_003:d91d351d",
        "jp_sha256": "0030be78721aaefdb73ba508fc81935a36e16eadd387fd19db94d2d277cbc053",
        "official_en_sha256": "2b8b0e90ac5c21837aacc684c18d0d613d2da4f65bf432df759f08c749fc25c7"
      },
      "text": {
        "jp": "後輩クン、久し振り。\r\n魔法剣は使ってる？",
        "official_en": "It’s been a while since our last encounter, my apprentice. Have you been using spellblades?",
        "real_en": "Kouhai-kun, long time no see.\r\nHave you been using your spellblade techniques?"
      },
      "review": {
