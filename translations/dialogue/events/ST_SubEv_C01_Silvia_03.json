    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Silvia_03:SubEv_C01_Silvia_03_014:4ee41fd6",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Silvia_03",
        "key": "SubEv_C01_Silvia_03_014",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Silvia_03:SubEv_C01_Silvia_03_014:4ee41fd6",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Silvia_03:SubEv_C01_Silvia_03_014:4ee41fd6",
