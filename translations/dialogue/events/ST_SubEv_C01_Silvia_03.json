        "official_en_sha256": "85c3f6a8195b718d5cbaa998adcc67aacd746311b3310cb708e17f439625ec05"
      },
      "text": {
        "jp": "でも、そう言われると余計に使いたくならない？",
        "official_en": "But who are <text style=\"italic\">they</> to say it’s impossible?",
        "real_en": "But doesn't being told you can't do something just make you want to try even more?"
      },
      "review": {
        "status": "CHANGE"
