        "official_en_sha256": "f4417bcc77e1a980ef0b40e50503a277cda545b2929591ba85a8b68b7795475a"
      },
      "text": {
        "jp": "何がそれなりよ。\r\nすごく使い込んでるじゃない。",
        "official_en": "Seems you were being modest—you’ve been using them quite a lot.",
        "real_en": null
      },
