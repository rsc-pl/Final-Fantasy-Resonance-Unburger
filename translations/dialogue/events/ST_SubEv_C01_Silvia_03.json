        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Silvia_03:SubEv_C01_Silvia_03_010:cb634e7d",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Silvia_03:SubEv_C01_Silvia_03_010:cb634e7d",
        "jp_sha256": "b11f289a04c1ef26b5621e95d0f959b64ee8f1b193b2a384d2563dfd49efee3b",
        "official_en_sha256": "6e196d5c52d63e7ef0f0e9a64e2a1f3fea813ade620ef3f60ccd7b55dcf83f98"
      },
      "text": {
        "jp": "俺はただ誰よりも強くなりたいだけだ。",
        "official_en": "All I wish is to become a greater fighter than anyone.",
        "real_en": "I just want to be stronger than anyone else."
      },
