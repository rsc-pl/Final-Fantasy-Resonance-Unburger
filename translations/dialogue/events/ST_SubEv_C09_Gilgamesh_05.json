    {
      "record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_006:0ad4064c",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C09_Gilgamesh_05",
        "key": "SubEv_C09_Gilgamesh_05_006",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_006:0ad4064c",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_006:0ad4064c",
        "jp_sha256": "ca132cc65ad70727654036eaaea356fa67826c5823d6782fa71ebf0a01bf3e7e",
        "official_en_sha256": "ddb70b9a748be13101cb54b7c48078c1c9925cf2097f0ca96ef9897110b613f3"
      },
      "text": {
        "jp": "オレと勝負したくても、ここではやめておきな。\r\n車内で騒ぎを起こせば、やっかいなことになるぜ。",
        "official_en": "What are you, tourists? Don’t even think to fight me here—have some common courtesy for crying out loud.",
        "real_en": "Even if you want to fight me, don't do it here. Making a scene on a train will only get you into trouble."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
