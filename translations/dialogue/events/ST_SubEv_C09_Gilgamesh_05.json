      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_005:bc98c290",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C09_Gilgamesh_05",
        "key": "SubEv_C09_Gilgamesh_05_005",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_005:bc98c290",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_005:bc98c290",
        "jp_sha256": "8ba83c0443bc70b87835efa78bec3a2c97564b35e550b1d46b18761291e74b86",
        "official_en_sha256": "8a9fd13fc01f6a61728171e89c9d67271c549c13218baa8f5c3913cf50d08caa"
      },
      "text": {
        "jp": "たまには線路を飛び出して、ドーンと自由に\r\n突っ走ってほしいんだが、ダメなのか？",
        "official_en": "Can’t you take them off the rails and have them run as free as your adventuring spirit?",
        "real_en": "Can't they just jump the tracks once in a while and charge off wherever they like?"
      },
      "review": {
        "status": "CHANGE"
      },
