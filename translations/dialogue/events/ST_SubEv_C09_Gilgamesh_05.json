      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_003:ae4d584a",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C09_Gilgamesh_05",
        "key": "SubEv_C09_Gilgamesh_05_003",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_003:ae4d584a",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_003:ae4d584a",
        "jp_sha256": "31e95abe78900063e5dd2771843e943ea32d76513258322fee9f994f6498cc86",
        "official_en_sha256": "d4810fa81733d6c5b07de4f95762e367db6468a9d4909b6ab151b0b31057577a"
      },
      "text": {
        "jp": "でも、ちょっと残念なことがあってな……。",
        "official_en": "Although there is one gripe I do have about them...",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
