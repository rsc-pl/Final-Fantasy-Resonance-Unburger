    {
      "record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_004:82148854",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C09_Gilgamesh_05",
        "key": "SubEv_C09_Gilgamesh_05_004",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_004:82148854",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_05:SubEv_C09_Gilgamesh_05_004:82148854",
        "jp_sha256": "ef48f1f50ff26f1db0efc9d80136d4a4734f4bc895e34c3c533eab25cf63a281",
        "official_en_sha256": "636ae0ddfb3283740de32fd52a08560a897c6ef3dbb8bf5b90784931a8331d19"
      },
      "text": {
        "jp": "もう何回も乗っているのに、いつも同じコースを\r\n行ったり来たりのくりかえしで、飽きてきたぜ。",
        "official_en": "No matter how many times you ride them, they never tread a new path—just back and forth, over and over and over. It’s nauseating!",
        "real_en": "I've ridden them so many times, but they keep going back and forth on the same route. I'm getting bored!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C09_Gilgamesh_05",
