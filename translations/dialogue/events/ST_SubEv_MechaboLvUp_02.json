        "namespace": "ST_SubEv_MechaboLvUp_02",
        "key": "SubEv_MechaboLvUp_02_006",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_MechaboLvUp_02:SubEv_MechaboLvUp_02_006:cd7d2783",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_MechaboLvUp_02:SubEv_MechaboLvUp_02_006:cd7d2783",
