        "key": "SubEv_MechaboLvUp_02_016",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_MechaboLvUp_02:SubEv_MechaboLvUp_02_016:3e41382f",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_MechaboLvUp_02:SubEv_MechaboLvUp_02_016:3e41382f",
