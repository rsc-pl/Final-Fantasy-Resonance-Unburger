    {
      "record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_021:ea076146",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C06_NoEntry",
        "key": "SubEv_C06_NoEntry_021",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_021:ea076146",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_021:ea076146",
