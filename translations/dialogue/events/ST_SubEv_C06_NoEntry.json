        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_020:ee2464e9",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C06_NoEntry",
        "key": "SubEv_C06_NoEntry_020",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_020:ee2464e9",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_020:ee2464e9",
        "jp_sha256": "d8fd72444ca1a7c35464eb4c42a1188245daa0662855eb75c0cb63990d4a914b",
        "official_en_sha256": "67e8f11b21443d94d884ab4275c79acc6453dfa3ca005a25df1096add549a50d"
      },
      "text": {
        "jp": "ここは……閉ざされた大地だ。\r\n中に入るのはかなり危険と\r\n飛空艇乗りの間でウワサされていたな。",
        "official_en": "This is...the Shuttered Land. Airship pilots all say it’s suicide to even approach.",
        "real_en": "This is... the Shuttered Land. Airship pilots say it's extremely dangerous to go inside."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C06_NoEntry",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "エヴァン",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0061",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C06_NoEntry/SubEv_C06_NoEntry_020"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_005:96ca9586",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C06_NoEntry",
        "key": "SubEv_C06_NoEntry_005",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_005:96ca9586",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_005:96ca9586",
        "jp_sha256": "ce90406c5c663823d4b169c8b6d1d977fb5d3f27f812cb29e53e2dc58751cdca",
        "official_en_sha256": "bcfea75eaa70051517b2ff6395497671944e16b063fbb55763e007e40d34c645"
      },
      "text": {
        "jp": "ここは至聖殿じゃな。\r\nまぎらわしいが、闇のクリスタルが\r\nあるのはもう１つの神殿じゃ。",
        "official_en": "’Twould seem you are confused. This is the Sanctissimus Shrine. The Dark Crystal lies elsewhere.",
        "real_en": "This is the Sanctissimus Shrine. It's confusing, but the Dark Crystal is in the other shrine."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
