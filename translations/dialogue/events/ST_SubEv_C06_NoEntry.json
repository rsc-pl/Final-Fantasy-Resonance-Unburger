        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_001:48e006aa",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C06_NoEntry",
        "key": "SubEv_C06_NoEntry_001",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_001:48e006aa",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_001:48e006aa",
        "jp_sha256": "877c7a067bb62e46d420ada6b308623dad3f42bb28c02c828388547239177cf6",
        "official_en_sha256": "82408d7ec5cd4528466e1b2999f8919b65a3b01318fffe635897cbcb0befe2eb"
      },
      "text": {
        "jp": "あの子をおいて、どこいく気？\r\n忘れずに迎えにいきましょう。",
        "official_en": "And where do you think you’re going? We can’t just leave her here.",
        "real_en": "Where do you think you're going without her? Let's make sure we go back and get her."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C06_NoEntry",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "魔人フィーナ",
