    {
      "record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_030:ec55bddc",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C06_NoEntry",
        "key": "SubEv_C06_NoEntry_030",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_030:ec55bddc",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_030:ec55bddc",
        "jp_sha256": "871aa1e2354208bb1fa0f0acdea5c37587461d35cafc34a64873f7ee35606eeb",
        "official_en_sha256": "7df2cfdce8bde7d5ccfde5bcb8e31045365212386b133c6943a240ddaa7261ab"
      },
      "text": {
        "jp": "すごい瘴気だわ。\r\nこの沼を通るには\r\nホーリーを覚えなきゃいけないんだっけ。",
        "official_en": "The miasma runs thick here. We’ll need to learn Holy to have any hope of passing through.",
        "real_en": "What thick miasma... Wasn't Holy the spell we needed to learn to cross this swamp?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
