    {
      "record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_035:13ce6f9e",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C06_NoEntry",
        "key": "SubEv_C06_NoEntry_035",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_035:13ce6f9e",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_035:13ce6f9e",
        "jp_sha256": "281ccdb12b16b55947f58947b312860db90211f2a3b0418b2053e73eb47c77bd",
        "official_en_sha256": "f5f54316c707d79380d56cd2b0b779ebb97b7b1ca64cd5347cb5b79db729ac3a"
      },
      "text": {
        "jp": "すごい瘴気じゃ。\r\nとても進むことはできん。",
        "official_en": "This overwhelming miasma leaves us at an impasse...",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
