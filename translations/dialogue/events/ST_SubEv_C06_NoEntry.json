    {
      "record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_015:ea7fea97",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C06_NoEntry",
        "key": "SubEv_C06_NoEntry_015",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_015:ea7fea97",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_015:ea7fea97",
        "jp_sha256": "cc763cc3201cb1f56524dc63207ccae775a97bbeaefdfadc36eb25d4ef1cd08f",
        "official_en_sha256": "b9b24d8e4a12336377c1d2fe603c9810ad5b4a75faa62ec06c900f5d62a620b2"
      },
      "text": {
        "jp": "動作していないようだな。\r\nどこかに電源があるんじゃないか？",
        "official_en": "It’s not working. Maybe it just needs power?",
        "real_en": "It doesn't seem to be working. Maybe there's a power source somewhere?"
      },
