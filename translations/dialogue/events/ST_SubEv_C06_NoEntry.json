        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C06_NoEntry:SubEv_C06_NoEntry_010:810eaee5",
        "jp_sha256": "21c763f7735c6b8616e41df686584f878edb4f86d90e61d8c0dfb85c21007fab",
        "official_en_sha256": "a0a14d0758b7f5b2176f73fb7a4d32cae83507882920605f23d16ef383a92ba7"
      },
      "text": {
        "jp": "……ここで逃げるわけにはいかないよな。",
        "official_en": "...We’re not going to turn our backs on what we need to do.",
        "real_en": "...We can't run away now."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
