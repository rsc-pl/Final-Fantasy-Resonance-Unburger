    {
      "record_id": "switch:locres:set-02:ST_SubEv_C05_NoEntry:SubEv_C05_NoEntry_001:452d86d6",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C05_NoEntry",
