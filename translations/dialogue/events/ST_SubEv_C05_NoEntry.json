    {
      "record_id": "switch:locres:set-02:ST_SubEv_C05_NoEntry:SubEv_C05_NoEntry_005:87c23ae6",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C05_NoEntry",
        "key": "SubEv_C05_NoEntry_005",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C05_NoEntry:SubEv_C05_NoEntry_005:87c23ae6",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C05_NoEntry:SubEv_C05_NoEntry_005:87c23ae6",
