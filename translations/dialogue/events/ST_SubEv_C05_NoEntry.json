    {
      "record_id": "switch:locres:set-02:ST_SubEv_C05_NoEntry:SubEv_C05_NoEntry_015:492ddc68",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C05_NoEntry",
        "key": "SubEv_C05_NoEntry_015",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C05_NoEntry:SubEv_C05_NoEntry_015:492ddc68",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C05_NoEntry:SubEv_C05_NoEntry_015:492ddc68",
        "jp_sha256": "603c78763deeab4df1bb66136e6a37638df01cc097d57f04e4760820fe2e0563",
        "official_en_sha256": "f4738fd69e9da1bb3fac6163659f6fdd2319a37e76929c59f56cf9a6d2a6f3fc"
      },
      "text": {
        "jp": "どうしたのじゃ？\r\nまずはスニウ村にポーションを\r\n届けるのが先なんじゃろ？",
        "official_en": "Whatever are you doing? Surely delivering potions to Sunioo is the most pressing matter.",
        "real_en": "What's wrong? Weren't we going to deliver the potions to Sunioo Village first?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
