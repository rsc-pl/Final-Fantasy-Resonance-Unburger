    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_004:59415aca",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_02",
        "key": "SubEv_C01_Zairu_02_004",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_004:59415aca",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_004:59415aca",
        "jp_sha256": "aad360108eff6064ec8daa672bd2687d7c290bc57e1a385518060c53efc106cd",
        "official_en_sha256": "3572c346ee6b065b6c5ab95f5b4dfc7752183c3dc42b75fb1720f3d3a997ea2b"
      },
      "text": {
        "jp": "荷車を引いた状態では、チョコボも\r\n魔物から素早く逃げることは難しいからな。",
        "official_en": "My chocobos can’t flee from those monsters while they’re pulling a carriage.",
        "real_en": "It's hard for chocobos to escape monsters quickly when they're pulling a cart."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
