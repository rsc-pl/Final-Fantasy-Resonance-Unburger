    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_009:54f1516a",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_02",
        "key": "SubEv_C01_Zairu_02_009",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_009:54f1516a",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_009:54f1516a",
        "jp_sha256": "4ab82612356236f761f03168747863380762639571a0ee7b056f787ca73b37ec",
        "official_en_sha256": "1382aa8b229c19a0235f84aa481178ecddbe21a615dbf6f77a4b20da1ad24691"
      },
      "text": {
        "jp": "イビルプラントならグランポート周辺の平原で見かけるな。",
        "official_en": "If it’s human traps we’re after, I believe we can find them in the plains around Grandport.",
        "real_en": "If it’s evil plants we’re after, I believe we can find them in the plains around Grandport."
      },
      "review": {
        "status": "UNREVIEWED"
