        "official_en_sha256": "6f925032c4523bff961cb8b633a4a48c7dfbd2e37629059f489d68f3a9d818ac"
      },
      "text": {
        "jp": "ほかにも必要な道具や薬剤があるんだが……\r\nイビルプラントを倒し終わったら相談させてくれ。",
        "official_en": "There are other tools and medicines I’d like to prepare too, but we can talk about those when you return.",
        "real_en": null
      },
      "review": {
        "status": "UNREVIEWED"
      },
