        "official_en_sha256": "208bf5b4cad4342bc8b3736f7d7e58a31f8c20bd393fdcb24f2bcde1cc4ae7a5"
      },
      "text": {
        "jp": "それには\r\n「イビルプラント」から取れるエキスが必要なんだ。",
        "official_en": "And for that I’ll need some extracts from a monster. Specifically, from human traps.",
        "real_en": "And for that I’ll need some extracts from a monster. Specifically, from evil plants."
      },
      "review": {
        "status": "UNREVIEWED"
