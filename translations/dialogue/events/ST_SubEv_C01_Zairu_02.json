        "key": "SubEv_C01_Zairu_02_007",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_007:129346d1",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_007:129346d1",
        "jp_sha256": "4da3807dede425f716672c75938e7e9e999764e5a4927f723507f1b04c14bbaa",
        "official_en_sha256": "cb342a9a45b4d7b4570c27eb5421d4e1f44c19141ec50b8065a16276f89c7ad0"
      },
      "text": {
        "jp": "わかった。\r\nイビルプラントを倒してくればいいんだな。",
        "official_en": "Got it, we’ll get them for you. You said you need them from human traps, right?",
        "real_en": "Got it, we’ll get them for you. You said you need them from evil plants, right?"
      },
      "review": {
        "status": "UNREVIEWED"
      },
      "function": "dialogue_line",
