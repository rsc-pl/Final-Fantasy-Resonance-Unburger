    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_001:18c00dce",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_02",
        "key": "SubEv_C01_Zairu_02_001",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_001:18c00dce",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_001:18c00dce",
        "jp_sha256": "f55d11a9ba12aaecfb2e98838f6cbe0a1e1f17f14b6a96aa08c875719ed63caf",
        "official_en_sha256": "2fea6761ef3b841ae72bda71674df1d35977f308d2381a4fc3421618e6110ef0"
      },
      "text": {
        "jp": "ちょっといいかな。\r\n王都へ物資の運搬を頼みたいんだ。",
        "official_en": "Hi there. We need your help to transport supplies to the Royal Capital.",
        "real_en": "Could I ask you something? We'd like you to transport supplies to the capital."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
