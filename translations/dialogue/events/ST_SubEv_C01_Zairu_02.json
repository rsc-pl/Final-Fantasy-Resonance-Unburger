    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_003:ecd582ad",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_02",
        "key": "SubEv_C01_Zairu_02_003",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_003:ecd582ad",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_003:ecd582ad",
        "jp_sha256": "3791228b14682d4950d2fedccdc5b9b215bf45260afec63c41674cfbf68e6824",
        "official_en_sha256": "9df0335fb57351a79efae701072bf0d7eb3b36019a61a10a56d16fcf47c60e79"
      },
      "text": {
        "jp": "王都へ行くには砂漠を渡る必要があるだろう。\r\nあのあたりには毒をもつ魔物が多く生息している。",
        "official_en": "We’ll need to cross the desert if we’re to get to the capital. The thing is, the monsters in that area tend to be venomous.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
