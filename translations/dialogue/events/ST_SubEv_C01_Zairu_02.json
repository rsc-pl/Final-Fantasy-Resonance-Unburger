    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_010:50a40a9b",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_02",
        "key": "SubEv_C01_Zairu_02_010",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_02:SubEv_C01_Zairu_02_010:50a40a9b",
