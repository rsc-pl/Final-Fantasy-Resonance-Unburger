    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_023:5c7cbb5a",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Lasswell_01",
        "key": "SubEv_C01_Lasswell_01_023",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_023:5c7cbb5a",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_023:5c7cbb5a",
        "jp_sha256": "6230bf0ff6bbd66ec29c4b365f37e8e2f2d5da79987ddcd4200298783e833fa5",
        "official_en_sha256": "5742815a270c1a3a382627aff35b3b49a784e0926195d90ac985efc607a8df79"
      },
      "text": {
        "jp": "商人から相談を受けて\r\n俺も捜査に参加していた。",
        "official_en": "The “victims” came to us after their money was stolen. I was part of the unit that was investigating the thefts, in fact.",
        "real_en": "The merchants came to us about it, and I took part in the investigation."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Lasswell_01",
