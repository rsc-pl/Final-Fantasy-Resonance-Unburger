    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_010:ba0b7a4c",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Lasswell_01",
        "key": "SubEv_C01_Lasswell_01_010",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_010:ba0b7a4c",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_010:ba0b7a4c",
        "jp_sha256": "67f53fb98b342e1de6c3aadc76f5c4a17fe8cac9defdd062373262a32d7478b9",
        "official_en_sha256": "b91b16f44b894dbc887a31b5d612038874f6b4ceb04fc7b749c96931fd2d1b71"
      },
      "text": {
        "jp": "今、グランシェルトは\r\n支援を一時停止している状態だ。",
        "official_en": "You might be aware, but with the attack on Grandshelt, we had to put a pause on most of the aid we’ve been giving out.",
        "real_en": "For now, Grandshelt has had to suspend its aid."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Lasswell_01",
