        "official_en_sha256": "79643870426dacb48a77ec3ae268b7aa81b7f0221d7bf186151e6dc7bdddd9fb"
      },
      "text": {
        "jp": "別にいいけど……なんでだ？",
        "official_en": "Sure, but why?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
