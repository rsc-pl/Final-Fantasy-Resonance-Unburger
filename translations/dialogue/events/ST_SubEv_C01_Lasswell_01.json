          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_011:d5baf88e",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Lasswell_01",
        "key": "SubEv_C01_Lasswell_01_011",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_011:d5baf88e",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_011:d5baf88e",
        "jp_sha256": "4b83c9f16f1bd614fff024c0e288ff13ce5e6eafc65b3e42f55d6c597e56ec10",
        "official_en_sha256": "d7d8cfd7dc0e9710fab0f145849821fce34eeced970843257dc11c73df907930"
      },
      "text": {
        "jp": "復興は急いで進めている。\r\n再開まで少しだけ待ってほしい。",
        "official_en": "The good news, though, is that I’ve heard they’re planning to resume aid once the restoration of the Royal Capital is complete. Everyone needs to hang on just a bit longer.",
        "real_en": "We're working as fast as we can to rebuild. Please bear with us a little longer until the aid resumes."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
