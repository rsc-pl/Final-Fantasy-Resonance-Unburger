        "official_en_sha256": "a36569da3e8db57b3565c53b8e7fc8f8508422df8118ef057ceef659d7e21360"
      },
      "text": {
        "jp": "レイン……ナシャトに行ってもいいか？",
        "official_en": "Rain... Can I ask that we go to Felicitas?",
        "real_en": null
      },
