          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_028:2d9019f0",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Lasswell_01",
        "key": "SubEv_C01_Lasswell_01_028",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_028:2d9019f0",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Lasswell_01:SubEv_C01_Lasswell_01_028:2d9019f0",
