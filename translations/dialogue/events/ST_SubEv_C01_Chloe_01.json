        "official_en_sha256": "60d52ab0dd25fdee96fb105d751f8e6c195f777513d8351bb597e54e0c15f4e6"
      },
      "text": {
        "jp": "これでもグランシェルトの雇われ学者だからね。\r\nいろいろと調査のために飛び回っているのよ。",
        "official_en": "Not just Felicitas, actually. I’ve been flying all over the place for research. That’s the life of a scholar working for Grandshelt for you.",
        "real_en": "I'm a scholar employed by Grandshelt, after all. My research takes me all over the place."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Chloe_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "クロエ",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0107",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Chloe_01/SubEv_C01_Chloe_01_003"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Chloe_01:SubEv_C01_Chloe_01_008:4ffc2799",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Chloe_01",
        "key": "SubEv_C01_Chloe_01_008",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Chloe_01:SubEv_C01_Chloe_01_008:4ffc2799",
