        "official_en_sha256": "fce2131d2468131b43fe4ff7ccd63fc2ffc2e43fa7b0e3e3e34736308019985f"
      },
      "text": {
        "jp": "ぐっ……なんだか無性に恥ずかしいぞ。",
        "official_en": "Ugh... Are you sure I still need to call you “Auntie”? It’s...embarrassing.",
        "real_en": "Ugh... This is just so embarrassing."
      },
      "review": {
        "status": "CHANGE"
      },
