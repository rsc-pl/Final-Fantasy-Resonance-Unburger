    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Chloe_01:SubEv_C01_Chloe_01_003:a59be587",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Chloe_01",
        "key": "SubEv_C01_Chloe_01_003",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Chloe_01:SubEv_C01_Chloe_01_003:a59be587",
