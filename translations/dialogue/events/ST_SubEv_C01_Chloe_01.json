        "official_en_sha256": "d4e66b2170adfceee90cc9597ca57b8163c575b90672711c5da3afeda416dcf2"
      },
      "text": {
        "jp": "そうそう、そうやって\r\n毎日私に会いに来たじゃない。\r\n私もレインちゃんって呼んでたし。",
        "official_en": "Ah, the memories... You used to come visit me every day, <text style=\"italic\">Rainy</>.",
        "real_en": "That's right! You used to come see me every day\r\nand call me that.\r\nI called you Rain-chan, too."
      },
      "review": {
        "status": "CHANGE"
      },
