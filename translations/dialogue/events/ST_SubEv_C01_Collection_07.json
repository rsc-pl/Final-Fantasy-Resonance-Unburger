    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Collection_07:SubEv_C01_Collection_07_014:04c30c15",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Collection_07",
        "key": "SubEv_C01_Collection_07_014",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Collection_07:SubEv_C01_Collection_07_014:04c30c15",
