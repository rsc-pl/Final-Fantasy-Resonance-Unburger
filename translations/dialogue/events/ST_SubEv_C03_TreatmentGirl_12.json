        "official_en_sha256": "2925af9fb528303b7bcf351a9b8a55f1ac803b62437aac6de32b1fcc1f9c08e6"
      },
      "text": {
        "jp": "それまで一緒に頑張りましょう。",
        "official_en": "I shall see to that personally.",
        "real_en": "Until then, let's keep doing our best together."
      },
      "review": {
        "status": "CHANGE"
