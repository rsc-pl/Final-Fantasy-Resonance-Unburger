      },
      "text": {
        "jp": "よかったな、サーラ。",
        "official_en": "Well, there you have it, Sarah. I’m so happy.",
        "real_en": "I'm glad you're feeling better, Sarah."
      },
      "review": {
        "status": "CHANGE"
