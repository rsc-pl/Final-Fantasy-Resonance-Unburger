    {
      "record_id": "switch:locres:set-02:ST_SubEv_StoneStatue:SubEv_StoneStatue_031:fb822811",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_StoneStatue",
        "key": "SubEv_StoneStatue_031",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_StoneStatue:SubEv_StoneStatue_031:fb822811",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_StoneStatue:SubEv_StoneStatue_031:fb822811",
        "jp_sha256": "3556ac6d69ce50651c34b2c46311548d2a807d19fb15d30280b41cc44dafe34c",
        "official_en_sha256": "d0d5916a40bfd820a4f5f8d964c535d22df3a65732aa9516084392f491e6e2b6"
      },
      "text": {
        "jp": "“はじまりの日、「折れた剣」が空を裂いて、光は世に満ちる。”\r\n“つぎの日、「朽ちし馬」は眠りにつき、大地の骨となる。”\r\n“おわりの日、「閉ざされた闇」が産声を上げ、昼と夜がわかたれる。”",
        "official_en": "First, a broken sword pierced the sky, bringing light. Then, a withered horse was laid to rest, becoming the land. Finally, darkness once sealed was unleashed, cleaving day from night.",
        "real_en": "\"On the first day, the 'Broken Sword' split the sky, and light filled the world. On the next day, the 'Withered Horse' fell asleep and became the bones of the earth. On the final day, the 'Sealed Darkness' let out its first cry, dividing day from night.\""
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_StoneStatue",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "空白",
          "label_status": "UNKNOWN",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_StoneStatue/SubEv_StoneStatue_031"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_StoneStatue:SubEv_StoneStatue_030:4154cfc9",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_StoneStatue",
        "key": "SubEv_StoneStatue_030",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_StoneStatue:SubEv_StoneStatue_030:4154cfc9",
