      },
      "text": {
        "jp": "あなたたち、メルセデスちゃんのことを\r\n調べているのかい？",
        "official_en": "You’re asking around town about little Mercedes, you say?",
        "real_en": "Are you looking into Mercedes-chan?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
