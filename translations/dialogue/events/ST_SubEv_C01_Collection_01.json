        "namespace": "ST_SubEv_C01_Collection_01",
        "key": "SubEv_C01_Collection_01_007",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Collection_01:SubEv_C01_Collection_01_007:560cbcbe",
