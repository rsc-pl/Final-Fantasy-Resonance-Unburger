        "official_en_sha256": "5c5d21fc30bfdadc90c2c3a99a4254a6d832c2ba20248840d0eb89364cf7fd5e"
      },
      "text": {
        "jp": "わたくしは、とある国の姫です……。",
        "official_en": "I am...of royal blood; a princess of a realm.",
        "real_en": "I'm a princess from a certain country..."
