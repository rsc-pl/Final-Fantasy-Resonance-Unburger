      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Collection_01",
        "key": "SubEv_C01_Collection_01_022",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Collection_01:SubEv_C01_Collection_01_022:ca3a066b",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Collection_01:SubEv_C01_Collection_01_022:ca3a066b",
        "jp_sha256": "39d97816d1a6cad3f1d791aee2d2c5ea794e0fa39bb24fb66b1626ddab588ccd",
        "official_en_sha256": "d7a99ccb16170f06983b2268d7fd8537e00c864c8f360083e10f964692b0f31d"
      },
      "text": {
        "jp": "どうしてでしょうか……。\r\nただ、何かきっと理由があるのでしょう。",
        "official_en": "That, too, is a mystery, the truth of which doth elude me. Yet in my heart, I believe ’tis not mere chance.",
        "real_en": "I don't know why... But there must be a reason."
      },
      "review": {
        "status": "CHANGE"
      },
