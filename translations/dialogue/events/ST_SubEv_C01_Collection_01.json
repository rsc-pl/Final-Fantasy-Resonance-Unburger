        "official_en_sha256": "3c1458c985ff2366ef3d3c9dfa1511b2dd59fc736f1e4e2ff986c1f85b959dd9"
      },
      "text": {
        "jp": "わかった。\r\n石板のカケラを見つけたら、ここに届けにくるよ。",
        "official_en": "Say no more. I’ll bring you the tablet shards...if I can find them.",
        "real_en": "Okay. If I find any tablet fragments, I'll bring them here."
      },
      "review": {
