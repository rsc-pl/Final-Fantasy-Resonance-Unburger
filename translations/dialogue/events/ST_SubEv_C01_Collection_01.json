        "official_en_sha256": "639a91fd304e6648b7a51dce64037a8c4cff30365827a33fde7f37c8f5f1f490"
      },
      "text": {
        "jp": "ここはグランシェルト領内だぜ。\r\nどこかの国の姫がなんでこんなところに？",
        "official_en": "And what’s a princess from another realm like you doing here in Grandshelt?",
        "real_en": "This is Grandshelt territory. What's a princess from another country doing here?"
      },
