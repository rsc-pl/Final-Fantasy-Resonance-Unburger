    {
      "record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_01:SubEv_C03_Mercedes_01_010:31121152",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C03_Mercedes_01",
        "key": "SubEv_C03_Mercedes_01_010",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_01:SubEv_C03_Mercedes_01_010:31121152",
