        "official_en_sha256": "567e0a6acba920532e1d696ae53d19e98fad437d3b20912de304c460790347d9"
      },
      "text": {
        "jp": "いまは、上陸して町を襲わないように、\r\nこうして警備をしているんです。",
        "official_en": "No telling when they might attempt to raid the town, so we’ve tightened security around here.",
        "real_en": "We're keeping watch here to stop them from coming ashore and attacking the town."
      },
      "review": {
        "status": "CHANGE"
      },
