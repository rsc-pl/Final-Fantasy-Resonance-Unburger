        "official_en_sha256": "299d52880ca6f6ea4929380084c905cf8a7c05004a86133ec769be3d8f8cfd71"
      },
      "text": {
        "jp": "ええ。\r\n話のできる相手かどうか、確かめたいので。",
        "official_en": "Correct—they may be pirates, but that does not necessarily make them savages. I intend to discern whether they are open to any negotiations.",
        "real_en": "Yes. I want to find out whether they're willing to talk."
      },
      "review": {
        "status": "CHANGE"
      },
