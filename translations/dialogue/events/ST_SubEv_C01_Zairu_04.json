      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_022:44c828d1",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_04",
        "key": "SubEv_C01_Zairu_04_022",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_022:44c828d1",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_022:44c828d1",
        "jp_sha256": "b0b44e7b43b54dc353291de7cf3ab6ea188beca378ddd2f028959ff3fc983dd7",
        "official_en_sha256": "3a572b96744d1cdb9dcab48bac7ec24fb8f46a70e3c75f8d199f9279b13c5485"
      },
      "text": {
        "jp": "おれも今は王都の復旧に回ってるんだ。\r\n大変だけど、みんなのために頑張るよ。",
        "official_en": "I’ve been working on restoring the Royal Capital, too. It’s tough, but I believe it’ll be well worth the effort.",
        "real_en": "I'm helping rebuild the capital now, too. It's hard work, but I'll give it my all for everyone's sake."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Zairu_04",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ザイル",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0167",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Zairu_04/SubEv_C01_Zairu_04_022"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_008:2b13d229",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_04",
        "key": "SubEv_C01_Zairu_04_008",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_008:2b13d229",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_008:2b13d229",
        "jp_sha256": "6faf90e33b1f6fca913802aecaa4a8ae00b882d9de6907f5ebb07deeef189f56",
        "official_en_sha256": "53c751201cd06dd424638bee0695c098e0184a77c1691bca366cd32fa1d9b2e6"
      },
      "text": {
        "jp": "おれも目立ちたくて、\r\nこんな派手な格好もしてみたけど。\r\nいくら頑張ってもかなわないと思ったよ。",
        "official_en": "I got myself this snappy outfit just to garner some attention from others in my own way, but by gosh, I was never going to reach the level he was at.",
        "real_en": "I wanted to stand out, so I even tried dressing this flashy. But no matter how hard I tried, I knew I couldn't match him."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Zairu_04",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ザイル",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0167",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Zairu_04/SubEv_C01_Zairu_04_008"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_005:0941f69f",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_04",
        "key": "SubEv_C01_Zairu_04_005",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_005:0941f69f",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_005:0941f69f",
        "jp_sha256": "a1293b701e22d4813900eb6fc44b2aad85f542236fed4daedfdef65852e53913",
        "official_en_sha256": "e2d3c130f6fb088e9f393e4296ac84c82e238068fda6e9d52f6a806ebae25cdd"
      },
      "text": {
        "jp": "これで陸路も万全だな。\r\nにしてもこんなに早く集めてくるとは、やるねー。\r\nさすがはレーゲンさんの息子たち！",
        "official_en": "You’ve secured a land route, and with remarkable speed at that. Well done! I wouldn’t have expected any less from Sir Raegen’s sons.",
        "real_en": "That takes care of the land route, too. And you gathered everything so quickly! Just what I'd expect from Raegen-san's sons!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Zairu_04",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ザイル",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0167",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Zairu_04/SubEv_C01_Zairu_04_005"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_007:0d84f568",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_04",
        "key": "SubEv_C01_Zairu_04_007",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_007:0d84f568",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_007:0d84f568",
        "jp_sha256": "f57f72ebf2d283e66edd0e821ca13fa64ff9b15022196654aca49e78b6c6fc80",
        "official_en_sha256": "d83b1ce6fa0518c2a38158612d3a427200e2799a22c57b5f1713d435ec808630"
      },
      "text": {
        "jp": "そうそう。\r\nなんだけどさ、レーゲンさんは入隊した時からすごくて。\r\n才能が違うっていうのかな。",
        "official_en": "That I did... Ah, that brings me back. Even when we were recruits, the skill he possessed was leagues beyond mine.",
        "real_en": "That's right. But you know, Raegen-san was remarkable from the moment he joined up. I guess you could say he was just naturally gifted."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
