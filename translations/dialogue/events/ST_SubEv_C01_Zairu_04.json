          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Zairu_04/SubEv_C01_Zairu_04_007"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_017:854646ce",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_04",
        "key": "SubEv_C01_Zairu_04_017",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_017:854646ce",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_017:854646ce",
        "jp_sha256": "8fe974deda8306206d014e65c4df358327dde34e4f08381f7f2a4798e1515479",
        "official_en_sha256": "4c98ac2e6b5ac0f50fc7c4a5008476b1375367ba427f28a3b4d922a3c7e3d69a"
      },
      "text": {
        "jp": "そうだな。\r\n国に暮らす人たちの生活を支える仕事もたくさんある。",
        "official_en": "You can say that again. There are duties we need to fulfill to support the everyday lives of the people we swore to protect.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
