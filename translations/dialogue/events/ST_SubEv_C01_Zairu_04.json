    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_002:5434edd0",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_04",
        "key": "SubEv_C01_Zairu_04_002",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_002:5434edd0",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_04:SubEv_C01_Zairu_04_002:5434edd0",
        "jp_sha256": "13b15d972342470cf828fe7d94088e0e5f206c658a2b582340b27f249b70f163",
        "official_en_sha256": "b9f4e3b765ba0b6bae8ca9fcbb48d59f5ba636c41b49aff67136484308e7be9e"
      },
      "text": {
        "jp": "ありがたい。\r\nさっそく解毒剤作りに取りかかるよ。",
        "official_en": "Much obliged. I’ll get working on synthesizing the antidotes right away.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
