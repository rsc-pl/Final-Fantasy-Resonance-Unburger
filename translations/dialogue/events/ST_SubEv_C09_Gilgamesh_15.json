    {
      "record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_15:SubEv_C09_Gilgamesh_15_009:6b96bc42",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C09_Gilgamesh_15",
        "key": "SubEv_C09_Gilgamesh_15_009",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_15:SubEv_C09_Gilgamesh_15_009:6b96bc42",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_15:SubEv_C09_Gilgamesh_15_009:6b96bc42",
        "jp_sha256": "cf04718f9e9cddc608ad383282c915cc3743e2c35c795ec28146b23644cd9eb4",
        "official_en_sha256": "7be48c2b291e8c893a6933f03c2015faa00d23dbae46be80a65340ee1151df95"
      },
      "text": {
        "jp": "だが、オレは記憶を取り戻したんだ。\r\nなんのために、この世界に来たかを思い出したぜ。",
        "official_en": "I’ve regained my memories. I now know why I came to your world in the first place. I’ve come to...",
        "real_en": "But I've regained my memories. I remember why I came to this world."
      },
      "review": {
        "status": "CHANGE"
      },
