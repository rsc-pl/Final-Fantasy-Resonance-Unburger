        "key": "SubEv_C09_Gilgamesh_15_013",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_15:SubEv_C09_Gilgamesh_15_013:f1cbb8a5",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_15:SubEv_C09_Gilgamesh_15_013:f1cbb8a5",
