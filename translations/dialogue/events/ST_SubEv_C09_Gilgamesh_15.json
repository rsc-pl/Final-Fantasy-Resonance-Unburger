    {
      "record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_15:SubEv_C09_Gilgamesh_15_008:de694710",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C09_Gilgamesh_15",
        "key": "SubEv_C09_Gilgamesh_15_008",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_15:SubEv_C09_Gilgamesh_15_008:de694710",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_15:SubEv_C09_Gilgamesh_15_008:de694710",
        "jp_sha256": "5877c06e221f1730eaabeb664fcf4c9c28fdae91cba623952da6d18a9c5ee061",
        "official_en_sha256": "7822d1c5a487b04316b0d14176437d39a46cf86791f8e3ddc2c79000afbce686"
      },
      "text": {
        "jp": "オレも同じだぜ。\r\n短いつきあいだが、オレも仲間に……なんてな。",
        "official_en": "The feeling is mutual... We haven’t known each other long, but...maybe I could be one of your—ah, forget it.",
        "real_en": "I feel the same way. We haven't known each other long, but maybe I could join you... Just kidding."
      },
      "review": {
