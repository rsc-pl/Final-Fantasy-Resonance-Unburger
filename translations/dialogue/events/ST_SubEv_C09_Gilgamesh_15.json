        "official_en_sha256": "0dc402d5d7b4f7580be0b95c4a8d093ee2e963dcc21ae62b46d021c4083ce373"
      },
      "text": {
        "jp": "そんな理由をつけなくても、本気で戦ってやるさ！\r\n行くぞ、ギルガメッシュ！",
        "official_en": "As if I need a reason to fight you full bore! Let’s go, Gilgamesh!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
