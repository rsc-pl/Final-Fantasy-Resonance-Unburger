    {
      "record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_15:SubEv_C09_Gilgamesh_15_010:c0ca6c32",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C09_Gilgamesh_15",
        "key": "SubEv_C09_Gilgamesh_15_010",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_15:SubEv_C09_Gilgamesh_15_010:c0ca6c32",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_15:SubEv_C09_Gilgamesh_15_010:c0ca6c32",
        "jp_sha256": "57cfd9a7b7a1900095032358b52d34354e9b5a90c3e5a4b96a39f49bf0f982b3",
        "official_en_sha256": "d9ea78c87ca59976cf28e1326e656453fac05e061e42ce6b5da4837f4ca67f6c"
      },
      "text": {
        "jp": "オレは……この世界をブッ壊すために来た。\r\n手始めに、お前たちの命をもらう！",
        "official_en": "LAY RUIN TO IT! I shall begin by taking your lives!",
        "real_en": "I... came here to destroy this world. I'll start by taking your lives!"
      },
      "review": {
        "status": "CHANGE"
