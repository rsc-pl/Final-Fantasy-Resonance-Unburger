          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_018:4787fd8d",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_01",
        "key": "SubEv_C01_Zairu_01_018",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_018:4787fd8d",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_018:4787fd8d",
        "jp_sha256": "74c9eced79ff0b0271b9206f30b489d0956bb57600b2090565a95dfac2b97a96",
        "official_en_sha256": "6e0978ebb22b858780fadcc8d4ca60b36583562e2815129b5e1d075810b69d1b"
      },
      "text": {
        "jp": "その申し出、ありがたいよ。\r\n騎士団も被害の確認や避難所の開設なんかで\r\nとにかく人手が足りなくて。",
        "official_en": "With the Order overwhelmed with tasks—assessing the extent of the damage, setting up evacuation camps to name a few—I’ll gladly take you up on your offer, Rain.",
        "real_en": "I'd appreciate that. The Order is short-handed, between assessing the damage and opening shelters."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Zairu_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ザイル",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0167",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Zairu_01/SubEv_C01_Zairu_01_018"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_002:968b2ec0",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_01",
        "key": "SubEv_C01_Zairu_01_002",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_002:968b2ec0",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_002:968b2ec0",
        "jp_sha256": "a8bcd9c804849b15774973992ca5e42e5d928ea2b23d65be2a1fc508c51202ef",
        "official_en_sha256": "5ef028c8523a3ab944f289ab0f89a403ce7e8830b768260705630ab0a6be2796"
      },
      "text": {
        "jp": "だーから、おれは海賊じゃないんだって。\r\nグランシェルト騎士団イチの砲撃士、ザイルだよ。",
        "official_en": "I <text style=\"italic\">told</> you; I am NOT a pirate. I am the premier bombardier of the Grandshelt Order—Zile, if you please.",
        "real_en": "I keep telling you, I'm not a pirate. I'm Zile, the finest artilleryman in the Grandshelt Order."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Zairu_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ザイル",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0167",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Zairu_01/SubEv_C01_Zairu_01_002"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_006:5809e590",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_01",
        "key": "SubEv_C01_Zairu_01_006",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_006:5809e590",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_006:5809e590",
        "jp_sha256": "d233fe4a9c529507b9b49c113219dc9460e7713dd7e919f0215d05934f906ecf",
        "official_en_sha256": "b41c1b5bb9019e50bf67684a462c25090642bd610b899eebc68bafd976104af3"
      },
      "text": {
        "jp": "ちょっと待ってくれ。\r\nザイルさんは本当にグランシェルトの騎士なんだ。",
        "official_en": "Hold up, he’s telling the truth. Sir Zile is one of us.",
        "real_en": "Wait a moment. Zile-san really is a knight of Grandshelt."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Zairu_01",
