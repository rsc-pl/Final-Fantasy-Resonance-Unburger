          "label_status": "VERIFIED",
          "name_entry": "CharaName0049",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Zairu_01/SubEv_C01_Zairu_01_010"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_017:97ea2565",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_01",
        "key": "SubEv_C01_Zairu_01_017",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_017:97ea2565",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_017:97ea2565",
        "jp_sha256": "8cd56c6a0cddd2c2c60ff6b90f5129fd567095530c6e2321bca82fd108be7a86",
        "official_en_sha256": "bc9a429fa74a5849273871b4eee85e95c8d9be93a4370acaf60635effa151215"
      },
      "text": {
        "jp": "そうか、王都のために……。\r\n俺たちに何か手伝えることはないですか？",
        "official_en": "So this is all for the reconstruction... Is there anything we can do to help?",
        "real_en": "I see, all for the capital... Is there anything we can do to help?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Zairu_01",
