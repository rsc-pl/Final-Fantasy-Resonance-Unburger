      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_004:ad41b4b2",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_01",
        "key": "SubEv_C01_Zairu_01_004",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_004:ad41b4b2",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_004:ad41b4b2",
        "jp_sha256": "b2166da986d28608488fe26dbb5ebf5b8fdddb6541cb7a52452ecdfedc43a47d",
        "official_en_sha256": "cce2c978ef69dbf978427af61fc9b8729eead0b7acfaf042ed1d9b3d041dc50d"
      },
      "text": {
        "jp": "まあ、そう勘違いされても仕方ないけど……\r\nこれは目立つのが好きで着てるだけっていうか。",
        "official_en": "Look, friend, I don’t blame you for the misunderstanding—I only dress like this as a fashion statement. A knight has the right to look dashing, you know.",
        "real_en": "Well, I can see why you'd think that... I just like wearing flashy clothes."
      },
