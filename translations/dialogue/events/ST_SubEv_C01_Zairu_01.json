          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_019:c5fa270f",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_01",
        "key": "SubEv_C01_Zairu_01_019",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_019:c5fa270f",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_019:c5fa270f",
        "jp_sha256": "c75025b654cb9114f31fff3def70c909c79f1ea091ddf21d1220fe5c01a37a6c",
        "official_en_sha256": "f6d89bbc5cfc8042d16180741b6c470b11fe7bddcd6571e4d2b0aab7efb6a5d4"
      },
      "text": {
        "jp": "じゃあ、チョコボ車の御者に\r\n輸送の依頼をしてくれないか？\r\n陸路はまだ手が回ってなくてさー。",
        "official_en": "Let’s see...would you kindly ask the chocobo carriage coachman to transport supplies to the capital? I haven’t been able to make a start on establishing a land route yet.",
        "real_en": "Could you ask the chocobo carriage driver to transport the supplies? We haven't been able to arrange the land route yet."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Zairu_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ザイル",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0167",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Zairu_01/SubEv_C01_Zairu_01_019"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_010:b6c4234c",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_01",
        "key": "SubEv_C01_Zairu_01_010",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_010:b6c4234c",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_010:b6c4234c",
        "jp_sha256": "11a243a04641431aeccfc3bcec2e95f3fc3716eef931da12eb394ee0288a5821",
        "official_en_sha256": "03e7f2577fcb897f63c54ae70bf13742e3864d07c48e2564cb82929be25e73cb"
      },
      "text": {
        "jp": "すまない……。\r\n俺の勘違いだったようだ。\r\nなんと言って詫びたらいいか……。",
        "official_en": "Y’have my sincerest apologies...er...sire.",
        "real_en": "I'm sorry... It seems I was mistaken. I don't know how to apologize..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Zairu_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
