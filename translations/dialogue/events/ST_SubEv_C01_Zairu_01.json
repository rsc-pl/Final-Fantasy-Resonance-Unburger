    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_007:65dfbb29",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_01",
        "key": "SubEv_C01_Zairu_01_007",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_007:65dfbb29",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_007:65dfbb29",
        "jp_sha256": "9b0f6e92c20930d4c43ba6d2b9005a15d752b24fe563db4ecd8a7b2eb3ad6192",
        "official_en_sha256": "86a13831468911b1f2847cdaf84bfbcc40f14f49221dab92687c0fed717051ab"
      },
      "text": {
        "jp": "おー、レインにラスウェル。\r\nいいところにきてくれた。",
        "official_en": "Ah, Rain and Lasswell. Impeccable timing.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
