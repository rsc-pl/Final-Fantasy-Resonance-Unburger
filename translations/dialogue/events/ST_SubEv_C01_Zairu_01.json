    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_008:fef9c980",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_01",
        "key": "SubEv_C01_Zairu_01_008",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_008:fef9c980",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_008:fef9c980",
        "jp_sha256": "af5fbc9d9436b50b7804ed70b08ba836b2196d841e602dc723eec96ce2bc75b4",
        "official_en_sha256": "95174237f0efe6d51e693fc201b5e5ac2e2ccfca7f2f72845eb92d54000a891a"
      },
      "text": {
        "jp": "こいつらは騎士団の後輩さ。\r\n記章を見れば本物だってわかるだろ？",
        "official_en": "These are my younger brethren of the knight order. As you can see, their insignias attest to their legitimacy.",
        "real_en": "They're my juniors in the Order. Their insignias prove they're real knights, don't they?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
