          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_003:7a4ad412",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Zairu_01",
        "key": "SubEv_C01_Zairu_01_003",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_003:7a4ad412",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Zairu_01:SubEv_C01_Zairu_01_003:7a4ad412",
        "jp_sha256": "97aecc56cbca872667bf518a106ee218864bfb993e7bdcb24a2d007b7e8f83a2",
        "official_en_sha256": "27afa2394c7e03047c633e30163d15ce45eeccaa74a3da9d6d8f6f140505aa82"
      },
      "text": {
        "jp": "はあ？　騎士だあ？\r\nその格好、どう見ても海賊じゃねえか！",
        "official_en": "A knight? With <text style=\"italic\">that</> flashy hat and suit!? Ha! Then I’m the King o’ Grandshelt!",
        "real_en": "Huh? A knight? Dressed like that, you look exactly like a pirate!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
