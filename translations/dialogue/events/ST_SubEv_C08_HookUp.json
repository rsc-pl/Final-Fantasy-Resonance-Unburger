    {
      "record_id": "switch:locres:set-02:ST_SubEv_C08_HookUp:SubEv_C08_HookUp_008:6d713736",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C08_HookUp",
        "key": "SubEv_C08_HookUp_008",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C08_HookUp:SubEv_C08_HookUp_008:6d713736",
