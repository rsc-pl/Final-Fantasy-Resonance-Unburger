        "jp_sha256": "d6de196fd87686f7275140be5a56dc3b13d3746d874f07787ca29e79018c8b36",
        "official_en_sha256": "611e8af3104c8409f0ce8420fb467d69f0272fa944d70160febc16706c233a65"
      },
      "text": {
        "jp": "少し痛い目を見て、お帰りいただこうか！",
        "official_en": "In fact, why don’t we rough you up a little instead? Then you’ll <text style=\"italic\">really</> have something to talk about when ya go crying back ta yer mommy!",
        "real_en": "How about we teach you a little lesson before sending you home?"
      },
