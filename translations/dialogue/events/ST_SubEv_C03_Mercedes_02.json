    {
      "record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_02:SubEv_C03_Mercedes_02_005:0b1156b8",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C03_Mercedes_02",
        "key": "SubEv_C03_Mercedes_02_005",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_02:SubEv_C03_Mercedes_02_005:0b1156b8",
