    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_02:SubEv_C01_Rain_02_016:04daa47d",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_02",
        "key": "SubEv_C01_Rain_02_016",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_02:SubEv_C01_Rain_02_016:04daa47d",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_02:SubEv_C01_Rain_02_016:04daa47d",
        "jp_sha256": "02a7a8c44da86b45f4f0ba7dbf2a5f837d487dd7486726ba2cca298d31207f3e",
        "official_en_sha256": "133cee33298d43ffcde555e106ae40e4dff200eb0695d46f5641ebbb68f89c0b"
      },
      "text": {
        "jp": "お前は俺に言ったな。\r\n飛空艇があれば\r\n有事に多くの人を助けることができる、と。",
        "official_en": "You told me we could save the lives of lots of people if we had airships.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
