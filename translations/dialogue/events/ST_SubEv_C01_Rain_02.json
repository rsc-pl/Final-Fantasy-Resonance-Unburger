        "official_en_sha256": "30db3a8160218e45adaa171005c8f08305272007d3917ea4258cf4138113fe2e"
      },
      "text": {
        "jp": "そうだ。\r\n土の神殿に行こう。",
        "official_en": "I have an idea. Let’s go to the Earth Shrine.",
        "real_en": null
      },
      "review": {
