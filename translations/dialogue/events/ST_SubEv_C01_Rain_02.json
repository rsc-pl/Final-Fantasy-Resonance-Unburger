    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_02:SubEv_C01_Rain_02_018:73963547",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_02",
        "key": "SubEv_C01_Rain_02_018",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_02:SubEv_C01_Rain_02_018:73963547",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_02:SubEv_C01_Rain_02_018:73963547",
        "jp_sha256": "072283568f08589697803fb5724967879c1898752e26ca60ad518463c35312d4",
        "official_en_sha256": "b359fe4023892ba779ee4bb36477b1d8c9442f291a101f51a9820dd98cab887b"
      },
      "text": {
        "jp": "……飛空艇部隊は、それを実現するための空駆ける騎士団。\r\nその信念に心打たれたから、\r\n俺は技師として飛空艇部隊を支えようと思った。",
        "official_en": "...And your airship squadron was the very embodiment of that belief, soaring across the blue skies. I was moved by what it represented. That’s why I decided to join your cause and play my part as the squadron’s engineer.",
        "real_en": "The airship squadron was to be a band of knights soaring through the skies to make that happen. Your conviction moved me, so I decided to support the squadron as an engineer."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C01_Rain_02",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "スコット",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0177",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C01_Rain_02/SubEv_C01_Rain_02_018"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_02:SubEv_C01_Rain_02_030:bc555a26",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_02",
        "key": "SubEv_C01_Rain_02_030",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_02:SubEv_C01_Rain_02_030:bc555a26",
