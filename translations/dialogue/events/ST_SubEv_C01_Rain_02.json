    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_02:SubEv_C01_Rain_02_006:2698185c",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Rain_02",
        "key": "SubEv_C01_Rain_02_006",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Rain_02:SubEv_C01_Rain_02_006:2698185c",
