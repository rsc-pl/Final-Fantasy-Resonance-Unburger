    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_004:f23b94eb",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_02",
        "key": "SubEv_C01_Moogle_02_004",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_004:f23b94eb",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_004:f23b94eb",
        "jp_sha256": "be72f6d948097a96b86025fb61016a308a2c7664a733becbd009e64ea3bf2967",
        "official_en_sha256": "27cbc7ccd7ec469a65a50f43467fc476895426b81109361bd734521208608f08"
      },
      "text": {
        "jp": "なかなかビジョンの使い方がうまいクポね。\r\nキミタチなら異界の優秀な戦士になれるかもしれないクポ。",
        "official_en": "I have to admit, you’re pretty good at using those visions, kupo.\r\nYou may make fine warriors in the Farplane, kupo.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
