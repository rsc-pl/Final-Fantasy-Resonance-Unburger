      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_002:44c964ad",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_02",
        "key": "SubEv_C01_Moogle_02_002",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_002:44c964ad",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_002:44c964ad",
        "jp_sha256": "5b5ce3b67c91c348bc6e9c9e5b4fbacb02938500ed4a135cf63d63d832143233",
        "official_en_sha256": "d29ab653b9fac305844da3ff6606e7bbeb51cfabf7fa77790c8640390e38e6ad"
      },
      "text": {
        "jp": "今日は、魔石を持ってきたクポ？",
        "official_en": "Did you bring me some magicites, kupo?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
