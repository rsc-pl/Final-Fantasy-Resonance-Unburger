    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_007:21a51896",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_02",
        "key": "SubEv_C01_Moogle_02_007",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_007:21a51896",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_007:21a51896",
        "jp_sha256": "b4ac4b717bdf3205013b09163544f99d6c77cc2bc3cec4054cd92d7b5b0e6201",
        "official_en_sha256": "c6ed33bee4b4d476a28070c6118a4785bf507bf390ff30f09e61d458059f5fe9"
      },
      "text": {
        "jp": "異界も居心地がいいけど、この世界も捨てたもんじゃないクポ。\r\nキミタチにはしっかり守ってもらわないと困るクポ。",
        "official_en": "The Farplane is cozy, but this world isn’t half bad, kupo. I’m counting on you to protect it at all costs, kupo.",
        "real_en": "The Farplane is comfortable, but this world isn't bad either, kupo. I'll need you to make sure you protect it, kupo!"
      },
      "review": {
