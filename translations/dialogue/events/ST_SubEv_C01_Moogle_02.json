    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_001:29002974",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_02",
        "key": "SubEv_C01_Moogle_02_001",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_001:29002974",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_001:29002974",
        "jp_sha256": "aa506c9cb2bcd3c971ac0563cae0d459f6cf148dd49d740efeabb92dbfc9d60a",
        "official_en_sha256": "776c9161dfda95f5d608f8383f98454e96bd560c0dbe5190c0099df625cffba0"
      },
      "text": {
        "jp": "ボクは異界のエラーイモーグリクポ。\r\n光の意思から頼まれてキミタチを手伝ってやるんだクポ！",
        "official_en": "I’m the moogle big shot from the Farplane, kupo. I’m here to help you boys at the request of the Will of Light, kupo.",
        "real_en": "I'm a very important moogle from the Farplane, kupo! The Will of Light asked me to help you, kupo!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
