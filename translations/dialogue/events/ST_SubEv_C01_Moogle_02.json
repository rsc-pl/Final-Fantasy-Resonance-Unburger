    {
      "record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_005:c2884fd1",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C01_Moogle_02",
        "key": "SubEv_C01_Moogle_02_005",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_005:c2884fd1",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_005:c2884fd1",
        "jp_sha256": "0550f3f9019bd16864be029f68afbe2b84661ac6dd2d7285f17a1cceeb93e0c4",
        "official_en_sha256": "b7890e1cac61ce04483bbbeab87f946ee50598c961691e6f04690f50b93c175e"
      },
      "text": {
        "jp": "キミタチの冒険は、風のウワサで聞こえてくるクポ。\r\nボクの伝説の旅についても、いつか聞かせる時がくるかもクポ。",
        "official_en": "I’ve heard about your adventures through the grapevine, kupo. Maybe I can share <text style=\"italic\">my</> tales of adventure with you one of these days, kupo.",
        "real_en": "Word of your adventures reaches me on the wind, kupo. Maybe one day I'll tell you about <text style=\"italic\">my</> legendary journey, kupo."
      },
      "review": {
        "status": "CHANGE"
      },
