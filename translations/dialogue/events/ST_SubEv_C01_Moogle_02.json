        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C01_Moogle_02:SubEv_C01_Moogle_02_006:93bbf8d9",
        "jp_sha256": "7280d56e3d6903f2f349c1401d861dd951f4bd6c3f2543e79f815c7d2011dc61",
        "official_en_sha256": "02ba68cbea26cdf7338673cecb0ac45e2cfcfd422146f294b226a9942d552fb1"
      },
      "text": {
        "jp": "そうだクポ。この前、あっちの谷でこれを拾ったからあげるクポ。",
        "official_en": "Oh yeah, take this, kupo. I found it in the valley over there, kupo.",
        "real_en": null
      },
      "review": {
