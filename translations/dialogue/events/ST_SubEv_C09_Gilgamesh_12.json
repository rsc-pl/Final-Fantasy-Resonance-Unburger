      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_12:SubEv_C09_Gilgamesh_12_005:61b63cb1",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C09_Gilgamesh_12",
        "key": "SubEv_C09_Gilgamesh_12_005",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_12:SubEv_C09_Gilgamesh_12_005:61b63cb1",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_12:SubEv_C09_Gilgamesh_12_005:61b63cb1",
        "jp_sha256": "3eac77aa74a2f1b83171cb487b15e83c911d3b3f86c0161fb8a212436f1f72a6",
        "official_en_sha256": "52114d151996c3a7965fb4cf3f58ef28b97b02c92bd9079d38b0d742cff4a969"
      },
      "text": {
        "jp": "今まで何度も橋を渡ってきたが、\r\nその度に前に進んでこられた。\r\nきっと、ギルガメッシュの故郷にもたどり着けるさ。",
        "official_en": "I’ve crossed bridges more times than I care to count, but I never stopped—not even once. I’m sure we’ll find a way to your home, Gilgamesh.",
        "real_en": "I've crossed bridges many times, and each time I've managed to keep moving forward. I'm sure we'll find a way back to your home, Gilgamesh."
      },
      "review": {
        "status": "CHANGE"
      },
