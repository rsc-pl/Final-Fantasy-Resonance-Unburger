        "namespace": "ST_SubEv_C09_Gilgamesh_12",
        "key": "SubEv_C09_Gilgamesh_12_003",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_12:SubEv_C09_Gilgamesh_12_003:a0922bdb",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C09_Gilgamesh_12:SubEv_C09_Gilgamesh_12_003:a0922bdb",
        "jp_sha256": "a0de9fd99ec740064032df75c74dbb07bdc7a4046ba923afd367350c35bd0e9f",
        "official_en_sha256": "582a575f249e59a87168d362247a196794455b0628c89e14ebcfc0fde27e6bbc"
      },
      "text": {
        "jp": "橋を渡れば、その先は未知の世界。\r\nそれは危険に踏み込むという意味でもある。",
        "official_en": "Crossing a bridge means entering a distant, unfamiliar land. And as with all things unknown, danger is never far behind.",
        "real_en": "Beyond the bridge was an unknown world. Crossing it also meant stepping into danger."
      },
