          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_018:1cfb471e",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C03_Mercedes_03",
        "key": "SubEv_C03_Mercedes_03_018",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_018:1cfb471e",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_018:1cfb471e",
        "jp_sha256": "2122a911dc663402183e4a276cb3fcaaed1ebacd9f7f3994e1d6e51e98e11bba",
        "official_en_sha256": "b795212e4c5f5be23f78feacef84daea400f2cabba582eef2b7adaeab8775f1d"
      },
      "text": {
        "jp": "はい。私も気になりました。\r\nそれと、彼らは私……というより、\r\n守り人に何か思うところがありそうでした……。",
        "official_en": "That caught my attention as well. It also seemed as though she harbors some enmity—not toward me personally, but toward the Wardens.",
        "real_en": "Yes, I thought so too. And they seemed to have a problem with Wardens in general, rather than with me personally..."
      },
      "review": {
        "status": "CHANGE"
      },
