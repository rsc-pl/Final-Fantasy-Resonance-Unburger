    {
      "record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_014:6e7b6b07",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C03_Mercedes_03",
        "key": "SubEv_C03_Mercedes_03_014",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_014:6e7b6b07",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_014:6e7b6b07",
        "jp_sha256": "084ae4805940fb866c712f9b5eea70f06f8237a89ca7b81fd252c1379e968e68",
        "official_en_sha256": "8b71dfd1561d191f203f0831794d1cd944c9ef2cd38fece5fbcbb336de78e21d"
      },
      "text": {
        "jp": "さ！　船の準備ができたみたいだ。\r\nアタイらはここで失礼するよ。",
        "official_en": "Welp, ya done all the talkin’ ya wanted, and looks like my ship’s ready ta sail. Later, landlubber!",
        "real_en": "Well, looks like the ship's ready. We'll be taking our leave now."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C03_Mercedes_03",
