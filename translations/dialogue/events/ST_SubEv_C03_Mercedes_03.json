    {
      "record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_003:6ab53905",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C03_Mercedes_03",
        "key": "SubEv_C03_Mercedes_03_003",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_003:6ab53905",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_003:6ab53905",
        "jp_sha256": "de574865aa37f667a7cd2da31973ea2eb6feafa945473da1ee109ca6f7420342",
        "official_en_sha256": "93a2aa6db66db6c1581a461f1b77585cd7de41f8f404015bc419dd94cb1adbea"
      },
      "text": {
        "jp": "うちの船員……ということは\r\nあなたが船長ですね。",
        "official_en": "“My boys”? I assume that means you are their captain.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
