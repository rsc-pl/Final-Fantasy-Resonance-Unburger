    {
      "record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_001:d94846f4",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C03_Mercedes_03",
        "key": "SubEv_C03_Mercedes_03_001",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_001:d94846f4",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_001:d94846f4",
        "jp_sha256": "87f51d1389d4fe40a3072168737860042796b9a3cd3679c6423903204724bd12",
        "official_en_sha256": "64a008235c15e7b5af5805fb0468abc95b06a50b7171fd723a9985dd7834f521"
      },
      "text": {
        "jp": "あなた達がメルセデス海賊団で\r\n間違いないですね？",
        "official_en": "You are Mercedes Pirates, are you not?",
        "real_en": null
      },
      "review": {
