    {
      "record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_010:6c3e733b",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C03_Mercedes_03",
        "key": "SubEv_C03_Mercedes_03_010",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_010:6c3e733b",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_010:6c3e733b",
        "jp_sha256": "cf7fb99a47ba9447d238e5e4664f546b164293153ca72e48f2a3a9226ad1f84f",
        "official_en_sha256": "128c5f013aecefc660191412bf97d6f820512c415009cc81e27e9e6b1064e33b"
      },
      "text": {
        "jp": "はんッ！\r\nくだらないね！",
        "official_en": "HA! Ya got barnacles in yer brain, Warden?",
        "real_en": "Hah! What a load of nonsense!"
      },
