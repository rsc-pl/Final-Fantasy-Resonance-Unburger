        "jp_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_004:ea4d4825",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_004:ea4d4825",
        "jp_sha256": "2a9065eebdd091424cf016ae58e39e524aab395bcfb4a5736b9ffe63ee520b51",
        "official_en_sha256": "ced6bee6ee357bc9434e5a8bd399432af30165d28a899637d1f1e9a461372329"
      },
      "text": {
        "jp": "ああ。\r\nアタイがメルセデス海賊団の船長……\r\nメルセデスだ。",
        "official_en": "Aye, I’m Mercedes. Captain of the—ya guessed it—Mercedes Pirates.",
        "real_en": "Yeah. I'm Mercedes, captain of the Mercedes Pirates."
      },
      "review": {
        "status": "CHANGE"
      },
