          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_009:64aed298",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C03_Mercedes_03",
        "key": "SubEv_C03_Mercedes_03_009",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_009:64aed298",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_009:64aed298",
        "jp_sha256": "1b4436b7103ad2e6500817e18942d325fb6f38e25cb8f0c7547796c9ba9c5a35",
        "official_en_sha256": "07b95a29713e625da6a2f27ce34152b32edf676dc29cbc14e782d884f3f3400b"
      },
      "text": {
        "jp": "そうですね……。\r\n単刀直入に言いますが……\r\n海賊行為をやめていただきたい。",
        "official_en": "I see your logic, but I have a duty to uphold.\r\nI will get straight to the point: I am here so that we may discuss ceasing your piracy.",
        "real_en": "I see... I'll be direct. I want you to stop your piracy."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C03_Mercedes_03",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ニコル",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0067",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C03_Mercedes_03/SubEv_C03_Mercedes_03_009"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_008:24272e7f",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C03_Mercedes_03",
        "key": "SubEv_C03_Mercedes_03_008",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_008:24272e7f",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_008:24272e7f",
        "jp_sha256": "49c3fb6ec4b272ad11cf356e92e892995b2e5fb356c03d26f3d3c14cc1e04227",
        "official_en_sha256": "908175938d92e9ef3b17f01073d03eed6532298495a26141dd94840d29367e18"
      },
      "text": {
        "jp": "だが、守り人さんがアタイら海賊に用だなんて\r\nろくなことじゃないに決まってる。\r\n襲われても仕方ないだろう？",
        "official_en": "But Wardens don’t usually approach us pirates for some friendly tea and cake—so ya hafta ’scuse us for not rollin’ out the red carpet.",
        "real_en": "But when a Warden comes lookin' for us pirates,\r\nthere's no way it's good news.\r\nCan't blame us for attackin', can ya?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C03_Mercedes_03",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "メルセデス",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0174",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_SubEv_C03_Mercedes_03/SubEv_C03_Mercedes_03_008"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_005:db18e54d",
      "source": {
        "set": "set-02",
        "namespace": "ST_SubEv_C03_Mercedes_03",
        "key": "SubEv_C03_Mercedes_03_005",
        "jp_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_005:db18e54d",
        "official_en_record_id": "switch:locres:set-02:ST_SubEv_C03_Mercedes_03:SubEv_C03_Mercedes_03_005:db18e54d",
        "jp_sha256": "34f2bddc6426190f62c5036065c4e79ab10ba4394ca5f8ce698fdbcbbbfc55be",
        "official_en_sha256": "b6bd80a493c9e348c4e278b1e169b365cb8c5d150519811b68fd4be200e7584d"
      },
      "text": {
        "jp": "で、のこのこやってきて、なんの用だい？\r\nいますぐに、\r\n船員たちのお礼をしてもいいんだが？",
        "official_en": "So what d’ya want, saunterin’ up like some sea slug? I’ve half a mind to give ya some payback for roughhousin’ my boys, ya know?",
        "real_en": "So what brings you wandering in here? I could pay you back for what you did to my crew right now, you know."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_SubEv_C03_Mercedes_03",
