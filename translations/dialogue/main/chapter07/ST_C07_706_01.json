        "official_en_sha256": "cf6d9cc6bfa7644ad561871dd4f6f1415e10e25198c311c43051c9640780ffd3"
      },
      "text": {
        "jp": "あなたは昔から\r\nよく私の真似をしますが、\r\nそれで成功したことがありますか？",
        "official_en": "You’ve always tried to mirror me, but tell me...has that ever worked in your favor?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
