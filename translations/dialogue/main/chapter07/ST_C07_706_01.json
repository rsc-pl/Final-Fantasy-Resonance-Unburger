    {
      "record_id": "switch:locres:set-02:ST_C07_706_01:706_01_010:b9a941f2",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_706_01",
        "key": "706_01_010",
        "jp_record_id": "switch:locres:set-02:ST_C07_706_01:706_01_010:b9a941f2",
