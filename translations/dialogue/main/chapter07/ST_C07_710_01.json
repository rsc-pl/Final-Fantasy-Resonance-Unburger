      },
      "text": {
        "jp": "あなたもすぐに送ってあげるわ！\r\n弟のいるところにね！",
        "official_en": "I’ve been just dying to send you off—off to join your little brother!",
        "real_en": "I'll send you to join your younger brother soon enough!"
      },
      "review": {
        "status": "CHANGE"
