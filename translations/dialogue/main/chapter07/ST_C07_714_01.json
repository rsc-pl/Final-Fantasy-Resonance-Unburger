    {
      "record_id": "switch:locres:set-02:ST_C07_714_01:714_01_006:6f37bffa",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_714_01",
        "key": "714_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C07_714_01:714_01_006:6f37bffa",
        "official_en_record_id": "switch:locres:set-02:ST_C07_714_01:714_01_006:6f37bffa",
        "jp_sha256": "80c53ba8f219a9b4cb5e77b30542e1060a0e9b212f8f3129cd4205077dd5910e",
        "official_en_sha256": "12e929fe0685a9757245d647c6246dc77bde20eb86fa4de1180eef4b76318bd3"
      },
      "text": {
        "jp": "美しい生き様を描けなくて\r\nなんのための命か。",
        "official_en": "After all...what life is worth living if you cannot make your mark with honor?",
        "real_en": "What is life for if you can't make something beautiful of the way you live?"
      },
      "review": {
        "status": "CHANGE"
      },
