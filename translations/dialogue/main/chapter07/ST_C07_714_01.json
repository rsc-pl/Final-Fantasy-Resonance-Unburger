        "official_en_sha256": "ea1f2803edccae6eba32ec857e60095cc4cf643fd1a70c52dc4957e60bc737eb"
      },
      "text": {
        "jp": "美学なくして生きる価値なし。",
        "official_en": "Honor...is all.",
        "real_en": "A life without ideals isn't worth living."
      },
