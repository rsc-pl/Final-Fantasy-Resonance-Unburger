      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C07_714_01:714_01_004:033e6b2f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_714_01",
        "key": "714_01_004",
        "jp_record_id": "switch:locres:set-02:ST_C07_714_01:714_01_004:033e6b2f",
