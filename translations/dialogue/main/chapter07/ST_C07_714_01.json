        "official_en_sha256": "36a5dd7c9c1ccec894fc4c5cc420794e443ee1a02cf2602d96ae960facd8b4a9"
      },
      "text": {
        "jp": "たとえ全てを失おうと、\r\nこの一瞬に全てを懸ける。",
        "official_en": "Even if everything may be lost, I must risk it all in this one glorious charge.",
        "real_en": "Even if I lose everything, I'll stake it all on this one moment."
      },
      "review": {
        "status": "CHANGE"
