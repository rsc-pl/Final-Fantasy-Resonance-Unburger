        "official_en_sha256": "045c9c658581c970e2d6816eb2e245af5030fabba639c8db7d7eb237910b7d2b"
      },
      "text": {
        "jp": "王土のパワーが上がっている！？",
        "official_en": "Wait, did he just get stronger!?",
        "real_en": "Sovereign Earth Veritas is getting stronger!?"
      },
