          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C07_717_01:717_01_015:786922e1",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_717_01",
        "key": "717_01_015",
        "jp_record_id": "switch:locres:set-02:ST_C07_717_01:717_01_015:786922e1",
