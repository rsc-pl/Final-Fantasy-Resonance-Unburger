    {
      "record_id": "switch:locres:set-02:ST_C07_717_01:717_01_006:6ea2167f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_717_01",
        "key": "717_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C07_717_01:717_01_006:6ea2167f",
        "official_en_record_id": "switch:locres:set-02:ST_C07_717_01:717_01_006:6ea2167f",
        "jp_sha256": "97a0d439234acb1e90da2289e3761d5bf1ee4df68d9a004c36da7d255fef3e95",
        "official_en_sha256": "fba6cdfb313d37852c91464bce6e0d4ba0f23346f05587d12d5f035e41472bf4"
      },
      "text": {
        "jp": "悲願を成すためには邪魔な存在だというのに……。\r\nなぜだろうな。\r\n俺はお前と戦えるのが嬉しくて仕方がない。",
        "official_en": "It is strange...\r\nYou’ve been a hindrance to our goals for so long... And yet, why do I feel such joy in the prospect of fighting you?",
        "real_en": "You stand in the way of the dream we've cherished for so long... So why am I so happy to fight you?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C07_717_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
