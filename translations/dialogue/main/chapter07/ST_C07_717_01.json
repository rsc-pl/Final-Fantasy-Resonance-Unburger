        "official_en_sha256": "53712b4664fc51855d679943cacc7ce8b395d7fc079ff9a946f4ecfe93a45aff"
      },
      "text": {
        "jp": "さあ、こい！　これが俺の全力！\r\n持てる力の全てだ！",
        "official_en": "Now, come! I’ll face you with all the powers at my disposal. Every ounce of my might!",
        "real_en": null
