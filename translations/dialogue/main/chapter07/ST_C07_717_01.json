    {
      "record_id": "switch:locres:set-02:ST_C07_717_01:717_01_008:dee7438e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_717_01",
        "key": "717_01_008",
        "jp_record_id": "switch:locres:set-02:ST_C07_717_01:717_01_008:dee7438e",
        "official_en_record_id": "switch:locres:set-02:ST_C07_717_01:717_01_008:dee7438e",
        "jp_sha256": "6ac5d94aa016388b8ee5bbcb47ad2d72ef78ce578c0060cf5c5fa53a362349c9",
        "official_en_sha256": "afc717f8261d7b6cb36947dfb772381a36b65902361a75871bc951926176cae3"
      },
      "text": {
        "jp": "こいつには負けたくない。\r\nそんな気持ちになったのは、ラスウェルと父さん……。\r\nそして常闇、お前だけだ。",
        "official_en": "There are very few people I can’t bear the thought of being outshone by: Lasswell, my old man...and now you, Umbra.",
        "real_en": "There are only three people I've ever felt I couldn't bear to lose to: Lasswell, Dad... and you, Veritas of the Dark."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
