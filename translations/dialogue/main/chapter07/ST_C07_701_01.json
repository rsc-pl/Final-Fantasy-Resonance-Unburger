        "official_en_sha256": "480448a9c83e9364f18160ea69d7032ded5ead30edcdccf652d1d40549775db7"
      },
      "text": {
        "jp": "妻と子は戦士ではないから\r\n俺たちのような肉体改造を受けていない。\r\nその意味がわかるか？",
        "official_en": "My wife and child were not warriors. They were not given the same physical alterations as us. Do you understand what that means?",
        "real_en": null
      },
