    {
      "record_id": "switch:locres:set-02:ST_C07_701_01:701_01_023:036834d1",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_701_01",
        "key": "701_01_023",
        "jp_record_id": "switch:locres:set-02:ST_C07_701_01:701_01_023:036834d1",
