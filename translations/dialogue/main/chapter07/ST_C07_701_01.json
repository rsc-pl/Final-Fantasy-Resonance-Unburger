    {
      "record_id": "switch:locres:set-02:ST_C07_701_01:701_01_015:f8b04717",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_701_01",
        "key": "701_01_015",
        "jp_record_id": "switch:locres:set-02:ST_C07_701_01:701_01_015:f8b04717",
        "official_en_record_id": "switch:locres:set-02:ST_C07_701_01:701_01_015:f8b04717",
        "jp_sha256": "01be85f4f0f70013a6dd69cde10e497c98c2150eeb031dab9e7d88e1f8f04158",
        "official_en_sha256": "5c821775901035e0386531f48b989d387e0752370e463e4bb8cf041da4442fd4"
      },
      "text": {
        "jp": "この世界が滅んでも構わないっていうのなら\r\nどうしてドワーフたちに\r\n飛空艇の技術を教えたりしたの？",
        "official_en": "You say you don’t care if this world is destroyed. So why bother teaching the dwarves about airship technology?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
