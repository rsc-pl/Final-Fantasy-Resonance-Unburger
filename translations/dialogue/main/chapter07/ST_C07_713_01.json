        "key": "713_01_016",
        "jp_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_016:b4034581",
        "official_en_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_016:b4034581",
        "jp_sha256": "21dc0b52e9ebb2edc4cf27b192b22a55dc98b1e9a157cac0a25b035b237cb2d3",
        "official_en_sha256": "3efce7066113e241282886457f753c2ed9730c3b101d7f0a345d4d83c65eaedf"
      },
      "text": {
        "jp": "俺はお前たちからも美学を感じる。",
        "official_en": "I sense from you the same adherence to honor, to which I have dedicated my life.",
        "real_en": "I see that same sense of conviction in all of you."
