          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C07_713_01:713_01_003:978df5ea",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_713_01",
        "key": "713_01_003",
        "jp_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_003:978df5ea",
        "official_en_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_003:978df5ea",
        "jp_sha256": "cab20e160180e4133bee0d8ae94d37cdc2ccea147a5f6110e2349fa30d15b95d",
        "official_en_sha256": "48bb6884d118541ecb0c7ed4f8214b1633a3c896bab39829f4bb264b1377aea7"
      },
      "text": {
        "jp": "この地に落ちて７００年……。\r\n俺は自分の美学を貫いて生きてきたつもりだ。\r\nそこに後悔はない。",
        "official_en": "It’s been seven hundred years since I was cast here...\r\nIn that time, I’ve stayed true to my honor. In that, I have no regrets.",
        "real_en": "It's been seven hundred years since I fell into this world... I've lived by my own ideals all that time. I have no regrets."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C07_713_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "王土のヴェリアス",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0084",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C07_713_01/713_01_003"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C07_713_01:713_01_018:cda56a08",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_713_01",
        "key": "713_01_018",
        "jp_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_018:cda56a08",
        "official_en_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_018:cda56a08",
