      "source": {
        "set": "set-02",
        "namespace": "ST_C07_713_01",
        "key": "713_01_013",
        "jp_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_013:d9b92cea",
        "official_en_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_013:d9b92cea",
