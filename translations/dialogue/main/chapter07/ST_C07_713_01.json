      "source": {
        "set": "set-02",
        "namespace": "ST_C07_713_01",
        "key": "713_01_007",
        "jp_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_007:e7d020b9",
        "official_en_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_007:e7d020b9",
