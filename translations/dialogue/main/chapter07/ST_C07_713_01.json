        "official_en_sha256": "6b9f790514d68a28e9818ea25f49c8f21fe97fce67596f2af95fa8ca4251e581"
      },
      "text": {
        "jp": "だからこそ、ここでお前たちを止めなければならない。",
        "official_en": "And that is why I, Tellus, Veritas of the Earth, must stop you all here and now.",
        "real_en": "That's exactly why I have to stop you here."
      },
