        "official_en_sha256": "c46c2bc964d8a548b12d13e86208eb3353125e9316cca7eb16c963858c4e39c1"
      },
      "text": {
        "jp": "それこそが俺の美学だ。",
        "official_en": "That, for me, is the very essence of honor.",
        "real_en": "That is my ideal of how to live."
      },
      "review": {
