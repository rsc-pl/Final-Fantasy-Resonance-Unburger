        "official_en_sha256": "77dad6b33b776745e0fc40563938b2f7faccaa84e82c12795be4c0d35bf16468"
      },
      "text": {
        "jp": "そうはいかない。\r\n俺たちは何があろうと先に進む。",
        "official_en": "Go on, try. We’ll press on no matter what blocks our path.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
