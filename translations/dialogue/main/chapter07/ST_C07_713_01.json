        "official_en_sha256": "a94f022257174ff9f20ee18c0063791e19ae2ea2e11ea6dcbebc8344bbcdf012"
      },
      "text": {
        "jp": "だったらどうして……？",
        "official_en": "Then why...?",
        "real_en": null
