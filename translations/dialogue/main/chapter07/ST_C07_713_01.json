    {
      "record_id": "switch:locres:set-02:ST_C07_713_01:713_01_017:3b92deda",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_713_01",
        "key": "713_01_017",
        "jp_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_017:3b92deda",
        "official_en_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_017:3b92deda",
