    {
      "record_id": "switch:locres:set-02:ST_C07_713_01:713_01_019:82804244",
      "source": {
        "set": "set-02",
        "namespace": "ST_C07_713_01",
        "key": "713_01_019",
        "jp_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_019:82804244",
        "official_en_record_id": "switch:locres:set-02:ST_C07_713_01:713_01_019:82804244",
        "jp_sha256": "125753000a7bab1a42d9aa4e3fb4b74b903e58703ce407d6ab37bf10cc369f14",
        "official_en_sha256": "5284faed4f4d31fd8124c4009d92be8090b221edfb8711abfb33b4b4b124cf7f"
      },
      "text": {
        "jp": "フッ。\r\nいいだろう。\r\nならば、どちらが美学を貫くか……勝負だ。",
        "official_en": "Ha! Very well. Let us see whose resolve is stronger... To battle!",
        "real_en": "Heh. Very well. Then let's see which of us can stay true to our ideals. Let's fight."
      },
      "review": {
        "status": "CHANGE"
