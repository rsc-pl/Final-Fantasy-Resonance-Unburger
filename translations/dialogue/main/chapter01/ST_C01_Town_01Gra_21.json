    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_025:efa80671",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_21",
        "key": "Town_01Gra_21_025",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_025:efa80671",
