    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_021:c067f471",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_21",
        "key": "Town_01Gra_21_021",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_021:c067f471",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_021:c067f471",
        "jp_sha256": "dbec6000e7cd734e146527bc7cb84364819319b2a0b358df3277896adc90ebb6",
        "official_en_sha256": "ca38d147129f27f7690d7deec3d6250ae2b855736410b2b7f234f7feafd2547c"
      },
      "text": {
        "jp": "おかげで怪我も少なく済んで、\r\nこの通り復興のお手伝いまでできているんです！",
        "official_en": "Because of you, I made it through with hardly a scratch, which means I can help with the reconstruction efforts!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
