    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_060:a4ef82e2",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_21",
        "key": "Town_01Gra_21_060",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_060:a4ef82e2",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_060:a4ef82e2",
        "jp_sha256": "6ac31fd396a9efaf3c74da53732c304e999715467f839e509dd90295bd5e25dc",
        "official_en_sha256": "67b01daf6617f1d75ef28ebc9a24db38a6537eb5cd47ff8e2b0c8c7ab8e979ab"
      },
      "text": {
        "jp": "おぉ！　レイン、ラスウェル。\r\n健在なようでなによりだ。",
        "official_en": "Rain! Lasswell! I am glad to see the both of you in good health.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
