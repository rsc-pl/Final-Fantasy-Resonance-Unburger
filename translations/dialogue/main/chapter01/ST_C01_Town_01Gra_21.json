        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_045:68fd271a",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_045:68fd271a",
