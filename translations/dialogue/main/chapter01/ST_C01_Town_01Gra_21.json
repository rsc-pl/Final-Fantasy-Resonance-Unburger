      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_21",
        "key": "Town_01Gra_21_050",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_050:7d26f1c5",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_050:7d26f1c5",
        "jp_sha256": "ce5a355f638848d71832b5c68f77bd1adbab82c7a4c40d2631f6b092a71df22c",
        "official_en_sha256": "7c3ad69481ba6e6885874270669983252d1b3b8bf3de81212efdacf98ada71ca"
      },
      "text": {
        "jp": "また一段と、たくましくなられましたな。\r\n貴方を見ていると、若き時分の王を思い出します。",
        "official_en": "My, how you’ve grown! I must say, you remind me of His Majesty when he was but a youth.",
        "real_en": null
      },
      "review": {
