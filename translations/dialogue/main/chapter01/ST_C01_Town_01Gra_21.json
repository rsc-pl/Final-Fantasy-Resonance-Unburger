    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_056:cfc0b114",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_21",
        "key": "Town_01Gra_21_056",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_056:cfc0b114",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_21:Town_01Gra_21_056:cfc0b114",
