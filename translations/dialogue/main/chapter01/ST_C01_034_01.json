        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_034_01:034_01_009:83940954",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_034_01",
        "key": "034_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C01_034_01:034_01_009:83940954",
        "official_en_record_id": "switch:locres:set-02:ST_C01_034_01:034_01_009:83940954",
