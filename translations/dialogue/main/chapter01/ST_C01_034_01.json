        "official_en_sha256": "8b6bbacccbf17ecf5aca635dfc87a7319aaedb298b4b9dd1f31c615fd2a26b6b"
      },
      "text": {
        "jp": "ここで立ち往生するわけにはいかない。\r\nセイレーンの塔へ行ってみるか。",
        "official_en": "We can’t afford to be stalled here. Let’s head to Siren’s Tower.",
        "real_en": null
