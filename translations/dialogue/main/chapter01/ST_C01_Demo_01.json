        "official_en_sha256": "c590786cc7c11910db180d27b057958ee3aa56869618eef8a51ec15bafee52ee"
      },
      "text": {
        "jp": "できる限りのことはしてきたつもりじゃが、\r\nそれでもダメじゃったか……。",
        "official_en": "I’ve done everything I can; alas, ’tis not enough...",
        "real_en": "I thought I'd done everything I could, but even that wasn't enough..."
      },
