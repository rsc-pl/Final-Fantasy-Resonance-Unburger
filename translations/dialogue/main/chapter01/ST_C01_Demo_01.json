    {
      "record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_014:92029708",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Demo_01",
        "key": "Demo_01_014",
        "jp_record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_014:92029708",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_014:92029708",
        "jp_sha256": "187034c040e9494f5bd7384f237565e3d788af866d0902abb8b86991f051f072",
        "official_en_sha256": "6554622f25b21dde310b293da4349ba2312aff7786fac7c5141c2f92df41cc7f"
      },
      "text": {
        "jp": "ん？　これはこれは。\r\n美しいお嬢さん。",
        "official_en": "Well, hello there... Aren’t you the cutest little cupcake?",
        "real_en": "Hm? Well, well.\r\nWhat a beautiful young lady."
