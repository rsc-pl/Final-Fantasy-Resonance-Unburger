    {
      "record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_018:3e71b35d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Demo_01",
        "key": "Demo_01_018",
        "jp_record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_018:3e71b35d",
