    {
      "record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_006:c1959b31",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Demo_01",
        "key": "Demo_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_006:c1959b31",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_006:c1959b31",
        "jp_sha256": "cdcfc406365b0cfdea71de066c4d5c96d3b99777421130ab3cdc27bb71340971",
        "official_en_sha256": "ec1a93057fc1704e841bb6624efbd857a9cd9cd8e6ca1dffba8e8875c71d66a3"
      },
      "text": {
        "jp": "ご苦労さまです。\r\nあなたたちは水の洞窟へいき\r\n水の巫女の警護にあたってください。",
        "official_en": "I have orders for you. You are to go to the Cave of Waters and protect the Water Maiden.",
        "real_en": "Thank you for your service. Head to the Cave of Waters and guard the Water Maiden."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
