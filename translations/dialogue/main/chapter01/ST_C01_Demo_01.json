        "official_en_sha256": "8928dea3c0bcbabf75be154fe6567587e14cb849fd38e6be8ea2891a873c7c61"
      },
      "text": {
        "jp": "さて、どうしたものか……。",
        "official_en": "How are we to overcome this nightmare...?",
        "real_en": "Now, what should I do...?"
      },
      "review": {
