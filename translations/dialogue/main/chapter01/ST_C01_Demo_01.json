        "jp_sha256": "2f3780584668189505dac2ccc5f017d7f36fd7d1b6aad97de995488209683b94",
        "official_en_sha256": "bed83fc1adc90923de5a17d08f3e2b84c16255c3b3fed441a38652647d1f1362"
      },
      "text": {
        "jp": "そのための犠牲は厭わない。\r\n立ち塞がる者は、全て斬り捨てるのみ。",
        "official_en": "We will stop at nothing. Any and all that stand in our way, will be cut down by my blade—no sacrifice too great.",
        "real_en": "We won't shrink from any sacrifice.\nAnyone who stands in our way will be cut down."
      },
      "review": {
        "status": "CHANGE"
      },
