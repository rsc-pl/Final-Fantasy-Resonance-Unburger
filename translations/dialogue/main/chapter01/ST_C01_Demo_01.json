    {
      "record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_002:45e48a5d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Demo_01",
        "key": "Demo_01_002",
        "jp_record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_002:45e48a5d",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_002:45e48a5d",
        "jp_sha256": "6bfe207e3cf545caff5d6fdb10e56d97519d1c24e5d43493672f8c4ded5a437f",
        "official_en_sha256": "3e02d0aeeb8d3ee12bf5902f99070010e43e2ddee64151b4155a30b2b3332dc5"
      },
      "text": {
        "jp": "アタシの飛空艇、このままじゃちゃんと飛ばないかも……。\r\nやっぱり、風の神殿まで行かないとダメか。",
        "official_en": "It looks like my airship isn’t going anywhere like this... I’m gonna have to go to the Wind Shrine after all.",
        "real_en": "My airship might not fly properly like this...\nLooks like I'll have to go to the Wind Shrine after all."
      },
      "review": {
        "status": "CHANGE"
      },
