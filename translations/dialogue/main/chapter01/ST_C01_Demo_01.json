      },
      "text": {
        "jp": "あ、ごめんなさい！\r\nぶつかってしまって……。",
        "official_en": "Oh, I’m sorry! I didn’t mean to—",
        "real_en": "Oh, I'm sorry!\nI bumped into you..."
