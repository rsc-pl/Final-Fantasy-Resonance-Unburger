        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_024:c5b0c84c",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Demo_01",
        "key": "Demo_01_024",
        "jp_record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_024:c5b0c84c",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_024:c5b0c84c",
        "jp_sha256": "32ef39c7db7db045aba126ebbc3e8671ba5bf0816e5bfe49fd4405599e2d1c27",
        "official_en_sha256": "ff03927b5455d3fed866bb62527b6e4b3332fa4e43f52adc33ef0f95b130d47a"
      },
      "text": {
        "jp": "さぁ、始めるとしようか。\r\n古き因縁と決別を果たす戦いを……！",
        "official_en": "Let us begin—the battle to free us from our eternal enmity!",
        "real_en": "Now, let us begin...\nThe battle to put our old grudge behind us!"
      },
      "review": {
        "status": "CHANGE"
      },
