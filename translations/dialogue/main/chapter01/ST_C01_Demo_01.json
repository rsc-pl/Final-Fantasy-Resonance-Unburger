    {
      "record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_022:147b3019",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Demo_01",
        "key": "Demo_01_022",
        "jp_record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_022:147b3019",
