    {
      "record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_009:8766f6b8",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Demo_01",
        "key": "Demo_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C01_Demo_01:Demo_01_009:8766f6b8",
