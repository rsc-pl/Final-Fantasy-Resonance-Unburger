          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_011_01:011_01_013:574fc9c5",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_011_01",
        "key": "011_01_013",
        "jp_record_id": "switch:locres:set-02:ST_C01_011_01:011_01_013:574fc9c5",
        "official_en_record_id": "switch:locres:set-02:ST_C01_011_01:011_01_013:574fc9c5",
        "jp_sha256": "47ebbf678a02e954c3e6bc5058a938c7f9bdd4b7c4aefb5368f03fe344dd1454",
        "official_en_sha256": "11a7819c950fa25b80b4bb1dc83ee18cf73a9e9560791018a128f5f5d47dca74"
      },
      "text": {
        "jp": "なんだって？",
        "official_en": "Wait, did he...?",
        "real_en": "What did you say?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_011_01",
