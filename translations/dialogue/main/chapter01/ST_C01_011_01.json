        "jp_record_id": "switch:locres:set-02:ST_C01_011_01:011_01_001:0faefafe",
        "official_en_record_id": "switch:locres:set-02:ST_C01_011_01:011_01_001:0faefafe",
        "jp_sha256": "8d83123b0b843cbe10fbef866fcd588bf648e042942c14121c3273c1452efcb1",
        "official_en_sha256": "5836e84fcd140c4383ffe5628e6e3275f19669926622ac01da193a8bdd4a73f9"
      },
      "text": {
        "jp": "……懐かしいな。",
        "official_en": "...It’s been a while since we’ve been back home.",
        "real_en": "...This brings back memories."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
