        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_011_01:011_01_016:79967b83",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_011_01",
        "key": "011_01_016",
        "jp_record_id": "switch:locres:set-02:ST_C01_011_01:011_01_016:79967b83",
        "official_en_record_id": "switch:locres:set-02:ST_C01_011_01:011_01_016:79967b83",
        "jp_sha256": "82f7a1e8fa955fa33c18eac81197a291fbe067ee005b33d409fae72ae9828fd6",
        "official_en_sha256": "ab7f19fdf9620957d67020bece1ced96109f6bb8186eb9e1b37aa7f8bf89be90"
      },
      "text": {
        "jp": "鍵を使う場所なら心当たりがある。\r\n行こう、俺たちが暮らしていた家に。",
        "official_en": "I don’t know, but I have an idea where this key fits. Let’s head there...our old home.",
        "real_en": "I think I know where to use this key. Come on, let’s go to the house where we used to live."
