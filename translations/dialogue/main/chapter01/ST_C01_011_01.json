    {
      "record_id": "switch:locres:set-02:ST_C01_011_01:011_01_002:2ea6990d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_011_01",
        "key": "011_01_002",
        "jp_record_id": "switch:locres:set-02:ST_C01_011_01:011_01_002:2ea6990d",
        "official_en_record_id": "switch:locres:set-02:ST_C01_011_01:011_01_002:2ea6990d",
        "jp_sha256": "52af9d09a6632a60844bf7be455c24651c6e51e60940d6968e9d1da0d66f0f23",
        "official_en_sha256": "8efcb5d736a8ffd0b93e0592abc9b65a1b538144fc79a6a02fbbc0e8cb7507ab"
      },
      "text": {
        "jp": "ああ、俺たちの生まれ育った町だ。",
        "official_en": "It has indeed.",
        "real_en": "Yeah. This is the town where we were born and raised."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
