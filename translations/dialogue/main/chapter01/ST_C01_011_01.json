          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_011_01:011_01_003:9375efc5",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_011_01",
        "key": "011_01_003",
        "jp_record_id": "switch:locres:set-02:ST_C01_011_01:011_01_003:9375efc5",
        "official_en_record_id": "switch:locres:set-02:ST_C01_011_01:011_01_003:9375efc5",
        "jp_sha256": "3170144d2c685f30d396209a79ec8387b7db6a2cbb1300f69bde7bb0c9cce6a7",
        "official_en_sha256": "1e692bf5c0796899c4a38a32025e5b3aaf4f9922918b8f96460083fd199718e4"
      },
      "text": {
        "jp": "あいつがいなくなったせいで\r\nこの町を出ることになったんだよな。",
        "official_en": "If that deadbeat hadn’t disappeared on us, we could have stayed.",
        "real_en": "We had to leave this town because he disappeared, didn’t we?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
