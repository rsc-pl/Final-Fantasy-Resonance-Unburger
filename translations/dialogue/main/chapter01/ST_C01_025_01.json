        "official_en_sha256": "73e97dd0bf80988a22170786c10a8bf730d178b52526c7378bd3000c91517052"
      },
      "text": {
        "jp": "お母さんが誕生日なのに\r\n帰ってこないから\r\nお花をプレゼントにして持って行こうと思って。",
        "official_en": "It’s my mommy’s birthday, but she hasn’t come home yet. I want to give her some flowers as a present.",
        "real_en": "It's Mom's birthday, but she hasn't come home. I thought I'd bring her some flowers as a present."
      },
      "review": {
        "status": "CHANGE"
