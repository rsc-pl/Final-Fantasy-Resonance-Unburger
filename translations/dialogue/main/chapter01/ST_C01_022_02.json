    {
      "record_id": "switch:locres:set-02:ST_C01_022_02:022_02_004:04b626c1",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_022_02",
        "key": "022_02_004",
        "jp_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_004:04b626c1",
        "official_en_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_004:04b626c1",
        "jp_sha256": "e2f1e474fe57aa82aa190bf03e5c01b0766ad3c897ea4c7266bdd9808698d13e",
        "official_en_sha256": "e2f1e474fe57aa82aa190bf03e5c01b0766ad3c897ea4c7266bdd9808698d13e"
      },
      "text": {
        "jp": "へぇー。\r\n人助けもできて、お礼ももらえるなんて\r\nとってもオトクだね！",
        "official_en": "へぇー。\r\n人助けもできて、お礼ももらえるなんて\r\nとってもオトクだね！",
        "real_en": "Wow! We can help people and get rewarded for it? That's a great deal!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_022_02",
        "sequence": null,
