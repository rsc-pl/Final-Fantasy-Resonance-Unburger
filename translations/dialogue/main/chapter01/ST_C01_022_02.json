        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_022_02:022_02_009:12f4eb1e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_022_02",
        "key": "022_02_009",
        "jp_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_009:12f4eb1e",
        "official_en_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_009:12f4eb1e",
        "jp_sha256": "90ddfb768d916511082f8f0110d6552547bc1c76ece3ececed2c3adc00b9ef58",
        "official_en_sha256": "90ddfb768d916511082f8f0110d6552547bc1c76ece3ececed2c3adc00b9ef58"
      },
      "text": {
        "jp": "依頼の達成報告や取り消しは\r\nどの町の掲示板からもできるんだったよな。",
        "official_en": "依頼の達成報告や取り消しは\r\nどの町の掲示板からもできるんだったよな。",
        "real_en": "We can report completed requests or cancel them at any town's board, right?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_022_02",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": null,
          "label_status": "UNKNOWN",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": []
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_022_02:022_02_008:b674e05a",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_022_02",
        "key": "022_02_008",
        "jp_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_008:b674e05a",
        "official_en_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_008:b674e05a",
        "jp_sha256": "d3499b186eded99dac81cc2b0da7bad4b6ac3de4f5872b84dd0b2ea028946676",
        "official_en_sha256": "d3499b186eded99dac81cc2b0da7bad4b6ac3de4f5872b84dd0b2ea028946676"
      },
      "text": {
        "jp": "受ける順序を考えたり、\r\n達成したものをこまめに報告したりすることも必要だ。",
        "official_en": "受ける順序を考えたり、\r\n達成したものをこまめに報告したりすることも必要だ。",
        "real_en": "We'll need to think about which requests to take first and report back regularly as we complete them."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
