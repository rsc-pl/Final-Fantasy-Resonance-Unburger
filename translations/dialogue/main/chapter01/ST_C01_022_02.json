    {
      "record_id": "switch:locres:set-02:ST_C01_022_02:022_02_003:058d5534",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_022_02",
        "key": "022_02_003",
        "jp_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_003:058d5534",
        "official_en_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_003:058d5534",
        "jp_sha256": "cbecc2a6ba06c9f17c8ddc910c5679a0addad02c04e904a6df222d868dd9b2bd",
        "official_en_sha256": "cbecc2a6ba06c9f17c8ddc910c5679a0addad02c04e904a6df222d868dd9b2bd"
      },
      "text": {
        "jp": "掲示板から依頼を受けて\r\n指定された魔物を討伐すれば報酬がもらえる。",
        "official_en": "掲示板から依頼を受けて\r\n指定された魔物を討伐すれば報酬がもらえる。",
        "real_en": "Accept a request from the board and defeat the specified monsters, and you'll receive a reward."
      },
      "review": {
        "status": "CHANGE"
      },
