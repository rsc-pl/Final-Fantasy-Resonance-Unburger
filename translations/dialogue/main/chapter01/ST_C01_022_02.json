    {
      "record_id": "switch:locres:set-02:ST_C01_022_02:022_02_006:363efd22",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_022_02",
        "key": "022_02_006",
        "jp_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_006:363efd22",
        "official_en_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_006:363efd22",
        "jp_sha256": "c6662312af13b96e4580d9b5fd20c8a3e4547a66de3adb82a471d0fda9666cca",
        "official_en_sha256": "c6662312af13b96e4580d9b5fd20c8a3e4547a66de3adb82a471d0fda9666cca"
      },
      "text": {
        "jp": "私たちもやってみない？\r\nお願いをたくさん叶えたら、町も安全になるんだもんね。",
        "official_en": "私たちもやってみない？\r\nお願いをたくさん叶えたら、町も安全になるんだもんね。",
        "real_en": "Why don't we give it a try, too? The more requests we fulfill, the safer the town will be!"
      },
      "review": {
        "status": "CHANGE"
      },
