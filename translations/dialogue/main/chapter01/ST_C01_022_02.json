    {
      "record_id": "switch:locres:set-02:ST_C01_022_02:022_02_002:7c2ba34b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_022_02",
        "key": "022_02_002",
        "jp_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_002:7c2ba34b",
        "official_en_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_002:7c2ba34b",
        "jp_sha256": "cb1601b5d9f2c2baea1e355c903a4a491b771d339883463071bc8af11c5deef7",
        "official_en_sha256": "cb1601b5d9f2c2baea1e355c903a4a491b771d339883463071bc8af11c5deef7"
      },
      "text": {
        "jp": "それは「討伐掲示板」だな。\r\n周辺に出る魔物を倒してほしいって\r\n依頼が書かれてるんだ。",
        "official_en": "それは「討伐掲示板」だな。\r\n周辺に出る魔物を倒してほしいって\r\n依頼が書かれてるんだ。",
        "real_en": "That's a monster-hunt board. It has requests to defeat monsters found in the surrounding area."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_022_02",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": null,
          "label_status": "UNKNOWN",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": []
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_022_02:022_02_007:ca2bed4b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_022_02",
        "key": "022_02_007",
        "jp_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_007:ca2bed4b",
        "official_en_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_007:ca2bed4b",
        "jp_sha256": "2518f4eb708379878100ba64e92fd6947209758a1145a27d665a5a4ff89dd26a",
        "official_en_sha256": "2518f4eb708379878100ba64e92fd6947209758a1145a27d665a5a4ff89dd26a"
      },
      "text": {
        "jp": "それはそうだが、依頼は一度に１０件までしか\r\n受けられないからな。",
        "official_en": "それはそうだが、依頼は一度に１０件までしか\r\n受けられないからな。",
        "real_en": "True, but we can only accept up to ten requests at a time."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
