    {
      "record_id": "switch:locres:set-02:ST_C01_022_02:022_02_001:d0f98ae0",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_022_02",
        "key": "022_02_001",
        "jp_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_001:d0f98ae0",
        "official_en_record_id": "switch:locres:set-02:ST_C01_022_02:022_02_001:d0f98ae0",
        "jp_sha256": "6d37ebac8c58ecfef22f82e676c80104480ee00cf02e0332bce0bcf96adbbe5c",
        "official_en_sha256": "6d37ebac8c58ecfef22f82e676c80104480ee00cf02e0332bce0bcf96adbbe5c"
      },
      "text": {
        "jp": "ねえ、レイン。\r\nこれは何？\r\n紙がたくさん貼ってあるよ！",
        "official_en": "ねえ、レイン。\r\nこれは何？\r\n紙がたくさん貼ってあるよ！",
        "real_en": "Hey, Rain, what's this? There are so many notices posted!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_022_02",
