    {
      "record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_026:75ba91e0",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_004_01_B",
        "key": "004_01_B_026",
        "jp_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_026:75ba91e0",
        "official_en_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_026:75ba91e0",
