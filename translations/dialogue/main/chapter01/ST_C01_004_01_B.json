          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C01_004_01_B/004_01_B_028"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_018:f1012945",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_004_01_B",
        "key": "004_01_B_018",
        "jp_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_018:f1012945",
        "official_en_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_018:f1012945",
        "jp_sha256": "9f35168c75748cff999e1752ec4771130eacaad3143b40c98bed97e771edcddb",
        "official_en_sha256": "35098f1821b77b9d893108af4701d49f13c35ad0e6dacfed7840500dd8e9d9fd"
      },
      "text": {
        "jp": "いいや、お前だ。\r\n俺が言うんだ。間違いない。",
        "official_en": "No, that’s you, not I. I say this with unclouded confidence.",
        "real_en": "No, that’s you. I’m saying it, so it must be true."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
