          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C01_004_01_B/004_01_B_016"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_020:a1dc8b67",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_004_01_B",
        "key": "004_01_B_020",
        "jp_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_020:a1dc8b67",
        "official_en_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_020:a1dc8b67",
