    {
      "record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_009:f2ffc270",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_004_01_B",
        "key": "004_01_B_009",
        "jp_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_009:f2ffc270",
        "official_en_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_009:f2ffc270",
