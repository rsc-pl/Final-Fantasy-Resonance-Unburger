    {
      "record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_011:31f9f54e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_004_01_B",
        "key": "004_01_B_011",
        "jp_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_011:31f9f54e",
        "official_en_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_011:31f9f54e",
        "jp_sha256": "3367850be344fa1d75b3c868f328c1abef165a53cd650410046898480122bde3",
        "official_en_sha256": "34ae51264f668d7f7d0646d6b971ac536b15bd96c512054d0316f1f6e327ae2b"
      },
      "text": {
        "jp": "お前、人の話を聞いてないだろ。",
        "official_en": "Everything just goes in one ear and out the other with you, doesn’t it?",
        "real_en": "You haven’t been listening to a word I’ve said, have you?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_004_01_B",
