      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_016:67cbae2c",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_004_01_B",
        "key": "004_01_B_016",
        "jp_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_016:67cbae2c",
        "official_en_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_016:67cbae2c",
        "jp_sha256": "d609c540c769a99527a63e81b9007efc7d0d48c78f40ae3d68c7ac21495856cd",
        "official_en_sha256": "211b4c37f49e42d8a3fde809acc4780cbf4255f135aa803d750b358d935c83c4"
      },
      "text": {
        "jp": "お前はグランシェルトの騎士の中でも\r\nナンバーワンになれる器だ。\r\n鍛錬は欠かさないようにしないとな。",
        "official_en": "No one can deny you have the potential to be Grandshelt’s finest. You just have to make sure that you’re not tardy when it comes to training.",
        "real_en": "You have what it takes to become Grandshelt’s number-one knight. Just don’t neglect your training."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_004_01_B",
