    {
      "record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_024:55c5f0f5",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_004_01_B",
        "key": "004_01_B_024",
        "jp_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_024:55c5f0f5",
        "official_en_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_024:55c5f0f5",
        "jp_sha256": "9cedc59314cdd8fda5cb5207589cf4972c1c0130e310e2390c203ee83d5f23e8",
        "official_en_sha256": "6807f94d0dfdd5c3ad80999c6443a8cf1f6d03800e9a941840be3088b6cc0e39"
      },
      "text": {
        "jp": "ああ、よろしく頼むぜ。",
        "official_en": "That’s the spirit. Good to have you.",
        "real_en": "Yeah. I’m counting on you."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
