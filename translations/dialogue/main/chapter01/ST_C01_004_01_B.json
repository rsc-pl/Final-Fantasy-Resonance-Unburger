      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_005:287434a5",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_004_01_B",
        "key": "004_01_B_005",
        "jp_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_005:287434a5",
        "official_en_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_005:287434a5",
        "jp_sha256": "0d03593e156edbb607f97aeba2074bcdfabed6c2f59d664620fb87ff682cce18",
        "official_en_sha256": "30f4f6529bba2ab8003571f3e9112a7c630d5481b0054a4c8ebc8b6e32b7c9ee"
      },
      "text": {
        "jp": "ありがとな。\r\nその時はよろしく頼むぜ。",
        "official_en": "Thanks. I look forward to that day.",
        "real_en": "Thanks. I'll be counting on you when the time comes."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
