        "official_en_sha256": "3d295b7e68429f2e36932bd264281873fb9c1221ed8e547756a041a461565d77"
      },
      "text": {
        "jp": "みんな、お前に期待しているんだ。\r\nわかってるな？",
        "official_en": "You see that? Everyone’s expecting greatness from you.",
        "real_en": "Everyone is counting on you. You understand that, right?"
      },
