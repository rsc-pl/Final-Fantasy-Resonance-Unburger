      },
      "text": {
        "jp": "ああ、いいよな？　ラスウェル。",
        "official_en": "You’re on. You game too, Lasswell?",
        "real_en": "Sure. Is that all right with you, Lasswell?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
