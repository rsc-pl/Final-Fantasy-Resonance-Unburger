    {
      "record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_028:72fd40eb",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_004_01_B",
        "key": "004_01_B_028",
        "jp_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_028:72fd40eb",
        "official_en_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_028:72fd40eb",
        "jp_sha256": "6fbd6fdf5eb70cd31cecb98ca5280e897a852f998edc4a0e57d9f9f8d823eba3",
        "official_en_sha256": "b1ddeacb21723dedd78bae2cadd6539fab0e71965fa80df8084142a6f43bd471"
      },
      "text": {
        "jp": "ありがとな。\r\n俺一人では部隊は成り立たない。\r\n頼りにさせてもらうぞ。",
        "official_en": "I appreciate it. This is a group effort, so like Lasswell said, I’m counting on you for your support.",
        "real_en": "Thanks. I couldn’t run this squadron on my own. I’ll be counting on you."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_004_01_B",
        "sequence": null,
