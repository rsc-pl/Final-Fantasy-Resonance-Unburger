        "official_en_sha256": "4e789d2070f102e8559fc130d5771f1fa416742945341e53d2bd45b80bb37149"
      },
      "text": {
        "jp": "今日から飛空艇部隊に配属されました。\r\nよろしくお願いします。",
        "official_en": "I’ve been assigned to the airship squadron starting today. Ready to give my all, sir.",
        "real_en": "I’ve been assigned to the airship squadron starting today. I look forward to serving with you."
