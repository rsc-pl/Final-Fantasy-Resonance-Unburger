        "official_en_sha256": "5af1d7a240f297eb8eccd4e7330a600834975d0a32099e7ec0f75c1fe2bc68e7"
      },
      "text": {
        "jp": "はははは。\r\nお前たちはいつも仲がいいな。\r\n本当の兄弟みたいだ。",
        "official_en": "Hahaha. You guys are really close; it’s like you’re actual brothers.",
        "real_en": null
      },
