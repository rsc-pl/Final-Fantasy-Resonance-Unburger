      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_004:82659915",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_004_01_B",
        "key": "004_01_B_004",
        "jp_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_004:82659915",
        "official_en_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_004:82659915",
        "jp_sha256": "625caef9f528001787955988f38ea3d7681e18b182d4b7733f40ebb9c6ae7fbb",
        "official_en_sha256": "6bb66e0ad2a41e55bdece215cec47e79ff36586c4cdafc148b029e9af64c21f8"
      },
      "text": {
        "jp": "いつかレイン隊長の飛空艇部隊に\r\n配備されたいものです。",
        "official_en": "Can I just say, I hope to be placed in your airship unit some day, Commander Rain.",
        "real_en": "I hope I can join Commander Rain’s airship squadron someday."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_004_01_B",
