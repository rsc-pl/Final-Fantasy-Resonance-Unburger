        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_007:06aee4fd",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_004_01_B",
        "key": "004_01_B_007",
        "jp_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_007:06aee4fd",
        "official_en_record_id": "switch:locres:set-02:ST_C01_004_01_B:004_01_B_007:06aee4fd",
        "jp_sha256": "1c51d3ae74d848d074d884c6d7dc8448d584a891ce044a99ffe1c90ee25a1114",
        "official_en_sha256": "6b81e42e3f3aefcfc7b74081d18332a0b07e2adf52cc0dcd6b5ee0f48b22f511"
      },
      "text": {
        "jp": "いやあ、それほどでもないけどね。",
        "official_en": "It’s no big deal, really.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
