      "source": {
        "set": "set-02",
        "namespace": "ST_C01_003_02",
        "key": "003_02_003",
        "jp_record_id": "switch:locres:set-02:ST_C01_003_02:003_02_003:4420135f",
        "official_en_record_id": "switch:locres:set-02:ST_C01_003_02:003_02_003:4420135f",
        "jp_sha256": "d8f4f640f6b3234be0eb33110388f6391f12dcbe5fd5d24cbcf5e43792699a1a",
        "official_en_sha256": "d8f4f640f6b3234be0eb33110388f6391f12dcbe5fd5d24cbcf5e43792699a1a"
      },
