        "namespace": "ST_C01_030_01",
        "key": "030_01_014",
        "jp_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_014:4a149776",
        "official_en_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_014:4a149776",
