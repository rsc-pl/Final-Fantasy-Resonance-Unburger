    {
      "record_id": "switch:locres:set-02:ST_C01_030_01:030_01_025:dde00f09",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_030_01",
        "key": "030_01_025",
        "jp_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_025:dde00f09",
        "official_en_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_025:dde00f09",
        "jp_sha256": "ce298d7e4a94e80d4689594d85980391fd8fb23876cb85b435daafe42bbb7c9e",
        "official_en_sha256": "3f4eb18fc26eb27473e1a34261e71e9260f6a7e4da8649627f24b004b18455a4"
      },
      "text": {
        "jp": "仲間を守るためか何か知りませんが\r\n必死に抵抗したので、さっさと実験に\r\n使ってしまいました。",
        "official_en": "She was fiery, that one. Perhaps she meant to protect her colleagues? Anyway, her resistance meant I had to use her for experiments immediately.",
        "real_en": "I don't know if she was trying to protect her companions, but she resisted so desperately that I used her for an experiment right away."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_030_01",
