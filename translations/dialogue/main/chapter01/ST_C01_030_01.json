        "official_en_sha256": "ba4b70d01c8301f2dd1e5bf0a424e585cb818966c722dd9b6984e102d8274e5b"
      },
      "text": {
        "jp": "神と呼びたければ、どうぞ。\r\n構いませんよ。",
        "official_en": "Call me a god if you wish—an apt title, and one I humbly accept.",
        "real_en": "Call me a god if you like. I don't mind."
