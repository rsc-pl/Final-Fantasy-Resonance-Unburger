    {
      "record_id": "switch:locres:set-02:ST_C01_030_01:030_01_028:43c539fb",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_030_01",
        "key": "030_01_028",
        "jp_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_028:43c539fb",
        "official_en_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_028:43c539fb",
        "jp_sha256": "5bfd3b25263eadaa1ee3dd4a8494bb434303943df566d3e0de1ad3f8dd9bd213",
        "official_en_sha256": "778d64fad9de43cdc1b61b5d30e29ceb3752b3d8fecaa405d72f50e666fd3c4c"
      },
      "text": {
        "jp": "実験の最中も、ずっとこう言っていましたよ。\r\nエマ、ごめんなさい……\r\nエマ、ごめんなさい……ってね。",
        "official_en": "Wouldn’t stop bawling during the procedure either. Nothing but, “Emma, I’m so sorry. I’m so sorry.”",
        "real_en": "Even during the experiment, she kept saying the same thing: 'Emma, I'm sorry... Emma, I'm sorry...'"
      },
      "review": {
        "status": "CHANGE"
      },
