    {
      "record_id": "switch:locres:set-02:ST_C01_030_01:030_01_009:eb384691",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_030_01",
        "key": "030_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_009:eb384691",
        "official_en_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_009:eb384691",
