    {
      "record_id": "switch:locres:set-02:ST_C01_030_01:030_01_018:7148e717",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_030_01",
        "key": "030_01_018",
        "jp_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_018:7148e717",
