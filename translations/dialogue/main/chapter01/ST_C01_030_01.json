    {
      "record_id": "switch:locres:set-02:ST_C01_030_01:030_01_006:7b120c15",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_030_01",
        "key": "030_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_006:7b120c15",
        "official_en_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_006:7b120c15",
