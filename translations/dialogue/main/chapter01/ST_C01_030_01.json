    {
      "record_id": "switch:locres:set-02:ST_C01_030_01:030_01_015:29c5446d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_030_01",
        "key": "030_01_015",
        "jp_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_015:29c5446d",
        "official_en_record_id": "switch:locres:set-02:ST_C01_030_01:030_01_015:29c5446d",
        "jp_sha256": "048880690f377d4672bd94282a0ade9196d8087f7700e907879acc6b71364f6f",
        "official_en_sha256": "92d597f0552532d9c8094eed17d22a1c6a0f2699c057afad8e4acf8b4912ee77"
      },
      "text": {
        "jp": "六盟傑だと……。\r\n奴らはどこにいる！",
        "official_en": "The Sworn Six? Where are they!?",
        "real_en": null
