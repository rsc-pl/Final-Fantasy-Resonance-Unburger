        "official_en_sha256": "8fa68d353144cfd5c9a9e50898288bef7cf8e14a62a81cad7ba8fbe5a1d93b54"
      },
      "text": {
        "jp": "無知であることが罪というならば、\r\nお前たちは全て罪人だ。",
        "official_en": "If ignorance is a sin—you are all guilty.",
        "real_en": "If ignorance is a sin, then every one of you is a sinner."
      },
