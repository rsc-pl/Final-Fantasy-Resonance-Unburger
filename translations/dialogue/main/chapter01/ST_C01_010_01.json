    {
      "record_id": "switch:locres:set-02:ST_C01_010_01:010_01_009:ad20f470",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_010_01",
        "key": "010_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C01_010_01:010_01_009:ad20f470",
        "official_en_record_id": "switch:locres:set-02:ST_C01_010_01:010_01_009:ad20f470",
        "jp_sha256": "5391244c5795ffafea3862505f581d155a356c08c7d0cb38f8e558a9663a4d26",
        "official_en_sha256": "812ea74c1cf49914bb0b5b849fcf99d3857e4bd2dc58f668d324922c42ad1e3c"
      },
      "text": {
        "jp": "さあ、始まりだ。\r\n億万劫の偽りに報復の鉄槌を。",
        "official_en": "...It begins. Retribution for an eternity of lies, exacted with the fall of the blade.",
        "real_en": "Now it begins. Let the hammer of vengeance fall upon an eternity of lies."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_010_01",
        "sequence": null,
        "speaker": {
