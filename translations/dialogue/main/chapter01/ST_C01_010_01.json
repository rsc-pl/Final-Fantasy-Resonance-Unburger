        "jp_record_id": "switch:locres:set-02:ST_C01_010_01:010_01_010:f2bd7ce0",
        "official_en_record_id": "switch:locres:set-02:ST_C01_010_01:010_01_010:f2bd7ce0",
        "jp_sha256": "fe09910689f8ffa47d11ab73f5e26cc1ec76a88161f69ee94b670ce0ac603704",
        "official_en_sha256": "0d6166a62d3f82e706fabd3f8a395015790f587be5b9d345734df31153bfc6a0"
      },
      "text": {
        "jp": "こんなところで……死なせない……。",
        "official_en": "You shall not meet your end here...",
        "real_en": "I won’t let you die here..."
      },
