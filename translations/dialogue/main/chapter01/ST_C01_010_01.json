          "name_entry": "CharaName0001",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C01_010_01/010_01_004"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_010_01:010_01_006:d20994bd",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_010_01",
        "key": "010_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C01_010_01:010_01_006:d20994bd",
        "official_en_record_id": "switch:locres:set-02:ST_C01_010_01:010_01_006:d20994bd",
