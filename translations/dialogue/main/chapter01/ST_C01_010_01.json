    {
      "record_id": "switch:locres:set-02:ST_C01_010_01:010_01_004:f3fbb608",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_010_01",
        "key": "010_01_004",
        "jp_record_id": "switch:locres:set-02:ST_C01_010_01:010_01_004:f3fbb608",
        "official_en_record_id": "switch:locres:set-02:ST_C01_010_01:010_01_004:f3fbb608",
        "jp_sha256": "140d424b174e476b45213dab3108f82fee27341e3b3f839f189cad093f98ab31",
        "official_en_sha256": "871ee03c6b6c4c46910da685d8656ec31553efc1726bfa383b8d94fbea65d15e"
      },
      "text": {
        "jp": "我らが抱きし積年の怨讐を\r\nこの地の者が知るはずもない。",
        "official_en": "I suppose there is no one in this land who knows of the eons of resentment that we bear.",
        "real_en": "No one in this land could know the hatred we’ve harbored for so long."
      },
      "review": {
        "status": "CHANGE"
      },
