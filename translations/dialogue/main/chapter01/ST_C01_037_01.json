    {
      "record_id": "switch:locres:set-02:ST_C01_037_01:037_01_005:b86bfa7c",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_037_01",
        "key": "037_01_005",
        "jp_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_005:b86bfa7c",
        "official_en_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_005:b86bfa7c",
        "jp_sha256": "1ba2b30e52ceff2f27a84502a5aba6d9254b908887fb831ca0c4a7d84ffc9745",
        "official_en_sha256": "635e2b3417c3cd1c18cdf4c0f37e0470cd06b1307babff73d20b98e2d66de68a"
      },
      "text": {
        "jp": "ですが、あなたたちからは力だけではなく\r\n強い信念と覚悟を感じました。",
        "official_en": "But you have shown me this strength—and the extent of your conviction.",
        "real_en": "But I sensed not only strength in you, but also firm convictions and resolve."
      },
      "review": {
        "status": "CHANGE"
      },
