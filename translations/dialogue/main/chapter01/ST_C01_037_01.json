    {
      "record_id": "switch:locres:set-02:ST_C01_037_01:037_01_019:0bab3ad0",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_037_01",
        "key": "037_01_019",
        "jp_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_019:0bab3ad0",
        "official_en_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_019:0bab3ad0",
