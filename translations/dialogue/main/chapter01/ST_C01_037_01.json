    {
      "record_id": "switch:locres:set-02:ST_C01_037_01:037_01_009:1b97e779",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_037_01",
        "key": "037_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_009:1b97e779",
        "official_en_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_009:1b97e779",
        "jp_sha256": "7a569ba16eff92f75180ff35bbf1695c670dcef6b3927cb40afe714904891f6f",
        "official_en_sha256": "c232b983a29411538828611abba7c9dd3aca1c97da3b262fcc5a0790927518d2"
      },
      "text": {
        "jp": "あなたには幻獣と交感する\r\n特別な力が備わっているようです。",
        "official_en": "I see that you have been blessed with the power to commune with espers.",
        "real_en": "It seems you have a special ability to commune with Eidolons."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_037_01",
        "sequence": null,
        "speaker": {
