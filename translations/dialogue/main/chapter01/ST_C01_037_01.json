            "key-identities:ST_C01_037_01/037_01_018"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_037_01:037_01_013:c3e88231",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_037_01",
        "key": "037_01_013",
        "jp_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_013:c3e88231",
        "official_en_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_013:c3e88231",
