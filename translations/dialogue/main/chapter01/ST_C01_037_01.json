          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_037_01:037_01_027:3f350f9b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_037_01",
        "key": "037_01_027",
        "jp_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_027:3f350f9b",
        "official_en_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_027:3f350f9b",
        "jp_sha256": "7f8d357c2d97841834d68c13247582f1180076d4e4986fef5d95bfe88b07fe9b",
        "official_en_sha256": "bcf849bb50c8e3dd056ac14f951d60be67d60ea536a046dd682c4f9259c18770"
      },
      "text": {
        "jp": "さて、これでディルナド大陸に向かえるな。\r\nグランポートに戻ろう。",
        "official_en": "Now then, we got what we needed—we now have passage to Dirnado. Let us return to Grandport.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
