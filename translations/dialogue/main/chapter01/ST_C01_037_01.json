      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_037_01:037_01_026:91567e7d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_037_01",
        "key": "037_01_026",
        "jp_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_026:91567e7d",
        "official_en_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_026:91567e7d",
        "jp_sha256": "03765b441c7799624a0ed05c35a16acd8b01bb9b412a80c5f517f29201b97748",
        "official_en_sha256": "e9924820248cf23b5de61eb7fdea97e583d41bf68c1441faf6734de264a82c3b"
      },
      "text": {
        "jp": "ありがとう、レイン。\r\n傷ついたら、回復は任せてね。",
        "official_en": "Thanks, Rain. When you’re hurt, leave the healing to me.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_037_01",
