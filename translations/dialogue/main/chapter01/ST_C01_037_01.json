        "official_en_sha256": "0c9b85a80f8a221293eb53bd39d94f31f46bf9f4034c4a98298b66dd7fd66c0c"
      },
      "text": {
        "jp": "そのことを……覚えておいてください……",
        "official_en": "Heed well these words... Remember all I’ve said...",
        "real_en": "Please... remember that..."
      },
      "review": {
        "status": "CHANGE"
      },
