        "official_en_sha256": "54853f4bedd021c7989c9e596a99e9da0780f2f10cc24a2a92fd8e69852a45ac"
      },
      "text": {
        "jp": "他の幻獣も各地で身を隠しています。\r\nあなたの資質が認められれば、\r\n力を貸してくれることでしょう。",
        "official_en": "There are many of us across each of the realms. Demonstrate your power, and I expect they shall pledge themselves to you.",
        "real_en": "Other Eidolons are hiding in places all over the world. If they recognize your potential, they may lend you their power too."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
