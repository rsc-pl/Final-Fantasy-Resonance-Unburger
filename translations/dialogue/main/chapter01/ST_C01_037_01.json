        "namespace": "ST_C01_037_01",
        "key": "037_01_016",
        "jp_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_016:9936ba2b",
        "official_en_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_016:9936ba2b",
        "jp_sha256": "8ece24a5c59877e9c28035fe714f7bd6cd35919c262e71c716ee9ce2c28116e1",
        "official_en_sha256": "002715b94af348f93ceabedcd83af0367b5d7664bd4864388113ad0e3b607c06"
      },
      "text": {
        "jp": "ああ。\r\n幻獣が力を貸してくれるなんて。",
        "official_en": "Indeed. An esper lending us aid is a pleasant surprise.",
        "real_en": "Yeah... I never imagined an Eidolon would lend us its power."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_037_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ラスウェル",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0003",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C01_037_01/037_01_016"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_037_01:037_01_006:31e4ecf7",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_037_01",
        "key": "037_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_006:31e4ecf7",
        "official_en_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_006:31e4ecf7",
        "jp_sha256": "4a8b011c6ec4b71264d9ddcb1dd713ea0a5042051945274ce164931f26a0c37d",
        "official_en_sha256": "94948500d30cddec03998883c4b6fe197187589860494fd28a60df5a3a20e4c6"
      },
      "text": {
        "jp": "あなたたちなら私の力も正しく扱うことが出来るはず……",
        "official_en": "I now have faith that you shall be able to use my powers for good...",
        "real_en": "I believe you will use my power properly..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_037_01",
