          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_037_01:037_01_024:dfbea1fc",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_037_01",
        "key": "037_01_024",
        "jp_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_024:dfbea1fc",
        "official_en_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_024:dfbea1fc",
        "jp_sha256": "6632fe0aaca6f41828c2a9b8f0665a6ffe2a1d80851c04ad61bbc2dc60b9de82",
        "official_en_sha256": "e84a1011c3d1f1c4cc0ff0a90946a57abcdb6c25035db82d2edeedba893af86f"
      },
      "text": {
        "jp": "うん！　弓での攻撃なら任せて！\r\n後ろからでもやっつけちゃうから！",
        "official_en": "Got it! Leave the arrows to me! I’ll get them no matter how far they are!",
        "real_en": "You can count on me to attack with my bow! I can hit them from the back, too!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
