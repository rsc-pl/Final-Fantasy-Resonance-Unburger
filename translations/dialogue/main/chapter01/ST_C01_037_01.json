        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_037_01:037_01_023:ad62de26",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_037_01",
        "key": "037_01_023",
        "jp_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_023:ad62de26",
        "official_en_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_023:ad62de26",
        "jp_sha256": "61af5641e6897324c847ca67dc97a53e14a996f35417a340f4f14b5b76c50681",
        "official_en_sha256": "14fd1c0231de5496a22ac3e5d31cd40de0033621df3a2a2bdafef0ed9671b78f"
      },
      "text": {
        "jp": "ずっと力になってるって。俺たちは仲間なんだから。",
        "official_en": "Don’t sell yourself short. We’re a team—you’re already doing an amazing job, Fina.",
        "real_en": "You've been helping us all along. We're friends, after all."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_037_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "レイン",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0002",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C01_037_01/037_01_023"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_037_01:037_01_018:3d47bd5e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_037_01",
        "key": "037_01_018",
        "jp_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_018:3d47bd5e",
        "official_en_record_id": "switch:locres:set-02:ST_C01_037_01:037_01_018:3d47bd5e",
        "jp_sha256": "41ea839a880da36b141b1525a65f3ecd818da746735e4ea8b75012a292e13490",
        "official_en_sha256": "7115e2de37332c964524aa8609243a00930b3cfb1693503a89673046dcd6a3e7"
      },
      "text": {
        "jp": "そうだね。\r\n私ってなんなんだろう……。",
        "official_en": "I’ve been asking myself that exact question, too. Who—<text style=\"italic\">what</>\nam I?",
        "real_en": "Yeah... What am I, anyway...?"
      },
      "review": {
        "status": "CHANGE"
      },
