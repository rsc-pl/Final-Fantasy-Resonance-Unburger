        "official_en_sha256": "1ee5a7d1cd1c2c4a56cd070ea5d31f8ed214350465c3db8f398169ea0ff6fb31"
      },
      "text": {
        "jp": "でも、これで私も\r\nレインとラスウェルの力になれるかな？",
        "official_en": "But I guess what matters is that I can be of better use to you two in a fight, right?",
        "real_en": "But does this mean I can help you and Lasswell now, Rain?"
      },
      "review": {
        "status": "CHANGE"
      },
