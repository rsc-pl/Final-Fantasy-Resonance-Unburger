    {
      "record_id": "switch:locres:set-02:ST_C01_008_01_B:008_01_B_002:13544d49",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_008_01_B",
        "key": "008_01_B_002",
        "jp_record_id": "switch:locres:set-02:ST_C01_008_01_B:008_01_B_002:13544d49",
        "official_en_record_id": "switch:locres:set-02:ST_C01_008_01_B:008_01_B_002:13544d49",
