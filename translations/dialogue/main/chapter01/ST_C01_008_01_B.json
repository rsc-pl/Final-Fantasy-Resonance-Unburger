        "official_en_sha256": "7ed35947004d58d0cc98811e76cd88f017786074563c78249d98597ab681c0d4"
      },
      "text": {
        "jp": "火、水、風、土……あとは、氷、雷……。",
        "official_en": "Should ruin befall the Crystals...Fire, Water, Wind, Earth, Ice, and Lightning...",
        "real_en": "Fire, water, wind, earth...and then ice and lightning..."
