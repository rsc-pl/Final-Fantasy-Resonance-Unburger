          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C01_008_01_B/008_01_B_008"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
