        "official_en_sha256": "f8353333d2289297e0ae3b2f4607738f242d3ebf7a1c9a01f98b95fe92671aa3"
      },
      "text": {
        "jp": "なんで俺だけで調べるんだ。\r\n二人でやればいいだろう。",
        "official_en": "Wait, why should I be the one looking into it? Shouldn’t we do that together?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
