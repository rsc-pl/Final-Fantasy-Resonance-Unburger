        "official_en_sha256": "c12a5615e803073728f6e61e86b0d8ff89952ac717a312d0b51ada7a2f220011"
      },
      "text": {
        "jp": "なあ、ラスウェル。\r\nクリスタルにはヤバい伝承があるよな。",
        "official_en": "There’s a pretty ominous legend about the Crystals... You know about it, Lasswell?",
        "real_en": "Hey, Lasswell. There’s an ominous legend about the Crystals, isn’t there?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
