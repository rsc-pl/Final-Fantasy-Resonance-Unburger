        "official_en_sha256": "7fe175fa67f20f088ca28b1beb6de53dc541429d7068e0b369f02a7c84906925"
      },
      "text": {
        "jp": "あそこには我が国が代々守っている土のクリスタルがある。",
        "official_en": "It houses the Earth Crystal—a precious heritage that we have safeguarded for generations.",
        "real_en": "It houses the Earth Crystal, which our kingdom has protected for generations."
      },
      "review": {
        "status": "CHANGE"
      },
