        "official_en_sha256": "d02adefd5860c395e9a4e117aba165dcad67da7f4cad9affb62c0215feaf499e"
      },
      "text": {
        "jp": "お任せください。\r\nどんなことであろうと対処してみせます。",
        "official_en": "You need not worry, Your Majesty. We will make sure to take care of the situation, no matter what we find.",
        "real_en": "Leave it to me. I’ll handle whatever comes up."
      },
