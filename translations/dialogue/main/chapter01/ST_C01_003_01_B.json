    {
      "record_id": "switch:locres:set-02:ST_C01_003_01_B:003_01_B_004:b3538706",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_003_01_B",
        "key": "003_01_B_004",
        "jp_record_id": "switch:locres:set-02:ST_C01_003_01_B:003_01_B_004:b3538706",
        "official_en_record_id": "switch:locres:set-02:ST_C01_003_01_B:003_01_B_004:b3538706",
