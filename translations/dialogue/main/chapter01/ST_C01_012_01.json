    {
      "record_id": "switch:locres:set-02:ST_C01_012_01:012_01_003:4be44119",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_012_01",
        "key": "012_01_003",
        "jp_record_id": "switch:locres:set-02:ST_C01_012_01:012_01_003:4be44119",
        "official_en_record_id": "switch:locres:set-02:ST_C01_012_01:012_01_003:4be44119",
        "jp_sha256": "2d4e0951510eb6e86eec5cae6f7b71c40b03a9224fd38703ca1e76ac0e1f5679",
        "official_en_sha256": "2e8740840c483de331e53d6d5af066030f00a6839a09d79ad5f774c036eafb24"
      },
      "text": {
        "jp": "レーゲンさんは親を亡くした俺を\r\n実の子供のように育ててくれた。\r\nその感謝を忘れることはない。",
        "official_en": "When...my parents died, Sir Raegen raised me like his own son—a kindness I’ll never forget.",
        "real_en": "When my parents died, Raegen-san raised me like his own son. I’ll never forget what he did for me."
      },
      "review": {
        "status": "CHANGE"
