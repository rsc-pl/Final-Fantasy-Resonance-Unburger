        "official_en_sha256": "652bc7c3afd19c7c85115ece807c2ecc45c0c8c48334e34a70bd9c6a04a06abe"
      },
      "text": {
        "jp": "変わってないな……。\r\n埃っぽいけど、あの頃のままだ……。",
        "official_en": "Nothing’s changed...except an added layer of dust.",
        "real_en": "Nothing’s changed... It’s dusty, but it’s just how I remember it."
      },
