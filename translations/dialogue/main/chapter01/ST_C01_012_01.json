        "jp_record_id": "switch:locres:set-02:ST_C01_012_01:012_01_002:027b52a6",
        "official_en_record_id": "switch:locres:set-02:ST_C01_012_01:012_01_002:027b52a6",
        "jp_sha256": "9154c3e92cbe03548e8d08d55d766e8615429fcc75be468508da47bbad8302be",
        "official_en_sha256": "4652f9712ba9d306106d3f6fb68b8e8c11b66caa51b8310587975f4168f4854c"
      },
      "text": {
        "jp": "レインと一緒にここで暮らしていたのが\r\nつい昨日のことのようだ。",
        "official_en": "Seems like just yesterday that we were living here.",
        "real_en": "It feels like only yesterday we were living here together, Rain."
      },
      "review": {
        "status": "CHANGE"
      },
