    {
      "record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_012:07d06bb2",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_005_01_B",
        "key": "005_01_B_012",
        "jp_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_012:07d06bb2",
        "official_en_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_012:07d06bb2",
        "jp_sha256": "7e16da996f70dbf1cfa527105c8ca367113c704ed41ced7983282799b5f120f7",
        "official_en_sha256": "205825ad21570387a449b747e1cc511ee43f05b392724db72e5769515c799a58"
      },
      "text": {
        "jp": "この異常な流星雨に\r\n土の神殿での異変……",
        "official_en": "This unusual meteor shower... And the anomaly at the Earth Shrine...",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_005_01_B",
