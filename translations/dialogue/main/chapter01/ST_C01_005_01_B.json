    {
      "record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_024:c691d2cc",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_005_01_B",
        "key": "005_01_B_024",
        "jp_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_024:c691d2cc",
        "official_en_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_024:c691d2cc",
        "jp_sha256": "9f52930f0ccf350e8ef482cdf9a7e4f767ec73ab589bd8b5d9a2b66cf29764de",
        "official_en_sha256": "6a55a734d7087329a77da2553b8bf60f5acfe5b9f37c958f8508bf82ca2c7944"
      },
      "text": {
        "jp": "このままではクリスタルが危ない……。\r\n頼めるのは、あなただけ……。",
        "official_en": "Without your help, the Crystal will be shattered...\nPlease...you’re the only one who can...",
        "real_en": "If this continues, the Crystal will be in danger... You’re the only one I can ask..."
      },
      "review": {
        "status": "CHANGE"
      },
