    {
      "record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_006:8d27ad6f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_005_01_B",
        "key": "005_01_B_006",
        "jp_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_006:8d27ad6f",
        "official_en_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_006:8d27ad6f",
        "jp_sha256": "c53d58e077102e2a0d003b09015a2374657223dfadb3ac2feb0d9e63d783369a",
        "official_en_sha256": "3d7eb19e478b0ab6f5b54a80e84b47ea530e5038fb6bd1f1994d14ed29aa0f0d"
      },
      "text": {
        "jp": "ああ。これだけ流れていれば\r\nどんな願いも叶うだろ。",
        "official_en": "Yeah, with this many in the sky, you’ll get anything, I reckon.",
        "real_en": null
      },
      "review": {
