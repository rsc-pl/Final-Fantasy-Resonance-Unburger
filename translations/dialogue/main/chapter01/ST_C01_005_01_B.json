    {
      "record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_023:6256d28b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_005_01_B",
        "key": "005_01_B_023",
        "jp_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_023:6256d28b",
        "official_en_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_023:6256d28b",
        "jp_sha256": "3fe9fdca5164b656c8b14aaad05e99042f5be49445bcd8bf16fa173366f40c28",
        "official_en_sha256": "cab074aed4ebbb67ecc25090a4ed06c50149aecfd7cc72d816f8d0c0037e94ad"
      },
      "text": {
        "jp": "お願い……。\r\n土の神殿に急いで……。",
        "official_en": "Please...hurry to the Earth Shrine...",
        "real_en": null
      },
      "review": {
