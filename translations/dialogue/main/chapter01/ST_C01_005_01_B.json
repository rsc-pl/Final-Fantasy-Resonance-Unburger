      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_014:a94ac7da",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_005_01_B",
        "key": "005_01_B_014",
        "jp_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_014:a94ac7da",
        "official_en_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_014:a94ac7da",
        "jp_sha256": "4651de82e0c55197e73b295e3ab61a53d3d87df01061601e362e1984c29e0a0d",
        "official_en_sha256": "0bcb4357cfd57b4df7c3b2855b3e492dac6c9197038b198391b6a8dc063c1e23"
      },
      "text": {
        "jp": "そうだな。\r\n土の神殿に異常が起きたって話は\r\n聞いたことがないしな。",
        "official_en": "You know, you might be onto something. There’s never been any unusual events at the Earth Shrine before—at least none that I’ve heard of.",
        "real_en": "Yeah. I've never heard of anything unusual happening at the Earth Shrine before."
      },
