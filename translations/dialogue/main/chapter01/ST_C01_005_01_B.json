    {
      "record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_018:29166e65",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_005_01_B",
        "key": "005_01_B_018",
        "jp_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_018:29166e65",
        "official_en_record_id": "switch:locres:set-02:ST_C01_005_01_B:005_01_B_018:29166e65",
