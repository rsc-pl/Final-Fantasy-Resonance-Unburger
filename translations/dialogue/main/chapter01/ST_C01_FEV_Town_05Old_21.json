    {
      "record_id": "switch:locres:set-02:ST_C01_FEV_Town_05Old_21:FEV_Town_05Old_21_011:d504d3f0",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_FEV_Town_05Old_21",
        "key": "FEV_Town_05Old_21_011",
        "jp_record_id": "switch:locres:set-02:ST_C01_FEV_Town_05Old_21:FEV_Town_05Old_21_011:d504d3f0",
        "official_en_record_id": "switch:locres:set-02:ST_C01_FEV_Town_05Old_21:FEV_Town_05Old_21_011:d504d3f0",
        "jp_sha256": "41da1690943db9ee1dc1743b273098ffdf7b890f16454e52bf92eb11f2172a1b",
        "official_en_sha256": "41da1690943db9ee1dc1743b273098ffdf7b890f16454e52bf92eb11f2172a1b"
      },
      "text": {
        "jp": "その中には昔の世界地図っぽいのがあったんだが、\r\n描かれている島の少なさから偽物だなと思ってたんだ。",
        "official_en": "その中には昔の世界地図っぽいのがあったんだが、\r\n描かれている島の少なさから偽物だなと思ってたんだ。",
        "real_en": "One of them looked like an old world map, but there were so few islands on it that I thought it had to be a fake."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_FEV_Town_05Old_21",
