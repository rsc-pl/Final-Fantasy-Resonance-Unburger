    {
      "record_id": "switch:locres:set-02:ST_C01_FEV_Town_05Old_21:FEV_Town_05Old_21_012:bd206759",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_FEV_Town_05Old_21",
        "key": "FEV_Town_05Old_21_012",
        "jp_record_id": "switch:locres:set-02:ST_C01_FEV_Town_05Old_21:FEV_Town_05Old_21_012:bd206759",
        "official_en_record_id": "switch:locres:set-02:ST_C01_FEV_Town_05Old_21:FEV_Town_05Old_21_012:bd206759",
        "jp_sha256": "46326b05b83b12314493719b82c102193f66c9eed4d2d7b55deb5f4b727a4c4c",
        "official_en_sha256": "46326b05b83b12314493719b82c102193f66c9eed4d2d7b55deb5f4b727a4c4c"
      },
      "text": {
        "jp": "だけど今の景色を見て本物だと確信したよ。\r\n島のほとんどは海に沈んでいたんだな……。",
        "official_en": "だけど今の景色を見て本物だと確信したよ。\r\n島のほとんどは海に沈んでいたんだな……。",
        "real_en": "But looking at things now, I'm convinced it was real. Most of the islands had sunk beneath the sea..."
      },
      "review": {
        "status": "CHANGE"
      },
