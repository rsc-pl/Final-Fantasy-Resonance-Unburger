        "key": "FEV_Town_05Old_21_010",
        "jp_record_id": "switch:locres:set-02:ST_C01_FEV_Town_05Old_21:FEV_Town_05Old_21_010:9c5a3a95",
        "official_en_record_id": "switch:locres:set-02:ST_C01_FEV_Town_05Old_21:FEV_Town_05Old_21_010:9c5a3a95",
