    {
      "record_id": "switch:locres:set-02:ST_C01_022_01:022_01_023:94ced647",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_022_01",
        "key": "022_01_023",
        "jp_record_id": "switch:locres:set-02:ST_C01_022_01:022_01_023:94ced647",
        "official_en_record_id": "switch:locres:set-02:ST_C01_022_01:022_01_023:94ced647",
