          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_022_01:022_01_029:2f470bd2",
      "source": {
        "set": "set-02",
