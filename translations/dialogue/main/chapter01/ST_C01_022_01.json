        "official_en_sha256": "13012db586b83670c2bc854bc1c550997ba2c5c72dcfe058b0fb8bdef547334b"
      },
      "text": {
        "jp": "ここをまっすぐすすめば\r\n砂漠に出るよ。",
        "official_en": "It leads to the desert. We just need to go straight following this path.",
        "real_en": "If we keep going straight, we'll reach the desert."
      },
