          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_022_01:022_01_017:13710a52",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_022_01",
        "key": "022_01_017",
