        "official_en_sha256": "2557e6bce2af35183f5014b36ba35bf83c43234d2630635ef581c2b7d7404474"
      },
      "text": {
        "jp": "うん！\r\nよろしくね、レイン、ラスウェル！",
        "official_en": "Thanks Rain, Lasswell! I won’t let either of you down!",
        "real_en": "Yeah! I'm looking forward to traveling with you, Rain and Lasswell!"
      },
      "review": {
        "status": "CHANGE"
