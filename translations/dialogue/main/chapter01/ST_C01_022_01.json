        "official_en_sha256": "a32b2236fee4b4e0defd31469831665f6a473f8670f1c133b8ed41134a81844c"
      },
      "text": {
        "jp": "うん。\r\nそうだな、冒険に出発するんだ。",
        "official_en": "Yeah... Maybe you’re right. We’re off on an adventure!",
        "real_en": "Yeah. You're right. We're setting off on an adventure."
      },
      "review": {
        "status": "CHANGE"
      },
