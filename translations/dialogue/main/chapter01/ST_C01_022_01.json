        "official_en_sha256": "80150633315a228d9ad4c456fdf15e63db6600d8f0076209e4d16a618ba1ecff"
      },
      "text": {
        "jp": "そうだよな。\r\n記憶がないんだもんな。",
        "official_en": "Right. Lost memory.",
        "real_en": "Oh, right. You don't remember."
      },
