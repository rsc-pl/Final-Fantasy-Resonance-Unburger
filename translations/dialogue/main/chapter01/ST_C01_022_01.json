        "official_en_sha256": "8ff98f3dd243e9994c1ef716ef83126b943993c6531b6d43dd505f8d55fc7219"
      },
      "text": {
        "jp": "この丘の先には何があるのかな？",
        "official_en": "What’s over this hill?",
        "real_en": null
      },
