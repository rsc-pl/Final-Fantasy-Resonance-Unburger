    {
      "record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_011:f93ad609",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_010_02_B",
        "key": "010_02_B_011",
        "jp_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_011:f93ad609",
        "official_en_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_011:f93ad609",
        "jp_sha256": "89417d92a754e8f7e72a74c1594d74e46d42d29e58610dd69a2e343c287e563f",
        "official_en_sha256": "7a34c82d8308e3a9aaf79617ba8e04956add482172ad6ee474becb9d6169236d"
      },
      "text": {
        "jp": "レイン隊長に任されたのに……こんなことに……。\r\n情けないな……。",
        "official_en": "I...I let you...down, Commander Rain... How could we...let this happen?",
        "real_en": "You entrusted it to me, Commander Rain...and look what happened... I’m ashamed..."
      },
      "review": {
