    {
      "record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_018:50db5b8d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_010_02_B",
        "key": "010_02_B_018",
        "jp_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_018:50db5b8d",
        "official_en_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_018:50db5b8d",
        "jp_sha256": "6ba38a77a5a958389290c24f92bf4e6f05f0933d2cc45d9b997f35ec2b9f1c8d",
        "official_en_sha256": "90c979782a89d2f18f72c250d87ded453cd74d88be31f93918f564a18d82429a"
      },
      "text": {
        "jp": "クリスタルの破壊は国を揺るがす一大事だ。\r\n陛下にここで起きたことを報告しなければ。",
        "official_en": "Right now, the Crystal being destroyed is the most important concern for our nation. We must report this to the king.",
        "real_en": "The destruction of the Crystal could shake the entire kingdom. We have to tell His Majesty what happened here."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_010_02_B",
