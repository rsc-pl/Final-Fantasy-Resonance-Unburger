    {
      "record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_017:5c97d52c",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_010_02_B",
        "key": "010_02_B_017",
        "jp_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_017:5c97d52c",
        "official_en_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_017:5c97d52c",
        "jp_sha256": "ddb14348d1ee7ef1ebda15f418ac549fd7708add0badb0b31b8b50f73fbd0772",
        "official_en_sha256": "7ce73fc17af42709ca9cef648c6407824982ef7e3aa74b7dbf9356530e2821ae"
      },
      "text": {
        "jp": "レイン、自分を責めるな。\r\nどんな指示を出しても結果は同じだった。\r\n鎧の奴の力はそれほど強大だ。",
        "official_en": "This isn’t on you, Rain. Against such an overwhelming enemy, the result would’ve been the same no matter the orders given.",
        "real_en": "Rain, don’t blame yourself. It would’ve ended the same way no matter what orders you’d given. That man in armor is that powerful."
      },
      "review": {
        "status": "CHANGE"
      },
