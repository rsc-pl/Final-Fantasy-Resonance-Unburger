    {
      "record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_027:f225349a",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_010_02_B",
        "key": "010_02_B_027",
        "jp_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_027:f225349a",
        "official_en_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_027:f225349a",
        "jp_sha256": "716818459422ce8b119eb0ce2a7ede5f9e808f053fc4993c82fcbdf6808b56f8",
        "official_en_sha256": "de77023f2724f42fce68e65c85da5def47a945135377ac3de51e16064113bb3c"
      },
