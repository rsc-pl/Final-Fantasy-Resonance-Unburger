        "official_en_sha256": "663d2991b3f3c43f872507de471a7b04a125be6901271592852dbdba641e907c"
      },
      "text": {
        "jp": "俺が待機の指示を出していなければ……。",
        "official_en": "If I hadn’t ordered them to stay at the airship...",
        "real_en": "If I hadn’t ordered them to stand by..."
