          "evidence_refs": [
            "key-identities:ST_C01_010_02_B/010_02_B_018"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_013:7474bd5d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_010_02_B",
        "key": "010_02_B_013",
        "jp_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_013:7474bd5d",
        "official_en_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_013:7474bd5d",
        "jp_sha256": "32bfd449da3fcb7ced07a4d5237500264f74a284659a504facea71f3fd23b946",
        "official_en_sha256": "660daf5aff5564c53b7003c407f402eb849b67d8c91888228f813c0a1ac010de"
      },
      "text": {
        "jp": "レイン、よせ……。\r\n飛空艇を守るために必死に戦ってくれたんだ。\r\nもう休ませてやれ。",
        "official_en": "They fought valiantly, sacrificing themselves in defense of the ship. All we can offer them now is peace.",
        "real_en": "Rain, stop... They fought desperately to protect the airship. Let them rest now."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_010_02_B",
