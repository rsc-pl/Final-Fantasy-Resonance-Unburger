    {
      "record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_028:df120723",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_010_02_B",
        "key": "010_02_B_028",
        "jp_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_028:df120723",
        "official_en_record_id": "switch:locres:set-02:ST_C01_010_02_B:010_02_B_028:df120723",
        "jp_sha256": "960481b5426e3a2fdc41cd422cf534783c24258bc58b059020df2e1cdc355023",
        "official_en_sha256": "4ae7e44685d7ec149340d8f3ef261cbc97571ad916837652d15c88eeb93d4afc"
      },
      "text": {
        "jp": "わかったよ……。\r\nラスウェルがそこまで言うのなら。",
        "official_en": "Fine—if you’re that sure...",
        "real_en": "All right... If you feel that strongly about it, Lasswell."
      },
