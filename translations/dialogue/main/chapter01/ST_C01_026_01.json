        "official_en_sha256": "2a0274424b4044607256d24abc18ba6d56d66afe2482949c937184ce703d051f"
      },
      "text": {
        "jp": "エマちゃん……。\r\nこの人たちに話してないの？",
        "official_en": "Emma... Have you not told these good people?",
        "real_en": "Emma-chan... You haven't told these people?"
