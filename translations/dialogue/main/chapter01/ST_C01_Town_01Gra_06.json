      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_002:7c26da70",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_06",
        "key": "Town_01Gra_06_002",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_002:7c26da70",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_002:7c26da70",
        "jp_sha256": "61632cf6d934e32d10c2651b0e1105de14434e63a358a92ab7188dc56b826266",
        "official_en_sha256": "4ead62e73e763934e7416b7265ffff3a9e611219e565c821dc20cc762f7bb1ca"
      },
      "text": {
        "jp": "あの事件の日から毎日、\r\nこの子なりにお稽古をしてて……",
        "official_en": "My boy has been practicing more diligently than ever since that dreadful day.",
        "real_en": "Ever since that incident, my boy has been practicing every day in his own way..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_Town_01Gra_06",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "おばさん",
