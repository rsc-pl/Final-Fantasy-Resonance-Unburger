          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C01_Town_01Gra_06/Town_01Gra_06_027"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_021:8b3959a5",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_06",
        "key": "Town_01Gra_06_021",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_021:8b3959a5",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_021:8b3959a5",
        "jp_sha256": "287811f198a9cdabd9e3bfc33a272d4133a40bc13c8ead7460a3ab79c98f1be6",
        "official_en_sha256": "97fe4bc4822c57c0ab3a39406b3bbb9afa3b7b8eae90c6e205a7a27898ee75a6"
      },
      "text": {
        "jp": "でもおかげで、皆も士気が上がっているので、\r\n必ず復活しますよ。飛空艇部隊。",
        "official_en": "But his efforts have raised morale considerably. I’m certain the squadron will return.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
