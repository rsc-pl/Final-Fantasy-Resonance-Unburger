          "name_entry": "CharaName0175",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C01_Town_01Gra_06/Town_01Gra_06_002"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_026:1e97c3cd",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_06",
        "key": "Town_01Gra_06_026",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_026:1e97c3cd",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_026:1e97c3cd",
        "jp_sha256": "cbd51af9d26d321e02c58a1b04ba8595a5d9f38bbbec676e187d8047ec1bc503",
        "official_en_sha256": "efb51ab7d80f63ff6f2cada9275b3425cf02c7ddf0b2fafdcfecf0b36116ee2e"
      },
      "text": {
        "jp": "あの時は、正直もうグランシェルト城は\r\nもとに戻らないのだと思っていました……。",
        "official_en": "I honestly feared I’d never see Grandshelt Castle in its full glory ever again...",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_Town_01Gra_06",
