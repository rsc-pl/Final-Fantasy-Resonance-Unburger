        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_011:1448cd3b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_06",
        "key": "Town_01Gra_06_011",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_011:1448cd3b",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_011:1448cd3b",
        "jp_sha256": "52367de132bfbf2768d7b32946c1aed6fcfff725a61e8998fa13119e306bbbf0",
        "official_en_sha256": "40ebc0ca8c739c7ee68fb89bddd6d245b9022ab0d6a2cc4ea45bba159c87bad8"
      },
      "text": {
        "jp": "ご飯をね、ここで食べないで\r\nどこかに持っていってるみたいなんだ。\r\nもしかして……。",
        "official_en": "Instead of eating their food here, they carry it off somewhere else. But I think I can guess as to why...",
        "real_en": "The cats seem to be taking their food somewhere else instead of eating here. I wonder if..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_Town_01Gra_06",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "老婆",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0030",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C01_Town_01Gra_06/Town_01Gra_06_011"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_027:62fc651d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_06",
        "key": "Town_01Gra_06_027",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_027:62fc651d",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_027:62fc651d",
        "jp_sha256": "ac2a0d1e27dce912dd0b436f83262500d18918f4c959d34a5f0bf753cb79c3d6",
        "official_en_sha256": "898f3818ebb3b8fd38963adeb92244c996460aac69f5aecd6b00fb54547e22a6"
      },
      "text": {
        "jp": "ですが、皆で小さなことを積み重ねて\r\nここまで大きな城をなおせた。\r\nグランシェルトの底力を思い知りました。",
        "official_en": "But many hands make light work, and even a towering castle can be repaired. It’s made me realize what the people of Grandshelt can do when they come together.",
        "real_en": "But little by little, we all worked together to restore a castle this big. It showed me what Grandshelt is really capable of."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_Town_01Gra_06",
        "sequence": null,
        "speaker": {
