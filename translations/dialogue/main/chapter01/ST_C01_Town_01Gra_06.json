    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_016:9cb50f2d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_06",
        "key": "Town_01Gra_06_016",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_016:9cb50f2d",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_06:Town_01Gra_06_016:9cb50f2d",
