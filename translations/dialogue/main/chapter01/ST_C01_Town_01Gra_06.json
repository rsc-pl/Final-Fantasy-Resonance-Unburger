      },
      "text": {
        "jp": "“きしだん”に入るために、\r\n毎日とっくんしているんだ！",
        "official_en": "I’m training real hard every day so I can join the knights!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_Town_01Gra_06",
