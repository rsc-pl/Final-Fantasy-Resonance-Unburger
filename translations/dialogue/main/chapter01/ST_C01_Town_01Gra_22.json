    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_003:586ba8b0",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_22",
        "key": "Town_01Gra_22_003",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_003:586ba8b0",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_003:586ba8b0",
        "jp_sha256": "849406da993a293fffdd68e08107e0aab2633236cc4defecb73f8b47c971c57d",
        "official_en_sha256": "1fd8f68fd822430131cc1367e61a579f9ba3255ea88e098ea5a7b869db713741"
      },
      "text": {
        "jp": "となると、飛空艇技師に\r\n改築を依頼しないとな。",
        "official_en": "In that case, we’ll need to have an airship engineer take a look at them and make the necessary modifications.",
        "real_en": "Then we'll have to ask an airship engineer to make modifications."
      },
      "review": {
        "status": "CHANGE"
      },
