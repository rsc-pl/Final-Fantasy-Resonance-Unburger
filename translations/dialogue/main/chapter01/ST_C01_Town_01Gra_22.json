      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_002:0e554f46",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_22",
        "key": "Town_01Gra_22_002",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_002:0e554f46",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_002:0e554f46",
        "jp_sha256": "be32c306e61c94d162950a79ec3e9eb2bfdb54e9bb170377504b544436a368ec",
        "official_en_sha256": "90c94449c751094c46e78f613f49f0d80f08c4d7b2d77b6c3906dc612236349b"
      },
      "text": {
        "jp": "ああ、部隊の機動力を\r\nもっと上げたくてな。",
        "official_en": "Yeah, I drafted them up to improve the mobility of the squadron.",
        "real_en": "Yeah. I want to make the squadron more mobile."
      },
      "review": {
        "status": "CHANGE"
      },
