    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_013:c283291e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_22",
        "key": "Town_01Gra_22_013",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_013:c283291e",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_013:c283291e",
        "jp_sha256": "29c2bceb1ca137551755fc765f451acee4e3d2c888665ce9cffd94dc299062bc",
        "official_en_sha256": "ccb1126d5e908fdcf5bc78b64071e56ef35e4f962754ab755eec768297ff6581"
      },
      "text": {
        "jp": "って、ラスウェル\r\n本の内容を暗記しているのかよ。",
        "official_en": "Wait, you actually remember some of it by heart...?",
        "real_en": null
      },
      "review": {
