    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_004:14880e8b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_22",
        "key": "Town_01Gra_22_004",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_004:14880e8b",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_004:14880e8b",
        "jp_sha256": "84380c0f0bb9f1478ae11b6ba65d94de9e68cbb475ff4787d606a0c29c23eb46",
        "official_en_sha256": "b1b9d517881beafb001c53af3cc25bd9692b2be82857cdf6d0942b65885d6b64"
      },
      "text": {
        "jp": "だな。\r\nしばらく会っていないけど\r\n技師のスコットは元気かな？",
        "official_en": "Right. I wonder what Scott’s up to these days.",
        "real_en": "Right. It's been a while since we last met him. I wonder how Scott's doing."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
