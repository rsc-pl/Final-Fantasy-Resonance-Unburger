    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_001:c4644bb2",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_22",
        "key": "Town_01Gra_22_001",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_001:c4644bb2",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_001:c4644bb2",
        "jp_sha256": "03497fa1a8d06afcab3ff8d9eda7898e0c51b094e3903f20713a34c9eb49830d",
        "official_en_sha256": "84fd22c1f9e31de539ca992eef7168620854b5c7ac239a9204c1208430a126f8"
      },
      "text": {
        "jp": "これは……\r\n飛空艇部隊の降下訓練の計画書か。",
        "official_en": "These are...plans for adding aerial deployment capabilities to our airships.",
        "real_en": "These are... plans for the airship squadron's descent training."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
