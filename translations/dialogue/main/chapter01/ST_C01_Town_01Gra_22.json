        "official_en_sha256": "c48a1b0c7739b8e18613ae5039fa26fb708be52eefd3e48d0924db8f7ee6fb43"
      },
      "text": {
        "jp": "このくらい当然だ。",
        "official_en": "Of course. These are but our basic tenets.",
        "real_en": "Of course I do."
      },
      "review": {
        "status": "CHANGE"
      },
