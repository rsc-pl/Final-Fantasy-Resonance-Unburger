          "name_entry": "CharaName0003",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C01_Town_01Gra_22/Town_01Gra_22_011"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_012:851d4872",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_22",
        "key": "Town_01Gra_22_012",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_012:851d4872",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_012:851d4872",
        "jp_sha256": "ce68f04b28d5d632a1181c524a59b28380e244d4ef2edd709baae18c7595d7a8",
        "official_en_sha256": "0210e29f0d1322484454f249bccfd42c515fd7e1e505a8852adcec08866d95b4"
      },
      "text": {
        "jp": "己の剣、己の盾、そして、己の精神こそが\r\n自由と平和を守る礎であると心得よ。\r\n「グランシェルトの騎士として」。",
        "official_en": "<text style=\"italic\">A knight’s sword, shield, and spirit are the very foundation of peace and liberty, both throughout the Kingdom and beyond. Do well to remember: as a knight of Grandshelt.”</>",
        "real_en": "<text style=\"italic\">“Know that your sword, your shield, and your spirit are the foundation of freedom and peace. ‘As a Knight of Grandshelt.’”</>"
      },
      "review": {
        "status": "CHANGE"
      },
