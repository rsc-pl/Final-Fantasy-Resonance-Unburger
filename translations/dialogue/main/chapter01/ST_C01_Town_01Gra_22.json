    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_011:806686af",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_22",
        "key": "Town_01Gra_22_011",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_011:806686af",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_22:Town_01Gra_22_011:806686af",
        "jp_sha256": "2f687dafea9526f8fb74bbd25aa0770505b63e18c15093c3fbfa3438caa92d1c",
        "official_en_sha256": "713fe3ddd554eb51542f5d1d466c14fd1b5bc593ba283d85085f10fe6ce0fda5"
      },
      "text": {
        "jp": "グランシェルトの騎士は、いついかなる時も\r\n己を鍛錬し、民のために尽くし、\r\n国家の支えとして働くこととする。",
        "official_en": "<text style=\"italic\">“A knight of Grandshelt must be the paragon of self-improvement and a pillar of the realm, ever striving to serve the people and support the nation.</>",
        "real_en": "<text style=\"italic\">“Knights of Grandshelt must train themselves at all times, serve the people, and uphold the nation.”</>"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_Town_01Gra_22",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ラスウェル",
