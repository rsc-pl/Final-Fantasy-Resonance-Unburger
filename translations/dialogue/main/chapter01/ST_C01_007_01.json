    {
      "record_id": "switch:locres:set-02:ST_C01_007_01:007_01_015:9aab3474",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_007_01",
        "key": "007_01_015",
        "jp_record_id": "switch:locres:set-02:ST_C01_007_01:007_01_015:9aab3474",
        "official_en_record_id": "switch:locres:set-02:ST_C01_007_01:007_01_015:9aab3474",
        "jp_sha256": "9f35168c75748cff999e1752ec4771130eacaad3143b40c98bed97e771edcddb",
        "official_en_sha256": "9f35168c75748cff999e1752ec4771130eacaad3143b40c98bed97e771edcddb"
      },
      "text": {
        "jp": "いいや、お前だ。\r\n俺が言うんだ。間違いない。",
        "official_en": "いいや、お前だ。\r\n俺が言うんだ。間違いない。",
        "real_en": "No, it's you. I'm telling you, and I know I'm right."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
