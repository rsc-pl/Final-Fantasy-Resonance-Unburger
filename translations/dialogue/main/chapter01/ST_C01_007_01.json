        "official_en_sha256": "673cf5973fb9437eb46fe061266ef47708654ebdc2e4bf970c266a196fc7ae41"
      },
      "text": {
        "jp": "あのなぁ……。\r\nレイン、真面目に聞け。",
        "official_en": "あのなぁ……。\r\nレイン、真面目に聞け。",
        "real_en": "Come on... Rain, take this seriously."
      },
      "review": {
        "status": "CHANGE"
      },
