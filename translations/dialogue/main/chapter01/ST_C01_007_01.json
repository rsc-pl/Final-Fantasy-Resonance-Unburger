    {
      "record_id": "switch:locres:set-02:ST_C01_007_01:007_01_008:8bae0895",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_007_01",
        "key": "007_01_008",
        "jp_record_id": "switch:locres:set-02:ST_C01_007_01:007_01_008:8bae0895",
        "official_en_record_id": "switch:locres:set-02:ST_C01_007_01:007_01_008:8bae0895",
        "jp_sha256": "9bfe6ec9a19720a1c363ec4beca2e589cb7c30fe1b25b095690038eec03b1916",
        "official_en_sha256": "9bfe6ec9a19720a1c363ec4beca2e589cb7c30fe1b25b095690038eec03b1916"
      },
      "text": {
        "jp": "そうか？\r\nでも、俺がピンチになったら\r\nラスウェルが助けてくれるだろ？",
        "official_en": "そうか？\r\nでも、俺がピンチになったら\r\nラスウェルが助けてくれるだろ？",
        "real_en": "Really? But if I get into trouble, you'll save me, right, Lasswell?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
