    {
      "record_id": "switch:locres:set-02:ST_C01_007_01:007_01_005:7e0a5bcd",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_007_01",
        "key": "007_01_005",
        "jp_record_id": "switch:locres:set-02:ST_C01_007_01:007_01_005:7e0a5bcd",
        "official_en_record_id": "switch:locres:set-02:ST_C01_007_01:007_01_005:7e0a5bcd",
        "jp_sha256": "daa96f309482c8398fbef2f8037ad48950517a3dda1111b7a94f9235f842662d",
        "official_en_sha256": "daa96f309482c8398fbef2f8037ad48950517a3dda1111b7a94f9235f842662d"
      },
      "text": {
        "jp": "いつも難しい顔をしてたら、\r\n部下たちも近寄りがたいぞ。\r\nもっとリラックスしていこうぜ。",
        "official_en": "いつも難しい顔をしてたら、\r\n部下たちも近寄りがたいぞ。\r\nもっとリラックスしていこうぜ。",
        "real_en": "If you're always looking so stern, your men won't feel comfortable approaching you. Loosen up a little."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
