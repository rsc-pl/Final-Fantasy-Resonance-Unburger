    {
      "record_id": "switch:locres:set-02:ST_C01_007_01:007_01_012:46946b60",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_007_01",
        "key": "007_01_012",
        "jp_record_id": "switch:locres:set-02:ST_C01_007_01:007_01_012:46946b60",
        "official_en_record_id": "switch:locres:set-02:ST_C01_007_01:007_01_012:46946b60",
        "jp_sha256": "1b1aa461a387f4f78469c3686b14a962ffad5c7d7ab7be833be023a2fd92b096",
        "official_en_sha256": "1b1aa461a387f4f78469c3686b14a962ffad5c7d7ab7be833be023a2fd92b096"
      },
      "text": {
        "jp": "お前はグランシェルトの騎士の中でも\r\nナンバーワンになれる器だ。\r\n俺はそう思っている。",
        "official_en": "お前はグランシェルトの騎士の中でも\r\nナンバーワンになれる器だ。\r\n俺はそう思っている。",
        "real_en": "I believe you have what it takes to become the best knight in Grandshelt."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_007_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ラスウェル",
          "label_status": "VERIFIED",
