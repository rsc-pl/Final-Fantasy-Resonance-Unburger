        "official_en_sha256": "a73307a31fd9db0b7c042e93dc10cf666c7adc274c1d8d17eaee9a0570e796b4"
      },
      "text": {
        "jp": "それを自分で言うか……。",
        "official_en": "それを自分で言うか……。",
        "real_en": "Do you really have to say it yourself...?"
      },
