        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_061:76368d9d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_02_01",
        "key": "Town_01Gra_02_01_061",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_061:76368d9d",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_061:76368d9d",
        "jp_sha256": "dff22e007e6b85c451124bf965aebb342e1a2ec11e94ba465003f1b2c74ace15",
        "official_en_sha256": "028435b8ca336cf5ae7104bfd6e990ea9bd4aa45076462f8f10f215089189e15"
      },
      "text": {
        "jp": "うちの子があの事件から、\r\n騎士になるってきかないんです。\r\nお母さんのことを守るんだって……。",
        "official_en": "Ever since the attack, my boy’s been saying he wants to <text style=\"italic\">join</> the Order when he grows up. Says he wants to protect me...the sweet little thing.",
        "real_en": "Ever since the attack, my son won't stop saying he wants to become a knight. He says he wants to protect his mom..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_Town_01Gra_02_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "おばさん",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0175",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C01_Town_01Gra_02_01/Town_01Gra_02_01_061"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_095:4e279c67",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_02_01",
        "key": "Town_01Gra_02_01_095",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_095:4e279c67",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_095:4e279c67",
        "jp_sha256": "08872a1104fe9420b23697e49771dfcb5302340d653b4bd35370684de2f1b4e5",
        "official_en_sha256": "79ef9d0fdb61c9d5f044443492142811320d21aea4295104669e3cc1ca50cbc1"
      },
      "text": {
        "jp": "せきぞうの\"きしさま\"も、                \r\nよごれて、元気がないようにみえるね……。  ",
        "official_en": "“Sir Statue” doesn’t look too happy all covered in soot...  ",
        "real_en": "Even the 'knight' statue looks unhappy, all dirty like that..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_Town_01Gra_02_01",
