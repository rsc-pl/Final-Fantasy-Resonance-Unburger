        "official_en_sha256": "cf79e7fd3e6956b1ae45500c9d4b4c05d799c008a680430d0a8e0164fa841460"
      },
      "text": {
        "jp": "それでも、お前たちは行くというのだな。",
        "official_en": "Yet you two will pursue them to fight them head on?",
        "real_en": "And yet you're still going?"
      },
      "review": {
        "status": "CHANGE"
      },
