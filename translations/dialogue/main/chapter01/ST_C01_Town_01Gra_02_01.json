        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_004:7f07b0f6",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_02_01",
        "key": "Town_01Gra_02_01_004",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_004:7f07b0f6",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_004:7f07b0f6",
        "jp_sha256": "e351754ad1b803ff96195a24936c50a51ff8985406028588e045f8fd57924209",
        "official_en_sha256": "c733fb7be1fa8161c976ae2e5375667873cc1971b47522e38196e53e5bbb188d"
      },
      "text": {
        "jp": "ああ、俺だって怖いよ。\r\nでも、次は絶対に負けない。",
        "official_en": "Yes. I’m afraid, too, Charlotte—but we won’t lose.",
        "real_en": "Yeah, I'm scared too. But next time, we absolutely won't lose."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_Town_01Gra_02_01",
