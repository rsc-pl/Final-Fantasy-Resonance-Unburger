  "records": [
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_006:2ff75e81",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_02_01",
        "key": "Town_01Gra_02_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_006:2ff75e81",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_006:2ff75e81",
        "jp_sha256": "1052f40740ca8edd9f25b3c030cdd422e4a05ab3208fbaff860c9465ebda0645",
        "official_en_sha256": "d7ff33b0e6c96a8a4985a4615628a2392bfd6f01c648e359e6f0eef046a7160e"
      },
      "text": {
        "jp": "……強いな、お前たちは。\r\n私もこの命に代えても、\r\nグランシェルトのために戦うと約束しよう。",
        "official_en": "...I almost forgot how stouthearted the two of you are. I shall also do what I can for Grandshelt.",
        "real_en": "...You two are strong. I swear I'll fight for Grandshelt, even if it costs me my life."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C01_Town_01Gra_02_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
