          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_096:38324ca7",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_02_01",
        "key": "Town_01Gra_02_01_096",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_096:38324ca7",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_096:38324ca7",
        "jp_sha256": "88bbf8e0e90885d3070f1bc5bc064fca2cdc4a454e4632c994d8f1b7912a6f8d",
        "official_en_sha256": "8d871c045af97c4e3efc8774ab3648782d9601b8ad2585d5c937fb959b8efb7c"
      },
      "text": {
        "jp": "そうね。あとで綺麗にしてあげましょ。",
        "official_en": "I think you’re right about that, sweetie. What do you say we give him a nice scrub down later? I’m sure he’ll appreciate it.",
        "real_en": "Yes. Let's clean him up later."
      },
      "review": {
        "status": "CHANGE"
      },
