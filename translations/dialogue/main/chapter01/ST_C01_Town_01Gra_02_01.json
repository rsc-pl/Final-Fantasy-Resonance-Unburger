    },
    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_049:d6626965",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_02_01",
        "key": "Town_01Gra_02_01_049",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_049:d6626965",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_049:d6626965",
