    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_085:5773c099",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_02_01",
        "key": "Town_01Gra_02_01_085",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_085:5773c099",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_085:5773c099",
