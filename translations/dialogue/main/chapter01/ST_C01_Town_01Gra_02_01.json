    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_051:ceb36cfb",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_02_01",
        "key": "Town_01Gra_02_01_051",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_051:ceb36cfb",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_051:ceb36cfb",
        "jp_sha256": "f484c54a60266a305a751367dd8791c36b0a0710a5ffdfd88f1ad6c5f67c9acc",
        "official_en_sha256": "20688c384f60cdf8729c5feac7d603a5284d8bb10619b77f11b148882a94b622"
      },
      "text": {
        "jp": "スコットさん、飛空艇団の再建のために\r\n毎日遅くまで頑張ってて……\r\n無理やり休んでもらってるくらいなんです。",
        "official_en": "Scott is working so ardently to rebuild the airship squadron that it is difficult to convince him to rest.",
        "real_en": "Scott-san has been working late every day to rebuild the airship squadron... We practically have to force him to take a break."
      },
      "review": {
        "status": "CHANGE"
      },
