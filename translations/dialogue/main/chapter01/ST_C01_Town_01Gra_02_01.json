    {
      "record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_060:b43e6809",
      "source": {
        "set": "set-02",
        "namespace": "ST_C01_Town_01Gra_02_01",
        "key": "Town_01Gra_02_01_060",
        "jp_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_060:b43e6809",
        "official_en_record_id": "switch:locres:set-02:ST_C01_Town_01Gra_02_01:Town_01Gra_02_01_060:b43e6809",
        "jp_sha256": "9bc16fd2db0feae2501765925d20df4f52fa897a6e09c000db289ebc5df57074",
        "official_en_sha256": "a9b8c42d69a361c8f6c902a0cba96bea06fd521b1285ee70765f913fd44415d6"
      },
      "text": {
        "jp": "ぼく、大きくなったら、\r\n“きしだん”に入るんだー！",
        "official_en": "I’m gonna be a <text style=\"italic\">knight order</> when I grow up!",
        "real_en": "I'm gonna join the knights when I grow up!"
      },
      "review": {
