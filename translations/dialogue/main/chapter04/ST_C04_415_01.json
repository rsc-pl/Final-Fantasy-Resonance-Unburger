        "official_en_sha256": "02336c52aa6abcadd6231d376e58345b5a7515b8330c8dd6ebcb3e55a8a153b9"
      },
      "text": {
        "jp": "俺は帝国軍を抜けて、\r\n反乱軍に加入したんだ。",
        "official_en": "I defected from the imperial military and joined the rebels.",
        "real_en": null
      },
