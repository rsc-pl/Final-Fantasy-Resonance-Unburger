    {
      "record_id": "switch:locres:set-02:ST_C04_415_01:415_01_008:2577f2f4",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_415_01",
        "key": "415_01_008",
        "jp_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_008:2577f2f4",
        "official_en_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_008:2577f2f4",
        "jp_sha256": "ff3762caad139cc422877411cc0decca7f5493916892f5a4943e0a30ee80c8a2",
        "official_en_sha256": "81c16c91ecf17443926ad73b70cda95bfdbe23de6d98bf1fef0f966f2f1fab50"
      },
      "text": {
        "jp": "今ではほとんどの人が\r\nシエラ皇太子に玉座に就いてほしいと願っているんだ。",
        "official_en": "But today, most citizens hope that Prince Shera ascends to the throne.",
        "real_en": "These days, almost everyone wants Crown Prince Shera to take the throne."
      },
      "review": {
        "status": "CHANGE"
      },
