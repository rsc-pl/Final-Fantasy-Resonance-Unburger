    {
      "record_id": "switch:locres:set-02:ST_C04_415_01:415_01_004:a317190e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_415_01",
        "key": "415_01_004",
        "jp_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_004:a317190e",
        "official_en_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_004:a317190e",
