    {
      "record_id": "switch:locres:set-02:ST_C04_415_01:415_01_011:009d1f49",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_415_01",
        "key": "415_01_011",
        "jp_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_011:009d1f49",
        "official_en_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_011:009d1f49",
        "jp_sha256": "5bdad335c8b07415b7304fc2f670768301e91f68d8dd74e6d794867fe0c6c80b",
        "official_en_sha256": "64268e9ca4fb5a9efce780f9c083ec8ce2969eca65b12a4fe07894c91cb3f7df"
      },
      "text": {
        "jp": "ジェイクは一人で反乱軍をつくり\r\nここまでの組織に育て上げた。",
        "official_en": "Jake single-handedly formed the rebel army, and built it into the force it is today.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
