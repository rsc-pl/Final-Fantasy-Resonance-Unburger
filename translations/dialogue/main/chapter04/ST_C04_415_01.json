    {
      "record_id": "switch:locres:set-02:ST_C04_415_01:415_01_009:3223a259",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_415_01",
        "key": "415_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_009:3223a259",
        "official_en_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_009:3223a259",
