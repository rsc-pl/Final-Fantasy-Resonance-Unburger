    {
      "record_id": "switch:locres:set-02:ST_C04_415_01:415_01_001:4e5f8fbd",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_415_01",
        "key": "415_01_001",
        "jp_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_001:4e5f8fbd",
        "official_en_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_001:4e5f8fbd",
