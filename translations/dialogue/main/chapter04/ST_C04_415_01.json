        "official_en_sha256": "569f489c1ec20186ae17471eb1937e3605754a08f8a6a59a818c1ac854c4f39b"
      },
      "text": {
        "jp": "ソゼ皇帝は軍拡を続けている。\r\nそれは防衛ではなく戦争のためだ。",
        "official_en": "Emperor Sozhe continues to expand the military—not for defense, but for war.",
        "real_en": null
      },
      "review": {
