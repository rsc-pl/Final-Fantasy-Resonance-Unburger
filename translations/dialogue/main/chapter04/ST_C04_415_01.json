        "official_en_sha256": "5a360e3002eee02d5f779f847c16bb19c03aa02d4d2d1c6a654df5a50c6b0624"
      },
      "text": {
        "jp": "ジェイクって少しは\r\n信用できる奴なのかも……。",
        "official_en": "I’m thinking maybe Jake...deserves a <text style=\"italic\">little</> trust.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
