    {
      "record_id": "switch:locres:set-02:ST_C04_415_01:415_01_006:527ffbcc",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_415_01",
        "key": "415_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_006:527ffbcc",
        "official_en_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_006:527ffbcc",
        "jp_sha256": "bb9bec602543360f2a3e98babf1f6d47b34e31b281746407b17fca9dcf83deca",
        "official_en_sha256": "b51fa7bc282b49a6c14a3c741ae05d42fc768ad3987a1a6e6531959b66fa6cee"
      },
      "text": {
        "jp": "ソゼ皇帝にはシエラ皇太子という後継者がいる。",
        "official_en": "Crown Prince Shera is in line to succeed Emperor Sozhe on the throne.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
