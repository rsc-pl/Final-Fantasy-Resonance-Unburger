    },
    {
      "record_id": "switch:locres:set-02:ST_C04_415_01:415_01_002:28d4a3ce",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_415_01",
        "key": "415_01_002",
        "jp_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_002:28d4a3ce",
        "official_en_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_002:28d4a3ce",
        "jp_sha256": "9fccfdeb80ceef0079586fe75cda2dbd99e911f052723d4da5a7418348fa89cf",
        "official_en_sha256": "cfde2cf76f3366ac03713bebb44bafd8ec8890253b82409d2e0e4dd587aa062a"
      },
      "text": {
        "jp": "昔の帝国兵は\r\n誰もが憧れる存在だった……。",
        "official_en": "Imperial soldiers used to be admired by everyone.",
        "real_en": null
