    {
      "record_id": "switch:locres:set-02:ST_C04_415_01:415_01_010:abc94da0",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_415_01",
        "key": "415_01_010",
        "jp_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_010:abc94da0",
        "official_en_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_010:abc94da0",
