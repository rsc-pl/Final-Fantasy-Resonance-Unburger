    {
      "record_id": "switch:locres:set-02:ST_C04_415_01:415_01_007:fa65bc29",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_415_01",
        "key": "415_01_007",
        "jp_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_007:fa65bc29",
        "official_en_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_007:fa65bc29",
        "jp_sha256": "9c5e4a8cfb559b567d8c079e6eeb30843408a94a7b5255217fb48fa459569c12",
        "official_en_sha256": "c121fc7e19c3349c75811462db911b0c3d032b0f6b7e6a75d3b4498732104c3b"
      },
      "text": {
        "jp": "シエラ皇太子は優しい心の持ち主でな。\r\n昔はそんな人間に\r\nゾルダードの皇帝が務まるかと批判されていた。",
        "official_en": "He’s a kind-hearted man. So much so that some people doubted he had the mettle to be Zoldaad’s emperor.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
