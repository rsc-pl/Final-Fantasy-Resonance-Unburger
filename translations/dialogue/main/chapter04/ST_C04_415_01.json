        "official_en_sha256": "0b13bfbe7571b7467e6c63cf8ea3026694a62db5b0b68121db4ffe11be34bc0b"
      },
      "text": {
        "jp": "全てはソゼ皇帝が変わってしまったからだ。",
        "official_en": "It’s all because of Emperor Sozhe, and how he changed so radically.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
