        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C04_415_01:415_01_014:f439407a",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_415_01",
        "key": "415_01_014",
        "jp_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_014:f439407a",
        "official_en_record_id": "switch:locres:set-02:ST_C04_415_01:415_01_014:f439407a",
