    {
      "record_id": "switch:locres:set-02:ST_C04_410_01:410_01_008:be1fc30f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_410_01",
        "key": "410_01_008",
        "jp_record_id": "switch:locres:set-02:ST_C04_410_01:410_01_008:be1fc30f",
        "official_en_record_id": "switch:locres:set-02:ST_C04_410_01:410_01_008:be1fc30f",
