        "official_en_sha256": "675656fb1dba60e64837ac92d4fa61aeb4d13d2f5a72ede789a6b1639d987906"
      },
      "text": {
        "jp": "さきほど口にしたのですが、\r\nどうにもゾルダードの水は\r\n私には合わないようです。",
        "official_en": "I just sampled the water here, and I must say, it is not for me.",
        "real_en": null
      },
