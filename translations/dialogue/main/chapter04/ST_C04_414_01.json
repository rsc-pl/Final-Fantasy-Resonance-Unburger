        "official_en_sha256": "141405c2fa3dab4bf6f545684f6cb1ae1e562669d4f3902fc2d8d685880a9926"
      },
      "text": {
        "jp": "それを止めるためにも\r\nお前たちに力を貸してほしいんだ。",
        "official_en": "We’re hoping that you’ll join forces with us to prevent that from happening.",
        "real_en": null
      },
