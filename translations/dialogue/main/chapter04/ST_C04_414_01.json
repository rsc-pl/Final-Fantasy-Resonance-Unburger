    {
      "record_id": "switch:locres:set-02:ST_C04_414_01:414_01_020:b6589649",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_414_01",
        "key": "414_01_020",
        "jp_record_id": "switch:locres:set-02:ST_C04_414_01:414_01_020:b6589649",
