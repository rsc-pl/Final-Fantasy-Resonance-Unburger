        "official_en_sha256": "33bb8a7f6f7227c6c2d258865e763e5096a271b63716fe818574241b250a19c3"
      },
      "text": {
        "jp": "その話が本当なら放ってはおけないけど……。",
        "official_en": "If what you’re saying is true, we’re not going to walk away from this, but...",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
