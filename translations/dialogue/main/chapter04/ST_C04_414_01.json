    {
      "record_id": "switch:locres:set-02:ST_C04_414_01:414_01_017:0dcf30b8",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_414_01",
        "key": "414_01_017",
        "jp_record_id": "switch:locres:set-02:ST_C04_414_01:414_01_017:0dcf30b8",
        "official_en_record_id": "switch:locres:set-02:ST_C04_414_01:414_01_017:0dcf30b8",
