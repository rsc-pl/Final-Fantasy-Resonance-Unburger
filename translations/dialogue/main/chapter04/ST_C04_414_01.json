        "namespace": "ST_C04_414_01",
        "key": "414_01_019",
        "jp_record_id": "switch:locres:set-02:ST_C04_414_01:414_01_019:81b3ac72",
        "official_en_record_id": "switch:locres:set-02:ST_C04_414_01:414_01_019:81b3ac72",
