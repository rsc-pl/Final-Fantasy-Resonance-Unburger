    {
      "record_id": "switch:locres:set-02:ST_C04_414_01:414_01_003:7ee2f73f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_414_01",
        "key": "414_01_003",
        "jp_record_id": "switch:locres:set-02:ST_C04_414_01:414_01_003:7ee2f73f",
        "official_en_record_id": "switch:locres:set-02:ST_C04_414_01:414_01_003:7ee2f73f",
