        "official_en_sha256": "daffa6c1524f96d5dd95ff61a0204941d280b084d74221b526643004a93f5cde"
      },
      "text": {
        "jp": "ここは反乱軍のアジトだ。",
        "official_en": "It’s a rebel hideout.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
