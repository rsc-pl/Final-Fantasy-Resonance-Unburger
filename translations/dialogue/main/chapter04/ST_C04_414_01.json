          "name_entry": "CharaName0067",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C04_414_01/414_01_020"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C04_414_01:414_01_011:16d07b2b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_414_01",
        "key": "414_01_011",
        "jp_record_id": "switch:locres:set-02:ST_C04_414_01:414_01_011:16d07b2b",
        "official_en_record_id": "switch:locres:set-02:ST_C04_414_01:414_01_011:16d07b2b",
