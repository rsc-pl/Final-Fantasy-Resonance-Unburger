    {
      "record_id": "switch:locres:set-02:ST_C04_414_01:414_01_005:12cd26c1",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_414_01",
        "key": "414_01_005",
        "jp_record_id": "switch:locres:set-02:ST_C04_414_01:414_01_005:12cd26c1",
        "official_en_record_id": "switch:locres:set-02:ST_C04_414_01:414_01_005:12cd26c1",
        "jp_sha256": "b78848e634feb9191c3568d271091f459614d23e38681210056f5bf2f60d6f06",
        "official_en_sha256": "93cade57e5520e403346b7431be17ba117d28e80fac9dde4ce305e19ef94166f"
      },
      "text": {
        "jp": "ちょっと、なに勝手に連れてきてんのよ！",
        "official_en": "Whoa, what’re you roping us into!?",
        "real_en": "Hey! Why'd you bring us here without asking?!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
