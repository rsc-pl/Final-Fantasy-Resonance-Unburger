        "official_en_sha256": "64b9751e9351ce3d08b6545cae56f2b9586d0adeba83ad92b4a60c2cda146f08"
      },
      "text": {
        "jp": "それこそゾルダードが\r\n戦争を仕掛ける口実になってしまいますね。",
        "official_en": "It could even be used as a pretext for Zoldaad to initiate a war—the very thing you say you want to prevent.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
