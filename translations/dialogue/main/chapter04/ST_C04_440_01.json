          "evidence_refs": [
            "key-identities:ST_C04_440_01/440_01_008"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C04_440_01:440_01_028:18dc35a2",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_440_01",
        "key": "440_01_028",
        "jp_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_028:18dc35a2",
        "official_en_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_028:18dc35a2",
