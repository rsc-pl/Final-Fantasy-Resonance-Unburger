        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C04_440_01:440_01_011:f01884e3",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_440_01",
        "key": "440_01_011",
        "jp_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_011:f01884e3",
        "official_en_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_011:f01884e3",
        "jp_sha256": "717a670e7a4077acfdb675d3f5bd67bb93e9829d4a3d5ee389c88d0bec670286",
        "official_en_sha256": "4758fa308f96da70722de7df4e406835ce2fd0444779d002972d262dda67cc49"
      },
      "text": {
        "jp": "このインビンシブルに搭載した……。\r\nクリスタル砲があればね。",
        "official_en": "As long as the <text style=\"italic\">Invincible</> is endowed with...my Crystal Cannon.",
        "real_en": "With the Crystal Cannon installed aboard the <text style=\"italic\">Invincible</>."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C04_440_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ラザロフ博士",
