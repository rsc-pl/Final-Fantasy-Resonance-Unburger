        "official_en_sha256": "121845b6b5d1f3083ae4cc506c203b32f1c4dd1f27fcda9212e9d6dde1d862b8"
      },
      "text": {
        "jp": "それなら初代シドが生きていることも\r\n説明がつく……。",
        "official_en": "That would explain why the first Cid is still alive.",
        "real_en": null
      },
      "review": {
