        "official_en_sha256": "a8698ad6931e008a05db924d1ea9a37225f2310c495c126ae0b581af3678f2e1"
      },
      "text": {
        "jp": "いえいえ、事実ですよ。",
        "official_en": "But it’s a fact.",
        "real_en": null
      },
      "review": {
