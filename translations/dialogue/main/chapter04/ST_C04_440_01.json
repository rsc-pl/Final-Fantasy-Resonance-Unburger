          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C04_440_01:440_01_017:b4379e1f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_440_01",
        "key": "440_01_017",
        "jp_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_017:b4379e1f",
        "official_en_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_017:b4379e1f",
        "jp_sha256": "8674bd33d64dad3b419190c8666d7f92d752bd47745f0a2b0ee91748766d4935",
        "official_en_sha256": "a5aa748181acaba2f044129d41540a20677de15e1ceb1b1deb7523893e72be78"
      },
      "text": {
        "jp": "そのあとでじっくりと\r\n私の夢を追求することとしましょう。",
        "official_en": "Then I can thoroughly devote myself to pursuing my dream.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C04_440_01",
