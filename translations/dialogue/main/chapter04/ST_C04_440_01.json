          "name_entry": "CharaName0048",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C04_440_01/440_01_011"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C04_440_01:440_01_029:6fd52d28",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_440_01",
        "key": "440_01_029",
        "jp_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_029:6fd52d28",
        "official_en_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_029:6fd52d28",
        "jp_sha256": "fa8099551bcfd91af23853b4a8e1c8950322e0d40ace2d4ef1b2292d56edee84",
        "official_en_sha256": "3869cfc1cbb902e8fca5cf551895543d119a96ef2dd3bd3f05cf9454c7e8464b"
      },
      "text": {
        "jp": "さて、おしゃべりはここまでです。\r\n世界制圧の前にあなたたちには\r\nここで死んでもらいましょう。",
        "official_en": "I’m afraid our little chat must end here. Before I conquer the world, all of you will die right here at my feet.",
        "real_en": "Well, that's enough talk. Before I conquer the world, I'll have you all die right here."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C04_440_01",
        "sequence": null,
