          "applicability": "REQUIRED",
          "label_jp": "ラザロフ博士",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0048",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C04_440_01/440_01_017"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C04_440_01:440_01_008:ba8c0910",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_440_01",
        "key": "440_01_008",
        "jp_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_008:ba8c0910",
        "official_en_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_008:ba8c0910",
        "jp_sha256": "9125708e38f9daab770a1a8c186b0bd104699d39046f448c38bc26a9c97b2e4f",
        "official_en_sha256": "86dae6d11adbdcc6ba8f0a6dbd954c8efe6952658f0760b86baf9bc4c4c30d75"
      },
      "text": {
        "jp": "それで気が付いたんです。\r\nこの世界は私が支配すれば\r\nよりよい方向に導かれるのではないかと。",
        "official_en": "And then it dawned on me... If I rule this world, I could take it into a better direction.",
        "real_en": "That's when it occurred to me: wouldn't the world be better off if I ruled it?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
