    {
      "record_id": "switch:locres:set-02:ST_C04_440_01:440_01_021:156c9c76",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_440_01",
        "key": "440_01_021",
        "jp_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_021:156c9c76",
        "official_en_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_021:156c9c76",
        "jp_sha256": "88bf9bb32b7c5ea39016279a6755fe5665741e202a531caf01ebf63d8d88ed19",
        "official_en_sha256": "d6f2b302922e85f50aaf602429b727b13c40180c9f73961cde6a53e3fabcb939"
      },
      "text": {
        "jp": "それはズバリ、永遠の命です。",
        "official_en": "Drumroll please... My dream is...attaining eternal life.",
        "real_en": "Quite simply, eternal life."
      },
      "review": {
        "status": "CHANGE"
      },
