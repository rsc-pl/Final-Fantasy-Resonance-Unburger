      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C04_440_01:440_01_032:3cd4ce02",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_440_01",
        "key": "440_01_032",
        "jp_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_032:3cd4ce02",
        "official_en_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_032:3cd4ce02",
        "jp_sha256": "db6f257d30067cc8cdef19dd38f458f17a5788ab808f1bc1228b4ce46204ab83",
        "official_en_sha256": "4cf04b80d14794f5e061a3a005700585420e035c5f1951609f71c6c3f60c4760"
      },
      "text": {
        "jp": "くくくく。\r\nこういった事態も想定して、\r\n私自身の体も肉体改造が施してあるのです。",
        "official_en": "Hee hee hee! I’ve taken on some physical enhancements myself, in anticipation of this moment!",
        "real_en": "Heh heh. I anticipated something like this, so I've modified my own body too."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
