      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C04_440_01:440_01_015:036825a4",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_440_01",
        "key": "440_01_015",
        "jp_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_015:036825a4",
        "official_en_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_015:036825a4",
        "jp_sha256": "83be522b2285c873aebafa64c656ad0245512cf1801fe430611e6aeb54a0b83c",
        "official_en_sha256": "2733b362d597de5e8b5dce494a3e63df5024d15639018ffeb18a307169604145"
      },
      "text": {
        "jp": "つ・ま・り！\r\n空から世界を！　恐怖で支配する！",
        "official_en": "Ergo—ER...GO! I will rule the world from above...in a reign of terror!",
        "real_en": "In other words! I'll rule the world from the skies through fear!"
      },
      "review": {
        "status": "CHANGE"
      },
