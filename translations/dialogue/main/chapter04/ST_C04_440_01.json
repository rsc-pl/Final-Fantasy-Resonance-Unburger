      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C04_440_01:440_01_003:61660cd2",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_440_01",
        "key": "440_01_003",
        "jp_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_003:61660cd2",
        "official_en_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_003:61660cd2",
        "jp_sha256": "5821e51e636d9edcca538a5aa9887822d34d442347e0fd42d7e60f3be0eb8a6d",
        "official_en_sha256": "8b9be59e83e8a5d55a2b03967c752b5de1cd2c88f4f6ffa44b65f09f19ce0201"
      },
      "text": {
        "jp": "てめえだけは許さねえ！\r\nゾルダードをめちゃくちゃにしやがって！",
