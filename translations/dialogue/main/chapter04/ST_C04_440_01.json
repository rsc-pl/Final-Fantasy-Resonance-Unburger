      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C04_440_01:440_01_022:e9e16272",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_440_01",
        "key": "440_01_022",
        "jp_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_022:e9e16272",
        "official_en_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_022:e9e16272",
        "jp_sha256": "6f52bc0c8dd37aa4c99cea26885987cb06bc56bc00bb31bcffb7a68e4cccae8b",
        "official_en_sha256": "e0285a91708c67a6c05ec88df7e8ae77915ae5aabe551ee6b36680dd3df7c6e1"
      },
      "text": {
        "jp": "そんなものがあると思っているのですか？",
        "official_en": "What nonsense. You truly believe that’s possible?",
        "real_en": "Do you really think such a thing exists?"
      },
      "review": {
        "status": "CHANGE"
      },
