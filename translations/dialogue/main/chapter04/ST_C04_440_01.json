    {
      "record_id": "switch:locres:set-02:ST_C04_440_01:440_01_025:d08b8c2b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_440_01",
        "key": "440_01_025",
        "jp_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_025:d08b8c2b",
        "official_en_record_id": "switch:locres:set-02:ST_C04_440_01:440_01_025:d08b8c2b",
        "jp_sha256": "3003eba1e33f92da9c5aa41fea512289413e57830800e0902742beb0460a13cf",
        "official_en_sha256": "548b417d68685a703fd67da1df83590d9d9f0cc950eee7d22b7cb47768621bcb"
      },
      "text": {
        "jp": "お前たちも知っているでしょう。\r\nパラデイアの六盟傑ですよ。",
        "official_en": "I’m sure you’re acquainted with them—the Sworn Six of Paladia.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
