    {
      "record_id": "switch:locres:set-02:ST_C04_427_01:427_01_011:d2b8f72c",
      "source": {
        "set": "set-02",
        "namespace": "ST_C04_427_01",
        "key": "427_01_011",
        "jp_record_id": "switch:locres:set-02:ST_C04_427_01:427_01_011:d2b8f72c",
        "official_en_record_id": "switch:locres:set-02:ST_C04_427_01:427_01_011:d2b8f72c",
        "jp_sha256": "32089fa393893905c9ffafa164290891a547d943b974ab99ed092775b564cb10",
        "official_en_sha256": "02a1c21a76a62e9514fb2fd94182b46eff257918ed9a80fbbfd328fff6bd4111"
      },
      "text": {
        "jp": "いい加減にして！\r\n飛空艇は人と思いを運ぶものよ！\r\n人殺しの道具なんかじゃない！",
        "official_en": "Stop it! Airships should be used to carry people’s hopes and dreams—not for murder!",
        "real_en": "Stop it! Airships are meant to carry people and their hopes! They're not tools for killing!"
      },
      "review": {
        "status": "CHANGE"
      },
