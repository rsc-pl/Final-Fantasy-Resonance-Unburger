        "official_en_sha256": "3eda07d729e2df4cd4fa8e34d397c265ddeb200597a8c2df5ceea56477af66e3"
      },
      "text": {
        "jp": "それよりも……。\r\n先にやっちまって構わねえな？",
        "official_en": "Anyhoo, aren’t you more worried that I’ll put an end to that kid before you?",
        "real_en": "More importantly... You don't mind if I take him out first, do you?"
      },
      "review": {
        "status": "CHANGE"
