    {
      "record_id": "switch:locres:set-02:ST_C05_515_01:515_01_002:c7a4f0bf",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_515_01",
        "key": "515_01_002",
        "jp_record_id": "switch:locres:set-02:ST_C05_515_01:515_01_002:c7a4f0bf",
