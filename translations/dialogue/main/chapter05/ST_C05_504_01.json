    {
      "record_id": "switch:locres:set-02:ST_C05_504_01:504_01_012:1a3c2b94",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_504_01",
        "key": "504_01_012",
        "jp_record_id": "switch:locres:set-02:ST_C05_504_01:504_01_012:1a3c2b94",
