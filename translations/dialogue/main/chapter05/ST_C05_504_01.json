        "official_en_sha256": "5da4549625cf38f8f562c392ef3736c216cfaa4f5b98de187c8181c207842e6b"
      },
      "text": {
        "jp": "そんなことよりも\r\n氷のクリスタルについて知りたいんじゃないのか？",
        "official_en": "Although...are you not more curious about the Ice Crystal?",
        "real_en": "But isn't it the Ice Crystal you really want to know about?"
      },
      "review": {
        "status": "CHANGE"
      },
