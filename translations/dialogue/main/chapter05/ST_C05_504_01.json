        "official_en_sha256": "964b9bb7e0d65068e2fdbce00fbdf301aa58c87c15b514f97a8d34de0ef92ed1"
      },
      "text": {
        "jp": "きたか。\r\nまぁ、くつろぐといい。",
        "official_en": "So you came. Pray, make yourselves comfortable.",
        "real_en": "You're here. Make yourselves comfortable."
      },
