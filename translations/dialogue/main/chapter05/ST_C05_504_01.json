    {
      "record_id": "switch:locres:set-02:ST_C05_504_01:504_01_011:bf9ed588",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_504_01",
        "key": "504_01_011",
        "jp_record_id": "switch:locres:set-02:ST_C05_504_01:504_01_011:bf9ed588",
        "official_en_record_id": "switch:locres:set-02:ST_C05_504_01:504_01_011:bf9ed588",
        "jp_sha256": "14bf7a794e37e428df4124ac598f1c28a75268301f6faa4208b6a4a862c8fb09",
        "official_en_sha256": "32e91f775db859a45fc035d694c20ab25ee9ceaf1590ef5567f044ff2c5559c2"
      },
      "text": {
        "jp": "そのせいで村に\r\nポーションを届けることができなくて……。",
        "official_en": "It’s preventing us from delivering the potions to the village.",
        "real_en": "That's why we haven't been able to deliver the potions to the village..."
      },
      "review": {
        "status": "CHANGE"
      },
