    {
      "record_id": "switch:locres:set-02:ST_C05_504_01:504_01_004:68bbf07a",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_504_01",
        "key": "504_01_004",
        "jp_record_id": "switch:locres:set-02:ST_C05_504_01:504_01_004:68bbf07a",
