        "official_en_sha256": "692845ff16550fb824d55596f434d47d6a9ca6891b20d949843791a0fd9c6359"
      },
      "text": {
        "jp": "お主は旅の目的を忘れてはないか？",
        "official_en": "Have you forgotten why you have come to this land?",
        "real_en": "Have you forgotten the purpose of your journey?"
      },
