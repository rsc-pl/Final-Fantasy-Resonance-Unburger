        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_021:df1dbc8c",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_021",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_021:df1dbc8c",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_021:df1dbc8c",
