        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "テロップ",
          "label_status": "UNKNOWN",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C05_537_ATC/537_ATC_013"
          ]
