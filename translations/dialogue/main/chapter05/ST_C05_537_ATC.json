    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_010:8e180c63",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_010",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_010:8e180c63",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_010:8e180c63",
        "jp_sha256": "bda904209a247ea9a119ac8963c5ae7da4ab23276ab887896db8ac527a46bf0f",
        "official_en_sha256": "d0b6ae91c8a6ca8fdc9d335cbe7f6083960688679b7c48a716b0034f0b78511b"
      },
      "text": {
        "jp": "それしか選べないのなら、真っすぐに進むだけ……。",
        "official_en": "I am determined to walk it.",
        "real_en": "If that's the only choice I have, I'll just keep moving straight ahead..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_537_ATC",
        "sequence": null,
        "speaker": {
