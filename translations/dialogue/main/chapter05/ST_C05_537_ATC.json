    },
    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_020:6bd396c5",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_020",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_020:6bd396c5",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_020:6bd396c5",
