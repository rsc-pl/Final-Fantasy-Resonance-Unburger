    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_012:352e9f09",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_012",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_012:352e9f09",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_012:352e9f09",
        "jp_sha256": "ea95835eccf034baa70cb7922b54212661c90dd8b1b3d9482aaad4e271395479",
        "official_en_sha256": "e8d1d577766395ebfe815b24349a34a52e65c347304cf5eb4705f21a89217593"
      },
      "text": {
        "jp": "何もわからない。何も覚えてない。",
        "official_en": "I don’t know. I don’t remember.",
        "real_en": "I don't know anything. I can't remember anything."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_537_ATC",
