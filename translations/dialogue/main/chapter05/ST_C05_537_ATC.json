        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_006:1c51f73a",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_006",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_006:1c51f73a",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_006:1c51f73a",
        "jp_sha256": "98ce26862e7f8f1ade8e2fefd057316c272900ac465fba1f05641365b4c60d35",
        "official_en_sha256": "bd978905fd492328325b2d32be9e5bd156270b5e1448a55b7112426ed7784d8d"
      },
      "text": {
        "jp": "だって、私は誰も癒すことができないのだから。",
        "official_en": "For I, myself, hold no means of healing others.",
        "real_en": "Because I can't heal anyone myself."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_537_ATC",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "テロップ",
          "label_status": "UNKNOWN",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C05_537_ATC/537_ATC_006"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_005:1e9d2f26",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_005",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_005:1e9d2f26",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_005:1e9d2f26",
        "jp_sha256": "8b20e9a96c01d09f694b2c13fc48d426348552c7d38d6c86983ef0feaba52024",
        "official_en_sha256": "097dd28f47f5bcd23cbb29e637b8e276900ec755d5cd7fd7f5c38dd88871434e"
      },
      "text": {
        "jp": "でも、誰かに癒しを求めるのは甘えだ。",
        "official_en": "...yet I know this is hypocrisy.",
        "real_en": "But relying on someone else to heal me would be selfish."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_537_ATC",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "テロップ",
          "label_status": "UNKNOWN",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C05_537_ATC/537_ATC_005"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_013:35fab293",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_013",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_013:35fab293",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_013:35fab293",
        "jp_sha256": "456478e2864c39f4f41563429ba71a8df119cdbc8e47cb1696b70503cd7eb72e",
        "official_en_sha256": "777abb0cf422874c3813cb3f27bcb3b502b540df637362b130d43fe644473e51"
      },
      "text": {
        "jp": "どこで生まれたのか。今まで何をしてきたのか。",
        "official_en": "Where I was born... All the things I’ve done before...",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_537_ATC",
