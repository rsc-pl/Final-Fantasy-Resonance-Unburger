        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_015:3a77e3b6",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_015",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_015:3a77e3b6",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_015:3a77e3b6",
        "jp_sha256": "8ef9c251333b7e7efeb30883ee685c77b6c3b7353523607793feb9cd2a0c1bef",
        "official_en_sha256": "64e2ada386787406fe80a10da0b87e5447d9c0e682810c3f87af1aa7165d5e9e"
      },
      "text": {
        "jp": "なんにもないのなら、誰からも必要とされない。",
        "official_en": "And I am nothing to anyone, because I have nothing.",
        "real_en": "If I have nothing, no one will need me."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_537_ATC",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "テロップ",
          "label_status": "UNKNOWN",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C05_537_ATC/537_ATC_015"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_018:aeb82fc0",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_018",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_018:aeb82fc0",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_018:aeb82fc0",
        "jp_sha256": "4bfedbdd2a42bb5ba6d64753746be3b3235e3d1c0f5374049fc6658703e3ee71",
        "official_en_sha256": "f2f86a311abbc3b48e4137781353cbbb9191b65083d0966f89dbd615bddcbab2"
      },
      "text": {
        "jp": "なんにもない私が手に入れた大切なもの。",
        "official_en": "I have something now—the most important something that a nothing like me could ever dream of.",
        "real_en": "Something precious that I found, even though I had nothing."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
