        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_016:ca959d69",
        "jp_sha256": "ad8cd00633af5341cc387c6cb7b49f213b089b26d4e6af4302166ef454c61802",
        "official_en_sha256": "ffcf0adabdd8e573d69fe5523f06d0345dae3d998a149189f541f3e096f250d9"
      },
      "text": {
        "jp": "そう思っていたけど……。",
        "official_en": "...That’s what I thought at first.",
        "real_en": "At least, that's what I used to think..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
