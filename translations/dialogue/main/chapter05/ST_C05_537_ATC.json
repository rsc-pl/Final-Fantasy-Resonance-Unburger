        "official_en_sha256": "ee6e073698da7a7b1d1d02ea07f5ef53d5813ceb42cfe5961725879359d1368c"
      },
      "text": {
        "jp": "もう一度、会いたい。",
        "official_en": "I want to see them again.",
        "real_en": null
      },
      "review": {
