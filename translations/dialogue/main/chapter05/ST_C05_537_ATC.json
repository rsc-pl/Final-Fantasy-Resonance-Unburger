    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_004:d9945d67",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_004",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_004:d9945d67",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_004:d9945d67",
        "jp_sha256": "7976de35cde222080708400561120e904262f1a1dfb75ed89fcd74b2a4627c52",
        "official_en_sha256": "26e7ecf06875e210743a12fdf0545ff16c083546911e8c5b2d8bbaf100fb5315"
      },
      "text": {
        "jp": "傷ついた心と体を癒してもらいたいときもある。",
        "official_en": "There are times when I yearn for another to heal my battered body and soul...",
        "real_en": "Sometimes I wish someone would heal my wounded heart and body."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_537_ATC",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "テロップ",
          "label_status": "UNKNOWN",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C05_537_ATC/537_ATC_004"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_019:7fa62e05",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_019",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_019:7fa62e05",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_019:7fa62e05",
        "jp_sha256": "8ba6cc8ace277757bffdde83c3176bb3b2814c0e8c5d8a5821926c1aeae4a875",
        "official_en_sha256": "196fb5bf4ec19d4d0f3f7d854a63a93bca613ddf75aad9ad7859b2159472b8b3"
      },
      "text": {
        "jp": "失いたくない。失いたくないよ。",
        "official_en": "I don’t want to lose it. I <text style=\"italic\">won’t</> lose it.",
        "real_en": "I don't want to lose it. I don't want to lose it."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_537_ATC",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "テロップ",
          "label_status": "UNKNOWN",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C05_537_ATC/537_ATC_019"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_007:dbc58cbe",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_007",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_007:dbc58cbe",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_007:dbc58cbe",
        "jp_sha256": "9a1e9101d6921ef53b6368f4c442ba31bfe2fbc882130170fea16d50bb1c9e6e",
        "official_en_sha256": "7af35e0e74585e32c8b7b101dd8561fe52f627502176ee728e3bf7cb2defe287"
      },
      "text": {
        "jp": "寂しくはない。辛くもない。",
        "official_en": "I am not lonely, nor am I bitter.",
        "real_en": "I'm not lonely. It doesn't hurt."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_537_ATC",
