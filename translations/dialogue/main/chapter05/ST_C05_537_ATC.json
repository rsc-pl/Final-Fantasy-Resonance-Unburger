        "official_en_sha256": "8f0ff8076868139bf069f28c1392c02d63299b19dec4f1e918887fd9d832641a"
      },
      "text": {
        "jp": "みんなに会いたい。",
        "official_en": "I want to see my friends.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
