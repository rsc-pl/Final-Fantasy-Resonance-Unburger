      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_001:eb7b74bb",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_537_ATC",
        "key": "537_ATC_001",
        "jp_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_001:eb7b74bb",
        "official_en_record_id": "switch:locres:set-02:ST_C05_537_ATC:537_ATC_001:eb7b74bb",
        "jp_sha256": "6cbaf111821d9e1315a855e4bcd31976cd6e0ad45706e2d140a509436f26c887",
        "official_en_sha256": "2c0416740e9dbf49d6b8f7af03d41302c8c247fec0bcbce63bad6352f6ca5ce5"
      },
      "text": {
        "jp": "後悔なんかしたことはない。",
        "official_en": "I have done things I’m proud of—and things I’m not, yet I’ve embraced all of the consequences.",
        "real_en": "I've never regretted anything."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_537_ATC",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
