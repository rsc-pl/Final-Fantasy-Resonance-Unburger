    },
    {
      "record_id": "switch:locres:set-02:ST_C05_514_01:514_01_004:f0e40fd8",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_514_01",
        "key": "514_01_004",
        "jp_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_004:f0e40fd8",
        "official_en_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_004:f0e40fd8",
        "jp_sha256": "ce9065ab3abf784dcf0e129a2add17783304604a8dffa063183647fd9c1b945c",
        "official_en_sha256": "fe6d53937babb60a3a2f64b0844c3bbe444a030fde620846e5685ed1eabeb969"
      },
      "text": {
        "jp": "何千年前からの本があると言ったか？\r\nそんな図書館をいつ誰が作ったんだ。",
        "official_en": "You say there are books from across the ages? When was this place even built? And by whom?",
        "real_en": "You said there are books thousands of years old? When and by whom was this library built?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_514_01",
        "sequence": null,
