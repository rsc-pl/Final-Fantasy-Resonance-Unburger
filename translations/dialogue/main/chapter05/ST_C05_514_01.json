    {
      "record_id": "switch:locres:set-02:ST_C05_514_01:514_01_003:b63a9f5e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_514_01",
        "key": "514_01_003",
        "jp_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_003:b63a9f5e",
        "official_en_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_003:b63a9f5e",
        "jp_sha256": "7ae5683567a4478127e384fb9a39a1021d508d53860d0066f2f6bc5afc8ce64c",
        "official_en_sha256": "ebcd231499f70a0603cc8d806a100a9b005cddd3232ba5745ffdb29ceed92c96"
      },
      "text": {
        "jp": "人間では一生かかっても読み切れんよ。",
        "official_en": "For an ordinary human, a lifetime could be spent reading here, yet many tomes would be left untouched.",
        "real_en": "Even a human couldn't finish reading all these books in a lifetime."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
