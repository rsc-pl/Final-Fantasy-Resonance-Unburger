        "jp_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_011:6756c638",
        "official_en_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_011:6756c638",
        "jp_sha256": "d48cd645d43848ec097d17249fb9762b071ecc1e437a23ba1fa7cb456a71e836",
        "official_en_sha256": "8d98ec85eac12182494a44543b12663f90c04f3cddf4a19a767df9a4c6b52e13"
      },
      "text": {
        "jp": "サクラ様、お待ちください。\r\n今、転送装置は動きません。",
        "official_en": "Forgive my interruption, Mistress Sakura. The teleportation device is out of order at the moment.",
        "real_en": "Sakura-sama, please wait. The teleportation device isn't working right now."
      },
      "review": {
        "status": "CHANGE"
