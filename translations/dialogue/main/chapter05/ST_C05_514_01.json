          "label_status": "VERIFIED",
          "name_entry": "CharaName0003",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C05_514_01/514_01_004"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_514_01:514_01_005:1f93d150",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_514_01",
        "key": "514_01_005",
        "jp_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_005:1f93d150",
        "official_en_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_005:1f93d150",
        "jp_sha256": "57d68e851f9c584576e828e692c372f6f4379174cb0364a6e22342f41b6a46d1",
        "official_en_sha256": "bd7b4f752904212c971726bb9e723d1072953aad1edb34abc4c56c643cd791a5"
      },
      "text": {
        "jp": "作ったんじゃない。",
        "official_en": "This library was not constructed as you might imagine.",
        "real_en": "It wasn't built."
      },
      "review": {
        "status": "CHANGE"
      },
