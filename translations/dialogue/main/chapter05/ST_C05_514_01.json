    },
    {
      "record_id": "switch:locres:set-02:ST_C05_514_01:514_01_015:8e470528",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_514_01",
        "key": "514_01_015",
        "jp_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_015:8e470528",
        "official_en_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_015:8e470528",
        "jp_sha256": "b5e9ca84b22f940f37411f003f3eadafab89e0bf4025a8fa5b49920eee466915",
        "official_en_sha256": "934eaa8f68927c90721e79810a3fb32aa02e3bec793550171a8079536b4847be"
      },
      "text": {
        "jp": "古の本には魔物が棲みついていることがあってのう。\r\n本から出てきては悪戯をするのじゃ。",
        "official_en": "Aged tomes often become havens for certain monsters. They have a rather pesky propensity to spring from their dwellings and stir mischief.",
        "real_en": "Sometimes monsters take up residence in ancient books. They come out to play tricks."
      },
      "review": {
        "status": "CHANGE"
