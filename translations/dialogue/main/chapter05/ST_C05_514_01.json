    {
      "record_id": "switch:locres:set-02:ST_C05_514_01:514_01_006:006f9953",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_514_01",
        "key": "514_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_006:006f9953",
        "official_en_record_id": "switch:locres:set-02:ST_C05_514_01:514_01_006:006f9953",
        "jp_sha256": "888261cc19b5931635eb7b1a0e183211f09927cf25a635763f54d6a8f9af1606",
        "official_en_sha256": "7258f5286e4ccad5a915b1b0402f4e4b935d760a3fe42e6ddd41ae2557be72aa"
      },
      "text": {
        "jp": "初めからあったものが、この世界にきたんじゃよ。",
        "official_en": "What had already existed, materialized into this world.",
        "real_en": "It already existed before it came into this world."
      },
      "review": {
        "status": "CHANGE"
      },
