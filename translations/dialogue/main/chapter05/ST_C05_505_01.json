        "official_en_sha256": "11952e5f500b31a2d03e86659482a54a9020d7c74e4479845c53240a8262b391"
      },
      "text": {
        "jp": "村への道に厄介な魔物が出てのう。\r\nこの物好きが、人助けをしたいらしいのじゃ。",
        "official_en": "Some wretched monster is wreaking havoc on the path to the village, and these peculiar folk are feeling charitable.",
        "real_en": "A troublesome monster has appeared on the road to the village. This odd fellow seems eager to help out."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
