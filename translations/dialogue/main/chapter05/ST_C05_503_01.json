        "official_en_sha256": "d308f27dee00e44f189e73e4c07d516044cdd12be8e1318efc27cbcb08bcc222"
      },
      "text": {
        "jp": "お主らよ、よくぞここまでたどり着いたのう。\r\nここが魔道都市ミシディアじゃ。",
        "official_en": "Good travelers, you have done well to find this place. Welcome to Mysidia, the magiapolis.",
        "real_en": "You've done well to make it this far. This is Mysidia, the city of mages."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
