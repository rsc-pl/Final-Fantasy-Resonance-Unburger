        "jp_sha256": "06bd2dbb26e2e0ab26dd7c5397033f3d1c76229bae07daea3fd6d16a553810d0",
        "official_en_sha256": "37e318baa1bb7cb7e00850432af27a57d30560a46029f4aabd42713e890bb54a"
      },
      "text": {
        "jp": "確かに、もう一人のフィーナが知らないことは\r\n再現できないわけですしね。",
        "official_en": "I see. The other Fina’s psyche cannot recreate something it doesn’t know.",
        "real_en": "Right. The other Fina's mind can't recreate what she doesn't know."
      },
