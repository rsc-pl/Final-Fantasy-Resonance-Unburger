        "official_en_sha256": "388b3857e871593a68eebf04a0fd3eb7bd477ae592c7b99a3d65cde7bcb7f667"
      },
      "text": {
        "jp": "レインはフィーナの存在を感じたようなんじゃが、\r\nお主の心に開かない門があってのう。\r\n先に進めないのじゃ。",
        "official_en": "Rain sensed a faint presence of Fina... Yet there is a gate within your mind we cannot open. It has ground our progress to a halt.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
