        "official_en_sha256": "8da1371271b0122b491dcd1d8483c9686e811d984c9209e40047a455d8c2cc8f"
      },
      "text": {
        "jp": "どうだった？\r\nもう一人の私は見つかった？",
        "official_en": "Well then, did you find my other self?",
        "real_en": null
      },
