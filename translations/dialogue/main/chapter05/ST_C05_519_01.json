        "jp_sha256": "614adab9aac94079288c6237344b7bc4c3c5df4bf7811d67244752c5c8670319",
        "official_en_sha256": "5c0ef092477b6c7349897d88dd37bc78967168a9799ebac317bef3ad695e1a4c"
      },
      "text": {
        "jp": "ああ、そうじゃ。\r\nワシらがお主らの星にいる理由は\r\nこの精神世界にいればわかるはずじゃ。",
        "official_en": "Indeed. ’Twill be made clear why we reside on your planet as we explore the Archwitch’s psyche.",
        "real_en": "That's right. You should understand why we're on your planet once you've explored this world of the mind."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_519_01",
        "sequence": null,
