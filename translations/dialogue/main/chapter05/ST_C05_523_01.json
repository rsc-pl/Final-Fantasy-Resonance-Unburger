    {
      "record_id": "switch:locres:set-02:ST_C05_523_01:523_01_013:5a723dbc",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_523_01",
        "key": "523_01_013",
        "jp_record_id": "switch:locres:set-02:ST_C05_523_01:523_01_013:5a723dbc",
        "official_en_record_id": "switch:locres:set-02:ST_C05_523_01:523_01_013:5a723dbc",
