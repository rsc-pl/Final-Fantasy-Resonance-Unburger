      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_523_01:523_01_010:58b00b23",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_523_01",
        "key": "523_01_010",
        "jp_record_id": "switch:locres:set-02:ST_C05_523_01:523_01_010:58b00b23",
        "official_en_record_id": "switch:locres:set-02:ST_C05_523_01:523_01_010:58b00b23",
        "jp_sha256": "23cc459b0e9a8adb768640b6fe2cd70fa66896813a86ce114f28fbca8339c9cf",
        "official_en_sha256": "006c242eea1078b3e3be5f217435d47469b0f7ab717adbc66a04b8804a21f63f"
      },
      "text": {
        "jp": "今更、こんなことを言ってはいけない。\r\nそれはわかっているのだが……。",
        "official_en": "I know it is not fitting to say such things at this point, but...",
        "real_en": null
      },
      "review": {
