    {
      "record_id": "switch:locres:set-02:ST_C05_523_01:523_01_008:e6a7b85e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_523_01",
        "key": "523_01_008",
        "jp_record_id": "switch:locres:set-02:ST_C05_523_01:523_01_008:e6a7b85e",
        "official_en_record_id": "switch:locres:set-02:ST_C05_523_01:523_01_008:e6a7b85e",
        "jp_sha256": "198d936a171628734b15c8731bfdb51fce106cc396511a7945201272b5b7eb58",
        "official_en_sha256": "fd93952d2a3bc25a2a7e428f5fcda2082e8c1965ae9a5515cf1bebf77bd534b0"
      },
      "text": {
        "jp": "命は何よりも尊いものだというのに。",
        "official_en": "Life is too precious a currency to be spent so recklessly.",
        "real_en": "And yet nothing is more precious than life."
      },
      "review": {
        "status": "CHANGE"
      },
