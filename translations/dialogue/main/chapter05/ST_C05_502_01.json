    {
      "record_id": "switch:locres:set-02:ST_C05_502_01:502_01_013:b94b4789",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_502_01",
        "key": "502_01_013",
        "jp_record_id": "switch:locres:set-02:ST_C05_502_01:502_01_013:b94b4789",
        "official_en_record_id": "switch:locres:set-02:ST_C05_502_01:502_01_013:b94b4789",
        "jp_sha256": "a3b2a44d5fdb19d86c0f4ff994c08135e2cc619dba023eb41ef9071613a41bf1",
        "official_en_sha256": "5e190992de73eb33c103cb7c7273799cdded19e78f4ef7c60cbd40cd436946bb"
      },
      "text": {
        "jp": "ミシディアには氷のクリスタルがあるって言われてる。\r\n六盟傑より先に見つけないとな。",
        "official_en": "The Ice Crystal is said to be kept in Mysidia. We better find it before the Sworn Six do.",
        "real_en": "They say the Ice Crystal is in Mysidia. We need to find it before the Sworn Six do."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_502_01",
        "sequence": null,
