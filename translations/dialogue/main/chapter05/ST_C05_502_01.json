      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_502_01:502_01_002:1f3faf76",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_502_01",
        "key": "502_01_002",
        "jp_record_id": "switch:locres:set-02:ST_C05_502_01:502_01_002:1f3faf76",
        "official_en_record_id": "switch:locres:set-02:ST_C05_502_01:502_01_002:1f3faf76",
        "jp_sha256": "307be94f74b13b908c0176dd21623a81c7702e1680f230d35a3b54ac43be68a7",
        "official_en_sha256": "505b99789cfa3d71f21e19a4abdacc2a8045514623ee7b9d75593c6f9bb57baf"
      },
      "text": {
        "jp": "ミシディアを探すための装置は\r\nリドとエヴァンの手を借りて\r\nエンタープライズに搭載しました。",
        "official_en": "I had Lid and Evan install a device on the <text style=\"italic\">Enterprise</> that will help you find Mysidia.",
        "real_en": "With Lid and Evan's help, we installed a device aboard the <text style=\"italic\">Enterprise</> to find Mysidia."
      },
      "review": {
        "status": "CHANGE"
      },
