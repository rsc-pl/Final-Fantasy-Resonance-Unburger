        "official_en_sha256": "2c512e3e7d0eae7a3a2a1e7c7d7605524b7b2fcc9934866904868e2c88c155ef"
      },
      "text": {
        "jp": "みなさん、よくきてくれました。",
        "official_en": "Everyone, my thanks for coming.",
        "real_en": null
      },
