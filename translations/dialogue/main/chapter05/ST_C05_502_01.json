    {
      "record_id": "switch:locres:set-02:ST_C05_502_01:502_01_019:51cde68b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_502_01",
        "key": "502_01_019",
        "jp_record_id": "switch:locres:set-02:ST_C05_502_01:502_01_019:51cde68b",
        "official_en_record_id": "switch:locres:set-02:ST_C05_502_01:502_01_019:51cde68b",
        "jp_sha256": "477b387a616175c8a09551378322780dadd1e5c434ba070c6d3e84a8eb89c8ea",
        "official_en_sha256": "6f12e457f1c9bee238df8d2f02aa0fc123e70e740ace41f5de51c4a8286c3cc9"
      },
      "text": {
        "jp": "フッ。\r\n俺は生き方に美学を持っている。\r\nそれに反することはしない。",
        "official_en": "Hmph. I live for honor. That is one principle I will not betray.",
        "real_en": "Hmph. I have my own code for how I live. I won't act against it."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
