        "official_en_sha256": "01be61946924d140530e4760be12f657b73f46a8263094ba5936933fbaefa0a8"
      },
      "text": {
        "jp": "つまらん情に流されるなよ。",
        "official_en": "Don’t let yourself get lost in pointless emotions.",
        "real_en": null
      },
      "review": {
