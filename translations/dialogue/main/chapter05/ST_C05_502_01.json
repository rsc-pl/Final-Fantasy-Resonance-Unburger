          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C05_502_01/502_01_013"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_502_01:502_01_007:84f05e3d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_502_01",
        "key": "502_01_007",
        "jp_record_id": "switch:locres:set-02:ST_C05_502_01:502_01_007:84f05e3d",
        "official_en_record_id": "switch:locres:set-02:ST_C05_502_01:502_01_007:84f05e3d",
        "jp_sha256": "d9e606c63b9961ccd429bf3e672579f9ef09e6e76f3f5a5738e8038a0ef85f12",
        "official_en_sha256": "1e92641b1099c60d676b94a543a3621361dbc0fa2ee8abdb42ead8293f468f77"
      },
      "text": {
        "jp": "ミシディアの魔法技術を軍事転用すれば\r\n世界最強の国家になる……。\r\n父上はそんなことを考えていたのかもしれません。",
        "official_en": "Presumably, he sought to use Mysidia’s magical technology for military purposes, which would allow us to become the world’s preeminent power.",
        "real_en": "Perhaps Father thought that using Mysidia's magical technology for military purposes would make Zoldaad the strongest nation in the world..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
