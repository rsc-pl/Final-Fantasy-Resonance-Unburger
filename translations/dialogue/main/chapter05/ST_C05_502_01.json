    {
      "record_id": "switch:locres:set-02:ST_C05_502_01:502_01_016:f369ee45",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_502_01",
        "key": "502_01_016",
        "jp_record_id": "switch:locres:set-02:ST_C05_502_01:502_01_016:f369ee45",
        "official_en_record_id": "switch:locres:set-02:ST_C05_502_01:502_01_016:f369ee45",
