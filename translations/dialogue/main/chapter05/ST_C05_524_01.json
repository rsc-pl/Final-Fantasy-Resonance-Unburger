    {
      "record_id": "switch:locres:set-02:ST_C05_524_01:524_01_018:041e7a41",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_524_01",
        "key": "524_01_018",
        "jp_record_id": "switch:locres:set-02:ST_C05_524_01:524_01_018:041e7a41",
        "official_en_record_id": "switch:locres:set-02:ST_C05_524_01:524_01_018:041e7a41",
