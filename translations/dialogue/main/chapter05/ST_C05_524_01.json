        "official_en_sha256": "3df1ce3abf25a015f5c526244ee8be92994b154f96f109dcccfbaa9dd6fd2a5e"
      },
      "text": {
        "jp": "君は元々アルドールにいたのか？",
        "official_en": "You were allied with Aldore before?",
        "real_en": "So you were with Aldore originally?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
