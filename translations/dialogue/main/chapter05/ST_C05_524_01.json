    {
      "record_id": "switch:locres:set-02:ST_C05_524_01:524_01_016:318b2652",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_524_01",
        "key": "524_01_016",
        "jp_record_id": "switch:locres:set-02:ST_C05_524_01:524_01_016:318b2652",
        "official_en_record_id": "switch:locres:set-02:ST_C05_524_01:524_01_016:318b2652",
        "jp_sha256": "c3120466bbdedee06d8fd3e6d2e8525c940500a0e84f21368a84fa3c51531fdf",
        "official_en_sha256": "e5ce7156c06454c2c43b419b6e13ba1e95109748cfa78b260044b26e3fea1865"
      },
      "text": {
        "jp": "戦争なんてどちらが正しいと言い切れないものだけど……。\r\nこの戦争に限っては断言できる。\r\nアルドールはヘスの独立を認めるべきだと。",
        "official_en": "I’ll not be so naïve as to say there is such a thing as a just war... But for this one, I’ll say with absolute certainty that Aldore <text style=\"italic\">must</> recognize Hess’s independence.",
        "real_en": "It's hard to say either side is right in a war... But in this war, I can say one thing for certain: Aldore should recognize Hess's independence."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_524_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "魔人フィーナ",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0072",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C05_524_01/524_01_016"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
