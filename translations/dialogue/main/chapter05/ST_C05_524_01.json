        "jp_record_id": "switch:locres:set-02:ST_C05_524_01:524_01_015:30e5dc27",
        "official_en_record_id": "switch:locres:set-02:ST_C05_524_01:524_01_015:30e5dc27",
        "jp_sha256": "cf4d252ce17e8a3b2dd9091911973027baa4f4f2ba9625871a6c938e73e6a6d6",
        "official_en_sha256": "74eb68283fb2c7b01d46dcd9b4a3323c3074f5ec2cf1f36345db8ca5186c3e15"
      },
      "text": {
        "jp": "ヘスの民は長きに亘って、\r\nアルドールの圧政に苦しんできたわ。",
        "official_en": "The Hessians have suffered under the tyranny of Aldore long enough.",
        "real_en": "The people of Hess have suffered under Aldore's oppression for a long time."
      },
      "review": {
        "status": "CHANGE"
      },
