    {
      "record_id": "switch:locres:set-02:ST_C05_522_01:522_01_012:6a211e39",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_522_01",
        "key": "522_01_012",
        "jp_record_id": "switch:locres:set-02:ST_C05_522_01:522_01_012:6a211e39",
        "official_en_record_id": "switch:locres:set-02:ST_C05_522_01:522_01_012:6a211e39",
