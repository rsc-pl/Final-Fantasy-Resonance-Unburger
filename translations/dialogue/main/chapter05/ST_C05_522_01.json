      "source": {
        "set": "set-02",
        "namespace": "ST_C05_522_01",
        "key": "522_01_007",
        "jp_record_id": "switch:locres:set-02:ST_C05_522_01:522_01_007:3e799c41",
        "official_en_record_id": "switch:locres:set-02:ST_C05_522_01:522_01_007:3e799c41",
