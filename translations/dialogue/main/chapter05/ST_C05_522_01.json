        "official_en_sha256": "eaa6c9aa2cf9799c9be0510bebb71315fd1a5803497df1de65c8fd47c83b48e8"
      },
      "text": {
        "jp": "こちらには人を超えた存在の君もいる。\r\n絶対にこのままでは終わらない。",
        "official_en": "And we have you and your supreme powers to call upon as well. We will not fail here.",
        "real_en": "And with someone like you, who surpasses ordinary humans, on our side, this won't be the end of us."
      },
      "review": {
        "status": "CHANGE"
      },
