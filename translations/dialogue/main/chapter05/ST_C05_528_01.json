        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_528_01:528_01_011:283b6ed5",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_528_01",
        "key": "528_01_011",
        "jp_record_id": "switch:locres:set-02:ST_C05_528_01:528_01_011:283b6ed5",
        "official_en_record_id": "switch:locres:set-02:ST_C05_528_01:528_01_011:283b6ed5",
        "jp_sha256": "efd3132ea9bae0b6d916248afee4c27b70e7ec6aea3d048a51bb27d882d77430",
        "official_en_sha256": "f724be0bb3c61f55675019da36c2bc8307044f441010e76ab786fe4169da1e23"
      },
      "text": {
        "jp": "いや、どうして心の中に\r\n行けない場所があるのかなと思って。",
        "official_en": "It’s nothing. I was just wondering why there would be a place closed off inside your mind.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_528_01",
