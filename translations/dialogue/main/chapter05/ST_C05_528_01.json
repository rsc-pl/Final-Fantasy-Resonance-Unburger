    {
      "record_id": "switch:locres:set-02:ST_C05_528_01:528_01_004:bc4d3f6d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_528_01",
        "key": "528_01_004",
        "jp_record_id": "switch:locres:set-02:ST_C05_528_01:528_01_004:bc4d3f6d",
