    {
      "record_id": "switch:locres:set-02:ST_C05_528_01:528_01_014:22367b91",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_528_01",
        "key": "528_01_014",
        "jp_record_id": "switch:locres:set-02:ST_C05_528_01:528_01_014:22367b91",
        "official_en_record_id": "switch:locres:set-02:ST_C05_528_01:528_01_014:22367b91",
        "jp_sha256": "fd1b59758a656ff6a1c67978eda3c2c5409f13ed19d80f9831904db7b5bf267b",
        "official_en_sha256": "0cda87455ca4b6acbebc0fddec7e93b26b062432ed8a352e347248f251d0448a"
      },
      "text": {
        "jp": "いいのよ、そんなこと気にしなくて。\r\nもう一人の私を助けたいんでしょ。",
        "official_en": "Don’t trouble yourself. Focus on saving her.",
        "real_en": "It's okay. Don't worry about that. You want to save my other self, don't you?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_528_01",
        "sequence": null,
