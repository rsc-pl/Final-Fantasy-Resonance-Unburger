          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C05_528_01/528_01_011"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C05_528_01:528_01_006:580a779e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_528_01",
        "key": "528_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C05_528_01:528_01_006:580a779e",
        "official_en_record_id": "switch:locres:set-02:ST_C05_528_01:528_01_006:580a779e",
        "jp_sha256": "32c2a57241546665d8456b39d70871f93d1a0e42aa9047bb8f1c847db588af52",
        "official_en_sha256": "068912abccb7d6e65593a17c4ff4f026a5178adecff1d7873481a4a46ca7622e"
      },
      "text": {
        "jp": "うむ。\r\nその術を応用すれば\r\n記憶も共有することができるはずじゃ。",
        "official_en": "Indeed. If we follow the same principle as the binding spell, in theory, it shall allow us to share memories, as well.",
        "real_en": "Yes. If we apply that technique, we should be able to share memories too."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
