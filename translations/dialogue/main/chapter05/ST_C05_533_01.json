    {
      "record_id": "switch:locres:set-02:ST_C05_533_01:533_01_015:8b54bc34",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_533_01",
        "key": "533_01_015",
        "jp_record_id": "switch:locres:set-02:ST_C05_533_01:533_01_015:8b54bc34",
        "official_en_record_id": "switch:locres:set-02:ST_C05_533_01:533_01_015:8b54bc34",
        "jp_sha256": "98b9f6e641e8f4f2b036345fa1afecdc164a953d516b1568a22d4774f2027739",
        "official_en_sha256": "5d55ae329b2132fd86c0728dcfb1a9af36921fc7fede1b974666431faa4b4085"
      },
      "text": {
        "jp": "アルドールの上層部は\r\nその技術の提供をヘスに求めた。",
        "official_en": "The leaders of Aldore requested that this technology be shared with them.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
