    {
      "record_id": "switch:locres:set-02:ST_C05_533_01:533_01_018:c6c03efe",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_533_01",
        "key": "533_01_018",
        "jp_record_id": "switch:locres:set-02:ST_C05_533_01:533_01_018:c6c03efe",
        "official_en_record_id": "switch:locres:set-02:ST_C05_533_01:533_01_018:c6c03efe",
        "jp_sha256": "99feaeb8a21fdff06cf7ca73ceea12d89a8a5f7101e57e1cc0748ebb2165c6da",
        "official_en_sha256": "3386c31d6450d6075dc31327c5430dce994d124f257d738deb7042e16d90877b"
      },
      "text": {
        "jp": "アルドールはクリスタルから\r\nエネルギーを生み出すことを禁止し、\r\nヘスの民への抑圧を強めた。",
        "official_en": "In response to this, Aldore forbade the harvesting of power from crystals, and further clamped down on Hess.",
        "real_en": "Aldore forbade generating energy from crystals and tightened its oppression of the people of Hess."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C05_533_01",
