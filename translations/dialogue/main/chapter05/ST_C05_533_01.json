    {
      "record_id": "switch:locres:set-02:ST_C05_533_01:533_01_017:5fb7172d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C05_533_01",
        "key": "533_01_017",
        "jp_record_id": "switch:locres:set-02:ST_C05_533_01:533_01_017:5fb7172d",
        "official_en_record_id": "switch:locres:set-02:ST_C05_533_01:533_01_017:5fb7172d",
        "jp_sha256": "2d77c8a81f3bd3f2c68aeef85e72c94f99e30dcb8d7118735da9d88bb658caed",
        "official_en_sha256": "10b1bc966b586d8fd2864c734e41d703cb5c9987008e4a3fb4ca2cf476023174"
      },
      "text": {
        "jp": "ヘスの民にとって、\r\n代々受け継いだ魔法は\r\n民族の誇りそのものだったからだ。",
        "official_en": "To the Hessians, this breakthrough technology was the culmination of generations of magical heritage—and a great source of cultural pride. As such, they refused to share it freely.",
        "real_en": "To the people of Hess, magic passed down through generations was the very pride of their people."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
