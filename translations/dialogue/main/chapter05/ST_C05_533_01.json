        "key": "533_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C05_533_01:533_01_006:e1b51bac",
        "official_en_record_id": "switch:locres:set-02:ST_C05_533_01:533_01_006:e1b51bac",
