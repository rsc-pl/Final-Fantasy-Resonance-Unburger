    {
      "record_id": "switch:locres:set-02:ST_C02_207_01:207_01_009:d943fa1b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_207_01",
        "key": "207_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C02_207_01:207_01_009:d943fa1b",
