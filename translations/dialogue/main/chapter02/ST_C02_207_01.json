        "official_en_sha256": "efbf94c20b00034a708cb4deb4fb32c0bf76921caee07bd385b2c3c376961dd1"
      },
      "text": {
        "jp": "お前たち、強そうラリ。\r\nお願いだから助けてほしいラリ。",
        "official_en": "Your little posse here looks rugged enough. Think you could lend us a hand?",
        "real_en": "You all look strong, lali. Please, could you help us, lali?"
      },
