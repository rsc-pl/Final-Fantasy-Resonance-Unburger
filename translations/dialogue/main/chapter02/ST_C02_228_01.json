    {
      "record_id": "switch:locres:set-02:ST_C02_228_01:228_01_021:b9afb83f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_228_01",
        "key": "228_01_021",
        "jp_record_id": "switch:locres:set-02:ST_C02_228_01:228_01_021:b9afb83f",
        "official_en_record_id": "switch:locres:set-02:ST_C02_228_01:228_01_021:b9afb83f",
