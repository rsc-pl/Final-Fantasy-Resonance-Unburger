    {
      "record_id": "switch:locres:set-02:ST_C02_228_01:228_01_016:bab3b68a",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_228_01",
        "key": "228_01_016",
        "jp_record_id": "switch:locres:set-02:ST_C02_228_01:228_01_016:bab3b68a",
