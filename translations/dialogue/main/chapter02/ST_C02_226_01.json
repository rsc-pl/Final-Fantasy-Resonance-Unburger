    {
      "record_id": "switch:locres:set-02:ST_C02_226_01:226_01_015:746a8a30",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_226_01",
        "key": "226_01_015",
        "jp_record_id": "switch:locres:set-02:ST_C02_226_01:226_01_015:746a8a30",
