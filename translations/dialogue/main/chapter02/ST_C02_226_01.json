      "source": {
        "set": "set-02",
        "namespace": "ST_C02_226_01",
        "key": "226_01_004",
        "jp_record_id": "switch:locres:set-02:ST_C02_226_01:226_01_004:093df401",
        "official_en_record_id": "switch:locres:set-02:ST_C02_226_01:226_01_004:093df401",
        "jp_sha256": "1642ec39d174f4bacf9f04943616fd82c6f2e742c66351bad0a4a2a1723e3f2a",
        "official_en_sha256": "d7f7c358cf0f83bcba6a322338d22e79332e5a11f89e92caaa3de8619769a6b7"
      },
      "text": {
        "jp": "天風はインビンシブルを復活させて\r\n何をするつもりなんだろう。",
        "official_en": "I’m at my wit’s end as to why Aether had to revive the <text style=\"italic\">Invincible</>.",
        "real_en": "I wonder what Heavenly Wind Veritas intends to do by reviving the Invincible."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C02_226_01",
