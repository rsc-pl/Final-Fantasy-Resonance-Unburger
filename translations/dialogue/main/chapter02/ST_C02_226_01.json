        "official_en_sha256": "efdffe040b336944c167207b42bab8ab417eda9487a300ab7fcdd312fb34e4d5"
      },
      "text": {
        "jp": "それはきっとレインとラスウェルが\r\n側にいるからだと思う。",
        "official_en": "I have you and Lasswell beside me, so that must be why.",
        "real_en": "I think it’s because you and Lasswell are here with me."
      },
      "review": {
        "status": "CHANGE"
