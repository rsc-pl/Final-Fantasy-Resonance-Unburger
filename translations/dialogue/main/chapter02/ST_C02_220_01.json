        "official_en_sha256": "9549c281fca8c29009fda62d186d5aaf8cbd9d913a11d5677d1a0dcb3d961766"
      },
      "text": {
        "jp": "それを邪魔するのならば、\r\n地を這う者にも容赦はしない。",
        "official_en": "Those who stand in our way—earth-groveller or otherwise—will receive no mercy.",
        "real_en": null
      },
      "review": {
