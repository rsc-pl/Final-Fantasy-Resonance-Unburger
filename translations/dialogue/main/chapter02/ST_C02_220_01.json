        "official_en_sha256": "0acd5389e1dbc03c46d811a6c93d5984032ac6a66144c60adc727cb504da0efb"
      },
      "text": {
        "jp": "兵士をこんな目に遭わせたのはあんたなの！？",
        "official_en": "You’re the one who did this to these soldiers!?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
