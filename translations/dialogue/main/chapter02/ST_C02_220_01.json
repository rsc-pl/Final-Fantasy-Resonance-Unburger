        "official_en_sha256": "641f91c3cdb18c378ac4bf725a99dd41f76e5a303d1a6d27b280e63f11a7b072"
      },
      "text": {
        "jp": "俺たちのことなら大丈夫だ。\r\n奴を追ってくれ……。",
        "official_en": "Don’t worry about us. You gotta catch up to him...",
        "real_en": null
