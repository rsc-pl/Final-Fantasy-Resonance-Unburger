    {
      "record_id": "switch:locres:set-02:ST_C02_220_01:220_01_016:f70e0e7c",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_220_01",
        "key": "220_01_016",
        "jp_record_id": "switch:locres:set-02:ST_C02_220_01:220_01_016:f70e0e7c",
