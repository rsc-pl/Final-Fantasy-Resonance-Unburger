        "official_en_sha256": "81c7f0404539466fb5649b4539ca975b85765da9330a4cd9a26d6ee86f867b20"
      },
      "text": {
        "jp": "ひどい怪我……。\r\n何があったの……。",
        "official_en": "These wounds... They weren’t just attacked.",
        "real_en": "Those injuries... What happened here?"
      },
