        "official_en_sha256": "5c46eab30106eaa14fdeb4449f2542d789342630ef29723238bef223fb1ea4fe"
      },
      "text": {
        "jp": "お前たちは俺の部下や\r\nグランシェルトの兵士たちを殺した！",
        "official_en": "You bastards killed Grandsheltian soldiers, including my men!",
        "real_en": "You killed my men and the soldiers of Grandshelt!"
      },
