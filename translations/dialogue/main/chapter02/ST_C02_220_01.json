        "official_en_sha256": "ee67bcdc81d62a92196769b44ccc6fae1a43002099e29ad455f9364bfb53e9d1"
      },
      "text": {
        "jp": "うう……。\r\nいきなり突風に包まれて……。",
        "official_en": "Ugh... A violent gale came out of nowhere...tore us to pieces...",
        "real_en": "Ugh... We were suddenly surrounded by a violent gust of wind..."
