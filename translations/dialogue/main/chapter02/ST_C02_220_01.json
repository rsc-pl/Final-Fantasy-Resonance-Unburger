    {
      "record_id": "switch:locres:set-02:ST_C02_220_01:220_01_012:29f47e76",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_220_01",
        "key": "220_01_012",
        "jp_record_id": "switch:locres:set-02:ST_C02_220_01:220_01_012:29f47e76",
        "official_en_record_id": "switch:locres:set-02:ST_C02_220_01:220_01_012:29f47e76",
        "jp_sha256": "cf98f1044f908aacac6b7ae66a4706a4d73e070c4cbdc2ef9a01edf93c19312e",
        "official_en_sha256": "d062334ca2c39d59bda1800ce60c0c312073c58b2fd4bf6f662d2ca291f4b8cd"
      },
      "text": {
        "jp": "地を這う者に\r\n俺の姿を見せる価値などない。",
        "official_en": "For what reason would I reveal myself to an earth-groveller such as you?",
        "real_en": "There’s no reason to show myself to someone who crawls on the earth."
      },
      "review": {
        "status": "CHANGE"
