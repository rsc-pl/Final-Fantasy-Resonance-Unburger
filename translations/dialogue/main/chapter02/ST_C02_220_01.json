    },
    {
      "record_id": "switch:locres:set-02:ST_C02_220_01:220_01_014:a6f79d74",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_220_01",
        "key": "220_01_014",
        "jp_record_id": "switch:locres:set-02:ST_C02_220_01:220_01_014:a6f79d74",
        "official_en_record_id": "switch:locres:set-02:ST_C02_220_01:220_01_014:a6f79d74",
