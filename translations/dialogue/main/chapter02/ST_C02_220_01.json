        "official_en_sha256": "8579bd37e39137c1834bc3f644a1d1d7c866393822cf9000bd072025fd582219"
      },
      "text": {
        "jp": "俺はパラデイアの六盟傑の１人、\r\n天風のヴェリアス。",
        "official_en": "I am Veritas of the Heavens, one of the Sworn Six of Paladia.\r\nSome call me Aether.",
        "real_en": "I’m one of Paladia’s Sworn Six.\r\nHeavenly Wind Veritas."
      },
      "review": {
        "status": "CHANGE"
      },
