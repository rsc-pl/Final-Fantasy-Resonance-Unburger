        "namespace": "ST_C02_220_01",
        "key": "220_01_019",
        "jp_record_id": "switch:locres:set-02:ST_C02_220_01:220_01_019:814af40b",
        "official_en_record_id": "switch:locres:set-02:ST_C02_220_01:220_01_019:814af40b",
