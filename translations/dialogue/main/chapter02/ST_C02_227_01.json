    {
      "record_id": "switch:locres:set-02:ST_C02_227_01:227_01_005:0de774e1",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_227_01",
        "key": "227_01_005",
        "jp_record_id": "switch:locres:set-02:ST_C02_227_01:227_01_005:0de774e1",
        "official_en_record_id": "switch:locres:set-02:ST_C02_227_01:227_01_005:0de774e1",
        "jp_sha256": "4dd786a4ccb556386c7fd48e647413d4d92364fcdb9afb43cbe1c7eb0f3f79f1",
        "official_en_sha256": "59f90f299893b0d100f5ff49a334b400127e418644aba63bbbb6f2d16021fc69"
      },
      "text": {
        "jp": "初代シドがなんで生きてるのか。\r\nどうして天風になったのか。",
        "official_en": "But why is the first Cid still alive? How did he become Aether?",
        "real_en": "Why is the first Cid still alive? And how did he become Heavenly Wind Veritas?"
      },
      "review": {
