          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C02_227_01:227_01_019:94de6b93",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_227_01",
        "key": "227_01_019",
        "jp_record_id": "switch:locres:set-02:ST_C02_227_01:227_01_019:94de6b93",
