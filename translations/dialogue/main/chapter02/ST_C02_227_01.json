    {
      "record_id": "switch:locres:set-02:ST_C02_227_01:227_01_015:177c9f41",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_227_01",
        "key": "227_01_015",
        "jp_record_id": "switch:locres:set-02:ST_C02_227_01:227_01_015:177c9f41",
        "official_en_record_id": "switch:locres:set-02:ST_C02_227_01:227_01_015:177c9f41",
        "jp_sha256": "22b179021b94c06e74a5c4aa48fc93dd6b73bec9dd09a393d9ade12db2426697",
        "official_en_sha256": "f70f5c58b6fbec5eafe27ec41e45439625de11bc47832576378b610405da9706"
      },
      "text": {
        "jp": "大雨の日もあれば、強い風が吹くときもある。\r\nそれでも必ず空は晴れる。",
        "official_en": "There are rainy days, and windy days, but it always clears up in the end.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
