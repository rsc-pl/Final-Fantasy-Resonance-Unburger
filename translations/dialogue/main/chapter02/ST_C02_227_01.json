    {
      "record_id": "switch:locres:set-02:ST_C02_227_01:227_01_017:37373370",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_227_01",
        "key": "227_01_017",
        "jp_record_id": "switch:locres:set-02:ST_C02_227_01:227_01_017:37373370",
        "official_en_record_id": "switch:locres:set-02:ST_C02_227_01:227_01_017:37373370",
        "jp_sha256": "307891f8f06066a2ec18151e4aebf3c6ec4fb5f3d07dde8462537f921edb7306",
        "official_en_sha256": "d21dcdfd989362475ba90416a9e5268416e0768bee2287ce94c07ca994147e68"
      },
      "text": {
        "jp": "怒ったり、悲しんだり、\r\n悩んだりすることもあるけど、\r\n夢を諦めたりはしないから。",
        "official_en": "Sometimes I’m angry, or sad, or troubled, but I never give up on my dreams.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C02_227_01",
