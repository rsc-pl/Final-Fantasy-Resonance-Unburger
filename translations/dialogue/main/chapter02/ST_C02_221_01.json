      },
      "text": {
        "jp": "地を這う者よ。\r\nお前はなにも知らない。",
        "official_en": "Your words betray your cluelessness, earth-groveller.",
        "real_en": "You who crawl upon the earth know nothing."
      },
      "review": {
        "status": "CHANGE"
      },
