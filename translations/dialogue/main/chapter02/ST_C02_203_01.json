    {
      "record_id": "switch:locres:set-02:ST_C02_203_01:203_01_014:cbab337f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_203_01",
        "key": "203_01_014",
        "jp_record_id": "switch:locres:set-02:ST_C02_203_01:203_01_014:cbab337f",
