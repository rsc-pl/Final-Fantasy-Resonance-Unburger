        "official_en_sha256": "a5e423f309739050bc12dfb777a476227de438d30f165dd9e05c47a09a6303ca"
      },
      "text": {
        "jp": "え？\r\n飛空艇を買う？",
        "official_en": "Wait, you can buy them?",
        "real_en": "Huh? Buy an airship?"
      },
