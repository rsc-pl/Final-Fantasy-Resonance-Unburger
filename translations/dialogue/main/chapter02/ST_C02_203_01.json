    {
      "record_id": "switch:locres:set-02:ST_C02_203_01:203_01_012:e6684845",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_203_01",
        "key": "203_01_012",
        "jp_record_id": "switch:locres:set-02:ST_C02_203_01:203_01_012:e6684845",
        "official_en_record_id": "switch:locres:set-02:ST_C02_203_01:203_01_012:e6684845",
        "jp_sha256": "034d2d3dccfd08b81e86ec5d8c106570a81f019851e475ad6796463487928b40",
        "official_en_sha256": "58725e946c926deccd9f5b4c0a40973c98ec2caedb2ee55f8a3f44e357651c2b"
      },
      "text": {
        "jp": "ああ。造船所に行ってみようと思う。\r\nリドっていう自作の飛空艇を持っている人がいるらしいんだ。",
        "official_en": "Yeah. We should head to the shipyard. There’s a person named Lid there who apparently has her own homebuilt ship.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
