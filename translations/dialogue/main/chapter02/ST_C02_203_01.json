    {
      "record_id": "switch:locres:set-02:ST_C02_203_01:203_01_002:4ab13afe",
      "source": {
        "set": "set-02",
        "namespace": "ST_C02_203_01",
        "key": "203_01_002",
        "jp_record_id": "switch:locres:set-02:ST_C02_203_01:203_01_002:4ab13afe",
        "official_en_record_id": "switch:locres:set-02:ST_C02_203_01:203_01_002:4ab13afe",
        "jp_sha256": "15b1d0d97253f67d6e1674bc9adcd75c8fd08ed99a4919f36cc4961aa352f7d2",
        "official_en_sha256": "6a4b008a970c3497183292f64ff89b9e5980595bb5604af2b06607007aa25cca"
      },
      "text": {
        "jp": "険しい道のりだからな……\r\n歩いて行けなくもないが魔物も多い。\r\n俺なら飛空艇以外では行きたくないね。",
        "official_en": "It’s a real tough road. And if you’re thinking of hoofing it, it’s chock-full of monsters. I’d never go except by air.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
