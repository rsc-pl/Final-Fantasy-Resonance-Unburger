        "official_en_sha256": "2f580bdb2ed2de5d956dfa68a77ad59da54a3762fb570f8c3ea3feda42cd5da6"
      },
      "text": {
        "jp": "ここが滝の回廊です。\r\n水の神殿に行くためには、封印を解く魔法が必要です。",
        "official_en": "This is Waterfall Way. If we are to enter the Water Shrine, we’ll need the magic that’s deep within to undo the seal around the shrine.",
        "real_en": "This is Waterfall Way. To reach the Water Shrine, we need magic to undo the seal around it."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C03_321_01",
