    {
      "record_id": "switch:locres:set-02:ST_C03_321_01:321_01_026:d39b5ca2",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_321_01",
        "key": "321_01_026",
        "jp_record_id": "switch:locres:set-02:ST_C03_321_01:321_01_026:d39b5ca2",
