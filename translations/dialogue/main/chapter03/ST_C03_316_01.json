        "official_en_sha256": "711b959fed04363e45dfcdafe357a482b8dbdf9da3ac2ba990b27949e9cba508"
      },
      "text": {
        "jp": "大勢の人に奉仕するのではなく\r\nたった１人……特別な誰かのために\r\n自分の全てを捧げる生き方に憧れるんです。",
        "official_en": "大勢の人に奉仕するのではなく\r\nたった１人……特別な誰かのために\r\n自分の全てを捧げる生き方に憧れるんです。",
        "real_en": "Instead of serving so many people, I long to devote everything I have to just one person... someone special."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
