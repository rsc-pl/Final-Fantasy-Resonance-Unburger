    {
      "record_id": "switch:locres:set-02:ST_C03_316_01:316_01_004:985ef071",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_316_01",
        "key": "316_01_004",
        "jp_record_id": "switch:locres:set-02:ST_C03_316_01:316_01_004:985ef071",
        "official_en_record_id": "switch:locres:set-02:ST_C03_316_01:316_01_004:985ef071",
        "jp_sha256": "18cee7ae70f8f612316a9b325903cf765398a7309585e5856a036b2f2a7d967b",
        "official_en_sha256": "18cee7ae70f8f612316a9b325903cf765398a7309585e5856a036b2f2a7d967b"
      },
      "text": {
        "jp": "だけどさ、１人の命と１００人の命、\r\nどっちかしか助けられないって\r\nどうして最初っから諦めてるんだ？",
        "official_en": "だけどさ、１人の命と１００人の命、\r\nどっちかしか助けられないって\r\nどうして最初っから諦めてるんだ？",
        "real_en": "But why give up from the start and assume you have to choose between saving one life and saving a hundred?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
