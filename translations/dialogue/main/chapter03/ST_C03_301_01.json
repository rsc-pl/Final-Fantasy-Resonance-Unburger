        "official_en_sha256": "546239714c9ce1765da97d15968190bfbb45765dea31844f1a1811dd51bac5fd"
      },
      "text": {
        "jp": "ああ、そうそう。\r\nそこのさえない坊や。",
        "official_en": "Ah, and you over there, you sullen boy.",
        "real_en": "Oh, right. You there, you rather unimpressive little boy."
      },
      "review": {
        "status": "CHANGE"
      },
