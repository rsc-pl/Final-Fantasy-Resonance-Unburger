        "jp_record_id": "switch:locres:set-02:ST_C03_301_01:301_01_013:ac3eb5be",
        "official_en_record_id": "switch:locres:set-02:ST_C03_301_01:301_01_013:ac3eb5be",
        "jp_sha256": "580b6e86966a7b7176a6f0b974d6511aed50aed2ed9565a38abb7221d8c95b6d",
        "official_en_sha256": "fe4bfad2b3f0a6f3e7df9c2d3fbba9f589fe5f8ba00193b4aaa09ef011803563"
      },
      "text": {
        "jp": "困ったわ。\r\n私、手加減するのって苦手なのよね。",
        "official_en": "That’s a frightful shame. I don’t pull my punches, you see.",
        "real_en": "Oh dear. I'm not very good at holding back, you see."
