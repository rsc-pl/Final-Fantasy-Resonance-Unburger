    {
      "record_id": "switch:locres:set-02:ST_C03_301_01:301_01_008:ec5586df",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_301_01",
        "key": "301_01_008",
        "jp_record_id": "switch:locres:set-02:ST_C03_301_01:301_01_008:ec5586df",
        "official_en_record_id": "switch:locres:set-02:ST_C03_301_01:301_01_008:ec5586df",
