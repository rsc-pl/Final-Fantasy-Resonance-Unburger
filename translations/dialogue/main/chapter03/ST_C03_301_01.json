        "official_en_sha256": "c76c9273e68cf140f699e80df51d64c1d241f212338d01347d9fe8081d5cc168"
      },
      "text": {
        "jp": "あら、つまらない反応ね。\r\n動揺する姿が見たかったのに。",
        "official_en": "My, how dull. I was hoping to see you all a tither.",
        "real_en": "Oh, how boring. I wanted to see you get upset."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
