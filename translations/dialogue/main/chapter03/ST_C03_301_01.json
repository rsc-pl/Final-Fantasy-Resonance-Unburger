    {
      "record_id": "switch:locres:set-02:ST_C03_301_01:301_01_017:25db27b7",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_301_01",
        "key": "301_01_017",
        "jp_record_id": "switch:locres:set-02:ST_C03_301_01:301_01_017:25db27b7",
