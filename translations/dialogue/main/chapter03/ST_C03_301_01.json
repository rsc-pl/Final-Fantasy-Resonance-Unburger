        "official_en_sha256": "8ab617bfabefd3460ea8fddc1b06e44ac9c169915332e3bb8cceb136dd30274c"
      },
      "text": {
        "jp": "せっかくなんだから\r\n人が苦しむところをいっぱい見たいじゃない。",
        "official_en": "Why indeed, when there’s so much more room to inflict pain and suffering?",
        "real_en": "Since we’ve got the chance, I want to see as many people suffering as possible."
      },
      "review": {
        "status": "CHANGE"
      },
