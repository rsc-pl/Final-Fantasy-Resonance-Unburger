          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C03_306_01:306_01_024:b4b053df",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_306_01",
        "key": "306_01_024",
        "jp_record_id": "switch:locres:set-02:ST_C03_306_01:306_01_024:b4b053df",
