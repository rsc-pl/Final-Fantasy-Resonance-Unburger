        "official_en_sha256": "490a7c0470c1c89397c68c1c06824dc2c76c61ae1a218c01e40ff0d68533de62"
      },
      "text": {
        "jp": "ええ。\r\nそれではよろしくお願いします。",
        "official_en": "Correct. I appreciate your helping us in this endeavor.",
        "real_en": "Yes. Then I'm counting on you."
      },
      "review": {
        "status": "CHANGE"
