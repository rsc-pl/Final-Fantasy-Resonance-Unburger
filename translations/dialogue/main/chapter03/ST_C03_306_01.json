          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C03_306_01:306_01_013:baed68d0",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_306_01",
        "key": "306_01_013",
        "jp_record_id": "switch:locres:set-02:ST_C03_306_01:306_01_013:baed68d0",
        "official_en_record_id": "switch:locres:set-02:ST_C03_306_01:306_01_013:baed68d0",
        "jp_sha256": "90617f7640e4450df21d32bd63d70172e2554e990370fa5432dca632147f8b42",
        "official_en_sha256": "5a03db57465fd02d0757240228b2483247df0233ca38d964a74cca24e448a997"
      },
      "text": {
        "jp": "ええ、正直にいうとその通りです。\r\n今はモーグリの手も借りたい。",
        "official_en": "Yes, if I’m being honest, it is as you say. We’re stretched thin like a flattened flan. Right now, we need all the help we can get.",
        "real_en": "Yes, to be honest. Right now, I’d even take a moogle’s help."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C03_306_01",
