    {
      "record_id": "switch:locres:set-02:ST_C03_306_01:306_01_014:8c34ee01",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_306_01",
        "key": "306_01_014",
        "jp_record_id": "switch:locres:set-02:ST_C03_306_01:306_01_014:8c34ee01",
        "official_en_record_id": "switch:locres:set-02:ST_C03_306_01:306_01_014:8c34ee01",
        "jp_sha256": "0e3007525a68f26d9fd62b57f69a9f298072c239a39211d160d8d0656f2d8b84",
        "official_en_sha256": "b5cf293fe25d41f29b31948feda930e360f78d78cd6045258fd8865b162f2b30"
      },
      "text": {
        "jp": "あなた方は街へ戻り防備を固めてください。\r\n私はこの者たちと巫女を救出にいきます。",
        "official_en": "You men head back to the aquapolis and strengthen our defenses. I’m going with these people to save the Maiden.",
        "real_en": "All of you, return to the city and reinforce its defenses. I'll go with these people to rescue the Maiden."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C03_306_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ニコル",
