      },
      "text": {
        "jp": "……一緒に戦うのなら黙ってやれ。",
        "official_en": "If I agree to fight with you, will you shut the hell up?",
        "real_en": "If you’re going to fight with me, then do it quietly."
      },
      "review": {
        "status": "CHANGE"
