        "official_en_sha256": "27a96a79e608c98d3e4817aa9421afdf2edab8e7a5905bc2530791a5243e34dc"
      },
      "text": {
        "jp": "だから、少しも怖くなかった。\r\nこんなに頼もしい人はいません。",
        "official_en": "I haven’t been the least bit scared because I’ve got you to keep me safe.",
        "real_en": "That’s why I wasn’t afraid at all. I can’t imagine anyone more dependable."
      },
      "review": {
        "status": "CHANGE"
      },
