    {
      "record_id": "switch:locres:set-02:ST_C03_313_01:313_01_003:67f9bf8f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_313_01",
        "key": "313_01_003",
        "jp_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_003:67f9bf8f",
        "official_en_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_003:67f9bf8f",
        "jp_sha256": "7b30dbb78ce4a1bac81d5a991fb1d57c8ac2d86cd0b01abf7a3b89488c7e3085",
        "official_en_sha256": "d70d52938c62b41c200c70580f04903f428f1d75dd45d2f904d1d159377d5534"
      },
      "text": {
        "jp": "さあ、ちゃっちゃとやっつけるわよ！",
        "official_en": "Helping you take out the trash, of course. C’mon, El!",
        "real_en": "Come on, let’s finish it off!"
      },
      "review": {
        "status": "CHANGE"
      },
