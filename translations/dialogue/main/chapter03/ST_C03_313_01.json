        "jp_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_001:1ea1e325",
        "official_en_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_001:1ea1e325",
        "jp_sha256": "ddbf2379ef511da67aadab7f3cc50c4964759fbf9def3d7dd50615ae00455493",
        "official_en_sha256": "598eb8aa9d2fddce06788db80cb1f3e0b234197ffe789cc1dd70272e24ac4540"
      },
      "text": {
        "jp": "エル！",
        "official_en": "El!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
