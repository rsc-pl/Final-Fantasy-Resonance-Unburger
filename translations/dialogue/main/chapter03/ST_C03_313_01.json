    },
    {
      "record_id": "switch:locres:set-02:ST_C03_313_01:313_01_007:f008ffc9",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_313_01",
        "key": "313_01_007",
        "jp_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_007:f008ffc9",
        "official_en_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_007:f008ffc9",
        "jp_sha256": "2ba723adea4e9076dbcee05d448caaa4eaa23b471aeb3897fb9085491590e1b0",
        "official_en_sha256": "ca3f292be62d2a915bf5315f316ef931f82186e915a4d3857fd37efc21fb7ef5"
      },
      "text": {
        "jp": "嫌味を言うな……。\r\n俺が頼りなさそうだから助けにきたんだろ？",
        "official_en": "I don’t need your snide remarks. You only came to help because you don’t think I’m competent, right?",
        "real_en": "Don’t be sarcastic... You only came because I looked like I couldn’t handle this on my own, right?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C03_313_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "エル",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0070",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C03_313_01/313_01_007"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C03_313_01:313_01_008:d80989fc",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_313_01",
        "key": "313_01_008",
        "jp_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_008:d80989fc",
        "official_en_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_008:d80989fc",
        "jp_sha256": "83bdb8332f3899f17a32c23353db3d9f3abd921ecf86539dd79010b53cb25bf1",
        "official_en_sha256": "8db2fd2b8a70466612038c823fad64c83127a7d65d90c3678c2483dd6d124a5b"
      },
      "text": {
        "jp": "頼りないわけないだろ？\r\nたった１人で大事な人を助けにいく\r\n勇気を持っているんだから。",
        "official_en": "The heck are you talking about? You went off all alone to save someone important to you—that’s not incompetence, that’s bravery.",
        "real_en": "Of course we can count on you! You had the courage to go save someone important to you all on your own."
      },
      "review": {
        "status": "CHANGE"
