    {
      "record_id": "switch:locres:set-02:ST_C03_313_01:313_01_004:8713ea90",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_313_01",
        "key": "313_01_004",
        "jp_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_004:8713ea90",
        "official_en_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_004:8713ea90",
        "jp_sha256": "d4f90523b8f891c50521b5cc1ec44daec9b35fa90729e8a1748579e950df0bbe",
        "official_en_sha256": "e388c06eb5abbc42b303193fed240ecebb2304fb1c7b2390ca228a928bcf72b0"
      },
      "text": {
        "jp": "そんな状況に見えるか？\r\nこれが。",
        "official_en": "Do you realize what we’re up against!?",
        "real_en": "Does it look that easy to you!?"
      },
      "review": {
        "status": "CHANGE"
      },
