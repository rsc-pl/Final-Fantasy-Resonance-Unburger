    },
    {
      "record_id": "switch:locres:set-02:ST_C03_313_01:313_01_009:5af47898",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_313_01",
        "key": "313_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_009:5af47898",
        "official_en_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_009:5af47898",
        "jp_sha256": "d0e7caaac56569c1ce85fd9e8ae6eae45b7ca74d7247b41fcfb85f504f64df16",
        "official_en_sha256": "e008d20c0e7eb889d856f7b6284b411ad549eaa19ef066e50ab2d482d2a35e82"
      },
      "text": {
        "jp": "はい。\r\nエルは私を守って必死に戦ってくれました。",
        "official_en": "He speaks the truth, El. You have fought hard to protect me.",
        "real_en": "Yes. El fought desperately to protect me."
      },
      "review": {
        "status": "CHANGE"
