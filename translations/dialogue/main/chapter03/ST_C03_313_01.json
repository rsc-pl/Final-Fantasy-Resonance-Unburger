    {
      "record_id": "switch:locres:set-02:ST_C03_313_01:313_01_006:bfb1d5ba",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_313_01",
        "key": "313_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_006:bfb1d5ba",
        "official_en_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_006:bfb1d5ba",
        "jp_sha256": "036126c62b5b64a8b0faed671b4e2992660588bf54985801ef20a7332c3f86ec",
        "official_en_sha256": "b33a6ae5bb94b6ad4da60a375595f4d89d67e78806b0657ac37cb23261665e7f"
      },
      "text": {
        "jp": "なに、俺たちとエルで戦えば楽勝さ。",
        "official_en": "We’re fine. This’ll be a cakewalk with El at our side.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
