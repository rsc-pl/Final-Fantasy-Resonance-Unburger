    {
      "record_id": "switch:locres:set-02:ST_C03_313_01:313_01_010:4a701757",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_313_01",
        "key": "313_01_010",
        "jp_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_010:4a701757",
        "official_en_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_010:4a701757",
