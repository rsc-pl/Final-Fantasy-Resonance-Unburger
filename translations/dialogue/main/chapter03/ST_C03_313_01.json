        "official_en_sha256": "b71219ad93aaca96caf198163f61746a82b636628dbd4bcd2b39a4c179bed3d2"
      },
      "text": {
        "jp": "たしかにちょっと強そうかも……！",
        "official_en": "Well, I guess it does look a <text style=\"italic\">little</> strong...",
        "real_en": null
      },
      "review": {
