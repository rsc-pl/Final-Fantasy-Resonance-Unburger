    {
      "record_id": "switch:locres:set-02:ST_C03_313_01:313_01_002:6bbc0d6a",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_313_01",
        "key": "313_01_002",
        "jp_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_002:6bbc0d6a",
        "official_en_record_id": "switch:locres:set-02:ST_C03_313_01:313_01_002:6bbc0d6a",
