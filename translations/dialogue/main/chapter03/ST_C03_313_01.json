        "official_en_sha256": "5ca13612e706f600796f3f6b97ebebe1789538a426388d3f81b9a6d3fdff1ebb"
      },
      "text": {
        "jp": "ああ、いくぞ！",
        "official_en": "That’s all I wanted to hear. Let’s do this!",
        "real_en": "Yeah, let’s go!"
      },
      "review": {
        "status": "CHANGE"
