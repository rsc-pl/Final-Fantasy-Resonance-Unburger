        "official_en_sha256": "e67458f612ae601c9954877de0178c3fd47b0237d2b8ca62af443c3b98e59501"
      },
      "text": {
        "jp": "お前ら、どうして？",
        "official_en": "What are you doing here?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
