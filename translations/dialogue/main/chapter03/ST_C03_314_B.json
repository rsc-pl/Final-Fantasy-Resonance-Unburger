    {
      "record_id": "switch:locres:set-02:ST_C03_314_B:314_B_015:b04aa055",
      "source": {
        "set": "set-02",
        "namespace": "ST_C03_314_B",
        "key": "314_B_015",
        "jp_record_id": "switch:locres:set-02:ST_C03_314_B:314_B_015:b04aa055",
