        "official_en_sha256": "333a2c4bd9eab88b9b5bb0b99337797ec5a7a4759073892251f8f15679461544"
      },
      "text": {
        "jp": "それを防ぐために１００年に１度\r\nゲートが開くのじゃ。\r\n魔力を放出するためにな。",
        "official_en": "To avert this, the gate opens once every century to release the energy pent up within.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
