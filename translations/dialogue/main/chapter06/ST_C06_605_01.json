    {
      "record_id": "switch:locres:set-02:ST_C06_605_01:605_01_015:ca4936a2",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_605_01",
        "key": "605_01_015",
        "jp_record_id": "switch:locres:set-02:ST_C06_605_01:605_01_015:ca4936a2",
        "official_en_record_id": "switch:locres:set-02:ST_C06_605_01:605_01_015:ca4936a2",
