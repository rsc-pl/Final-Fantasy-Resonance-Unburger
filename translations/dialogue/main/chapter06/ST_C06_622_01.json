        "official_en_sha256": "16f8c4ae3541158f108be3d1501f43e5cbc9e410c417bfceb611562c3daba609"
      },
      "text": {
        "jp": "俺はあいつの顔が曇るところを見たくない。",
        "official_en": "I could not bear to watch sorrow cloud his face.",
        "real_en": null
      },
      "review": {
