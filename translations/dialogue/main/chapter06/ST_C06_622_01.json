        "jp_record_id": "switch:locres:set-02:ST_C06_622_01:622_01_029:9c964a19",
        "official_en_record_id": "switch:locres:set-02:ST_C06_622_01:622_01_029:9c964a19",
        "jp_sha256": "7a7f6f50b49bd3614f97a912b041c963e2017401cad20dd1dbb8c5764b38bb5a",
        "official_en_sha256": "f38fff71b35a75e6b39b6c09c7b80c5094ce5fa8b2e252d367ef1a1a264e373d"
      },
      "text": {
        "jp": "……頑張って。\r\nレイン、ラスウェル。",
        "official_en": "...Good luck, you two.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
