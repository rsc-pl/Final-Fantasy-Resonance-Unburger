      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C06_622_01:622_01_028:e17d1236",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_622_01",
        "key": "622_01_028",
        "jp_record_id": "switch:locres:set-02:ST_C06_622_01:622_01_028:e17d1236",
        "official_en_record_id": "switch:locres:set-02:ST_C06_622_01:622_01_028:e17d1236",
        "jp_sha256": "01dfbf0b9b426403d7e3c47d2de07ddc85c0a0a0b965e56d5cc1b02ef261ac69",
        "official_en_sha256": "08a70054f59e703ae5ee2bb185ba6951a0ee7e3798cd17e527fbf15e8bc6a586"
      },
      "text": {
        "jp": "うん。",
        "official_en": "Yeah...",
        "real_en": null
      },
      "review": {
