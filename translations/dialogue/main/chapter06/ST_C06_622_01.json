    {
      "record_id": "switch:locres:set-02:ST_C06_622_01:622_01_006:1bed3748",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_622_01",
        "key": "622_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C06_622_01:622_01_006:1bed3748",
        "official_en_record_id": "switch:locres:set-02:ST_C06_622_01:622_01_006:1bed3748",
        "jp_sha256": "ad3a2145e5faca3c1e5ae3ae30de2fb3df68182dd611d7934a9b94be97601cb2",
        "official_en_sha256": "76049a844d4059bdc87c337b57b3d96e6da2d7e2f5dc70ecab2ae73403267950"
      },
      "text": {
        "jp": "ああ……。\r\n振り返ってみると、騎士団での日々は、\r\n楽しかった記憶しかない。",
        "official_en": "Indeed. Looking back, I only have fond memories of being in the Order.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
