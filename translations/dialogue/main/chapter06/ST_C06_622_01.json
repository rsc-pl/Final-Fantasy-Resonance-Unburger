        "official_en_sha256": "03377fa6c6c7a4686d905232894f48014a49f4b74d7f56585a7cf4afbdd98311"
      },
      "text": {
        "jp": "俺や父さんを越えてみせるって言ったのは\r\n嘘だったのかよ。",
        "official_en": "So were you lying when you told me you were going to get ahead of me and my old man?",
        "real_en": null
      },
      "review": {
