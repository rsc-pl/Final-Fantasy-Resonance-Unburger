        "official_en_sha256": "5cef7ea5b9ad2e730d2428990d3a63c720e5cb7b2c657a92e1c752e8a4659029"
      },
      "text": {
        "jp": "それは本当の意味で\r\n負けたことがないから言えることだ。",
        "official_en": "You only say that because you’ve never once truly lost.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
