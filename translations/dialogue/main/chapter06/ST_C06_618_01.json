      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C06_618_01:618_01_011:fb25556f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_618_01",
        "key": "618_01_011",
        "jp_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_011:fb25556f",
        "official_en_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_011:fb25556f",
        "jp_sha256": "f0faecb891ab1ca51ac00f568e637288f742f8407f1fe47df06e0ce2d0ffeb9f",
        "official_en_sha256": "7ed10cf63fda562111d210551e233c2d1055838e48724fbec692551c3668a8b6"
      },
      "text": {
        "jp": "ん？\r\nそんなの当たり前だろ。",
        "official_en": "Huh? Is...that a riddle? Lasswell, that’s how duels <text style=\"italic\">work</>.",
        "real_en": "Huh? Isn't that obvious?"
      },
      "review": {
        "status": "CHANGE"
      },
