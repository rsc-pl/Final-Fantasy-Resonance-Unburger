        "official_en_sha256": "fc42462f9715d3a7b2179448b5f77b911fab6afa1909009b9d9398f34a740cc7"
      },
      "text": {
        "jp": "ここが至聖殿じゃ。",
        "official_en": "Lo. Sanctissimus Shrine.",
        "real_en": "So this is the Sanctissimus Shrine."
      },
      "review": {
        "status": "CHANGE"
