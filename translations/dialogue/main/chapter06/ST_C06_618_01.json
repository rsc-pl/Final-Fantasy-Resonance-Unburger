        "jp_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_002:3cdaa476",
        "official_en_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_002:3cdaa476",
        "jp_sha256": "b03d1163c93989b2fdeb6425f1669af4c13590fbd68e6abcc8c3ffdc38d4d37e",
        "official_en_sha256": "de0865e26cc424679d5d38760622727e066621b016b3730ed657a64e45391e32"
      },
      "text": {
        "jp": "なんだか、仰々しい場所ね……。",
        "official_en": "This place seems...a little over the top...",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
