          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C06_618_01/618_01_013"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C06_618_01:618_01_014:d7a67452",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_618_01",
        "key": "618_01_014",
        "jp_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_014:d7a67452",
        "official_en_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_014:d7a67452",
        "jp_sha256": "076d93a0b087c954878e156d8ad8794faf90d8bc0fb4e98928708e9476d740ca",
        "official_en_sha256": "71a0cb36f6c70b3a4030dde2bf88f652f7501e587e3ec24189ebcc6b2e5973da"
      },
      "text": {
        "jp": "だいたいさ、勝っても負けても\r\nいい勝負ができれば最高じゃないか。",
        "official_en": "Besides, does it matter who wins or who loses? It’s the actual fight that matters.",
        "real_en": "Besides, win or lose, isn't it great if we can have a good fight?"
      },
      "review": {
        "status": "CHANGE"
      },
