    {
      "record_id": "switch:locres:set-02:ST_C06_618_01:618_01_012:9ebd24c0",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_618_01",
        "key": "618_01_012",
        "jp_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_012:9ebd24c0",
        "official_en_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_012:9ebd24c0",
        "jp_sha256": "51c7c8af0ea93228b672fc8cd81381131e70ad7bc794367f924f3d3a218baa80",
        "official_en_sha256": "0990a0b094c641b3ce3e583e67748fed03f4cc2418279ed06f91c39f23b2a103"
      },
      "text": {
        "jp": "……レインは自分が負けたときのことを考えないのか？",
        "official_en": "Have you not considered the ramifications of you losing, Rain?",
        "real_en": "Rain... don't you ever think about what it'd be like to lose?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
