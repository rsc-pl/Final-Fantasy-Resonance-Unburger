    {
      "record_id": "switch:locres:set-02:ST_C06_618_01:618_01_013:4e059aa2",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_618_01",
        "key": "618_01_013",
        "jp_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_013:4e059aa2",
        "official_en_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_013:4e059aa2",
        "jp_sha256": "8febc1a3a3ca7225efd45e85351efdd7d8bf711426fa93f7f9a963779849ccbe",
        "official_en_sha256": "4735d18ecbb21c6e3ffad29ff5b10ef1c6ebdf9d5bd0c93575a816528e002da8"
      },
      "text": {
        "jp": "そんなこと戦う前に考えるかよ。",
        "official_en": "Why would I think about losing before we even begin the fight?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C06_618_01",
