    {
      "record_id": "switch:locres:set-02:ST_C06_618_01:618_01_005:09d28dc7",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_618_01",
        "key": "618_01_005",
        "jp_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_005:09d28dc7",
        "official_en_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_005:09d28dc7",
        "jp_sha256": "9763909ecfb54302ffb495207ce811b4752884bd0273106cf19e4dcf85a0af12",
        "official_en_sha256": "126a7d5585dcea6e96b6398eae6afc27691ef9902b93cce5201d258da4b46056"
      },
      "text": {
        "jp": "ちょっと前から気付いていたんだけど……。\r\nあいつ、すごく強くなったよな。",
        "official_en": "I’ve noticed that he’s gotten a lot stronger recently.",
        "real_en": null
      },
      "review": {
