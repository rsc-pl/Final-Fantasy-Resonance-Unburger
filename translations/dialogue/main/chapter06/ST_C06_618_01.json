      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C06_618_01:618_01_006:72a2a3b2",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_618_01",
        "key": "618_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_006:72a2a3b2",
        "official_en_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_006:72a2a3b2",
        "jp_sha256": "a923de78badf7fb1b620010fc28b38ea9bdd32cefc7e5b30148491201d119672",
        "official_en_sha256": "8ff957fe30a7019f44eb87a5cf7476e11ffb4cd98f6aa020d04b98ee18599662"
      },
      "text": {
        "jp": "うん、そうだと思う。\r\nラスウェルはいっぱい努力してたしね。",
        "official_en": "Yeah, he’s been trying really hard—training all the time.",
        "real_en": "Yeah, I think so. Lasswell's been working really hard."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
