    {
      "record_id": "switch:locres:set-02:ST_C06_618_01:618_01_009:020af364",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_618_01",
        "key": "618_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_009:020af364",
        "official_en_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_009:020af364",
        "jp_sha256": "bf79887385f77cc17e882d9d83dae426bba5cc725bb5e6f859f0c1a5811c3bda",
        "official_en_sha256": "e9e219ab9bf11ce320f44a76c5e3fd28c6d3851daec226ea4a7bad6f4405c601"
      },
      "text": {
        "jp": "なんだよ、テンションが低いな。\r\nお前がゾルダードで言い出したことじゃないか。",
        "official_en": "What, aren’t you looking forward to it? You’re the one who first suggested it back in Zoldaad.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
