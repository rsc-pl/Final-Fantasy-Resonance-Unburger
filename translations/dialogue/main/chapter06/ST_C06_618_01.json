      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C06_618_01:618_01_001:a1b15ab5",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_618_01",
        "key": "618_01_001",
        "jp_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_001:a1b15ab5",
