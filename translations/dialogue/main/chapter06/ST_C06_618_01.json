    },
    {
      "record_id": "switch:locres:set-02:ST_C06_618_01:618_01_007:f4efa93e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_618_01",
        "key": "618_01_007",
        "jp_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_007:f4efa93e",
        "official_en_record_id": "switch:locres:set-02:ST_C06_618_01:618_01_007:f4efa93e",
        "jp_sha256": "ba942a77286e9333571bb3a9413a29ff849dd03fe9ba3214a90697bf1534955a",
        "official_en_sha256": "8e24511bd3edd192604308eb717c7253e79900dfc3e02bed60c1d5439f36f1fa"
      },
      "text": {
        "jp": "ラスウェル、\r\n六盟傑との戦いが終わったら勝負だな。\r\nナンバーワンの騎士を決めようぜ。",
        "official_en": "Lasswell, you remember our promise, right? After we’re done dealing with the Sworn Six, you and I are going to see who’s the strongest knight.",
        "real_en": "Lasswell, once we're done fighting the Sworn Six, let's settle who's the number-one knight."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C06_618_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
