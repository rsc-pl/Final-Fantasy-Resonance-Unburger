        "official_en_sha256": "ed15f258cf94f640211393270c594e763c1746ad44e76b8cee8054fc628401d8"
      },
      "text": {
        "jp": "私とてこの命を復讐で\r\n縛りつけるつもりはない。",
        "official_en": "I do not wish for my life to be forever shackled by this quest for revenge.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
