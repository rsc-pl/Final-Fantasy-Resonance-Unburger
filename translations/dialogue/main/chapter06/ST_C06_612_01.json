        "official_en_sha256": "fed7ac10720923f71cb1f82559ea18bd94a1baa03d559e3a89cb7a053cf77ea5"
      },
      "text": {
        "jp": "それの何が\r\nおかしいというのだ！",
        "official_en": "I ask you—is that not reasonable!?",
        "real_en": "What's wrong with that!?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
