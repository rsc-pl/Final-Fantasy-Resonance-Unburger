    {
      "record_id": "switch:locres:set-02:ST_C06_612_01:612_01_010:d4f70bfc",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_612_01",
        "key": "612_01_010",
        "jp_record_id": "switch:locres:set-02:ST_C06_612_01:612_01_010:d4f70bfc",
        "official_en_record_id": "switch:locres:set-02:ST_C06_612_01:612_01_010:d4f70bfc",
