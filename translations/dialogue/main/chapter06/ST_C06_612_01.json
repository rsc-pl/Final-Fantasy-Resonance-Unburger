    {
      "record_id": "switch:locres:set-02:ST_C06_612_01:612_01_003:cc45fc5e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_612_01",
        "key": "612_01_003",
        "jp_record_id": "switch:locres:set-02:ST_C06_612_01:612_01_003:cc45fc5e",
        "official_en_record_id": "switch:locres:set-02:ST_C06_612_01:612_01_003:cc45fc5e",
        "jp_sha256": "be28a51797f993fbfedd680607bb6c9d77a324151de5aafd3ea59452c95a1795",
        "official_en_sha256": "bf26c4df10281973e3cbe187daaa40eb8fbc197ddf318e2087b187fe684cddec"
      },
      "text": {
        "jp": "新たな人生を歩むのなら\r\nまず復讐を遂げてから……。",
        "official_en": "Only after my vengeance is exacted, will I walk a new path.",
        "real_en": "If I'm going to start a new life, I'll have to exact my revenge first..."
      },
      "review": {
        "status": "CHANGE"
      },
