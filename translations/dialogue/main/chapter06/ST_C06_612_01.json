        "official_en_sha256": "8d5c8f5325e2999eca4008da95b3a7cf2075441b248b03f2fbc237f6f167c99f"
      },
      "text": {
        "jp": "復讐という名の幻影を。",
        "official_en": "A mirage that bears the name of vengeance.",
        "real_en": "An illusion called revenge."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
