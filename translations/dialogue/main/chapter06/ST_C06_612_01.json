        "official_en_sha256": "c05446261f573aa192fa923239c763cc0b35c046b8bcf45c232aa5b4fcc032c2"
      },
      "text": {
        "jp": "ワシはこの世界を\r\n気に入ってるんじゃよ。",
        "official_en": "I’ve taken a liking to this world, you see.",
        "real_en": null
      },
      "review": {
