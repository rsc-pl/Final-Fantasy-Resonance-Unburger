    {
      "record_id": "switch:locres:set-02:ST_C06_612_01:612_01_009:986fc74f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_612_01",
        "key": "612_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C06_612_01:612_01_009:986fc74f",
        "official_en_record_id": "switch:locres:set-02:ST_C06_612_01:612_01_009:986fc74f",
        "jp_sha256": "bfe0681899c6c629731cd788be0fba781f84048cb6b04f6792df2c0fcb05f3cd",
        "official_en_sha256": "9d3a13701b358d7acfd106cb9c803f36d919decfc7f00f178ff9aa43d2a14f9c"
      },
      "text": {
        "jp": "姉さんは幻影を\r\n追い求めてるだけなんじゃよ。",
        "official_en": "What you chase is a mere mirage, Sister.",
        "real_en": "Nee-san, you're only chasing an illusion."
      },
      "review": {
        "status": "CHANGE"
      },
