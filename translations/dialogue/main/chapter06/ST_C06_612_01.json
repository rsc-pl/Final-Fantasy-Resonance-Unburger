        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C06_612_01:612_01_001:a45abc5f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_612_01",
        "key": "612_01_001",
        "jp_record_id": "switch:locres:set-02:ST_C06_612_01:612_01_001:a45abc5f",
