          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C06_612_01:612_01_002:5c0e0dbb",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_612_01",
        "key": "612_01_002",
        "jp_record_id": "switch:locres:set-02:ST_C06_612_01:612_01_002:5c0e0dbb",
        "official_en_record_id": "switch:locres:set-02:ST_C06_612_01:612_01_002:5c0e0dbb",
        "jp_sha256": "8afd81267646be2debff87c208b0283260198c356270e283bf7741a594ff589d",
        "official_en_sha256": "1a2520b02a605fb1a1ab01168c55baa8d13727080d7220c2551c0f47ba959ec2"
      },
      "text": {
        "jp": "だが、これはケジメなのだ。",
        "official_en": "But this is a matter of principle.",
        "real_en": "But this is something I have to settle."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
