    {
      "record_id": "switch:locres:set-02:ST_C06_612_01:612_01_007:52fe671a",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_612_01",
        "key": "612_01_007",
        "jp_record_id": "switch:locres:set-02:ST_C06_612_01:612_01_007:52fe671a",
        "official_en_record_id": "switch:locres:set-02:ST_C06_612_01:612_01_007:52fe671a",
        "jp_sha256": "deebb0c7e05a143a88abc2e7a238199d78c85f6e1d241b5a9f047b9f880097b5",
        "official_en_sha256": "0c67e73f16d21405126424b1479d7ab3736bcc334982db82d7d47bb21a862cfc"
      },
      "text": {
        "jp": "それを巻き込むような\r\n復讐を認めるわけにはいかん。",
        "official_en": "And I refuse to accept any vengeance that victimizes them.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C06_612_01",
