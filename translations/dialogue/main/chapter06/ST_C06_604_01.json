          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C06_604_01:604_01_003:ed559ce4",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_604_01",
        "key": "604_01_003",
        "jp_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_003:ed559ce4",
        "official_en_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_003:ed559ce4",
        "jp_sha256": "b9123278adbb4a2ab13f533fe1eb6d3f03d726c2c77441068fc61c2542cfcd51",
        "official_en_sha256": "5d807e58ed9b73628bde54b357ad95057c19444308912ae29fe5106a67605dd7"
      },
      "text": {
        "jp": "そうはいってもな。\r\nお前さんらも見たじゃろ、あの沼を。",
        "official_en": "I’m not doubting that, but as I’m sure you’ve noticed, there’s a bog out there that says otherwise.",
        "real_en": "Even so, you've seen that swamp, haven't you?"
      },
      "review": {
