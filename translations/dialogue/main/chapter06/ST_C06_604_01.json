    {
      "record_id": "switch:locres:set-02:ST_C06_604_01:604_01_001:8a2938cd",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_604_01",
        "key": "604_01_001",
        "jp_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_001:8a2938cd",
        "official_en_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_001:8a2938cd",
        "jp_sha256": "c43086e10000a2dbe675e16525b149092a5e913ef807e13c1eaeba63c306d56e",
        "official_en_sha256": "994a94c70eb857ef55d5353d0bd26c84c37932e885e73f2b8a7f6961d9fd2d44"
      },
      "text": {
        "jp": "おや？　お前さんら、旅人かね？\r\nこんなところに来るものではないぞ。\r\nさっさと帰るんじゃな。",
        "official_en": "Hmm? You folks travelers? This is no tourist spot. I’d turn back if I were you.",
        "real_en": "Oh? You folks are travelers? You shouldn't have come to a place like this. Better turn back at once."
      },
      "review": {
        "status": "CHANGE"
      },
