    },
    {
      "record_id": "switch:locres:set-02:ST_C06_604_01:604_01_022:9d9ea5eb",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_604_01",
        "key": "604_01_022",
        "jp_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_022:9d9ea5eb",
        "official_en_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_022:9d9ea5eb",
        "jp_sha256": "6b7e75750b5e653601e0c49116d94307ea35182a1eb9ea7fca085e36b64f6659",
        "official_en_sha256": "46e3f29ce625f68ad5aa57e3fcac84f5bfcbcd0f2173f611babe048181e9c3df"
      },
      "text": {
        "jp": "そこにある白輝石を\r\n持ってくるのじゃ。\r\n白く光り輝いている石じゃ。",
        "official_en": "Bring me a white jade stone that you’ll find there. It glows with an ivory shimmer.",
        "real_en": "Bring me a white shining stone from there. It glows with a bright white light."
      },
