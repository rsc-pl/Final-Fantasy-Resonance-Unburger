    {
      "record_id": "switch:locres:set-02:ST_C06_604_01:604_01_010:118a7ccd",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_604_01",
        "key": "604_01_010",
        "jp_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_010:118a7ccd",
        "official_en_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_010:118a7ccd",
        "jp_sha256": "57a4254297736aead58398c2cb0af59c6ee8f10b28d0eba076aa4c1f79622ae5",
        "official_en_sha256": "f5c0f2e063af14832ff4450587792cdc4dff75235d7c1d827895e71616d00a12"
      },
      "text": {
        "jp": "ちょっとあなた、いきなり失礼でしょ。\r\nこの子、困ってるじゃない。",
