    {
      "record_id": "switch:locres:set-02:ST_C06_604_01:604_01_002:2910b77e",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_604_01",
        "key": "604_01_002",
        "jp_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_002:2910b77e",
        "official_en_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_002:2910b77e",
        "jp_sha256": "21de8985bf9b5d6687b12fc8427618beaa3556027a675fd17ec856c4a63bad05",
        "official_en_sha256": "a0a8700435eaafee78e792c5675ee6e0d9e1739ac00e2aa81f446d29529d1e7e"
      },
      "text": {
        "jp": "そういうわけにもいかないんだ。\r\nこのゴロノアに行きたい場所があってさ。",
        "official_en": "We don’t have that option. There’s a place in Gronoa we need to visit.",
        "real_en": null
      },
