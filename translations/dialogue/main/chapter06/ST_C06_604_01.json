        "official_en_sha256": "6110ecab525cea33056d25d491c3696b7be22a758bc8203a46c24921f1b382f1"
      },
      "text": {
        "jp": "このガベラダを出て東へいった場所に\r\n廃墟がある。",
        "official_en": "East of here, outside of Gaberada, are ruins.",
        "real_en": null
      },
