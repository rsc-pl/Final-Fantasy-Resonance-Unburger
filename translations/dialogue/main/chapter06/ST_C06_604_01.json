    {
      "record_id": "switch:locres:set-02:ST_C06_604_01:604_01_021:41e03914",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_604_01",
        "key": "604_01_021",
        "jp_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_021:41e03914",
