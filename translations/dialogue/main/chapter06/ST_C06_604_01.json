    {
      "record_id": "switch:locres:set-02:ST_C06_604_01:604_01_019:f3d67f33",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_604_01",
        "key": "604_01_019",
        "jp_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_019:f3d67f33",
        "official_en_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_019:f3d67f33",
        "jp_sha256": "8c9408ed78f2b3b2056768513f4f283f7161036681f17d27d81f4e33679710bf",
        "official_en_sha256": "7d2db48d888a591c63a29d58f7723d31f76a4c7108a5588b558439181eeb7ab3"
      },
      "text": {
        "jp": "そうじゃ。\r\nワシがフィーナに伝授しよう。\r\nそのために、あるものを取ってきてもらう。",
        "official_en": "Yes, you. I can instruct you...but for that purpose, you must bring me something.",
        "real_en": "Yes. I’ll teach Fina. But first, I need you to bring me something."
      },
      "review": {
        "status": "CHANGE"
      },
