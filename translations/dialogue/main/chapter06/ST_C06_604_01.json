        "official_en_sha256": "6146114742fafbe116c8b2b61df53ea67dadbf270200b8134715e16f6139531e"
      },
      "text": {
        "jp": "あなた方だってここに住んでいるんでしょう？\r\nなにか解決策があるのでは……",
        "official_en": "But all of you have managed to live here. There must be some way to avoid the miasma.",
        "real_en": "But you live here yourselves, don't you? Isn't there some way through...?"
      },
      "review": {
        "status": "CHANGE"
