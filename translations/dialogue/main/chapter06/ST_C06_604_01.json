    {
      "record_id": "switch:locres:set-02:ST_C06_604_01:604_01_004:1e7786da",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_604_01",
        "key": "604_01_004",
        "jp_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_004:1e7786da",
        "official_en_record_id": "switch:locres:set-02:ST_C06_604_01:604_01_004:1e7786da",
