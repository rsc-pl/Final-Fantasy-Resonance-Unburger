    {
      "record_id": "switch:locres:set-02:ST_C06_623_01:623_01_005:cc349a5f",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_623_01",
        "key": "623_01_005",
        "jp_record_id": "switch:locres:set-02:ST_C06_623_01:623_01_005:cc349a5f",
        "official_en_record_id": "switch:locres:set-02:ST_C06_623_01:623_01_005:cc349a5f",
