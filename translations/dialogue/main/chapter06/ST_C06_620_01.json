    },
    {
      "record_id": "switch:locres:set-02:ST_C06_620_01:620_01_006:4edb66b3",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_620_01",
        "key": "620_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C06_620_01:620_01_006:4edb66b3",
        "official_en_record_id": "switch:locres:set-02:ST_C06_620_01:620_01_006:4edb66b3",
        "jp_sha256": "34e12ad18d5985adf1adcabd1f95baf60f8ea91a95ee3b9cf91a48112fbd885d",
        "official_en_sha256": "86b214ff1c66cfb53a403bcde5df53c809662b000ee5818df652e5ab0dede541"
      },
      "text": {
        "jp": "二人一組で協力して進んできた者よ。\r\n最後の試練は一対一の真剣勝負で行うものとする。\r\n勝ち残った者を最強とし、聖騎士の称号を与える。",
        "official_en": "You two, having endured the trials as a pair, must now face the final test—an earnest duel against one another. The victor shall be granted the honor of the title of Paladin.",
        "real_en": "You two, having worked together through these trials, must face each other in a serious one-on-one duel for the final trial. The winner will be recognized as the strongest and awarded the title of Paladin."
      },
      "review": {
        "status": "CHANGE"
      },
