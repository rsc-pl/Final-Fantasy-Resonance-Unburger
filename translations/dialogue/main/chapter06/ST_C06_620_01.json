    {
      "record_id": "switch:locres:set-02:ST_C06_620_01:620_01_017:10c6e2ef",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_620_01",
        "key": "620_01_017",
        "jp_record_id": "switch:locres:set-02:ST_C06_620_01:620_01_017:10c6e2ef",
        "official_en_record_id": "switch:locres:set-02:ST_C06_620_01:620_01_017:10c6e2ef",
        "jp_sha256": "8196ba3b1a5ce6968a0e5906c2ac02cb77eb3120d01db06f0d5ee501672201ed",
        "official_en_sha256": "95c5eabc5145b21a0244ab4569414f66872fa3b1c91c699a6d34f8f79146e50b"
      },
      "text": {
        "jp": "ラスウェル、ちょうどいいじゃないか。\r\nナンバーワンの騎士を決める勝負、\r\nここでやろうぜ。",
        "official_en": "Talk about timing. Lasswell, this is it—let’s follow through on our promise and decide who’s the strongest knight here and now.",
        "real_en": "This is perfect, Lasswell. Let's have our duel to decide who's the number-one knight right here."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
