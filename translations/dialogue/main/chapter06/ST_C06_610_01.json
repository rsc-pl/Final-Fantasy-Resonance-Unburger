        "official_en_sha256": "2c7b7bb2ad9c589b32919a6b0cbc72e212f1277d0573ad925c18e4900308496a"
      },
      "text": {
        "jp": "じゃ、俺たちもパラデイアの子孫ってことなのか？",
        "official_en": "So <text style=\"italic\">we’re</> part Paladian, too?",
        "real_en": "Then does that mean <text style=\"italic\">we're</> descended from Paladians too?"
      },
      "review": {
        "status": "CHANGE"
      },
