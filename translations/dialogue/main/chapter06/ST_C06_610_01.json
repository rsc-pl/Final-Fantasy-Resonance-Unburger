    {
      "record_id": "switch:locres:set-02:ST_C06_610_01:610_01_010:b79eaace",
      "source": {
        "set": "set-02",
        "namespace": "ST_C06_610_01",
        "key": "610_01_010",
        "jp_record_id": "switch:locres:set-02:ST_C06_610_01:610_01_010:b79eaace",
