        "official_en_sha256": "3b70ccccb74eddf899989d7fd610e1cfbd4d6f6f9bb3925d1a6427f2ac81ec5f"
      },
      "text": {
        "jp": "何より……。\r\n私はニコルの手助けがしたくて……。",
        "official_en": "But most of all... I want to lend you a hand, Nichol.",
        "real_en": null
      },
      "review": {
