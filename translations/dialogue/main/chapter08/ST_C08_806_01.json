        "key": "806_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C08_806_01:806_01_009:1fb04f9c",
        "official_en_record_id": "switch:locres:set-02:ST_C08_806_01:806_01_009:1fb04f9c",
        "jp_sha256": "c11c2ace1a983e998b3ddffa0356146f2f168c3ea9fdbbe73091b10a8ee23d87",
        "official_en_sha256": "10a76667e3907b1de592687bd1d5048cad753ae7ba3890cdd611f47368edc542"
      },
      "text": {
        "jp": "私は本当に何もかも失ってしまった……。\r\nだが、まだ力は残されている。",
        "official_en": "I have truly lost everything... Yet I can still fight.",
        "real_en": "I've truly lost everything... But I still have my strength."
      },
      "review": {
        "status": "CHANGE"
      },
