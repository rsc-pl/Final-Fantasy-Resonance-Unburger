        "official_en_sha256": "14bfacd134676d2e5eaf816c935400a1f5d4b35b18379e9b104700e08de1d3b6"
      },
      "text": {
        "jp": "姉さん、ありがとう。\r\n助けてくれて感謝する。",
        "official_en": "You have my gratitude, Sister. I appreciate your help.",
        "real_en": "Thank you, Nee-san. I really appreciate your help."
      },
      "review": {
