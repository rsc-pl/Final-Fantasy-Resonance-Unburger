    {
      "record_id": "switch:locres:set-02:ST_C08_806_01:806_01_002:d2822e61",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_806_01",
        "key": "806_01_002",
        "jp_record_id": "switch:locres:set-02:ST_C08_806_01:806_01_002:d2822e61",
        "official_en_record_id": "switch:locres:set-02:ST_C08_806_01:806_01_002:d2822e61",
        "jp_sha256": "eaa56d7b79ee557a93ce302f2204c33fd1932cd3bca48c8656a7bdb0ef561c71",
        "official_en_sha256": "0855e589ae70102b21fad8a838719d4f87e4fd67aebd1352cbb9c8074557a67a"
      },
      "text": {
        "jp": "世界の崩壊を防ぐことができれば\r\n罪滅ぼしになると思ったからです。",
        "official_en": "Saving this world from annihilation is a natural extension of my path to atonement.",
        "real_en": "I thought helping to keep the world from collapsing would be a way to atone for my sins."
      },
      "review": {
        "status": "CHANGE"
      },
