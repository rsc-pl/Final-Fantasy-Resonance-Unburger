        "official_en_sha256": "04a8f8c179a3ac60df036e0ad2c4d91c45bd4f4b1f158323afe1d37c11094f2a"
      },
      "text": {
        "jp": "何かの力に押し戻されて\r\n頂上まで飛ぶことができない。",
        "official_en": "Some kind of force is knocking us back. I can’t get us to the top.",
        "real_en": null
      },
