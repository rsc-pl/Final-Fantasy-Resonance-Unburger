        "set": "set-02",
        "namespace": "ST_C08_801_01",
        "key": "801_01_011",
        "jp_record_id": "switch:locres:set-02:ST_C08_801_01:801_01_011:e6a4af78",
        "official_en_record_id": "switch:locres:set-02:ST_C08_801_01:801_01_011:e6a4af78",
