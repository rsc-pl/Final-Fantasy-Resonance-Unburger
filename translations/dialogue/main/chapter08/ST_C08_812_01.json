    {
      "record_id": "switch:locres:set-02:ST_C08_812_01:812_01_008:f3cc53de",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_812_01",
        "key": "812_01_008",
        "jp_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_008:f3cc53de",
        "official_en_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_008:f3cc53de",
        "jp_sha256": "7a07bb1f295f14798df6258348b8e083019cdbdffe501ec36577905801c98342",
        "official_en_sha256": "a753275c3561e5f4cc10211bbb160c9c966d9b451946107065754e2bda2b17d6"
      },
      "text": {
        "jp": "人間の歴史は憎しみで彩られている。\r\nこの大地で何度争いが起こり、\r\nどれだけの血が流れたと思う？",
        "official_en": "Human history is adorned with hatred. How many wars have there been in this land? How much blood has soaked into its soil?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C08_812_01",
        "sequence": null,
