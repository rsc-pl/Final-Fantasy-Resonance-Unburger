        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C08_812_01:812_01_009:bb703185",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_812_01",
        "key": "812_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_009:bb703185",
