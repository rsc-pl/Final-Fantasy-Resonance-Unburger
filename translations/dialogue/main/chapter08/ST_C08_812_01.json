    {
      "record_id": "switch:locres:set-02:ST_C08_812_01:812_01_018:4da6cfc5",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_812_01",
        "key": "812_01_018",
        "jp_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_018:4da6cfc5",
        "official_en_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_018:4da6cfc5",
        "jp_sha256": "8fff7cc50ac383fcc4df34906c32e8cd3b1cc3cec651583ffc44a7660371c85e",
        "official_en_sha256": "92eec4001d68fdaf63bd0267500ca55d0d555302170a377db17e6a0f52929c9f"
      },
      "text": {
        "jp": "まだだ！\r\nあのビジョンはまだ完全じゃない！\r\nその前にソルを止めるぞ！",
        "official_en": "That vision’s still not complete! We better stop Sol before it is!",
        "real_en": "Not yet! That Vision isn't complete! We have to stop Sol before it is!"
      },
      "review": {
        "status": "CHANGE"
