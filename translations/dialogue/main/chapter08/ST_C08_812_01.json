    {
      "record_id": "switch:locres:set-02:ST_C08_812_01:812_01_006:bb0dcac4",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_812_01",
        "key": "812_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_006:bb0dcac4",
        "official_en_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_006:bb0dcac4",
        "jp_sha256": "358738c4ab1b5b8eaaf8a38e4010e3fbad9e5906f708c109f5d5c451382a8db1",
        "official_en_sha256": "8d1998cce7a201ee125feb6f5303f17de557c6d215114c1ed43313dc62748ec8"
      },
      "text": {
        "jp": "お前たちは皆、悲劇に酔っているにすぎない。",
        "official_en": "Tragedy is intoxicating to you—the whole lot of you.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
