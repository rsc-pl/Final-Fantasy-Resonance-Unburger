    {
      "record_id": "switch:locres:set-02:ST_C08_812_01:812_01_012:c459279b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_812_01",
        "key": "812_01_012",
        "jp_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_012:c459279b",
        "official_en_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_012:c459279b",
        "jp_sha256": "4a761c06612eddfd6506f640c60ac52afe642ed11507243f1ddbb5b4361cdaf0",
        "official_en_sha256": "7a76cec4b48e318c16328c50b9f4214dc34d61c52298f6a672ed8be20110ebbd"
      },
      "text": {
        "jp": "あの混沌の闇は人間の思いそのものだ。\r\n刮目するがいい。\r\n人間とはこれほどまでに禍々しいものなのだ。",
        "official_en": "Behold Chaotic Darkness—the embodiment of the human mind and its desires. Look upon it, and despair. This is the terror your precious humanity is capable of.",
        "real_en": "That Chaotic Darkness is the embodiment of human feelings. Look closely. This is how sinister humanity truly is."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C08_812_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "ソル",
