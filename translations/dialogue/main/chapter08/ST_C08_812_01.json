          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C08_812_01:812_01_014:f8626be2",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_812_01",
