    {
      "record_id": "switch:locres:set-02:ST_C08_812_01:812_01_013:395c30ae",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_812_01",
        "key": "812_01_013",
        "jp_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_013:395c30ae",
        "official_en_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_013:395c30ae",
