          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C08_812_01/812_01_006"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C08_812_01:812_01_017:d2e88c94",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_812_01",
        "key": "812_01_017",
        "jp_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_017:d2e88c94",
        "official_en_record_id": "switch:locres:set-02:ST_C08_812_01:812_01_017:d2e88c94",
        "jp_sha256": "c9bc7397ddc3f6948af715644b798ed679b2c28a5dfc353e38a20e5a66d6fa72",
        "official_en_sha256": "0a2295ae879bb586127d7da4b89a980450363df4719d1b14609ef60b3f14e8f0"
      },
      "text": {
        "jp": "そうだ。\r\nだが、それは解放でもあるのだ。\r\n唾棄すべき命からのな。",
        "official_en": "Correct. But I think of it as liberation, from that malignancy you refer to as “life.”",
        "real_en": "Yes. But it's also a kind of liberation... from this loathsome thing called life."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
