        "official_en_sha256": "8bd9b7b8394ad5044580693ca3cad0858b5e1f51226f109de3a449ee989a9c99"
      },
      "text": {
        "jp": "え……。\r\nそ、そんな……。",
        "official_en": "Huh...? How—how could that...?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
