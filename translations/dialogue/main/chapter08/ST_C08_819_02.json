    {
      "record_id": "switch:locres:set-02:ST_C08_819_02:819_02_019:ea61922d",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_819_02",
        "key": "819_02_019",
        "jp_record_id": "switch:locres:set-02:ST_C08_819_02:819_02_019:ea61922d",
