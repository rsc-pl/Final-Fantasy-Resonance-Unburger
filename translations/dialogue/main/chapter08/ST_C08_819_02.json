        "official_en_sha256": "df47d1580db067d4d3500190f9521f535663abd25f6cb36e0bc431fe66261bd0"
      },
      "text": {
        "jp": "お調子者で、女の子に甘くて、怠け者で……。",
        "official_en": "You were a bit of a clown, with a soft spot for girls, and prone to slacking off...",
        "real_en": "You were always fooling around, soft on girls, and lazy..."
      },
      "review": {
