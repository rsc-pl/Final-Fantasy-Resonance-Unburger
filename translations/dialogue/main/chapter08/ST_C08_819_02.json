        "official_en_sha256": "5b44b9aef5733cb652644670ffde1e73d6ad87e4d274dda442f0501e5d0d126d"
      },
      "text": {
        "jp": "私の願いは叶った。",
        "official_en": "And at last, my wish was granted.",
        "real_en": null
