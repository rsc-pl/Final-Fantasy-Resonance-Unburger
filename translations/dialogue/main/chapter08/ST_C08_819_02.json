        "official_en_sha256": "c4969f772a4f0464394f7532bc159253a2b423f8c09505874f77aadc95d28722"
      },
      "text": {
        "jp": "こんなふうにして消えたら、\r\nレインは私のこと忘れられなくなるから。",
        "official_en": "If I disappear here, Rain will never be able to forget me.",
        "real_en": "If I disappear like this, Rain won’t be able to forget me."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
