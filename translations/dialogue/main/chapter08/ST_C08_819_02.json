        "official_en_sha256": "bb64b41e10540745e491d55be3d94b05739b205ce1846c94c7b07eaeccbba649"
      },
      "text": {
        "jp": "気付いたら私はあなたに惹かれていた。",
        "official_en": "And before I knew it...I had lost my heart to you.",
        "real_en": "Before I knew it, I found myself drawn to you."
