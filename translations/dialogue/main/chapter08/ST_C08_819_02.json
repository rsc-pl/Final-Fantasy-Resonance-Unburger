          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C08_819_02:819_02_010:3429a10b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_819_02",
        "key": "819_02_010",
        "jp_record_id": "switch:locres:set-02:ST_C08_819_02:819_02_010:3429a10b",
