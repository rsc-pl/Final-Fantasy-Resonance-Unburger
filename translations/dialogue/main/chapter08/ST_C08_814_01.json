        "key": "814_01_002",
        "jp_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_002:f06ec025",
        "official_en_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_002:f06ec025",
        "jp_sha256": "1f7b03e996b18d806e10409cf6cd2184da406db6090825028635b5714e5cf459",
        "official_en_sha256": "1f7b03e996b18d806e10409cf6cd2184da406db6090825028635b5714e5cf459"
      },
      "text": {
        "jp": "ソル、何がおかしい。",
