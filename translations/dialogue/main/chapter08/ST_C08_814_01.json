        "official_en_sha256": "588b42af955362b1e5173d5101999f2456497d36545b90d353e76763dc3d0096"
      },
      "text": {
        "jp": "それって俺の思いが弱かったってことだろ……。",
        "official_en": "それって俺の思いが弱かったってことだろ……。",
        "real_en": "That means my feelings weren't strong enough, right...?"
