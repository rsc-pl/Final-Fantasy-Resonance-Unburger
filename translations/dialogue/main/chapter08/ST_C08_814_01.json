    {
      "record_id": "switch:locres:set-02:ST_C08_814_01:814_01_011:8fc20ce3",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_814_01",
        "key": "814_01_011",
        "jp_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_011:8fc20ce3",
        "official_en_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_011:8fc20ce3",
        "jp_sha256": "65cc02da50ce452c97931c371b32b04e9c3dd2fc220db9467ab157910297ff33",
        "official_en_sha256": "65cc02da50ce452c97931c371b32b04e9c3dd2fc220db9467ab157910297ff33"
      },
      "text": {
        "jp": "それが悔しい。\r\nお前にわかってもらえなかったことが悔しいんだ。",
        "official_en": "それが悔しい。\r\nお前にわかってもらえなかったことが悔しいんだ。",
        "real_en": "That's what frustrates me. I'm frustrated that I couldn't make you understand."
      },
      "review": {
        "status": "CHANGE"
      },
