          "evidence_refs": []
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C08_814_01:814_01_021:3cb4a4f5",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_814_01",
        "key": "814_01_021",
        "jp_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_021:3cb4a4f5",
        "official_en_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_021:3cb4a4f5",
        "jp_sha256": "99c0c0baea8d55623811ab4f2e5ab6a03c2f215f7810a69eeed81848e9cbe410",
        "official_en_sha256": "99c0c0baea8d55623811ab4f2e5ab6a03c2f215f7810a69eeed81848e9cbe410"
      },
      "text": {
        "jp": "このままでは世界が混沌の闇に飲み込まれてしまう。",
        "official_en": "このままでは世界が混沌の闇に飲み込まれてしまう。",
        "real_en": "At this rate, Chaotic Darkness will swallow the world."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C08_814_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
