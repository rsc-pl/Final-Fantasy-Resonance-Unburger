        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C08_814_01:814_01_014:1e5a4295",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_814_01",
        "key": "814_01_014",
        "jp_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_014:1e5a4295",
        "official_en_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_014:1e5a4295",
        "jp_sha256": "c88a1d9ad6c582d590860c849826062bda743521624ba67bdda43761ae05323d",
        "official_en_sha256": "c88a1d9ad6c582d590860c849826062bda743521624ba67bdda43761ae05323d"
      },
      "text": {
        "jp": "その醜いまでの甘い感情……。\r\n本当に唾棄すべき存在だな。",
        "official_en": "その醜いまでの甘い感情……。\r\n本当に唾棄すべき存在だな。",
        "real_en": "Those disgustingly naïve emotions of yours... You really are a loathsome being."
      },
      "review": {
        "status": "CHANGE"
      },
