    {
      "record_id": "switch:locres:set-02:ST_C08_814_01:814_01_012:c5eb9fa7",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_814_01",
        "key": "814_01_012",
        "jp_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_012:c5eb9fa7",
        "official_en_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_012:c5eb9fa7",
        "jp_sha256": "db1aa7a35f3243f59b7e1c77f04f70b5ba5ec5e3b0559589aac271255a5cfbc1",
        "official_en_sha256": "db1aa7a35f3243f59b7e1c77f04f70b5ba5ec5e3b0559589aac271255a5cfbc1"
      },
      "text": {
        "jp": "お前……名前はレインと言うのか。",
        "official_en": "お前……名前はレインと言うのか。",
        "real_en": "You... Your name is Rain?"
      },
      "review": {
        "status": "CHANGE"
      },
