        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C08_814_01:814_01_015:1fba2801",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_814_01",
        "key": "814_01_015",
        "jp_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_015:1fba2801",
        "official_en_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_015:1fba2801",
        "jp_sha256": "9061b98a9f3742c2ce7bd096278a1041eab573e0098eb44c9f029e2fd4806e3d",
        "official_en_sha256": "9061b98a9f3742c2ce7bd096278a1041eab573e0098eb44c9f029e2fd4806e3d"
      },
      "text": {
        "jp": "しかし、だからこそ愉快で仕方がない。\r\nレインよ。\r\n今からお前を絶望の海に沈めてやる。",
        "official_en": "しかし、だからこそ愉快で仕方がない。\r\nレインよ。\r\n今からお前を絶望の海に沈めてやる。",
        "real_en": "And yet that's exactly why I find this so amusing. Rain, I'm going to drown you in a sea of despair."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C08_814_01",
        "sequence": null,
