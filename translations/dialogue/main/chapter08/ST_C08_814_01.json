    {
      "record_id": "switch:locres:set-02:ST_C08_814_01:814_01_005:c9597a80",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_814_01",
        "key": "814_01_005",
        "jp_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_005:c9597a80",
        "official_en_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_005:c9597a80",
        "jp_sha256": "a8d177480cd1d7e01b0619d5933321510c7bbfcf46f328e0646084edda3ecaf1",
        "official_en_sha256": "a8d177480cd1d7e01b0619d5933321510c7bbfcf46f328e0646084edda3ecaf1"
      },
      "text": {
        "jp": "お前は私と同じだ。\r\n私は愛に敗れたのではない。\r\n憎しみに敗れたのだ。",
        "official_en": "お前は私と同じだ。\r\n私は愛に敗れたのではない。\r\n憎しみに敗れたのだ。",
        "real_en": "You're just like me. I wasn't defeated by love. I was defeated by hatred."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C08_814_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": null,
