        "jp_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_020:e0246000",
        "official_en_record_id": "switch:locres:set-02:ST_C08_814_01:814_01_020:e0246000",
        "jp_sha256": "821eb37a822372bfa2ee4826184c3b7d7a235538b2da2143311eba4e018cadbd",
        "official_en_sha256": "821eb37a822372bfa2ee4826184c3b7d7a235538b2da2143311eba4e018cadbd"
      },
      "text": {
        "jp": "いったい……。\r\nこの世界に何が起こっているのだ……。",
        "official_en": "いったい……。\r\nこの世界に何が起こっているのだ……。",
        "real_en": "What... What is happening to this world...?"
      },
