        "official_en_sha256": "bdb785b7b4a3796a2c48b0b6fafdb13761fc032df40814a84aadf3fa7e38af4e"
      },
      "text": {
        "jp": "鎧の力を引き出すのか？\r\nそんなことをしたら……。",
        "official_en": "You’ll draw power from your armor? But if you do that...",
        "real_en": null
      },
