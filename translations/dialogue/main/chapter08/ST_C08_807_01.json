        "official_en_sha256": "09e9669a861b9a71bb76c5f0994fc223804967d4a7ed6cc9964db31627ad2272"
      },
      "text": {
        "jp": "俺は人間を醜いとは思わない。",
        "official_en": "Humans are nothing like that.",
        "real_en": "I don't think humans are ugly."
      },
      "review": {
        "status": "CHANGE"
