    {
      "record_id": "switch:locres:set-02:ST_C08_807_01:807_01_016:b89da823",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_807_01",
        "key": "807_01_016",
        "jp_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_016:b89da823",
        "official_en_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_016:b89da823",
        "jp_sha256": "7767801d41c2af5f29085fca81f872ea8f8cef9fbfe15b017e8b6df6e562cd5c",
        "official_en_sha256": "394d6eb7e868e70ed1069f8457762908a0d6ef067fbf34c22293d0509ac4d73d"
      },
      "text": {
        "jp": "ラスウェルは悩みながらも、全力で俺と向き合ってくれた。",
        "official_en": "Lasswell struggled to figure out stuff between himself and me, but he never ran from it—instead he gave his all to straighten it out.",
        "real_en": "Lasswell struggled with his feelings, but he still faced me with everything he had."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C08_807_01",
        "sequence": null,
        "speaker": {
