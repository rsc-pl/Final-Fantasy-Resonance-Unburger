          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C08_807_01/807_01_009"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C08_807_01:807_01_010:930f5a44",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_807_01",
        "key": "807_01_010",
        "jp_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_010:930f5a44",
        "official_en_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_010:930f5a44",
