    {
      "record_id": "switch:locres:set-02:ST_C08_807_01:807_01_011:b9e0f64c",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_807_01",
        "key": "807_01_011",
        "jp_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_011:b9e0f64c",
        "official_en_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_011:b9e0f64c",
