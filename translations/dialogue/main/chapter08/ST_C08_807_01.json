        "official_en_sha256": "95c80edc624586efc85e531031cbaa7804e2f63c2a6d66473e3fd8c7c454019b"
      },
      "text": {
        "jp": "これを醜いと言わず、何を醜いと言えばいい。",
        "official_en": "If that is not repulsive, what is?",
        "real_en": null
      },
      "review": {
