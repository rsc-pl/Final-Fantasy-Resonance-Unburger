        "official_en_sha256": "ab733e2a2ff810f4f2724853df4fed1bfa5d08f3360249035c2582a8381c4397"
      },
      "text": {
        "jp": "俺の母さんは身を挺して……命を懸けて父さんを守った。",
        "official_en": "Mom sacrificed herself to protect Dad...",
        "real_en": "My mom put herself in harm's way... risked her life to protect Dad."
      },
