    {
      "record_id": "switch:locres:set-02:ST_C08_807_01:807_01_008:c2690aac",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_807_01",
        "key": "807_01_008",
        "jp_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_008:c2690aac",
        "official_en_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_008:c2690aac",
        "jp_sha256": "81a91c891c0f983e1c21bab522ce36bab277ee357ad6d6641d19b828650b586c",
        "official_en_sha256": "1339f47050e00b87e5841ad9561f2fb8fa28f1fa2172473bbfebfbc0de13a1a8"
      },
      "text": {
        "jp": "人間は自分の命のためだけに行動する。\r\n故に争って奪うことでしか生きられない。",
        "official_en": "Humans act only for the benefit of their own lives. As such, they can only survive through conflict and plunder.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
