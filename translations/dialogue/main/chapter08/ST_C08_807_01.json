    {
      "record_id": "switch:locres:set-02:ST_C08_807_01:807_01_003:e1b3ad50",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_807_01",
        "key": "807_01_003",
        "jp_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_003:e1b3ad50",
        "official_en_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_003:e1b3ad50",
        "jp_sha256": "a49d3fa1189b7cfcfcc6fcd1802fb589a7764574152ed4a796f4b8fa4c5c5a7e",
        "official_en_sha256": "00b1d17a3934484e0e925ebd759f9b9c793bd87dcf500a3462cbbbdc27e7b535"
      },
      "text": {
        "jp": "お前はどうしてそこまで命を憎むんだ？",
        "official_en": "Why do you have so much hatred for life?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C08_807_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
