          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C08_807_01:807_01_019:f7139fb1",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_807_01",
        "key": "807_01_019",
        "jp_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_019:f7139fb1",
        "official_en_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_019:f7139fb1",
        "jp_sha256": "c514e4b9ce05095e04898e742cda7bcf75a8f6d6f68d23964c74d78f9cc0b52b",
        "official_en_sha256": "2de852d5330b38e4e2e43519c279a927ef52cc5080931c8aba3552b4fc8dfa06"
      },
      "text": {
        "jp": "人間は自分の命のためだけに行動する？\r\nもし、みんながそうだったとしたら、\r\n俺はここにたどり着けなかった。",
        "official_en": "You say that humans only act to serve themselves, but if that were true of everyone, I’d have never made it this far.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_C08_807_01",
