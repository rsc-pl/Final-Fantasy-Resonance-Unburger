    },
    {
      "record_id": "switch:locres:set-02:ST_C08_807_01:807_01_022:0148f540",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_807_01",
        "key": "807_01_022",
        "jp_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_022:0148f540",
        "official_en_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_022:0148f540",
