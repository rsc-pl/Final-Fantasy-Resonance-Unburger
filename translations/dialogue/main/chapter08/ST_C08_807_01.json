        "official_en_sha256": "840bfe88c6493887c7343537c47c7ba9a97e622e024c2776ca6626a054ba9d9b"
      },
      "text": {
        "jp": "ベヒーモス、常闇の仇をとらせてもらうぞ……。",
        "official_en": "...Behemoth. Umbra shall have his revenge.",
        "real_en": "Behemoth... I'll avenge Veritas of the Dark."
      },
      "review": {
