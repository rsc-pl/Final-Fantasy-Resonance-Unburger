        "official_en_sha256": "6dfc0d0fb1f3539ba537bd324ea2b81c99279ab9d2eafb9abf5a45df090c65eb"
      },
      "text": {
        "jp": "あなたたちが先に進むために、\r\n私たちにも命の素晴らしさを証明させてください。",
        "official_en": "Let us Veritas aid you in proving the greatness of life...so that your group can move forward.",
        "real_en": "Let us prove how wonderful life is, too, so that you can keep moving forward."
      },
      "review": {
