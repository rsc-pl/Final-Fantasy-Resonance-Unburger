    {
      "record_id": "switch:locres:set-02:ST_C08_807_01:807_01_006:ad885b9b",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_807_01",
        "key": "807_01_006",
        "jp_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_006:ad885b9b",
        "official_en_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_006:ad885b9b",
        "jp_sha256": "e855c9f321aee613e18887c9b8d01e4b78bb00efd285d7a591a77972dc0f87bc",
        "official_en_sha256": "9e5da0329b6456ae95231d5f22638e417eb7991bf2df7802c76ac0741fce8c17"
      },
      "text": {
        "jp": "私は考えた。\r\nなぜ、人は争いの繰り返しから脱することができないのか。",
        "official_en": "So I thought to myself—why is it that man cannot break free from this ceaseless violence?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
