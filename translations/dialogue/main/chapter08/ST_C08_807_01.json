          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_C08_807_01/807_01_003"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_C08_807_01:807_01_009:37bd76c9",
      "source": {
        "set": "set-02",
        "namespace": "ST_C08_807_01",
        "key": "807_01_009",
        "jp_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_009:37bd76c9",
        "official_en_record_id": "switch:locres:set-02:ST_C08_807_01:807_01_009:37bd76c9",
        "jp_sha256": "b9bef3b87ee0014bb2a8771cc0461ff32973a77e427deac80e8f2ef8391f25c6",
        "official_en_sha256": "c438314bba364e94012f27bd758b0a857ff894f82b533bc64e685de41bbd1591"
      },
      "text": {
        "jp": "これが命の本質……。\r\n命とは利己的なのだ。",
        "official_en": "That is the nature of life. It is selfish at its very core.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
