        "official_en_sha256": "70217444ccf77d9adab95e5ba8c0feee6772d3a243d994ffbdd8874760adfe5c"
      },
      "text": {
        "jp": "今、俺がここにいる。\r\nそれが命の……人間の素晴らしさの証だ。",
        "official_en": "I’ve made it here now. That’s hard proof of how incredible life is...how incredible people can be.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
