        "official_en_sha256": "84ea5304642e45afce3ef4b4ea834e2b453df9e6171461292621246a098ea15c"
      },
      "text": {
        "jp": "レイン。\r\n今の話、心に響きました。",
        "official_en": "Rain, I could not agree more with what you said.",
        "real_en": "Rain. What you said really moved me."
      },
      "review": {
