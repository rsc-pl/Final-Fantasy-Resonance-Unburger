          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0070_003_01:ChrEv_0070_003_01_006:d2a4a772",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0070_003_01",
        "key": "ChrEv_0070_003_01_006",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0070_003_01:ChrEv_0070_003_01_006:d2a4a772",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0070_003_01:ChrEv_0070_003_01_006:d2a4a772",
