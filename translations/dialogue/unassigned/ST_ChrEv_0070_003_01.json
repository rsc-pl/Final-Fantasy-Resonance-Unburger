      },
      "text": {
        "jp": "ソゼ皇帝とはどこで知り合ったんだ？",
        "official_en": "How did she meet Emperor Sozhe?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
