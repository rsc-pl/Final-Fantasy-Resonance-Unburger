        "official_en_sha256": "17024704b5ed1c99668e01b69665737b8dd8d25c569f75c0365422dd32718f04"
      },
      "text": {
        "jp": "一戦一戦で勝敗はつくが、\r\nそうやって勝ったり負けたりして\r\n最強を目指す……",
        "official_en": "So each match has a winner and loser, but we keep competing that way while striving to be the best...",
        "real_en": null
