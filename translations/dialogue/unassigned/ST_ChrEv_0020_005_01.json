        "official_en_sha256": "499464c0cb6471f0053712e8042672c86dfd17b7960c42114809c3327ca03221"
      },
      "text": {
        "jp": "何言ってるんだよ、ラスウェル。",
        "official_en": "What makes you say that, Lasswell?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
