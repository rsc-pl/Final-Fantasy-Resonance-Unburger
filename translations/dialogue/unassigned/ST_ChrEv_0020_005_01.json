      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0020_005_01",
        "key": "ChrEv_0020_005_01_015",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0020_005_01:ChrEv_0020_005_01_015:e1289686",
