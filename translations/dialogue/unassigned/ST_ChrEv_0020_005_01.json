        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0020_005_01:ChrEv_0020_005_01_004:5a96bdde",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0020_005_01:ChrEv_0020_005_01_004:5a96bdde",
