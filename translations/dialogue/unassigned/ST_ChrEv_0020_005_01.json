    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0020_005_01:ChrEv_0020_005_01_012:35467d2f",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0020_005_01",
        "key": "ChrEv_0020_005_01_012",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0020_005_01:ChrEv_0020_005_01_012:35467d2f",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0020_005_01:ChrEv_0020_005_01_012:35467d2f",
