        "official_en_sha256": "3cbca6788597ac134f34875194823116b402f12fb38be47ed5ad94d9ef3d874c"
      },
      "text": {
        "jp": "子供の頃、ここで話したことを覚えているか？",
        "official_en": "Do you remember what we talked about here when we were younger?",
        "real_en": null
