        "official_en_sha256": "e186cd722450df446b6f2e8cabc2c2998017a1e857dd36c4338ea5b12d72ec59"
      },
      "text": {
        "jp": "昔はよく来たな、この場所……。",
        "official_en": "We used to come here all the time... Takes you back, huh?",
        "real_en": "We used to come here a lot..."
