        "official_en_sha256": "b7e3b048619a6e8da63314dd4bcaf8773e4b027bb4269b90135677a723de2c65"
      },
      "text": {
        "jp": "二人でナンバーワンになる、だろ？\r\nもちろん、覚えてるさ。",
        "official_en": "About both of us being the greatest knight? I sure do.",
        "real_en": null
      },
      "review": {
