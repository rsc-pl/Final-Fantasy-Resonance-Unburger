    {
      "record_id": "switch:locres:set-02:ST_Summon630_Ifrit_01:Summon630_Ifrit_01_002:1bea290e",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon630_Ifrit_01",
        "key": "Summon630_Ifrit_01_002",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_01:Summon630_Ifrit_01_002:1bea290e",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_01:Summon630_Ifrit_01_002:1bea290e",
