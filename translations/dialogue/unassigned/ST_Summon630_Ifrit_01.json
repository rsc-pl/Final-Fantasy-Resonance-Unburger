        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_01:Summon630_Ifrit_01_003:daa8ed90",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_01:Summon630_Ifrit_01_003:daa8ed90",
