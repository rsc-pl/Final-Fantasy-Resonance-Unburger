        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0050_002_01:ChrEv_0050_002_01_014:b7346ca9",
        "jp_sha256": "74b419795d3574dd3e992914cf7cc85d2d0bb33df52f651e07324131ec32687a",
        "official_en_sha256": "a2f73bc5c86a89d34202b4f96bbdae4a5ac6dcc745f30009b7e9f55730530abe"
      },
      "text": {
        "jp": "あの新参の行商人の野郎。\r\nあんなまずいもんで儲けやがって。",
        "official_en": "Damn that lousy upstart, making a ridiculous profit off that slop.",
        "real_en": "That damn new traveling merchant, making money off that awful stuff!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
