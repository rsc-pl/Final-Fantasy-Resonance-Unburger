    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0050_002_01:ChrEv_0050_002_01_012:55d14159",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0050_002_01",
        "key": "ChrEv_0050_002_01_012",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0050_002_01:ChrEv_0050_002_01_012:55d14159",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0050_002_01:ChrEv_0050_002_01_012:55d14159",
        "jp_sha256": "c5d6f7aa917c9cbc5f380ca455c66857190208f8f275bfb319bfa33ce0b76e56",
        "official_en_sha256": "bb2bd9613207e142cce8bb67d580060157e454e0cbd2514b718bfe67f7936e18"
      },
