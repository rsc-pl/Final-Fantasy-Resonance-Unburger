        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0050_002_01:ChrEv_0050_002_01_013:4b7827e4",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0050_002_01:ChrEv_0050_002_01_013:4b7827e4",
