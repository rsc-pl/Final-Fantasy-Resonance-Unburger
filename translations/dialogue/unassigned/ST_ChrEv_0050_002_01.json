        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0050_002_01:ChrEv_0050_002_01_008:2d9e7862",
        "jp_sha256": "f28a548be6590c0472e56dd5cca9c0c7a0f2febf2a8e435c814c3d8f8647142d",
        "official_en_sha256": "e65b9eaf1d096d557e852b7b29153c3620f2d7586d9732391fd5f349d2fc840a"
      },
      "text": {
        "jp": "ありゃ水神様の呪いだぜ。\r\n間違いない。",
        "official_en": "The curse of the God of Water, no doubt... I can feel it in my bones.",
        "real_en": "That’s the God of Water’s curse, all right.\r\nI’m sure of it."
      },
      "review": {
        "status": "CHANGE"
      },
