    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_010:035ff110",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2630_005_01",
        "key": "ChrEv_2630_005_01_010",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_010:035ff110",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_010:035ff110",
        "jp_sha256": "e7ebe559c50f5ba8dfe935d14f44b1ddbd3c521bc2ca5eb3a198170630a940bc",
        "official_en_sha256": "dade6084bb692d6f5cd40109734b117eca0f22865311561f5e52ff174f3dbc28"
      },
      "text": {
        "jp": "いいわ、オゼッタ。\r\n私はタダでは記事は書かない女だけど\r\nこればかりは、将軍への恩返しと思って記事にする。",
        "official_en": "I usually don’t work for free, but...this one’s on the house, Ozetta. I’ll write the article—I owe the general that much.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_ChrEv_2630_005_01",
