        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_012:e340ad12",
        "jp_sha256": "4c1cb80cafe32741bda3b0be0c909c7bcbe25fee925e95677096c9d311380fb4",
        "official_en_sha256": "0db83a336e931ad09c473cbd1f1c7042ccbefbee9e359881dc1d4056d718cfdb"
      },
      "text": {
        "jp": "ありがとうございます……。",
        "official_en": "Thank you, Foxie...",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
