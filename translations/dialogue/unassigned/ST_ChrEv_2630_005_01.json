          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_002:ad28e8e5",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2630_005_01",
        "key": "ChrEv_2630_005_01_002",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_002:ad28e8e5",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_002:ad28e8e5",
        "jp_sha256": "59e89f24d0e927323c687685c6081421e98ce0313087230855aa393343db28b0",
        "official_en_sha256": "fdd8d3ddaf61e278ca6018bf5e7aab2e301c27ba27c05d6d4b16e6c9241d6f76"
      },
      "text": {
        "jp": "あら、オゼッタ。\r\n今日は珍しく、一人じゃないのね。",
        "official_en": "Ozetta. Not every day that I see you with company. What’s up?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
