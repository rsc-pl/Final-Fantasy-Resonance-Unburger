      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_003:81025fa1",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2630_005_01",
        "key": "ChrEv_2630_005_01_003",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_003:81025fa1",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_003:81025fa1",
        "jp_sha256": "8dbedac893b0cf017975dc8cdcdaf93eb2c011a21a757da19e6b61f9478d4306",
        "official_en_sha256": "5f95070675b8b4d31ef3f80f8e2e3741c249add70f45e77ee4f64282af9c7969"
      },
      "text": {
        "jp": "あなたが新聞記者か？",
        "official_en": "So you’re the journalist Ozetta mentioned?",
        "real_en": "Are you the journalist?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_ChrEv_2630_005_01",
