    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_019:9f387d00",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2630_005_01",
        "key": "ChrEv_2630_005_01_019",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_019:9f387d00",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_019:9f387d00",
        "jp_sha256": "943c225c4bd78bc25b6dc5b943fb51e5936fb9fd744d6074632baf2d543b13e6",
        "official_en_sha256": "0b25018cad5d651fef6f2e4b5691b008e8232e38b512c8b727c422af13c0db55"
      },
      "text": {
        "jp": "いいえ。\r\n私よりもあなたたちが持つべきです。",
        "official_en": "I insist. It belongs in your hands, not mine.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
