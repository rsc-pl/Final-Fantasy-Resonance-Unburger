    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_021:999c4388",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2630_005_01",
        "key": "ChrEv_2630_005_01_021",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_021:999c4388",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_021:999c4388",
        "jp_sha256": "83580297426f928ad9681ef6dcdeb06d0c54a892c12b4d6fa1ff4e0484580942",
        "official_en_sha256": "ec90ff6a398d0de721835543fbcdda0e2821bf659f6f9bfda2d430ece3445fb6"
      },
      "text": {
        "jp": "あなたたちは世界を守るため……。\r\n「世界の盾」となるべく旅をしているのだと思います。",
        "official_en": "You are on a journey to save the world, are you not? To become the “Shield of the World”?",
        "real_en": "I think you’re travelling to protect the world... to become its “Shield.”"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_ChrEv_2630_005_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "オゼッタ",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0117",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
