      },
      "text": {
        "jp": "……で、調査に進展があったの？",
        "official_en": "I see. What have you got for me?",
        "real_en": "So, have you made any progress with the investigation?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
