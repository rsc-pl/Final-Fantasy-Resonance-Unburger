          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_015:32fd95c8",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2630_005_01",
        "key": "ChrEv_2630_005_01_015",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_015:32fd95c8",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2630_005_01:ChrEv_2630_005_01_015:32fd95c8",
