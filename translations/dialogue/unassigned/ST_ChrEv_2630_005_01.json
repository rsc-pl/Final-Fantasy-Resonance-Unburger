        "official_en_sha256": "a7ef74e401ca29e2ee172c7a0b5f09ffca4eb58761bdd5220c628a36236c6208"
      },
      "text": {
        "jp": "お礼と言ってはなんですが……これを受け取ってください。",
        "official_en": "As a token of my appreciation...please, take this.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
