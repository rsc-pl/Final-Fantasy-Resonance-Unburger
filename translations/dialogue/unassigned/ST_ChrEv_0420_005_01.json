    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_007:4eb3dd0d",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_005_01",
        "key": "ChrEv_0420_005_01_007",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_007:4eb3dd0d",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_007:4eb3dd0d",
        "jp_sha256": "413f29f2d58425c4ae875517dba80af729b6639621e530e39d961828c08c9061",
        "official_en_sha256": "7b60d0df6b03708fc038912f7d375c836cd895e6f1eb3a78d9f2c6a341b047a4"
      },
      "text": {
        "jp": "じゃが、お前はこの町に必要な白魔道士じゃ。\r\nいなくなれば多くの人が困るに違いない。",
        "official_en": "Yet, you are a white mage—an essential presence in this town. If you were to leave, many would doubtless suffer from your absence.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
