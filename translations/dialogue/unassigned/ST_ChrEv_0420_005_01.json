        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_012:82bcc50a",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_005_01",
        "key": "ChrEv_0420_005_01_012",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_012:82bcc50a",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_012:82bcc50a",
        "jp_sha256": "33cea836389286f34c38c00715a2e7377beec44c039f5a5246d7fa1a2dffff86",
        "official_en_sha256": "7da108f2262c857551f5c0d293504c531c9e9aadfdae2d12d6ae0bba7e18a349"
      },
      "text": {
        "jp": "そんなことだと思ってました。",
        "official_en": "I knew it.",
        "real_en": "I had a feeling it was something like that."
      },
      "review": {
        "status": "CHANGE"
      },
