      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_002:d4d5ab01",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_005_01",
        "key": "ChrEv_0420_005_01_002",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_002:d4d5ab01",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_002:d4d5ab01",
        "jp_sha256": "1bb86d7d32b48f44c1808c23db90ac4b88d846d9cf523d243f275926751d484a",
        "official_en_sha256": "8d3edb76b75a18466fcbaa4cdc6022fa83c3c3b9b600faae9a4a4884b6ccc656"
      },
      "text": {
        "jp": "うむ。\r\nワシの言った心得は忘れていないようじゃな。",
        "official_en": "Good, good. You have remembered my lesson.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
