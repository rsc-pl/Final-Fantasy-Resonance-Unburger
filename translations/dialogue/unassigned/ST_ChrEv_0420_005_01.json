    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_008:2070155a",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_005_01",
        "key": "ChrEv_0420_005_01_008",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_008:2070155a",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_008:2070155a",
        "jp_sha256": "da1fa555825f28f6baee165b57b0f40b48198bffcd2cc6b22d1a0e31aba1e49b",
        "official_en_sha256": "4d2e7c189483a69cb91d324e387b6cc492967aba0490a29a2522844ceba4bd85"
      },
      "text": {
        "jp": "だからアヤカに黙って町からいなくなったのか。",
        "official_en": "So that’s why you left for Mysidia without telling her...",
        "real_en": null
      },
      "review": {
