    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_016:f4f5da8e",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_005_01",
        "key": "ChrEv_0420_005_01_016",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_016:f4f5da8e",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_016:f4f5da8e",
        "jp_sha256": "49dbd05113e59fccd4b20afefa22caf1b28ad15d67aab0cd493b9340d0ffd33f",
        "official_en_sha256": "abb8b8f1aa538058e781a8ac09a7955593681daac025c7a6daddde5655dc7b8b"
      },
      "text": {
        "jp": "そこはやっぱり師匠の口から聞きたいじゃないですか。\r\n大事な弟子って。",
        "official_en": "Because if I hadn’t, I would have missed out on hearing you say it, Mistress Sakura!",
        "real_en": "Because I wanted to hear you say it yourself,\r\nMaster—that I’m your precious apprentice."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_ChrEv_0420_005_01",
