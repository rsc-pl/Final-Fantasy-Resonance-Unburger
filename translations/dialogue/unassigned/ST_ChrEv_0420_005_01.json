    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_010:086b789e",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_005_01",
        "key": "ChrEv_0420_005_01_010",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_010:086b789e",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_010:086b789e",
        "jp_sha256": "31c527b57f501c9b9fbe58871753b7509ed6ccdf1e192bff8d0900395849801c",
        "official_en_sha256": "b4eaa25e265b5fba294385be170c9c06f1598a9c157546630e5e3c731634224d"
      },
      "text": {
        "jp": "それにワシと一緒にいれば\r\nいろいろ面倒なことに巻き込まれる。",
        "official_en": "Following me would also have inevitably put her in the path of danger.",
        "real_en": "Besides, staying with me would get her tangled up in all sorts of trouble."
      },
      "review": {
        "status": "CHANGE"
      },
