        "official_en_sha256": "f3c093c166d451bbdbe09c96841e9991d4e39241aa4f8c0b33551c37b0dbf6b7"
      },
      "text": {
        "jp": "そうじゃ。",
        "official_en": "Indeed.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
