    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_003:ddaead85",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_005_01",
        "key": "ChrEv_0420_005_01_003",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_003:ddaead85",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_003:ddaead85",
        "jp_sha256": "d68ac5bd83ab0adb3798b72fafbf99c8506ac83164a1313d42c09fa5a0236b0a",
        "official_en_sha256": "a75103428cf85ff6be1b0a171516ce135c9af11ccdb8f5401b6c6996d1b2c18e"
      },
      "text": {
        "jp": "はい！\r\nこの魔力は自分のためではなく、誰かのために使うこと。\r\n師匠の教えはずっと守っています。",
        "official_en": "Yes! My magic should be used for the good of others, not for my own gains. I’ve taken your words to heart, Mistress Sakura!",
        "real_en": "Yes! You taught me to use my magic\r\nfor others, not myself.\r\nI’ve always followed that lesson, Master."
      },
      "review": {
        "status": "CHANGE"
      },
