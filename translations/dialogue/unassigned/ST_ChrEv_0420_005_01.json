    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_017:0e179a33",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_005_01",
        "key": "ChrEv_0420_005_01_017",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_005_01:ChrEv_0420_005_01_017:0e179a33",
