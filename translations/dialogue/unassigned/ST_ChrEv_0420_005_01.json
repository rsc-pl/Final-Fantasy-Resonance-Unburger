        "official_en_sha256": "f1e59608b830dcce16e529d2d371fe090dcc9f546b243f9f19ee01b82141ca6c"
      },
      "text": {
        "jp": "はい！",
        "official_en": "But of course!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
