        "official_en_sha256": "48f00a864811287bc267a9bda3537de26179cc3fa95709d7ff7aa7ab2f72aa04"
      },
      "text": {
        "jp": "じゃ、少し休もうか。\r\nあんまり思い詰めるのもよくないし。",
        "official_en": "How about we rest a bit? No need to rack our brains out here.",
        "real_en": "How about we take a little break? It's not good to dwell on it too much."
      },
