    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0410_006_01:ChrEv_0410_006_01_010:28708a2c",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0410_006_01",
        "key": "ChrEv_0410_006_01_010",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0410_006_01:ChrEv_0410_006_01_010:28708a2c",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0410_006_01:ChrEv_0410_006_01_010:28708a2c",
        "jp_sha256": "aaa879d854fdfdb837faabd7797179acc417c1694001822bc27d109a7dae6b02",
        "official_en_sha256": "bbeda29ea7fcfd72593f601e65bb5de7894fd5fc9260d642392e960a753879ba"
      },
      "text": {
        "jp": "たしかに、列車事故の被害者なら\r\n事件の後のことを知っているのはおかしいな。",
        "official_en": "Now that you mention it... If you died on that train, it wouldn’t make sense for you to know what happened afterward.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
