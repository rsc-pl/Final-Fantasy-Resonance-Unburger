        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0410_006_01:ChrEv_0410_006_01_004:d5e49a90",
        "jp_sha256": "cbf8e3cf72a611679763f360240f0fc485a1a5390b61dfe39bb47248289ac156",
        "official_en_sha256": "2b60ba98c840a13eb2a8af721da134db4f22f0181a2683f6e8f4711629c03ac1"
      },
      "text": {
        "jp": "さすがに、この人が犯人じゃないよな……",
        "official_en": "This poor woman can’t be the culprit, right?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
