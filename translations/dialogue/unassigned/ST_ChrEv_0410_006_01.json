        "official_en_sha256": "0f9b7467d861a7826d5da55d56fc560f55ad62c60b1b588f97e68368ad400c3d"
      },
      "text": {
        "jp": "この列車はゾルダードに向かっていたの。\r\nでも、あんな事故にあうなんてねぇ……。",
        "official_en": "This train was headed for Zoldaad. It’s hard to believe the accident it was in.",
        "real_en": null
      },
      "review": {
