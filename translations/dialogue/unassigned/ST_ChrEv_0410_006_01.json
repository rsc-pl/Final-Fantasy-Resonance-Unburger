    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0410_006_01:ChrEv_0410_006_01_005:80248343",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0410_006_01",
        "key": "ChrEv_0410_006_01_005",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0410_006_01:ChrEv_0410_006_01_005:80248343",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0410_006_01:ChrEv_0410_006_01_005:80248343",
        "jp_sha256": "2e7cea7720a27ad866caf065472f4be10d71f83b5c88f9f9ee7d16ad49d7f8ef",
        "official_en_sha256": "10af1dc0e5668f3035543983b22b463a6b7049c85db4ce018f26152425ddc668"
      },
      "text": {
        "jp": "レイン、最初に言ったわよね。\r\n「お人好し」は少しだけ封印した方がいいって。",
        "official_en": "Rain... Like I told you, your good nature’ll only get you in trouble here.",
