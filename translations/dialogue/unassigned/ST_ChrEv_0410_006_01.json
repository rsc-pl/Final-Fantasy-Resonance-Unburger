        "official_en_sha256": "f6b7b240ea148091926ee0c7f94426b3fa365599cec8bb720e9b93a9a5ee1d5a"
      },
      "text": {
        "jp": "でも、今回はそれが裏目に出たようね。",
        "official_en": "But I’d say this time that became its undoing.",
        "real_en": null
      },
      "review": {
