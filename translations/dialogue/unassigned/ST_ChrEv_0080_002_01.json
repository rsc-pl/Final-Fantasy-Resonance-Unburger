    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_024:9fb185b6",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_002_01",
        "key": "ChrEv_0080_002_01_024",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_024:9fb185b6",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_024:9fb185b6",
        "jp_sha256": "ca0858de980bd5fa0059cb1d9de6cebf4f02cbf3a8cc7df174afe2e62e2f9a73",
        "official_en_sha256": "b42e83f7494ce079de1a68770d4faf9432331bdf80fabab7948e440a4856bb9c"
      },
      "text": {
        "jp": "さぁ、ミシディアの塔の頂上へいくぞ。\r\nそこで見せてやろう。\r\nワシの過去をな。",
        "official_en": "Come—let us venture there once more. ’Tis there that I shall reveal my past to you.",
        "real_en": "Come on, let's go to the top of the Tower of Mysidia. I'll show you my past there."
      },
      "review": {
        "status": "CHANGE"
      },
