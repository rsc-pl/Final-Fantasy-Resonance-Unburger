        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_006:55dfbfde",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_006:55dfbfde",
        "jp_sha256": "b185fd46afe53d9be662378890011bd73f9866fcd4596139991a6a29f472e1de",
        "official_en_sha256": "b6c9cb4e0a76899b3f954218f3e255daed242b20f4912f1074d6068cde96ac6c"
      },
      "text": {
        "jp": "あるなら最初から教えてくれればいいのに。",
        "official_en": "You know you could have saved us time and told me where it was in the first place.",
        "real_en": null
      },
      "review": {
