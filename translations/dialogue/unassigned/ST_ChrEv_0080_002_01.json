    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_014:5bf66827",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_002_01",
        "key": "ChrEv_0080_002_01_014",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_014:5bf66827",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_014:5bf66827",
        "jp_sha256": "4390340d4168e2545238a556b608a4da1d0548b2e27d4a8ed35efafe6e10d4bc",
        "official_en_sha256": "6cecece70dc46f17b2d1d79c25701c88d09473fa853f74e689e6dbe3771dcdd6"
      },
      "text": {
        "jp": "おおらかで人当たりが良かったサクラとは対照的に、\r\nひどく偏屈で冷酷だったって。",
        "official_en": "It says that, in contrast to your “warm and pleasant nature,” she was “terribly disagreeable and coldhearted.”",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
