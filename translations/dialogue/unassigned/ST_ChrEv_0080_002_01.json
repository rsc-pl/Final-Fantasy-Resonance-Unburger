        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_004:e14b96e6",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_004:e14b96e6",
        "jp_sha256": "b02008026decd6cd26ae8497fdc8031b56a099fd9cfc070ca0da24cfc6592352",
        "official_en_sha256": "c4ee60a4276b397711becb2d8af0c0936832ce5e6e577746600e96b6cd5220e0"
      },
      "text": {
