        "key": "ChrEv_0080_002_01_017",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_017:7f4fff03",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_017:7f4fff03",
