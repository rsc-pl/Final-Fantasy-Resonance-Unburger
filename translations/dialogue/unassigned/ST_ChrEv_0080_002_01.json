    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_007:cb7ce841",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_002_01",
        "key": "ChrEv_0080_002_01_007",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_007:cb7ce841",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_007:cb7ce841",
        "jp_sha256": "3e7566b7a1535f4312214e8f11f898fe89a265f2742b4aa0f22947dd669dfbae",
        "official_en_sha256": "76d3562d2a3ad6dca53c38785aed661f870731b7a37dd3ba3fe45bc56fd56120"
      },
      "text": {
        "jp": "ここは基本的にはパラデイアの蔵書が大半じゃ。\r\n最近作られた本については、ワシも全部は把握しとらんよ。",
        "official_en": "Most of the space here is dedicated to books from Paladia. As such, I am somewhat unacquainted with recent additions.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_ChrEv_0080_002_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "サクラ",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0085",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_ChrEv_0080_002_01/ChrEv_0080_002_01_007"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_001:0860bbe6",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_002_01",
        "key": "ChrEv_0080_002_01_001",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_001:0860bbe6",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_002_01:ChrEv_0080_002_01_001:0860bbe6",
        "jp_sha256": "9331a3efab589eb4f7eb2a4e1eb3f5a932ffe6dfc97362f5ce1f95cecbbc0d9f",
        "official_en_sha256": "2dc1c59c6f85e2bf3cc78cc5b2cbbd16c90b5fbe41b54f235786a8fb1c6cd323"
      },
      "text": {
        "jp": "これだけの本があるんだ。\r\nミシディア建国当時の記録だって\r\nあるだろ？",
        "official_en": "With this many books, there has to be some record of the creation of Mysidia. Any idea on where we should start looking?",
        "real_en": "With this many books, there's bound to be a record of Mysidia's founding, right?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
