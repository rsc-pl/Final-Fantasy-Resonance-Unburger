        "set": "set-02",
        "namespace": "ST_Summon620_Ramuh_03",
        "key": "Summon620_Ramuh_03_016",
        "jp_record_id": "switch:locres:set-02:ST_Summon620_Ramuh_03:Summon620_Ramuh_03_016:67bf5be3",
