        "official_en_sha256": "839b7aa9659795ad4457aba7991767a84d6633a068242635b465d49eb66cb712"
      },
      "text": {
        "jp": "この装置は作動していない。\r\nどこかでスイッチを入れる必要がありそうだ。",
        "official_en": "This elevator seems to be offline. There must be a way to turn the power back on.",
        "real_en": "This device isn't running. Looks like we need to flip a switch somewhere."
