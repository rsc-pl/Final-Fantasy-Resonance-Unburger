    {
      "record_id": "switch:locres:set-02:ST_GimEv_SystemMessage:GimEv_SystemMessage_018:731302ba",
      "source": {
        "set": "set-02",
        "namespace": "ST_GimEv_SystemMessage",
        "key": "GimEv_SystemMessage_018",
        "jp_record_id": "switch:locres:set-02:ST_GimEv_SystemMessage:GimEv_SystemMessage_018:731302ba",
        "official_en_record_id": "switch:locres:set-02:ST_GimEv_SystemMessage:GimEv_SystemMessage_018:731302ba",
