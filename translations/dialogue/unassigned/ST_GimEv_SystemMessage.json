    {
      "record_id": "switch:locres:set-02:ST_GimEv_SystemMessage:GimEv_SystemMessage_027:da332db1",
      "source": {
        "set": "set-02",
        "namespace": "ST_GimEv_SystemMessage",
        "key": "GimEv_SystemMessage_027",
        "jp_record_id": "switch:locres:set-02:ST_GimEv_SystemMessage:GimEv_SystemMessage_027:da332db1",
        "official_en_record_id": "switch:locres:set-02:ST_GimEv_SystemMessage:GimEv_SystemMessage_027:da332db1",
        "jp_sha256": "83712c8441031328a59f7f31544a337ceadabfe29485ea088d038a3056025b6a",
        "official_en_sha256": "25239ee900df71d9ea0e8d9e052da49c474d62ebea4a059844d3ac7ae48b5cae"
      },
      "text": {
        "jp": "これは……この村の掲示板だな。\r\nさて、どのお知らせを読もうか……。",
        "official_en": "This looks like the noticeboard for the area. Which notice should I check out?",
        "real_en": "This is the village bulletin board... Which notice should I read?"
      },
      "review": {
        "status": "CHANGE"
      },
