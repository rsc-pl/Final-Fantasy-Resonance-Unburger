          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_012:1d5deeb7",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_002_01",
        "key": "ChrEv_0420_002_01_012",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_012:1d5deeb7",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_012:1d5deeb7",
        "jp_sha256": "d9edc7c756b73e01e89a887f6eaf7ccef6b0b4e9a76fe1fe7bbd60c3cf94a6d9",
        "official_en_sha256": "59c4fa476fd47219501a72cfbf6c87dab734cfaa65009e71612454606a09f60e"
      },
      "text": {
        "jp": "そうじゃったかのう？",
        "official_en": "Hm. ’Twould seem my memory may as well be writ in water.",
        "real_en": "Did I say that?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_ChrEv_0420_002_01",
