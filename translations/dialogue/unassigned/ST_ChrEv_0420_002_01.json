    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_002:09b3e433",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_002_01",
        "key": "ChrEv_0420_002_01_002",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_002:09b3e433",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_002:09b3e433",
        "jp_sha256": "5174d29af228887052f9f7bb3df34ea760e1d912242365bca6098c766ee646f2",
        "official_en_sha256": "821f6617aace9736669326b4496310da925111f33b90441c585734e0f0dca482"
      },
      "text": {
        "jp": "はい！\r\nなんか体がリフレッシュした感じがします！",
        "official_en": "I do! I feel amazing!",
        "real_en": "Yes! I feel refreshed, somehow!"
      },
      "review": {
