    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_001:a63b3999",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_002_01",
        "key": "ChrEv_0420_002_01_001",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_001:a63b3999",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_001:a63b3999",
        "jp_sha256": "4bd832d819d01dd47993c42e37f32a29ba582b6e57c33136a8f1a3609a945979",
        "official_en_sha256": "5167889d9d0f8b2ca961718ae1d7a3a42af174b8e07e7dca2206f9598d56ec93"
      },
      "text": {
        "jp": "アヤカ、どうじゃ？\r\n大自然の力を感じるか？",
        "official_en": "Tell me, Ayaka, do you feel the essence of nature coursing through you?",
        "real_en": null
