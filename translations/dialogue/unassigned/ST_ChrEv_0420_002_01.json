        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_006:4ab29c7a",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_002_01",
        "key": "ChrEv_0420_002_01_006",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_006:4ab29c7a",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_006:4ab29c7a",
        "jp_sha256": "09035e313d7b9465130301f2db8d736dcad12d62efe391aa96882ede164b457e",
        "official_en_sha256": "ed5e1500b30dafd2838d40beb2e35f01c783d4ec6138dac57c0ea50e73454ccb"
      },
      "text": {
        "jp": "なあ、サクラとアヤカは\r\nどうして師弟関係になったんだ？",
        "official_en": "Speaking of which, how did Ayaka come to be your apprentice?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
