      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_008:e026170a",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_002_01",
        "key": "ChrEv_0420_002_01_008",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_008:e026170a",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_008:e026170a",
        "jp_sha256": "b7283c7f802b470423c63e91569cd434dc5b1db01f12f97cc996d47de9882ffe",
        "official_en_sha256": "d99858ce902cbed85540d98afd393831ac5c60147ddb74a60a2b2db1ddd8690b"
      },
      "text": {
        "jp": "そのときにまだ幼かったアヤカが\r\n魔法を教えろとしつこくせがんできてのう。",
        "official_en": "It was then that Ayaka—wee little thing that she was—rather industriously hounded me to instruct her in the arcane arts.",
        "real_en": "Ayaka was still little back then, but she kept pestering me to teach her magic."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_ChrEv_0420_002_01",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "サクラ",
          "label_status": "VERIFIED",
