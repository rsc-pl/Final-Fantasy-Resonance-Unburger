          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_019:13359e96",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_002_01",
        "key": "ChrEv_0420_002_01_019",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_019:13359e96",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_019:13359e96",
        "jp_sha256": "e51c202f0c66df8e6f4539b85c2f76ca82d663c1970533d37d68b3d6bb1a65aa",
        "official_en_sha256": "f12d3092045478698930f139385f91ba2cca7abe6cfc6ea3143448aa7c85ed1e"
      },
      "text": {
        "jp": "ちょうどゾルダードの火山に\r\n飛空艇で入れる洞窟があったはずじゃ。\r\nそこへいこう。",
        "official_en": "I do seem to recall that within the volcano of Zoldaad lies a vast cave into which an airship can fly. We shall venture thither.",
        "real_en": "There should be a cave in a volcano in Zoldaad that we can fly the airship into. Let's go there."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
