    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_018:4e4fff65",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_002_01",
        "key": "ChrEv_0420_002_01_018",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_018:4e4fff65",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_018:4e4fff65",
        "jp_sha256": "9fd7428b12653e98de9e24619b3f59d65e89987711eeaa03c90424a9103cab18",
        "official_en_sha256": "d0ee01922e4408dbbe995df86dd4aa6bf01ef82357dc27a3225260647dbc5ddc"
      },
      "text": {
        "jp": "さあ、次の地脈に行くぞ。\r\n炎の地脈じゃな。",
        "official_en": "Now, let us journey to the next ley line—that of Fire.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
