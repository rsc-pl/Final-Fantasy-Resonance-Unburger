    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_014:e06830f7",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_002_01",
        "key": "ChrEv_0420_002_01_014",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_014:e06830f7",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_014:e06830f7",
        "jp_sha256": "cdef3d00686ce04692f1079ace927fc53d100b591f39712f2d3ee39b7634079c",
        "official_en_sha256": "e81f44ab5062b07b9259d22793e41fc19a7fc68714ed5c280e41b213c7462030"
      },
      "text": {
        "jp": "はい。\r\n今は独りで暮らしています。",
        "official_en": "That’s right. I live on my own now.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
