        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_013:2513335a",
        "jp_sha256": "25c301817357aeae84f4ca2bb677472b32d19b94bae751ced358df21a47e472e",
        "official_en_sha256": "491265b4861178280b795f3d0706262212019102ca5eb624d7d6ae2b3962ecc2"
      },
      "text": {
        "jp": "……そっか。\r\nアヤカの両親はもういないのか。",
        "official_en": "I see... So your parents are no longer around.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
