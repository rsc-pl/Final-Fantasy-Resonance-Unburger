        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_005:955d266c",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_002_01",
        "key": "ChrEv_0420_002_01_005",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_005:955d266c",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_005:955d266c",
        "jp_sha256": "9840cf2bc62c5dd90576eff20cff8fd84699223a02d411f4110268f3ff95fc9f",
        "official_en_sha256": "eff41040bc4f8b07f8e45bfd159faa925a90f61b222c3d86f114d64c002d9e87"
      },
      "text": {
        "jp": "はい、師匠！",
        "official_en": "Yes, Mistress!",
        "real_en": "Yes, Master!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
