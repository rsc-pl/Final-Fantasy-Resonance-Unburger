    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_015:8ef5e163",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_002_01",
        "key": "ChrEv_0420_002_01_015",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_015:8ef5e163",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_002_01:ChrEv_0420_002_01_015:8ef5e163",
        "jp_sha256": "623d1964eb70e5f185e325112ec6fc106d8a580eb6c020040a242746d1099e15",
        "official_en_sha256": "c50e976a1524eb8569ccb2b3bd892b4675e10737f24e8e7075710fa60754f8eb"
      },
      "text": {
