        "official_en_sha256": "a4d49f87c37d6030675812b49c1794fed755c4d595babdd275873d6038e55fc6"
      },
      "text": {
        "jp": "そうか、冗談でよかったよ。",
        "official_en": "Glad to know you’re still sane. Can’t say the same for your sense of humor, though.",
        "real_en": "Oh, good. I'm glad you were joking."
      },
