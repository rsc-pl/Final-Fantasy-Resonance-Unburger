        "official_en_sha256": "61a284ec24eed9679ac5df5bf4cce38806afdc0eda8ae3e6201e99056cf6822a"
      },
      "text": {
        "jp": "もちろん、本気だ。\r\n気になるだろ！　火山の中なんてさ！",
        "official_en": "I’m being completely serious, Evan. It’s the inside of a volcano. Don’t tell me you aren’t at least a little curious.",
        "real_en": "Of course I'm serious. Aren't you curious? It's the inside of a volcano!"
      },
