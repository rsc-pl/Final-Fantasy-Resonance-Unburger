        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_02:Summon630_Ifrit_02_002:14694933",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_02:Summon630_Ifrit_02_002:14694933",
