        "official_en_sha256": "28d900920f8bd4156db35793288434d4965be988a4497280e31f407a092524b2"
      },
      "text": {
        "jp": "レインさん、サクラ師匠！\r\n今回はありがとうございました！",
        "official_en": "Rain! Mistress Sakura! Thank you for everything!",
        "real_en": "Rain-san! Master Sakura!\r\nThank you so much for everything this time!"
      },
      "review": {
        "status": "CHANGE"
