      },
      "text": {
        "jp": "おぉーっと！　この船を見つけるたァ、ツイてるなアンタ！\r\n潮に呼ばれたか、このオレに会いてぇってよォ！",
        "official_en": "Ahoy, matey! Lucky ye found us on the high seas—or perhaps the sea willed our meetin’!",
        "real_en": "Whoa there! You're lucky you found this ship! Did the tide lead you here, or were you hoping to see me?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
