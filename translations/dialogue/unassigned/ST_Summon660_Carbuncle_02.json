      }
    },
    {
      "record_id": "switch:locres:set-02:ST_Summon660_Carbuncle_02:Summon660_Carbuncle_02_004:ad63cf5a",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon660_Carbuncle_02",
        "key": "Summon660_Carbuncle_02_004",
        "jp_record_id": "switch:locres:set-02:ST_Summon660_Carbuncle_02:Summon660_Carbuncle_02_004:ad63cf5a",
        "official_en_record_id": "switch:locres:set-02:ST_Summon660_Carbuncle_02:Summon660_Carbuncle_02_004:ad63cf5a",
        "jp_sha256": "adf696230ae0e7be59fa025d5241ba3ede98e478284840f70ae520d6e3ad8ac6",
        "official_en_sha256": "06f454feca57f656dbf980474a930d454bfb11b9d2b903dd8ed8e8eef23ad456"
      },
      "text": {
        "jp": "１つ目は、水都の南東、大きな水と小さな水を両手にする。\r\n２つ目は、水都の東、二つのへこみを背にして海を見下ろす。\r\n３つ目は、水都の北西、７つの水が落下する場所の左側。",
        "official_en": "<text style=\"italic\">“The first lies southeast of the city. It holds the big and small ponds in both hands. The second, to the city’s east. With your back to the two indentations, look at the sea.”</>",
        "real_en": "<text style=\"italic\">“The first lies southeast of the water city, holding the large and small waters in both hands. The second lies east of the water city, looking down at the sea with two hollows at your back. The third lies northwest of the water city, to the left of where seven waters fall.”</>"
      },
      "review": {
        "status": "CHANGE"
