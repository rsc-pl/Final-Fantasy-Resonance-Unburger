    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0410_002_01:ChrEv_0410_002_01_014:3434e3d6",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0410_002_01",
        "key": "ChrEv_0410_002_01_014",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0410_002_01:ChrEv_0410_002_01_014:3434e3d6",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0410_002_01:ChrEv_0410_002_01_014:3434e3d6",
