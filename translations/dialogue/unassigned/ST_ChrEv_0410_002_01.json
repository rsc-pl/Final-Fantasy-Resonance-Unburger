    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0410_002_01:ChrEv_0410_002_01_031:9914e30e",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0410_002_01",
        "key": "ChrEv_0410_002_01_031",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0410_002_01:ChrEv_0410_002_01_031:9914e30e",
