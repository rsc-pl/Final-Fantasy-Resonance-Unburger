        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_007:a5773756",
      "source": {
        "set": "set-02",
        "namespace": "ST_BtlEv_Lazarov_01",
        "key": "BtlEv_Lazarov_01_007",
        "jp_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_007:a5773756",
        "official_en_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_007:a5773756",
        "jp_sha256": "c46afc714f7c58a2b3f25dc4d31bcd56dcbcc22359d72c1ae5128e4910e10a19",
        "official_en_sha256": "9b47cbaa37a81401cb0a1618133010a6dcad345803bbf6a91aaf3da963051eeb"
      },
      "text": {
        "jp": "これは出し惜しみする場面ではないでしょう。\r\n私にはわかります！　頭がいいのですから。",
        "official_en": "I’m not one to hold off on using my ace in the hole...oh no—because I...am SMART!",
        "real_en": "This is no time to hold back. I know that!\nBecause I'm smart!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_BtlEv_Lazarov_01",
