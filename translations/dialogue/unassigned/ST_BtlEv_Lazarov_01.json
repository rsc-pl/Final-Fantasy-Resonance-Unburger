          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_002:df2a3fda",
      "source": {
        "set": "set-02",
        "namespace": "ST_BtlEv_Lazarov_01",
        "key": "BtlEv_Lazarov_01_002",
        "jp_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_002:df2a3fda",
        "official_en_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_002:df2a3fda",
        "jp_sha256": "58514bb704216f1a7613de7230d3e73e9383d1fbb8a1d9285dee2d002287f694",
        "official_en_sha256": "e33f63a7db7f5fce1766975539dd9997e24c47250ae5e11f57bd0c8e96c170ad"
      },
      "text": {
        "jp": "それでは、思い出話に花を咲かせましょうか！\r\nこの懐かしい私の実験体ちゃんと一緒に！",
        "official_en": "Ah...the memories... How about a little throwback? A fight with my lovely experiment!",
        "real_en": "Well then, shall we reminisce?\r\nTogether with this dear old test subject of mine!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
