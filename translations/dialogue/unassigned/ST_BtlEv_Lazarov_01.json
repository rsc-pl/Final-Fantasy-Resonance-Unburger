    {
      "record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_011:4acb2bea",
      "source": {
        "set": "set-02",
        "namespace": "ST_BtlEv_Lazarov_01",
        "key": "BtlEv_Lazarov_01_011",
        "jp_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_011:4acb2bea",
        "official_en_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_011:4acb2bea",
        "jp_sha256": "3c83c7e35d87218f942a1f53d4c54430a1d28c886f5b80d663113aac46506451",
        "official_en_sha256": "e4f6b8c5fc6fe1029e2f9a4a0375b6a9c0fd49c0aef75a7e4cc1a66bd2acc359"
      },
      "text": {
        "jp": "こうなったら、奥の手を使わせてもらいます！",
        "official_en": "That’s it! The kid gloves are coming off! They were too tight anyway!",
        "real_en": "Then I'll have to use my secret weapon!"
      },
      "review": {
        "status": "CHANGE"
      },
