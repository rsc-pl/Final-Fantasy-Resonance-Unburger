        "official_en_sha256": "300b78a71a4ba26c9764bdcf84b9abc144978f9468129d75af92c261fbb99b2e"
      },
      "text": {
        "jp": "ぐおおおおおおおおおおっ！！！！\r\nみなぎる！　パワー！\r\nうなりをあげる！　筋肉！",
        "official_en": "GRAAAAAAAAAH! MUSCLES...ABOUNDING! POWER...OVERWHELMING!",
        "real_en": "GRAAAAAAH!\nPOWER SURGING THROUGH ME!\nMUSCLES ROARING!"
      },
      "review": {
