    {
      "record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_013:f2d81291",
      "source": {
        "set": "set-02",
        "namespace": "ST_BtlEv_Lazarov_01",
        "key": "BtlEv_Lazarov_01_013",
        "jp_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_013:f2d81291",
        "official_en_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_013:f2d81291",
        "jp_sha256": "0c78b42a837e80be322cf6c8f2c3d8df413530523ae4e1a9ab7d77641a9a2ca7",
        "official_en_sha256": "47cb51dc241a2c8a6d252e18a9c644dc3e8987ff223e8333f7121358c1c5d442"
      },
      "text": {
        "jp": "くっくっく！　私自身の肉体を強化しました。\r\nこれであなた方もおしまいです！",
        "official_en": "Heh heh heh! I’ve augmented my own body for peak performance! Now you’re done for!",
        "real_en": "Heh heh heh! I've enhanced my own body.\nNow you're finished!"
      },
      "review": {
        "status": "CHANGE"
      },
