      },
      "text": {
        "jp": "くっくっく！\r\nこいつは倒せますかぁ？",
        "official_en": "Heh heh heh! Let’s see how you’ll fare against this one!",
        "real_en": "Heh heh heh!\nCan you defeat this one?"
      },
