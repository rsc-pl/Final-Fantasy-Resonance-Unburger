      }
    },
    {
      "record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_003:74e66a2c",
      "source": {
        "set": "set-02",
        "namespace": "ST_BtlEv_Lazarov_01",
        "key": "BtlEv_Lazarov_01_003",
        "jp_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_003:74e66a2c",
        "official_en_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_003:74e66a2c",
        "jp_sha256": "a9b7b7e1ed5cd715424324bb207fe48c21b4ad5497cffff72ef3c88519319b98",
        "official_en_sha256": "b616ce404fea7ed2cbc438dd4e15fc677fd079d9b202c539cf68dbde38dcb9ce"
      },
      "text": {
        "jp": "ふむ……かなり強化したのですが\r\nあなた達もかなり成長したようですねぇ。",
        "official_en": "Hmm... That was some of my best work yet... I see someone’s been training.",
        "real_en": "Hmm... I strengthened it quite a bit, but it seems you've grown much stronger, too."
      },
      "review": {
