      },
      "text": {
        "jp": "いでよ！　究極の実験体！\r\nナンバー９９９！！",
        "official_en": "Witness my ultimate experiment! Number Nine-Ninety-Nine!",
        "real_en": "Come forth! My ultimate test subject!\nNumber 999!"
      },
