    {
      "record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_014:295351e0",
      "source": {
        "set": "set-02",
        "namespace": "ST_BtlEv_Lazarov_01",
        "key": "BtlEv_Lazarov_01_014",
        "jp_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_014:295351e0",
        "official_en_record_id": "switch:locres:set-02:ST_BtlEv_Lazarov_01:BtlEv_Lazarov_01_014:295351e0",
        "jp_sha256": "49b8b3ecdf12d59679ab1e382ea33a1987b7ef0639c435a595bcb95c0d10122d",
        "official_en_sha256": "a3a6b4be54e1f591d180a1886c6b11a8c3c61e8e7d36769f37006be3acdf2f8d"
      },
      "text": {
        "jp": "これで私は……頭がいい！　だけでなく、力もいい！\r\nこの私自ら、引導を渡して差し上げましょう！",
        "official_en": "Now I have the brawn AND the brains! It shall be ME who performs your last rites!",
        "real_en": "Now I'm not just smart, I'm strong, too!\nI'll be the one to finish you off!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
