        "official_en_sha256": "c6bf5f92d616599b14fd1044b2c1e088dc217bf790cfcea5b9c49ac3d874f20c"
      },
      "text": {
        "jp": "では、誰が暴れている？",
        "official_en": "Then it shall behoove you to give me the name of the one responsible instead.",
        "real_en": "Then who's causing all the trouble?"
      },
      "review": {
        "status": "CHANGE"
      },
