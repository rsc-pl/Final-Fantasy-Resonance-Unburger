    {
      "record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_020:8eb1b894",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon630_Ifrit_03_NF",
        "key": "Summon630_Ifrit_03_NF_020",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_020:8eb1b894",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_020:8eb1b894",
        "jp_sha256": "afebcba918153da85f3553ffe39d27f7dd8f11b3ed19749a8ceafcd58eb0e773",
        "official_en_sha256": "f17a54a83100e14bfd4f1811295dfebed2ee29b68e6fe2aadeebd9e650d48902"
      },
      "text": {
        "jp": "お前のような、ひょろっとした者が\r\nタイタンやシヴァのいる地上を\r\n平定できるわけなかろう。",
        "official_en": "A twiggy individual such as you could never keep the peace on the surface, where the likes of Titan and Shiva roam.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_Summon630_Ifrit_03_NF",
