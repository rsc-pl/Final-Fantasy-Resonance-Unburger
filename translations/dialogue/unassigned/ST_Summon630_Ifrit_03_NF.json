        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_009:6a178722",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_009:6a178722",
