    {
      "record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_019:e5593262",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon630_Ifrit_03_NF",
        "key": "Summon630_Ifrit_03_NF_019",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_019:e5593262",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_019:e5593262",
