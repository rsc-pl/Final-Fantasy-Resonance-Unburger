    {
      "record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_022:16aa8519",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon630_Ifrit_03_NF",
        "key": "Summon630_Ifrit_03_NF_022",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_022:16aa8519",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_022:16aa8519",
        "jp_sha256": "a57ce4e29910fd307962efb1ef1dc4ef3629d6f389a8162df0165b42eb92dbed",
        "official_en_sha256": "cc70d2d2fc150bd10e97080b44f3e1a1ca354db1fe7699eee2a771420a7f021e"
      },
      "text": {
        "jp": "そこになおれっていつの時代の言葉？\r\nいいから黙って力を貸しなさいよ。",
        "official_en": "“Prepare for your immolation?” Oh, spare me your impotent chest-thumping. How about you just keep your mouth closed and lend us a hand like a good boy?",
        "real_en": "'Stand right there'? What era are you from? Just shut up and lend us your power."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_Summon630_Ifrit_03_NF",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "魔人フィーナ",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0072",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_Summon630_Ifrit_03_NF/Summon630_Ifrit_03_NF_022"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_006:09e8b135",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon630_Ifrit_03_NF",
        "key": "Summon630_Ifrit_03_NF_006",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_006:09e8b135",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_006:09e8b135",
        "jp_sha256": "171b4a6059736b88dae52964f3b8fa1c99ea13dd7c18c90ad8b35a5033423638",
        "official_en_sha256": "b9f59d8b9a2ab557ecdb4668138a1003f32c78a77e8eae0f93bbc873a2d13400"
      },
      "text": {
        "jp": "ちょっと待ってくれ。\r\n俺たちは暴れたりしてない。",
        "official_en": "Hold on, we’re not to blame for that.",
        "real_en": "Wait a minute! We haven't been causing any trouble."
      },
      "review": {
        "status": "CHANGE"
      },
