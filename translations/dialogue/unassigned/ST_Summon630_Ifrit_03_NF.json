        "official_en_sha256": "b39cd8bfb15b609d7a5483684f374bb81594f8e0fef6351b692280e555d5af80"
      },
      "text": {
        "jp": "つまらぬ冗談を言う。",
        "official_en": "Surely you do not think I would believe that?",
        "real_en": "What a dull joke."
      },
      "review": {
        "status": "CHANGE"
