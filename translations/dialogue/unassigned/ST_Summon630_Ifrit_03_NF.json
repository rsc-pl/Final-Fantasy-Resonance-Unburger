    {
      "record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_013:f038f686",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon630_Ifrit_03_NF",
        "key": "Summon630_Ifrit_03_NF_013",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_013:f038f686",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_013:f038f686",
        "jp_sha256": "bb68c47f907432dd9af58efee427281271a9abd98e3fec8e273b6b8c49295579",
        "official_en_sha256": "94e0930293f6f52b75b94e64361c638afd1444dae962714f944971b4f89a4b03"
      },
      "text": {
        "jp": "お前たちは人で、我は幻獣だからな。",
        "official_en": "Such has always been the way between human and esper.",
        "real_en": "Because you're humans, and I'm an Eidolon."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_Summon630_Ifrit_03_NF",
