    {
      "record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_017:1b0296f7",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon630_Ifrit_03_NF",
        "key": "Summon630_Ifrit_03_NF_017",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_017:1b0296f7",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_03_NF:Summon630_Ifrit_03_NF_017:1b0296f7",
        "jp_sha256": "887ccd6728489ba3018ba6ed8b8a87fb31132d0db7e76b502b73031b36d351a4",
        "official_en_sha256": "32e0bdf3830f6e18b7f74c6d1c6df0b9a8226b2431a05f39c886e583e41038a4"
      },
      "text": {
        "jp": "なぜそう言える？\r\nお前たちが地上の騒ぎをおさめたとでも？",
        "official_en": "How can you be sure, mortal child? You make it sound like you had a hand in it.",
        "real_en": "How can you say that? Are you claiming you put an end to the trouble on the surface yourselves?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
