    {
      "record_id": "switch:locres:set-02:ST_Summon670_Odin_01:Summon670_Odin_01_009:ef88a53d",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon670_Odin_01",
        "key": "Summon670_Odin_01_009",
        "jp_record_id": "switch:locres:set-02:ST_Summon670_Odin_01:Summon670_Odin_01_009:ef88a53d",
