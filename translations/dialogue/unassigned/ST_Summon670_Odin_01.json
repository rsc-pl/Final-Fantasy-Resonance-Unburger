        "jp_sha256": "cff739869169bb34fa55146a5cc9d09f6e1e939de58c5f2d405b26d648f7ed39",
        "official_en_sha256": "d74e2547159d1f051c39c0df059933bb9b6ff78f28781d4cd1e5e20ce829baf4"
      },
      "text": {
        "jp": "何かを探していた爺さまなんだが\r\n最近見かけないんだよな……",
        "official_en": "It’s been a while since I last saw that old man who was searching for something.",
        "real_en": null
      },
      "review": {
