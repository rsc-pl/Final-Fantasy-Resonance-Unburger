        "official_en_sha256": "0fb7a01095aaab6ebfb96b335f637fcb6022604e0582f61e3f323ee9c5de5275"
      },
      "text": {
        "jp": "なんでも、「コジョウ」に行くとか言ってたな……\r\n古い城のことかね。",
        "official_en": "He mentioned something about an old abandoned castle.",
        "real_en": "He said he was heading to 'Kojou'... Does he mean an old castle?"
      },
