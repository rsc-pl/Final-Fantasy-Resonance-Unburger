    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_003:5aee0e68",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_001_01",
        "key": "ChrEv_0080_001_01_003",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_003:5aee0e68",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_003:5aee0e68",
        "jp_sha256": "ffc289ca5be63ba0649461d6253b38813d2413c1b451cb2cf358c336c2d7f386",
        "official_en_sha256": "6c3e2eb028333f1c307c68fb4e33d472ea2ae4d23b4f89ba41f15d8c5ce735f7"
      },
      "text": {
        "jp": "すまんが、ワシは忙しいのでな。\r\n先生たちに教わるとよい。",
        "official_en": "My apologies little ones, yet there are duties to which I must attend. ’Twould be better if you seek instruction from your teachers instead.",
        "real_en": "Sorry, but I’m busy.\r\nYou should learn from your teachers."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_ChrEv_0080_001_01",
        "sequence": null,
        "speaker": {
