    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_004:b83d8cf8",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_001_01",
        "key": "ChrEv_0080_001_01_004",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_004:b83d8cf8",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_004:b83d8cf8",
        "jp_sha256": "9ef5ee73fa40afb62d9cf65da299918ac1b34b546b75509c48644e43793ec109",
        "official_en_sha256": "7f878e17594a2d91953865d062c45f8c358313788cfd74af7370cf49a546ecbf"
      },
      "text": {
        "jp": "えーっ、サクラおねえちゃん\r\nいっつもそうじゃん！",
        "official_en": "Aw, but you <text style=\"italic\">always</> say that!",
        "real_en": "Aw, Sakura-oneechan! You <text style=\"italic\">always</> say that!"
      },
      "review": {
        "status": "CHANGE"
      },
