    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_023:1a8c8601",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_001_01",
        "key": "ChrEv_0080_001_01_023",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_023:1a8c8601",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_023:1a8c8601",
        "jp_sha256": "9fc87945046fe44e37e063442b674b1f379bdd78131de53ffeed351c55a6b32b",
        "official_en_sha256": "215ca4d5d409c40af8d90a2927805c17a4a15c4c01033081d0508cd87578a547"
      },
      "text": {
        "jp": "すまぬが、これに関して\r\nこれ以上話すことは何もない。",
        "official_en": "I’m afraid I have naught else to say on the matter.",
        "real_en": "Sorry, but I have nothing more to say about that."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
