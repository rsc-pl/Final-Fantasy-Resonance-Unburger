          "name_entry": "CharaName0085",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_ChrEv_0080_001_01/ChrEv_0080_001_01_003"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_011:3821e08b",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_001_01",
        "key": "ChrEv_0080_001_01_011",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_011:3821e08b",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_011:3821e08b",
        "jp_sha256": "d6c74c042bbaece7fb2c06b194499861f8ccfad58a210233291ab3fa72675899",
        "official_en_sha256": "411de2c1b18f93c48bfd3dc83ded6cc109683bb329394bf13dad0c94c20de628"
      },
      "text": {
        "jp": "そうだよな。\r\nサクラはミシディアを建国したんだもんな。",
        "official_en": "I suppose it makes sense you’d treat everyone the same, seeing as you founded this place, after all.",
        "real_en": "Right. You founded Mysidia, after all."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_ChrEv_0080_001_01",
