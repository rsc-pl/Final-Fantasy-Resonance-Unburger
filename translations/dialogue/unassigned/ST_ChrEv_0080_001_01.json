        "official_en_sha256": "4a49e0e7ea0dc30d852a28ccdac030b6c6bd8fa5fc61f1d3217127e5f2fd464b"
      },
      "text": {
        "jp": "じゃあね、サクラおねえちゃん。",
        "official_en": "Oh well... Bye then, Sakura.",
        "real_en": "Bye, Sakura-oneechan!"
      },
      "review": {
        "status": "CHANGE"
      },
