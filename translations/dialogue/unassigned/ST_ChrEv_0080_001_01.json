    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_019:cd60f608",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_001_01",
        "key": "ChrEv_0080_001_01_019",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_019:cd60f608",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_019:cd60f608",
        "jp_sha256": "47575b3d716a0e0378309a90cab01b08d9ebd2e1e425baed20098fb0a7cb84d2",
        "official_en_sha256": "bf1122d751faf9886f442b7f3d53768d8de92538d640fc0ae8e3490555dbc265"
      },
      "text": {
        "jp": "そもそも、ミシディア建国の祖はワシであって、\r\nワシではない。",
        "official_en": "And you are mistaken about my status as the founder of Mysidia...in a way.",
        "real_en": "The thing is, I founded Mysidia... and yet I didn't."
      },
      "review": {
        "status": "CHANGE"
      },
