          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_ChrEv_0080_001_01/ChrEv_0080_001_01_011"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_024:068b9ac4",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_001_01",
        "key": "ChrEv_0080_001_01_024",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_024:068b9ac4",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_024:068b9ac4",
        "jp_sha256": "e135cc5a5a340a7c5937027f9c9ea88ad57115009dc9dc8731b773596cf3b24f",
        "official_en_sha256": "8eb867933395ad371ce7f3a1f50f3bd91e92a0d6b5126f953c059193aefe3f4b"
      },
      "text": {
        "jp": "そうやって誤魔化すんなら\r\n俺にも考えがあるぞ。",
        "official_en": "If that’s how you’re going to be, I think I have an idea.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
