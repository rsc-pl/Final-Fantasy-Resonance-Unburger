    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_020:f3aa0ba6",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_001_01",
        "key": "ChrEv_0080_001_01_020",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_020:f3aa0ba6",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_020:f3aa0ba6",
        "jp_sha256": "a13c22ae47506877eb2febe7328ae38327dd611c60f619f960753f6665071cde",
        "official_en_sha256": "c281e292d8b1fc521e1898e25943c2135fab736ba6df3005efc8768deaec34cf"
      },
      "text": {
        "jp": "どういうことだ？\r\nミシディアを作ったのはサクラだろ？",
        "official_en": "“In a way”? Wasn’t it you who built this place?",
        "real_en": "What do you mean? You're the one who founded Mysidia, aren't you?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
