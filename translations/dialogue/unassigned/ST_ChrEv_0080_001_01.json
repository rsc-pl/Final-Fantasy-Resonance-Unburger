        "official_en_sha256": "397b7ec8cbc617a8282497c020994b67e9581e3196e5c1f2ac778ca25a3af1be"
      },
      "text": {
        "jp": "いや、その認識は正しいようで、\r\n正しくないというか……。",
        "official_en": "’Tis not wrong...yet not precisely correct, either.",
        "real_en": null
      },
      "review": {
