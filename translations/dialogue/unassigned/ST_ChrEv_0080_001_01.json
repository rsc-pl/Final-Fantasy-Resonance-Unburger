    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_008:2c457525",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0080_001_01",
        "key": "ChrEv_0080_001_01_008",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_008:2c457525",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0080_001_01:ChrEv_0080_001_01_008:2c457525",
