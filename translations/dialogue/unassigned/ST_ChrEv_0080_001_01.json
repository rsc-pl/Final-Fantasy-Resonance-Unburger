        "official_en_sha256": "bfe469ca5856c42d92ebf54ffb41f4ed2b228ebb6c05a39522ae764b369a2db5"
      },
      "text": {
        "jp": "たまには教えてよ～！",
        "official_en": "Yeah! Can <text style=\"italic\">you</> teach us? Please?",
        "real_en": "Teach us once in a while!"
      },
      "review": {
