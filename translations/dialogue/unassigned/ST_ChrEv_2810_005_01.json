        "official_en_sha256": "5ea07438f9449aaefc643c6d2cd5313cabeb88bbf798528a298b397eba200417"
      },
      "text": {
        "jp": "この村でじっとしているわけにはいかないの。\r\n私にはかわいい娘との生活があるんだから。",
        "official_en": "I’ve got a sweet little daughter to feed! I can’t just sit on my hands and do nothing.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
