        "key": "ChrEv_2810_003_01_009",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2810_003_01:ChrEv_2810_003_01_009:73319061",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2810_003_01:ChrEv_2810_003_01_009:73319061",
