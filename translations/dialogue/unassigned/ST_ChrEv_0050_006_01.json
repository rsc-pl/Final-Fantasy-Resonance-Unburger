    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_012:3f881e60",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0050_006_01",
        "key": "ChrEv_0050_006_01_012",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_012:3f881e60",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_012:3f881e60",
        "jp_sha256": "e1c344be69c2f4dc08c9762a89e9cb3e11937b41d01eb1e2256dcfb2dccece7c",
        "official_en_sha256": "cf70ac9d55e295a3fb82c184c92186e2c29759c7efb9a60dc12ca2fdc8ec0d77"
      },
      "text": {
        "jp": "しかし、私が暴走したせいで\r\nオルデリオンの民は被害を受けました。",
        "official_en": "But when I raged uncontrollably, it caused the people of Olderion much suffering.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
