        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_013:d0da61bf",
        "jp_sha256": "26b2c5de1fe7b645fd9ec82b3f6d9aadcbed62f85a9284e3369d6f69aec284dd",
        "official_en_sha256": "6be3bd5972fa987005730184f84c433afc41cdbe6c6878f6b06e482f89de0102"
      },
      "text": {
        "jp": "あなたたち、水の守り人の一族にも\r\n申し訳ないことをしました。",
        "official_en": "And the harm I inflicted upon your clan was unforgivable.",
        "real_en": "I've also wronged your clan, the Wardens of Water. I'm sorry."
      },
      "review": {
        "status": "CHANGE"
      },
