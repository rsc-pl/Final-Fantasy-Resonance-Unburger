    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_022:deb69ca5",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0050_006_01",
        "key": "ChrEv_0050_006_01_022",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_022:deb69ca5",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_022:deb69ca5",
        "jp_sha256": "308eb250eda90e09943c67e8154255aad7288c9b2dd3149cc52bc1ab2e5ccaf3",
        "official_en_sha256": "15657ae435c9094b4ac319bcbee23dced99106db056bbebb55ed665c13b5e349"
      },
      "text": {
        "jp": "その少女に私の力を預けます。\r\n力が必要となったとき、召喚するといいでしょう。",
        "official_en": "I shall grant her my powers. Summon me when you are in need of them.",
        "real_en": null
      },
      "review": {
