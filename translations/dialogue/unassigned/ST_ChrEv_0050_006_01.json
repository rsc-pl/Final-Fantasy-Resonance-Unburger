        "official_en_sha256": "3d034ea0dbc101258f8ed6d6d67a7e504924b50f855298afe629565effbec944"
      },
      "text": {
        "jp": "ですが、それでは私の気持ちが収まりません。",
        "official_en": "Yet I feel that it is not quite enough.",
        "real_en": "But that still doesn't put my mind at ease."
      },
      "review": {
        "status": "CHANGE"
      },
