      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0050_006_01",
        "key": "ChrEv_0050_006_01_033",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_033:7b97598f",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_033:7b97598f",
        "jp_sha256": "52fe26209394288bdd7b3a2330d657f6a6f2ef4626cae37754dea62d28ae1308",
        "official_en_sha256": "4824097ac87b2b491dc2ce122886f5b739189fb601210f64cf18a11c4d40a754"
      },
      "text": {
        "jp": "さあ、旅に戻りましょう。",
        "official_en": "Well, it is time to resume our journey.",
        "real_en": null
      },
      "review": {
