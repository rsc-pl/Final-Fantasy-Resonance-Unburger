    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_008:3bac9200",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0050_006_01",
        "key": "ChrEv_0050_006_01_008",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_008:3bac9200",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_008:3bac9200",
        "jp_sha256": "f884befe02ca25f2f1dfc5e774f696d020119d61b4b40fd25035cf2dfa3ea2bb",
        "official_en_sha256": "92bad0e96eb2573c203da234cdc8120ef9ebadb4a40727b86e0edb298e246fa6"
      },
      "text": {
        "jp": "ええ、いいサハギンとして\r\n褒美を取らせましょう。",
        "official_en": "Yes, and for that, I must reward you.",
        "real_en": "Yes. I'll reward you for being such a good sahagin."
      },
      "review": {
        "status": "CHANGE"
      },
