      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_019:68779f6c",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0050_006_01",
        "key": "ChrEv_0050_006_01_019",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_019:68779f6c",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_019:68779f6c",
