    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_031:7090a9f2",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0050_006_01",
        "key": "ChrEv_0050_006_01_031",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_031:7090a9f2",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0050_006_01:ChrEv_0050_006_01_031:7090a9f2",
        "jp_sha256": "41858a5fa807aea2d2fb7af745cc0b9803dcfcd258bb6cb860cacbb0bf8b22d3",
        "official_en_sha256": "4de64ee737fb296c4cb475d6831163e64147a67bc7dc931730d0fc7ec9759d19"
      },
      "text": {
        "jp": "それもまた水の守り人の役目です。",
        "official_en": "This is my solemn duty as a Warden of the Waters.",
        "real_en": "That's another duty of the Wardens of Water."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
