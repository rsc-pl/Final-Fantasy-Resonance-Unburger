    {
      "record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_009:84822106",
      "source": {
        "set": "set-02",
        "namespace": "ST_Sakura_Review",
        "key": "Sakura_Review_009",
        "jp_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_009:84822106",
        "official_en_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_009:84822106",
        "jp_sha256": "058fce6f0cf5f463d8a3a4e474d0af95f8d3781870f318eeaf9e93a507a54f8c",
        "official_en_sha256": "2bed80d8bb61db3214746d3e8299b96b8e7c0bad381ece133fa505f699cf5bab"
      },
      "text": {
        "jp": "そして、飛ばされた先が、この星じゃった。\r\nつまり、ラピスという星の上に\r\nパラデイアの大地が落着したんじゃな。",
        "official_en": "It occurred that this planetary fragment appeared above Lapis. With great force it crashed down, transforming the land as it struck the surface.",
        "real_en": "And it ended up here, on this planet. In other words, part of Paladia's land landed on the planet Lapis."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
