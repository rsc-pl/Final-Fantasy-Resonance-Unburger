          "applicability": "REQUIRED",
          "label_jp": "サクラ",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0085",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_Sakura_Review/Sakura_Review_008"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
