    {
      "record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_028:8f109d26",
      "source": {
        "set": "set-02",
        "namespace": "ST_Sakura_Review",
        "key": "Sakura_Review_028",
        "jp_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_028:8f109d26",
        "official_en_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_028:8f109d26",
        "jp_sha256": "2a125b8cbae1980cdbb6e4d4d5718c1653b037d81e95c0eb68b8d542b233d3ff",
        "official_en_sha256": "531af2b4b7827d4e2a00aa2b30c6662a76aa717adb00998ec93a5e1a8f5708ba"
      },
      "text": {
        "jp": "この世界の人たちが好きになった……。\r\nそれが一番大きい理由かのう。",
        "official_en": "The greatest reason of all was that I became fond of the denizens of this world.",
        "real_en": "I grew fond of the people of this world... That may have been the biggest reason."
      },
      "review": {
        "status": "CHANGE"
      },
