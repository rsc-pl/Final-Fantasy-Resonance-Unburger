    {
      "record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_053:f52c3fde",
      "source": {
        "set": "set-02",
        "namespace": "ST_Sakura_Review",
        "key": "Sakura_Review_053",
        "jp_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_053:f52c3fde",
        "official_en_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_053:f52c3fde",
        "jp_sha256": "7b7fd7afa28e134f766fecf83d33321b844ab75cc6e53fd01b6195f190ba1397",
        "official_en_sha256": "a8d24ab90b9f2f9c26d2f5ad95b06367844e3414b04792c374e475a729db76ab"
      },
      "text": {
        "jp": "その恨みは７００年もの間、消えることがない。\r\n六盟傑はパラデイアに戻って\r\n上層部に復讐するつもりなのじゃ。",
        "official_en": "Even after seven hundred years, their grudge remains unforgotten. They now seek to return to Paladia, determined to ensure that the Aldorian rulers receive their just deserts.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
