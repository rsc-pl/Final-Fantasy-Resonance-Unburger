    {
      "record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_008:e0c22075",
      "source": {
        "set": "set-02",
        "namespace": "ST_Sakura_Review",
        "key": "Sakura_Review_008",
        "jp_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_008:e0c22075",
        "official_en_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_008:e0c22075",
        "jp_sha256": "6e02db51ef5d1a784ca73b6a4b1b718ab90334ddc3c3d74efc432bc24dc59412",
        "official_en_sha256": "4997e6f2d40148595d7f016e66a1716f27bada30bb9b3bc2cba0a620fb1ad5e7"
      },
      "text": {
        "jp": "すごい揺れがあって、地面が浮いたじゃろ。\r\nあの時、パラデイアの大地が\r\n時空を越えて飛ばされたんじゃ。",
        "official_en": "As you witnessed for yourself, a piece of land began a-floating after an extraordinary tremor. ’Twas a part of Paladia being slung through dimensions.",
        "real_en": "There was a tremendous tremor, and the ground rose into the air, remember? That was when part of Paladia's land was sent across space and time."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_Sakura_Review",
        "sequence": null,
