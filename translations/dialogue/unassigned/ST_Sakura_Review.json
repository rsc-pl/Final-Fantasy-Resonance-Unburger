      "source": {
        "set": "set-02",
        "namespace": "ST_Sakura_Review",
        "key": "Sakura_Review_060",
        "jp_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_060:ab3121fa",
        "official_en_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_060:ab3121fa",
