        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_026:ac84e39a",
      "source": {
        "set": "set-02",
        "namespace": "ST_Sakura_Review",
        "key": "Sakura_Review_026",
        "jp_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_026:ac84e39a",
        "official_en_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_026:ac84e39a",
        "jp_sha256": "105bb2cb72cbba8b9568ef9b097f6df703fc17ab4981b36b5ded774d0537595b",
        "official_en_sha256": "94b539a9f1d0b693cebdab8c81fda411c42e949abe2ffac37e5e2109c30712d8"
      },
      "text": {
        "jp": "じゃが、迅雷のワシと氷刃が抜けて六人になり\r\nそれからは六盟傑を名乗るようになったようじゃ。",
        "official_en": "Yet Gelidus and I left their ranks. Elementary math dictated that they aptly rename themselves the Sworn Six.",
        "real_en": "But Frost Blade Veritas and I, Thunderclap Veritas, left, leaving six. It seems they then began calling themselves the Sworn Six."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
