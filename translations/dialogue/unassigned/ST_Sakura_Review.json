    {
      "record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_007:f789ad3b",
      "source": {
        "set": "set-02",
        "namespace": "ST_Sakura_Review",
        "key": "Sakura_Review_007",
        "jp_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_007:f789ad3b",
        "official_en_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_007:f789ad3b",
        "jp_sha256": "6f76e9df76bbe49b7b29c3229c9a1d759b432b930861d125945e3ad0ebdd1f89",
        "official_en_sha256": "531e7266eb0f6eaed54f8d75e3c7ec9b85c804afcbf3930850b9e17799271f1c"
      },
      "text": {
        "jp": "さて、ラピスとパラデイアの関係じゃが、\r\nフィーナの精神世界で\r\n見たことを思い出してみるといい。",
        "official_en": "As for the relationship between Lapis and Paladia, you shall recall what you saw in Fina’s psyche.",
        "real_en": "As for how Lapis and Paladia are connected, think back to what you saw in Fina's mind."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_Sakura_Review",
        "sequence": null,
