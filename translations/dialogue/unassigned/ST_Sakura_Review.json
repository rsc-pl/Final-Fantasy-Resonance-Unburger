        "jp_sha256": "9ed5458b0bb0f4d8276bcf2e0face0fba5fa82473ea7363725d94302e015bc86",
        "official_en_sha256": "5151e093908fd99d55211738f17b243ba39adde6413adc3802b960de60a031c9"
      },
      "text": {
        "jp": "ふむ。\r\nワシに何か聞きたいことがあるのか？",
        "official_en": "What is it? Do you have something to ask of me?",
        "real_en": null
      },
