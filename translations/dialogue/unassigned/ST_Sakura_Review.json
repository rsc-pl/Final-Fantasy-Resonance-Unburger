        "official_en_sha256": "2c5f9ff811a3cc75c7ccc64406d9372d0534c0604a4737504268838e9d54299c"
      },
      "text": {
        "jp": "そうか。\r\nまた気になることがあったら\r\nワシに聞くといい。",
        "official_en": "Very well. Return to me when you wish to be further enlightened on the matter.",
        "real_en": "I see. If something else is bothering you, feel free to ask me."
      },
      "review": {
        "status": "CHANGE"
      },
