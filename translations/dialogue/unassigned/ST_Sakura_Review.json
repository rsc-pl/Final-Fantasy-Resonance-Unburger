    {
      "record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_044:c1a3c5db",
      "source": {
        "set": "set-02",
        "namespace": "ST_Sakura_Review",
        "key": "Sakura_Review_044",
        "jp_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_044:c1a3c5db",
        "official_en_record_id": "switch:locres:set-02:ST_Sakura_Review:Sakura_Review_044:c1a3c5db",
        "jp_sha256": "bf277b1d8e007594b26eda964b51db73dccf874d708de8f66a1f590377c623fa",
        "official_en_sha256": "28c59b013d9fb9e514ba960f4a9c7b671dba0eda28fd5826b55fb0ca52aedeb8"
      },
      "text": {
        "jp": "そこで巨大なクリスタルを楔とし、\r\nラピスの大地に固定することにしたのじゃ。",
        "official_en": "Hence, they utilized immense Crystals as seals—or anchors—to bind a piece of Paladia within the land of Lapis.",
        "real_en": "So they used an enormous crystal as a wedge to anchor it to the land of Lapis."
      },
      "review": {
        "status": "CHANGE"
      },
