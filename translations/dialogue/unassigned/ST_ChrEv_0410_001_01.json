        "key": "ChrEv_0410_001_01_011",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0410_001_01:ChrEv_0410_001_01_011:77ecc6c8",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0410_001_01:ChrEv_0410_001_01_011:77ecc6c8",
