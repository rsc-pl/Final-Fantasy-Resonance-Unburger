        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": "何かを訴える男",
          "label_status": "VERIFIED",
          "name_entry": "CharaName0196",
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
