        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0410_001_01:ChrEv_0410_001_01_013:b19d25e8",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0410_001_01:ChrEv_0410_001_01_013:b19d25e8",
