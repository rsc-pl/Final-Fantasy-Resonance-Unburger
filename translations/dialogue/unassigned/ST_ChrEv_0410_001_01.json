    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0410_001_01:ChrEv_0410_001_01_007:3e03735d",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0410_001_01",
        "key": "ChrEv_0410_001_01_007",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0410_001_01:ChrEv_0410_001_01_007:3e03735d",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0410_001_01:ChrEv_0410_001_01_007:3e03735d",
        "jp_sha256": "b2bf1112b94387777b82e32c5705ed419e817197d001757c039fb6bbd5a13bf4",
        "official_en_sha256": "9ddbdfecb84bbcb4e9baa8d9f4dd4a19b626d1af19b3dc2eb73380d103673aca"
      },
      "text": {
        "jp": "その駅に今も列車が走っていたんだ。\r\n俺だけじゃないぞ！\r\n何人も見かけて、ウワサになっているんだ！",
        "official_en": "But a train still runs by there. I’m not the only one who saw it, either. Lots of folks did! The rumors are all over town!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_ChrEv_0410_001_01",
