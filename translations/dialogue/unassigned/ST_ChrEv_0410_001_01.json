        "official_en_sha256": "2bdbc12a7b751e0e3a0624ed4be200378bb7ec894ee68ebad0b984e09f181326"
      },
      "text": {
        "jp": "そういうことか。\r\nだったら、俺が調査を請け負うよ。",
        "official_en": "Okay then. In that case, I’ll go check it out.",
        "real_en": null
      },
