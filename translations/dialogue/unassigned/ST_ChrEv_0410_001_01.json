    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0410_001_01:ChrEv_0410_001_01_002:72aa1d30",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0410_001_01",
        "key": "ChrEv_0410_001_01_002",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0410_001_01:ChrEv_0410_001_01_002:72aa1d30",
