        "official_en_sha256": "0f27e0a80f7e3fddbe518eb5c0c3666786ff10df7c559a1b1a3e30d8e8e5d4a8"
      },
      "text": {
        "jp": "もう一人のフィーナは\r\nパラデイアで闘技大会に出ていたんだろ？",
        "official_en": "You fought in a tournament in Paladia, didn’t you?",
        "real_en": "As the other Fina, you used to compete in tournaments in Paladia, right?"
