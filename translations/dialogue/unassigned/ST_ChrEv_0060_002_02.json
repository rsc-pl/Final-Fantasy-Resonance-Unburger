        "official_en_sha256": "c7a8a4a40459a1dd26fe58ff22c582b98adc3ea3172d6a6be8a66db4de99d2e9"
      },
      "text": {
        "jp": "戦いの中では、私は誰のものでもない。\r\n思うままに、自分らしくあれた。",
        "official_en": "In the midst of battle, I answered to no one. I could be my true self, and act just as I desired.",
        "real_en": null
