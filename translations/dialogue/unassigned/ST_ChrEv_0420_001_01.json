    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_001_01:ChrEv_0420_001_01_008:6c4f4d63",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_001_01",
        "key": "ChrEv_0420_001_01_008",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_001_01:ChrEv_0420_001_01_008:6c4f4d63",
