    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_001_01:ChrEv_0420_001_01_020:15b53f2c",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_001_01",
        "key": "ChrEv_0420_001_01_020",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_001_01:ChrEv_0420_001_01_020:15b53f2c",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_001_01:ChrEv_0420_001_01_020:15b53f2c",
        "jp_sha256": "3748e3865edcf99123d444cef6dab1b23cf2bfa9c9f0dca320c473e8aae6847e",
        "official_en_sha256": "bec2d25b6f03bf1e6d3fac01be809c10f4ee11d99b0757a11b1f7e032d600970"
      },
      "text": {
        "jp": "その強い魔力を制御するためには\r\n心と体のバランスがとれてなければならんからのう。",
        "official_en": "To harness such vast magic, equilibrium must exist between body and soul.",
        "real_en": "To control that much magic, your mind and body have to be in balance."
      },
      "review": {
        "status": "CHANGE"
      },
