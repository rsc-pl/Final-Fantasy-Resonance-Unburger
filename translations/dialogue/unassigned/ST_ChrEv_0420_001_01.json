    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0420_001_01:ChrEv_0420_001_01_007:8471c9b9",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0420_001_01",
        "key": "ChrEv_0420_001_01_007",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0420_001_01:ChrEv_0420_001_01_007:8471c9b9",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0420_001_01:ChrEv_0420_001_01_007:8471c9b9",
        "jp_sha256": "dbcdec9ff4d18c9742338eeceb6415056a43a3d7e21944b7e70bae715f4e169c",
        "official_en_sha256": "139fd8be1468a23ab95538ab6663444b67a5ebca4e53b212a6821381db288fb7"
      },
      "text": {
        "jp": "そうです、そうです。\r\nレインさんの言う通りです。\r\n理由があるなら教えてください。",
        "official_en": "Yeah, see, Mistress? What Rain said. Can’t you at least tell me why?",
        "real_en": "That's right, that's right.\r\nJust as Rain-san said.\r\nIf there's a reason, please tell us."
      },
      "review": {
        "status": "CHANGE"
      },
