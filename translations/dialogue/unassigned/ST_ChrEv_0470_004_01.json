        "official_en_sha256": "87a8fd7791c979901102d6d3c6621d6f67af001c71e3ee887471ed7aaca2cba2"
      },
      "text": {
        "jp": "あの頃は、生きるのが精一杯で……。\r\n世界に希望なんてなかった。",
        "official_en": "It took all I had just to survive. I saw no hope in this world.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
