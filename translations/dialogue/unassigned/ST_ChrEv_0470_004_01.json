    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0470_004_01:ChrEv_0470_004_01_015:f7fd12e2",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0470_004_01",
        "key": "ChrEv_0470_004_01_015",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0470_004_01:ChrEv_0470_004_01_015:f7fd12e2",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0470_004_01:ChrEv_0470_004_01_015:f7fd12e2",
