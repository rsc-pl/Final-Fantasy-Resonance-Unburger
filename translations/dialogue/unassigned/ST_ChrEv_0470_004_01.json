        "official_en_sha256": "e0eeaf82ca691b520c4745e692a72f65a73ac89db9a3b384db87fe9fabe5e28a"
      },
      "text": {
        "jp": "ああ。\r\n母上の指導を受けた孤児たちだ。",
        "official_en": "Yes. They were all orphans that Mother trained.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
