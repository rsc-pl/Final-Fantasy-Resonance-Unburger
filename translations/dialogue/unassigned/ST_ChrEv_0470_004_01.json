        "official_en_sha256": "daf0be6f0976f0334679ec3660c6beaf00cd2860974899507a395f38647307a0"
      },
      "text": {
        "jp": "お前は甘い。\r\n気持ちが弱すぎると。",
        "official_en": "They said I was too soft—that I was much too weak inside.",
        "real_en": null
      },
