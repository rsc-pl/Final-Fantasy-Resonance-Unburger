    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0470_004_01:ChrEv_0470_004_01_023:b62953a4",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0470_004_01",
        "key": "ChrEv_0470_004_01_023",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0470_004_01:ChrEv_0470_004_01_023:b62953a4",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0470_004_01:ChrEv_0470_004_01_023:b62953a4",
