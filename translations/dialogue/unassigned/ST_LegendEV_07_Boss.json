    {
      "record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_007:18623dab",
      "source": {
        "set": "set-02",
        "namespace": "ST_LegendEV_07_Boss",
        "key": "LegendEV_07_Boss_007",
        "jp_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_007:18623dab",
        "official_en_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_007:18623dab",
        "jp_sha256": "b4faa7dc78752fe67774b75ffc79a74f3a0b6dbe5be26a6ea293378cbf172a72",
        "official_en_sha256": "44b8b21d872e85b0156b6a61a3cf0533f84811f2fa2a2f4fdd30ac598a55793e"
      },
      "text": {
        "jp": "あなたの覚悟をたたえましょう。\r\n命をかけて立ち向かい、決意を示すのです。",
        "official_en": "That you would risk your life is a testament to your determination. Now to put that determination to the test.",
        "real_en": "I commend your resolve. Risk your life to face him, and prove your determination."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
