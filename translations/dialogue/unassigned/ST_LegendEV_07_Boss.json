    {
      "record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_006:4b758234",
      "source": {
        "set": "set-02",
        "namespace": "ST_LegendEV_07_Boss",
        "key": "LegendEV_07_Boss_006",
        "jp_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_006:4b758234",
        "official_en_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_006:4b758234",
        "jp_sha256": "7920eb1ee7df74a182ec510fade8960a75330d5ebb41334335a6adb2d6945de8",
        "official_en_sha256": "8a0230bbf06cf1da0f998ca689fcc6df036009d842202042889006accee55dae"
      },
      "text": {
        "jp": "力を求めし者よ……それでも彼に挑みますか？",
        "official_en": "What say you? Will you undertake this challenge?",
        "real_en": "You who seek power... will you challenge him even so?"
      },
      "review": {
        "status": "CHANGE"
      },
