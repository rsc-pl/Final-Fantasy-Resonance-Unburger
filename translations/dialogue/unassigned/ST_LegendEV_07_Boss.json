    {
      "record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_009:91d2e42d",
      "source": {
        "set": "set-02",
        "namespace": "ST_LegendEV_07_Boss",
        "key": "LegendEV_07_Boss_009",
        "jp_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_009:91d2e42d",
        "official_en_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_009:91d2e42d",
        "jp_sha256": "f675e6529fcf9b7205efd0cfe95824e6fa90ce627518c96372d7dcf6a44a5783",
        "official_en_sha256": "431d44bcadb75dd10e898400380d6a1dce350a4b98e133cbb2af0799f3d6fbba"
      },
      "text": {
        "jp": "それは、命と想いが星をめぐる異界の記憶――",
        "official_en": "In a world where memories flow as would a river, he took form...",
        "real_en": "These are memories of another world where life and feelings flow through the planet—"
      },
      "review": {
        "status": "CHANGE"
      },
