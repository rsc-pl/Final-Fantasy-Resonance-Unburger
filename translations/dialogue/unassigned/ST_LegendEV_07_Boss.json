    {
      "record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_003:6bff36c0",
      "source": {
        "set": "set-02",
        "namespace": "ST_LegendEV_07_Boss",
        "key": "LegendEV_07_Boss_003",
        "jp_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_003:6bff36c0",
        "official_en_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_003:6bff36c0",
        "jp_sha256": "725a24bcbdfcee52039b043fe62c08334caa0af61ce099063dbd9ff7358488b7",
        "official_en_sha256": "0dccff2091c8d4f52b0fbe389025392c7c085f81a14cb41db1e907b98f454054"
      },
      "text": {
        "jp": "いまではなく、ここでもない異界で\r\n人々の記憶に残る、幻想の英雄たち……。",
        "official_en": "A reliquary for the memories of heroes fantastical in nature—\r\nscattered across myriad realms and epochs.",
        "real_en": "Heroes of legend, remembered by people in other worlds, in times and places far removed from our own..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
