      }
    },
    {
      "record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_020:be141027",
      "source": {
        "set": "set-02",
        "namespace": "ST_LegendEV_07_Boss",
        "key": "LegendEV_07_Boss_020",
        "jp_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_020:be141027",
        "official_en_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_020:be141027",
        "jp_sha256": "64ce0ead926dda82c9323bd9f0d3b247d2335fccf504422e5eed293c1c7f765e",
        "official_en_sha256": "64ce0ead926dda82c9323bd9f0d3b247d2335fccf504422e5eed293c1c7f765e"
      },
      "text": {
        "jp": "人ならざる域にまで剣を極めた、孤絶なる英雄。",
        "official_en": "人ならざる域にまで剣を極めた、孤絶なる英雄。",
