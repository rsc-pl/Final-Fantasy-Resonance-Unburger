      }
    },
    {
      "record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_012:f2201743",
      "source": {
        "set": "set-02",
        "namespace": "ST_LegendEV_07_Boss",
        "key": "LegendEV_07_Boss_012",
        "jp_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_012:f2201743",
        "official_en_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_012:f2201743",
        "jp_sha256": "e1e68b6b4c0d3694a8814f6dd925d14eb9717298334e16817120420a1a6c4240",
        "official_en_sha256": "4a73366a4a0cb19f49be3841524821ef4a9620d16955b770374dd51d5e7db091"
      },
      "text": {
        "jp": "ありがとう……。\r\nあなたの想いは、たしかに伝わりました。",
        "official_en": "Though he knew not the strength of your conviction before, he most certainly does now.",
        "real_en": "Thank you... Your feelings have reached me."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
