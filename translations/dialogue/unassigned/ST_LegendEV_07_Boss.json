    {
      "record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_015:6897017d",
      "source": {
        "set": "set-02",
        "namespace": "ST_LegendEV_07_Boss",
        "key": "LegendEV_07_Boss_015",
        "jp_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_015:6897017d",
        "official_en_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_015:6897017d",
        "jp_sha256": "a64727a793342c71c46c3fbb4414bab52aa2cb7b566ce014c9e0a8e285f32e37",
        "official_en_sha256": "d16583503ecc5862b10785f9236d865040ab0dc0a6036395805e808d071c676f"
      },
      "text": {
        "jp": "あなたなら、セフィロスの力を\r\n正しく導けるはず。\r\n信じていますよ……。",
        "official_en": "I have the utmost faith you will wield his power with all the wisdom it is due.",
        "real_en": "I believe you can guide Sephiroth’s power in the right direction..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
