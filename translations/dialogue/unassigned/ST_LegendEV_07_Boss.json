    {
      "record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_001:fb6fda1f",
      "source": {
        "set": "set-02",
        "namespace": "ST_LegendEV_07_Boss",
        "key": "LegendEV_07_Boss_001",
        "jp_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_001:fb6fda1f",
        "official_en_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_001:fb6fda1f",
        "jp_sha256": "888067e3c675d43f4d1e82b9c8a6272cafd2d0e7e91ecb8ec5f95457a45eb5d2",
        "official_en_sha256": "7eee796c229fbebd6b06a74c7207d65e7d872228d395c830f18f3ddb61ee24fd"
      },
      "text": {
        "jp": "……力を求めし者よ。\r\nよくぞ来ました。",
        "official_en": "Ah, yes, it was but a matter of time before you would find your way here.",
        "real_en": "...You who seek power. Welcome."
      },
      "review": {
        "status": "CHANGE"
      },
