        "jp_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_011:6527d9fc",
        "official_en_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_011:6527d9fc",
