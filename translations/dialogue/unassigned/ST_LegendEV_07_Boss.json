    {
      "record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_002:b8ace0d8",
      "source": {
        "set": "set-02",
        "namespace": "ST_LegendEV_07_Boss",
        "key": "LegendEV_07_Boss_002",
        "jp_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_002:b8ace0d8",
        "official_en_record_id": "switch:locres:set-02:ST_LegendEV_07_Boss:LegendEV_07_Boss_002:b8ace0d8",
        "jp_sha256": "016bd5944b80385e692646d451ec89158977c3ce8c6de9f48ee410228d59ddb2",
        "official_en_sha256": "3fed9d97b6b02a3d258bfd24a72fec7bace04cc33a81290523bb81d908940039"
      },
      "text": {
        "jp": "ここはビジョンクリスタルの祠……\r\n異界につながる聖域です。",
        "official_en": "Welcome to the Vision Crystal Sanctum—a nexus between planes of existence...",
        "real_en": null
