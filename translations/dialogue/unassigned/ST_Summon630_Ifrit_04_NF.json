        "namespace": "ST_Summon630_Ifrit_04_NF",
        "key": "Summon630_Ifrit_04_NF_012",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_012:af4d505e",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_012:af4d505e",
        "jp_sha256": "f606f239cac54b5d2b9c0cd86e8aea7008e7fde8283f6f93f639229a9a954e26",
        "official_en_sha256": "cd19ea2c338cfe1b8e6cb928165759f84154272db71c58efe5c857c15c21eace"
      },
      "text": {
        "jp": "そもそもなんだ貴様は。\r\nぞろぞろと手下をつれてやってきて。\r\n誇りというものがないのか？",
        "official_en": "Bringing a pack of underlings? Where is your pride as a warrior? Have you no shame?",
        "real_en": "And who do you think you are, bringing a whole pack of underlings along? Don't you have any pride?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
