    {
      "record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_015:eeb9f877",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon630_Ifrit_04_NF",
        "key": "Summon630_Ifrit_04_NF_015",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_015:eeb9f877",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_015:eeb9f877",
        "jp_sha256": "c13a631a5f8e231d5c3b72a1bb97267314da6e50d85d451f25b5097410f953d3",
        "official_en_sha256": "c1aacc1b3301a8af447213f6f62d2544c2844f65d54f047e178ab92706018cb4"
      },
      "text": {
        "jp": "礼を言うわ、イフリート。\r\n私たちに力を貸すため、手加減してくれた。\r\nそういうことよね。",
        "official_en": "I must commend you, Ifrit. You held back deliberately so that you might have an excuse to aid us, didn’t you?",
        "real_en": "Thank you, Ifrit. You held back because you wanted to lend us your power. Isn't that right?"
      },
      "review": {
        "status": "CHANGE"
