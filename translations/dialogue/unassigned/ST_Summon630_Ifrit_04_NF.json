    {
      "record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_024:3f28ac97",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon630_Ifrit_04_NF",
        "key": "Summon630_Ifrit_04_NF_024",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_024:3f28ac97",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_024:3f28ac97",
