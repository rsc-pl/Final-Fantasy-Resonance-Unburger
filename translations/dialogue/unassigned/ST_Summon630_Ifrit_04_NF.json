        "key": "Summon630_Ifrit_04_NF_023",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_023:d4ea5f9e",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_023:d4ea5f9e",
        "jp_sha256": "55259afe184217ba419880a65ec716548f31e856d500d6cee96f493230f71afd",
        "official_en_sha256": "aaa43a6f8f86a7ee722612badf2d1e352e6e4ad976d388d0a5666231d92a047b"
      },
      "text": {
        "jp": "我はまた寝ることにする。\r\nさっさとここから出ていけ。",
        "official_en": "Now leave me in peace. I wish to sleep once more.",
        "real_en": "I'm going back to sleep. Get out of here already."
