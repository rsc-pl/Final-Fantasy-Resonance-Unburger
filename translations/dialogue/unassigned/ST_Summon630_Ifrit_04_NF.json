    {
      "record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_018:937fb053",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon630_Ifrit_04_NF",
        "key": "Summon630_Ifrit_04_NF_018",
        "jp_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_018:937fb053",
        "official_en_record_id": "switch:locres:set-02:ST_Summon630_Ifrit_04_NF:Summon630_Ifrit_04_NF_018:937fb053",
        "jp_sha256": "5befdd8396358cd5b10befd3180bc8be927dae96cf8346167333fd5c5093dd64",
        "official_en_sha256": "a073f908a51716278c88f72bcefa320deb661d630bd3fd514a97d00f09f957e4"
      },
      "text": {
        "jp": "横柄な女よ。\r\nお前には真実を見抜く目があるようだな。\r\nそこの男とは違って。",
        "official_en": "I am impressed, callous one. Your perceptiveness and wisdom put your acquaintance to shame.",
        "real_en": "Arrogant woman, you seem to have an eye for the truth. Unlike that man over there."
      },
      "review": {
        "status": "CHANGE"
      },
