        "official_en_sha256": "ae3e8142777f5262233de35e8d56d77474639e7728cb95da1fabafb439246271"
      },
      "text": {
        "jp": "イフリート、俺たちの勝ちだな。",
        "official_en": "It’s over, Ifrit.",
        "real_en": "Ifrit, we won."
