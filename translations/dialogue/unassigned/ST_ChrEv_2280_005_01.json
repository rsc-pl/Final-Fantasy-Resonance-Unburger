    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_006:6e3fe7df",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2280_005_01",
        "key": "ChrEv_2280_005_01_006",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_006:6e3fe7df",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_006:6e3fe7df",
        "jp_sha256": "1b49bf67cad67dc751c393e2e8a3ba394e0a832f3c8c1d51ac2708cc6f029c41",
        "official_en_sha256": "533bd23fc1732f945fa612c59e6ebaf9b096029fd21180d18c0a163101706503"
      },
      "text": {
        "jp": "あやつがとんでもないトラブルを起こして\r\nワシが解決のために奔走する……。\r\nそのやりとりを楽しんでいたところもある。",
        "official_en": "’Twas exhausting, dealing with the tomfoolery she caused... And yet...a small part of me found a certain amusement in it.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
