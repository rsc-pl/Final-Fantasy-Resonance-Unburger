    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_022:80b2f7ff",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2280_005_01",
        "key": "ChrEv_2280_005_01_022",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_022:80b2f7ff",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_022:80b2f7ff",
        "jp_sha256": "79062eec841082f029a3d646e694a8053fd2bdf334efce81c8f825a81494b9b3",
        "official_en_sha256": "588fd7c233e8255212d5123149eb8dfe3a7fc2b64705daac2e173a9076bac1d7"
      },
      "text": {
        "jp": "すごい人気だな……。",
        "official_en": "I didn’t realize she was this popular...",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
