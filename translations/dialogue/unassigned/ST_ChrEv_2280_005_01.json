    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_026:badaa309",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2280_005_01",
        "key": "ChrEv_2280_005_01_026",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_026:badaa309",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_026:badaa309",
        "jp_sha256": "416644a4695b0e4322d12a0bded9fd53575ca01b5645cb78d7e850cea79c53a7",
        "official_en_sha256": "964e49513178890c4c4bf285905a9d3b7d54e9585a463183512774f63c78c11d"
      },
      "text": {
        "jp": "すまん、ビクトリア……\r\nお主の噂をぬぐいさるには\r\n長い時間がかかりそうじゃ……",
        "official_en": "Forgive me Victoria... ’Twill take some time to dispel your rumor...",
        "real_en": "Sorry, Victoria... It looks like it’ll take a long time to clear up those rumors about you..."
      },
      "review": {
        "status": "CHANGE"
      },
