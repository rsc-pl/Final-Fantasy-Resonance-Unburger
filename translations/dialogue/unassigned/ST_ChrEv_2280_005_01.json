        "official_en_sha256": "33b66dc1bace01d84c21ddf18e80af1e3e58a09bee6916551b9c0dd3b161ec31"
      },
      "text": {
        "jp": "さあ、街を見て回り\r\nパウダーの効果を確認するとするか。",
        "official_en": "For now, let us survey the streets and check to see if the powder has worked.",
        "real_en": null
      },
