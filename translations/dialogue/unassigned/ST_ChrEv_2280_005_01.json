    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_017:ceff39c4",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2280_005_01",
        "key": "ChrEv_2280_005_01_017",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_017:ceff39c4",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_017:ceff39c4",
        "jp_sha256": "5413441d0085862cd3676b0ff7f1e88e61f59b04e8d2da5bcd4547f1a4ddf6e0",
        "official_en_sha256": "a6051e15f435fe0880fa0166d8514d524c20ec7086a2d95b903114f4bba9bb9a"
      },
      "text": {
        "jp": "ああ……！\r\n私はフレアを教わるところだったのに！",
        "official_en": "Yeah... And she was just about to teach me how to cast Flare!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
