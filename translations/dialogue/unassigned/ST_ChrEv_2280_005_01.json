    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_016:bc8b0972",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2280_005_01",
        "key": "ChrEv_2280_005_01_016",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_016:bc8b0972",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_016:bc8b0972",
        "jp_sha256": "773a84557e7b032e9560435146959127bc0e283a65e0da6b87ea1adcba15383a",
        "official_en_sha256": "11caf0030ad7f1d4fa2cbfa6b2dbe747b928e8fe209b3eb8676d10749af93d5b"
      },
      "text": {
        "jp": "あなたが粉をまいたのを見ましたよ！\r\nそしたら、ビクトリア様が砂のように消滅して！！",
        "official_en": "I saw you sprinkle some kind of powder with my own eyes! It caused our precious Lady Victoria to crumble into dust!",
        "real_en": "I saw you scatter that powder!\r\nThen Victoria-sama crumbled away like sand!!"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
