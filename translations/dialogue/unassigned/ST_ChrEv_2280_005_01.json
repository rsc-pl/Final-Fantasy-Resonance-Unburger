    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_001:3ff15fd1",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2280_005_01",
        "key": "ChrEv_2280_005_01_001",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_001:3ff15fd1",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_001:3ff15fd1",
        "jp_sha256": "4d6891cfe4192cfc468f604afa1ffab29c9abee19baaf234f53bcb9eb5e115be",
        "official_en_sha256": "ec7e01725f12cf3bae6e62941ca90e49e378b3f2104e4ec5010e836200459cda"
      },
      "text": {
        "jp": "ここからビクトリア消滅パウダーを\r\nまくとしよう。",
        "official_en": "Here. This is where we shall cast down the “evict-toria” powder.",
        "real_en": "Let’s scatter the Victoria Vanishing Powder from here."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
