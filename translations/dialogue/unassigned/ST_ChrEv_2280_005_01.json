    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_002:29da8cf6",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2280_005_01",
        "key": "ChrEv_2280_005_01_002",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_002:29da8cf6",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_002:29da8cf6",
        "jp_sha256": "5c1122793011aacd9448bfb31f170da5d2a56fda27365aa1813f46780438a18d",
        "official_en_sha256": "c342748a06873237e32d8200c737eed5bac2440e7a767104ac306f384f2bdbff"
      },
      "text": {
        "jp": "これでビクトリアは全員消えたはずじゃ。\r\nもう二度と会うこともあるまい。",
        "official_en": "’Tis done. We shall not likely see any of them ever again.",
        "real_en": "That should have made all the Victorias disappear. I doubt we’ll ever see them again."
      },
      "review": {
        "status": "CHANGE"
      },
