    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_009:8d08f014",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2280_005_01",
        "key": "ChrEv_2280_005_01_009",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_009:8d08f014",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_009:8d08f014",
        "jp_sha256": "62de2304ffefd25f72ccfbd0aa7ca0e29650783f685b3d644c1e55b667d48361",
        "official_en_sha256": "dd458ebae1e2987be8d1de50fd90fd99001d74d474dd373447b0e2998fd0e044"
      },
      "text": {
        "jp": "そう思ったんじゃがのう……。\r\nやっぱり何も言わないことにしたわい。",
        "official_en": "The thought crossed my mind...yet I could not quite bring myself to tell her.",
        "real_en": "I thought about it... but in the end, I decided not to say anything."
      },
