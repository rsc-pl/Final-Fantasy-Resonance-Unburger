          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_025:130f412f",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_2280_005_01",
        "key": "ChrEv_2280_005_01_025",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_025:130f412f",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_2280_005_01:ChrEv_2280_005_01_025:130f412f",
        "jp_sha256": "8cc815d05b5a442e9f264225dc038e858e85d91c418c048481f7ab4b27c0335f",
        "official_en_sha256": "c0d3f772d6c9c1137787893ebf5054a7016d769298af808503e4a0c41d03c973"
      },
      "text": {
        "jp": "いやむしろ吸ってくれ！\r\n半分！　いや全部でもいい！！",
        "official_en": "Oh, oh! I offer mine gladly! Drain me of half—no, all of it!",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
