      },
      "text": {
        "jp": "じゃあ決まり！\r\nこれからよろしくね、レイン。",
        "official_en": "Perfect! Thanks for letting me on board, Rain.",
        "real_en": "Then it’s settled! Looking forward to working with you, Rain."
      },
