    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_011:d4af7122",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_011",
        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_011:d4af7122",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_011:d4af7122",
        "jp_sha256": "db9e4cf964d14c2822e560a12ca15f2560300be4db9302cd4b5337bad94cfde0",
        "official_en_sha256": "05e6443b38be4b60fba1e68e6d9ffefd7d11b770dac57047b2ecb9e2408f2c60"
      },
      "text": {
        "jp": "人は皆、我が天の炎を求める。\r\n故に問う。\r\n汝らの戦いに我を動かす大義はあるのか？",
        "official_en": "All who seek me covet my divine strength.\nWhat creed dost thou champion that might sway me to lend thee mine aid?",
        "real_en": "Everyone who seeks me wants my heavenly fire. So I ask: is there a cause behind your fight that would move me?"
      },
      "review": {
        "status": "CHANGE"
      },
