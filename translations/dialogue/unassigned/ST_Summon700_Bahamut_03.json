    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_015:5228a8f2",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_015",
        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_015:5228a8f2",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_015:5228a8f2",
        "jp_sha256": "83ebf4a3587a35bf09e76945ff9eeb2d43fabfbc6d2bc321f6e4b2204c4dc2b9",
        "official_en_sha256": "e8304ddcd2b999df76d8f7e7614821cc83939802812988c3e4ef12bf39ef3a7b"
      },
      "text": {
        "jp": "だから、俺はもっと強くなりたい。もっと力がほしいんだ。",
        "official_en": "So, I need to become stronger. I need more power at my side.",
        "real_en": null
      },
      "review": {
