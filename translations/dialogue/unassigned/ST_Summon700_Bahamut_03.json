        "official_en_sha256": "cab463d6cfcfe8c101245b0fc3bf2d111f7625a7bd2c62692968f8db90b78d20"
      },
      "text": {
        "jp": "だが、他の者はどうだ？",
        "official_en": "I ask, however—what of thy companions?",
        "real_en": "But what of the others?"
