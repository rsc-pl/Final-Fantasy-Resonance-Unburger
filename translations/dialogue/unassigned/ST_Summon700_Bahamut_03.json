    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_007:826c32dd",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_007",
        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_007:826c32dd",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_007:826c32dd",
        "jp_sha256": "9422658912f3b9843fe9111cddd7b8e2151774df116ea4790fb35e9dd2412597",
        "official_en_sha256": "1146698e90f013a16fde4458c4eea5daf2b60f0e6f685568bfea111458443f3f"
      },
      "text": {
        "jp": "この地に降りし幻獣たちの力を\r\n一身に集めているようだが、汝らは何を成すつもりだ？",
        "official_en": "For what cause dost thou claim the might of espers that descend upon the lands?",
        "real_en": "You seem to be gathering within yourselves the power of the Eidolons who descended upon this land. What do you intend to do?"
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_Summon700_Bahamut_03",
        "sequence": null,
        "speaker": {
          "applicability": "REQUIRED",
          "label_jp": null,
          "label_status": "UNKNOWN",
          "name_entry": null,
          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": []
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_017:823b0900",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_017",
        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_017:823b0900",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_017:823b0900",
        "jp_sha256": "b086506f274a672e582a2764e5fddecbd8b6096b37e9040a6c175611f6e91118",
        "official_en_sha256": "f64e6f6047f0a47182bafa0623d18b86f6ea9b224caece2082195442a1a5f595"
      },
      "text": {
        "jp": "そうかもしれません。\r\nでも、私たちはそれを最後まで貫く覚悟です。",
        "official_en": "It might sound “trifling,” but we’re prepared to stand behind it to the end.",
        "real_en": "Maybe so. But we're determined to stand by it to the very end."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_Summon700_Bahamut_03",
