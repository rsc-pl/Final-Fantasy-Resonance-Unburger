    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_006:7197dfa6",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_006",
        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_006:7197dfa6",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_006:7197dfa6",
        "jp_sha256": "d7a83ceb15acaa086fabcaee95109bba89b854e7589400bbd4584b95cc374654",
        "official_en_sha256": "7524c73f626740e0a47e89376d141315636d65e9f651f3c6659a03c9be0b1fe7"
      },
      "text": {
        "jp": "で、私たちを呼んだ理由は何？",
        "official_en": "Enough small talk. Mind explaining why you called us here?",
        "real_en": "So, why did you call us here?"
      },
      "review": {
        "status": "CHANGE"
      },
