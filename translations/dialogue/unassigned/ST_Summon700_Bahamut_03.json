        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_003:fac71680",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_003:fac71680",
        "jp_sha256": "f0422100510105715db5088e560f11df206fd00b47795a2002e4bfb29a97bde7",
        "official_en_sha256": "692dec9f7d6cf836556bf3a1957865e8620f691f3f8681e4091acf521c8280bd"
      },
      "text": {
        "jp": "アルドールとあそこまで戦えたのは\r\nあなたがいたからよ。本当に頼もしかったわ。",
        "official_en": "It was thanks to you that we were able to give the Aldorians a run for their money.",
        "real_en": "We could never have fought Aldore as far as we did without you. You were truly dependable."
      },
