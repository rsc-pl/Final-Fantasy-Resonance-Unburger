    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_008:802c8b6b",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_008",
        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_008:802c8b6b",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_008:802c8b6b",
        "jp_sha256": "cda71eb7015821faa5d666c88d3f15270e94cc916dcb72f67ea872d1a3b5c1e0",
        "official_en_sha256": "f33375d54c780dd532efae6615da683a3b3c8164cb309e326f9a13728f9209e9"
      },
      "text": {
        "jp": "７００年前の戦いの因縁が、\r\nこの世界を巻き込もうとしているの。\r\nあなたも私たちに力を貸す気はない？",
        "official_en": "A seven-hundred-year-old grudge is about to set the world ablaze. Care to fight alongside me once more?",
        "real_en": "The consequences of a war seven hundred years ago are threatening to engulf this world. Will you lend us your strength, too?"
      },
