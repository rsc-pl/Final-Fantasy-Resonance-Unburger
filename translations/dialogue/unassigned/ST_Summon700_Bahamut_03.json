    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_002:38b49fee",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_002",
        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_002:38b49fee",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_002:38b49fee",
        "jp_sha256": "f47349b52b75f3e2aa497e4d92cd43920e9aa4d8ea9f4ee15cbf0e57eb0ab47b",
        "official_en_sha256": "c2d75e1da50ae00d0c46d37d78729b8cac4b618cd21641e228b473f2720425c5"
      },
      "text": {
        "jp": "ええ、アルドールとの戦争以来ね。",
        "official_en": "It certainly has. Last we met, we were still crossing swords with Aldore.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
