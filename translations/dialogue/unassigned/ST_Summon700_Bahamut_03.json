    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_004:5299c168",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_004",
        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_004:5299c168",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_004:5299c168",
        "jp_sha256": "f990f10f35e83562efaa8a27b5f29f93c42f49a731bdc6bdd1f5fcb7da1ed00d",
        "official_en_sha256": "d309a3ded940a0da9151faf6856e613de698daa9baf621f6dda1b017f89a4598"
      },
      "text": {
        "jp": "頼もしかったというのなら我も同じ。\r\n我が背中を貸したのは、後にも先にも汝だけだ。",
        "official_en": "The feeling is returned in kind. Of all the world,\n’tis thee alone I entrust to ride with me into the fray. So it was then, and so shall it ever be.",
        "real_en": "I could say the same of you. You're the only person I have ever allowed to ride on my back."
      },
      "review": {
        "status": "CHANGE"
      },
