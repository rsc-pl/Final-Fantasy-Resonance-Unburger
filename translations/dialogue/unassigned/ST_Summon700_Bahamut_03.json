    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_016:c982b6a4",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_016",
