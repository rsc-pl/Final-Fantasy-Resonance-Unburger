        "official_en_sha256": "21169b933564fcd6a12d4c3550766485ae3c965ae513d9537e76fa2fdd452f73"
      },
      "text": {
        "jp": "そう言ってもらえると嬉しいわ。",
        "official_en": "You flatter me, but...",
        "real_en": "I'm glad to hear you say that."
      },
      "review": {
        "status": "CHANGE"
