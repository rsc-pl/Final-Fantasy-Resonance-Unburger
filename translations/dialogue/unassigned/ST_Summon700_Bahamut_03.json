        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_016:c982b6a4",
        "jp_sha256": "9de02079835ec8fcd203f0bdf50ce397d0d7178b0c3a3164ba6ecabe6f67ab8e",
        "official_en_sha256": "27663e65852a1ac577392ab950da98a0d5aaaaa82e6f0c32307fad07421b6a7b"
      },
      "text": {
        "jp": "小さき理由だな。",
        "official_en": "A trifling motive.",
        "real_en": "A rather small reason."
