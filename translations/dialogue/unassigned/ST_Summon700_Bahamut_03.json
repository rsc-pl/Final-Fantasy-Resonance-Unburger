      }
    },
    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_013:913c67c7",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_013",
        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_013:913c67c7",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_013:913c67c7",
        "jp_sha256": "0c96073e4eb52c039dea496e04c595e9d35a3ce131310048809e95fe2bd88585",
        "official_en_sha256": "6e8a9cf356e8c3e2264b6fd3b651b0e9588c2262fdb38dabab991b9fb099050c"
      },
      "text": {
        "jp": "大義なんて偉そうなものじゃないけど……。\r\n俺は理不尽なことから、みんなを守れる力がほしい。",
        "official_en": "Well, it’s nothing as grand as a creed, but...I want the power to protect everyone from harm and cruelty.",
        "real_en": "It's nothing as grand as a cause, but... I want the power to protect everyone from injustice."
      },
      "review": {
        "status": "CHANGE"
      },
