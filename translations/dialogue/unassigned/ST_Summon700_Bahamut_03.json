    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_009:e5605644",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_009",
        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_009:e5605644",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_009:e5605644",
        "jp_sha256": "87e77a27f6673ac1ff5200fedfd22e33e5a00170f2f6b6122fc67f0c770d13f3",
        "official_en_sha256": "fff33bde3699dea409bcc2ae4c0f96e42859ff1cf5c71e22de9b9bbc27d95cfd"
      },
      "text": {
        "jp": "魔人フィーナよ。\r\n汝とはヘスの八賢者として一緒に戦った仲だ。\r\nその言葉には耳を傾ける重みがある。",
        "official_en": "...Archwitch Fina. Together we did stand, side by side, as brethren of the Eight Sages of Hess.\nThy words beareth great weight.",
        "real_en": "Dark Fina. We fought together as two of the Eight Sages of Hess. Your words carry weight with me."
      },
      "review": {
        "status": "CHANGE"
      },
