    {
      "record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_014:c5c28ff1",
      "source": {
        "set": "set-02",
        "namespace": "ST_Summon700_Bahamut_03",
        "key": "Summon700_Bahamut_03_014",
        "jp_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_014:c5c28ff1",
        "official_en_record_id": "switch:locres:set-02:ST_Summon700_Bahamut_03:Summon700_Bahamut_03_014:c5c28ff1",
        "jp_sha256": "c69623fd6923a5248620dae8b89b131f305e7ae92a83ef14318421d85594dbfb",
        "official_en_sha256": "310a84a266800754ed47dd0f0f988db499735dc1fb329df56f3163809daf2638"
      },
      "text": {
        "jp": "その力が大きければ大きいほど、\r\nたくさんの人を守れるってわかったから……。",
        "official_en": "I’ve come to realize that the greater that power, the more people I can save. That’s why I need your help.",
        "real_en": "I've learned that the greater my power, the more people I can protect..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
      "context": {
        "scene_ref": "ST_Summon700_Bahamut_03",
