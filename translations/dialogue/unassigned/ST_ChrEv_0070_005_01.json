      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0070_005_01",
        "key": "ChrEv_0070_005_01_009",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_009:04f4d315",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_009:04f4d315",
