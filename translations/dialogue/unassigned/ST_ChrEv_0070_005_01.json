        "official_en_sha256": "499e228c2a9778ba36774d7617431e9e79563e0c75739fb3820b56b4923aa019"
      },
      "text": {
        "jp": "そうか……",
        "official_en": "That makes sense...",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
      "function": "dialogue_line",
