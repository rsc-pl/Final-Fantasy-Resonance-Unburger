    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_025:f184b6cb",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0070_005_01",
        "key": "ChrEv_0070_005_01_025",
