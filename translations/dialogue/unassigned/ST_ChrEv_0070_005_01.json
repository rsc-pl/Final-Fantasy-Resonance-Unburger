          "identity": null,
          "runtime_character_id": null,
          "evidence_refs": [
            "key-identities:ST_ChrEv_0070_005_01/ChrEv_0070_005_01_007"
          ]
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_017:7f803867",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0070_005_01",
        "key": "ChrEv_0070_005_01_017",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_017:7f803867",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_017:7f803867",
        "jp_sha256": "1a5c7f4429b98609a399cfdcee3087bd3cd527375c79b84a5775eed12e97f66b",
        "official_en_sha256": "c076458e2e4b4fad4c505c0dacc452197a38f655b6a856c9548622f412301206"
      },
      "text": {
        "jp": "だから、俺にあの言葉を託した……",
        "official_en": "Is that why you gave me that advice?",
        "real_en": "That's why you entrusted those words to me..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "dialogue_line",
