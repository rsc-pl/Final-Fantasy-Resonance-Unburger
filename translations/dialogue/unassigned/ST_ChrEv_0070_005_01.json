        "official_en_sha256": "e1be445f8beebad0b6bfad5ae29435debd99903e543411c19754b7280df234ec"
      },
      "text": {
        "jp": "ゾルダード城に行けばわかる。\r\nシエラに会いに行こう。",
        "official_en": "Let’s go pay him a visit at Zoldaad Castle. You’ll see.",
        "real_en": null
      },
