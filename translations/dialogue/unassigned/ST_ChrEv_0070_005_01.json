        "official_en_sha256": "a40e7181cfe9ea56e50fbf31a38f01d748ff1c7884e22b8d18fce8ea18c03716"
      },
      "text": {
        "jp": "この、ゾルダードの最果ての地で……",
        "official_en": "Here, on the edge of Zoldaad.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
