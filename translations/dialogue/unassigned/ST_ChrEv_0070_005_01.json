      }
    },
    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_008:7a826e98",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0070_005_01",
        "key": "ChrEv_0070_005_01_008",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_008:7a826e98",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_008:7a826e98",
        "jp_sha256": "cd50239d68dcf4121f5c9cba8fb2571e48014eae307db7a6bbc7df6caa8a65a3",
        "official_en_sha256": "0015916474b8a0bc6bf501290622be7a2768778a6d1fd3978c7f7a71acedc5df"
      },
      "text": {
        "jp": "だけど……違ったんだな。",
        "official_en": "But I had it all wrong.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
