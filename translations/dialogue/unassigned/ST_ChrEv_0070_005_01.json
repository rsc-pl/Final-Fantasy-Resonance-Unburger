        "official_en_sha256": "c16ce56ec5914fea90529cb0f3e6c5d16d6cb967c5cd30dd66d1a24ab798caba"
      },
      "text": {
        "jp": "母さんがさ、よく言ってたんだ。\r\n「帝都から離れたい」って……",
        "official_en": "Mom always talked about how she wanted to get out of the capital.",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
