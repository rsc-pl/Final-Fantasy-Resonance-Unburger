    {
      "record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_021:d54c8db7",
      "source": {
        "set": "set-02",
        "namespace": "ST_ChrEv_0070_005_01",
        "key": "ChrEv_0070_005_01_021",
        "jp_record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_021:d54c8db7",
        "official_en_record_id": "switch:locres:set-02:ST_ChrEv_0070_005_01:ChrEv_0070_005_01_021:d54c8db7",
        "jp_sha256": "037adcf418c34208fbfe07e8927b9ec72edae706243ee845e9d8ca34a985fd8c",
        "official_en_sha256": "cff5d329e818f640e1fa435479d2553d3315c09087f7e244fa1d135eaacb21d9"
      },
      "text": {
        "jp": "でも……俺達は二人いる。\r\nだから……。",
        "official_en": "But pops had the two of us. Which means...",
        "real_en": "But there are two of us. So..."
      },
      "review": {
        "status": "CHANGE"
      },
