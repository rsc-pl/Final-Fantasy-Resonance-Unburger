        "official_en_sha256": "c0a9b2a3051525d693758c47dde2c91f7f60a36ecd0f19e510d26f57c0e5c04e"
      },
      "text": {
        "jp": "別にこれと言って\r\n特徴のない駅だな。\r\n二人はどうしてここに……",
        "official_en": "There’s nothing particularly special about this place. Why do you think they came here?",
        "real_en": null
      },
      "review": {
        "status": "KEEP"
      },
