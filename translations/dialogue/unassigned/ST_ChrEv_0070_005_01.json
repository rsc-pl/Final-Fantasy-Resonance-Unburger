        "official_en_sha256": "3eb4b20d1632e61b83fa494be869281f376c915bb1f837437b1f7d8bc05e427c"
      },
      "text": {
        "jp": "現実にはイカサマは通用しない。\r\nコインの表裏のようにはいかないんだ。",
        "official_en": "You can’t cheat reality. Sometimes you don’t even get to toss a coin.",
        "real_en": "You can't cheat reality. It doesn't work like the two sides of a coin."
      },
