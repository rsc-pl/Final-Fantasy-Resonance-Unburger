        "official_en_sha256": "58737e69c27ad5048253532c548b592667aca4ade9cba94d6c0f18153e8b9180"
      },
      "text": {
        "jp": "母さんは、ずっとオヤジを……\r\nゾルダードで待っていたんだ。",
        "official_en": "She was waiting for Dad the whole time over there. In Zoldaad.",
        "real_en": null
      },
