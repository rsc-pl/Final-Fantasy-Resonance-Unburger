    {
      "record_id": "switch:locres:set-02:ST_Tutorial_Buff_Debuff:Tutorial_Buff_Debuff_002:8f7dc187",
      "source": {
        "set": "set-02",
        "namespace": "ST_Tutorial_Buff_Debuff",
