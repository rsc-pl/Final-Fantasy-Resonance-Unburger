      },
      "text": {
        "jp": "デブレイ　：物理攻撃ダウン\r\nデフェイ　：魔法攻撃ダウン\r\nデプロテ　：物理防御ダウン\r\nデシェル　：魔法防御ダウン\r\nブレイク防御ダウン　：受けるブレイクダメージ上昇",
        "official_en": "<text style=\"bold\">Debrave:</> Decreases physical attack.\r\n<text style=\"bold\">Defaith:</> Decreases magic attack.\r\n<text style=\"bold\">Deprotect:</> Decreases physical defense.\r\n<text style=\"bold\">Deshell:</> Decreases magic defense.\r\n<text style=\"bold\">Stagger defense down:</> Increases stagger power taken.",
        "real_en": "<text style=\"bold\">Debrave:</> Decreases physical attack.\r\n<text style=\"bold\">Defaith:</> Decreases magic attack.\r\n<text style=\"bold\">Deprotect:</> Decreases physical defense.\r\n<text style=\"bold\">Deshell:</> Decreases magic defense.\r\n<text style=\"bold\">Break defense down:</> Increases Break damage taken."
      },
