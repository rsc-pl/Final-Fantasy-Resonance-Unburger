    {
      "record_id": "switch:locres:set-02:ST_Tutorial_Break:Tutorial_Break_002:66d7a64f",
      "source": {
        "set": "set-02",
        "namespace": "ST_Tutorial_Break",
        "key": "Tutorial_Break_002",
        "jp_record_id": "switch:locres:set-02:ST_Tutorial_Break:Tutorial_Break_002:66d7a64f",
        "official_en_record_id": "switch:locres:set-02:ST_Tutorial_Break:Tutorial_Break_002:66d7a64f",
        "jp_sha256": "0bdc1eec41f0294ed28a458d2a672b268d3b338b844dcc03f14b473106683904",
        "official_en_sha256": "13974511099caf8e2e52219c2c4a3ed95bd8054b3ecaefefca5a61d1b9869e2f"
      },
      "text": {
        "jp": "敵にはそれぞれブレイクゲージがあります。\r\nブレイクゲージを削りきるとその敵はブレイク状態となります。\r\n\r\nブレイク状態となった敵はそのターンの行動ができなくなるのに加え\r\nより多くのダメージを受ける状態になります。",
        "official_en": "Each enemy has its own stagger gauge.\r\nReduce it to zero, and the enemy will be staggered.\r\n\r\nStaggered enemies will be unable to perform actions\r\non their turn and will take more damage than usual.",
        "real_en": "Each enemy has its own Break gauge.\r\nReduce it to zero, and the enemy will be Broken.\r\n\r\nBroken enemies will be unable to perform actions\r\non their turn and will take more damage than usual."
      },
