    {
      "record_id": "switch:locres:set-02:ST_Tutorial_Nichol:Tutorial_Nichol_004:105a5de4",
      "source": {
        "set": "set-02",
        "namespace": "ST_Tutorial_Nichol",
        "key": "Tutorial_Nichol_004",
        "jp_record_id": "switch:locres:set-02:ST_Tutorial_Nichol:Tutorial_Nichol_004:105a5de4",
        "official_en_record_id": "switch:locres:set-02:ST_Tutorial_Nichol:Tutorial_Nichol_004:105a5de4",
        "jp_sha256": "a632c243dd4a21d824fd4b6b3e2984fc4234ad1d0ba79bfb5ed54766fa81e025",
        "official_en_sha256": "89838344de9d2f640e543020f362bbc4fe6d80e31ef10d14cde867c341ebcf97"
      },
      "text": {
        "jp": "攻勢の陣　　：味方全体のブレイクダメージが上昇する\r\n突撃の陣　　：味方全体のクリティカル率が上昇する\r\n鉄壁の陣　　：味方全体の物理防御・魔法防御が上昇する\r\n転戦自在の策：陣を使用した後に再度行動が可能になる\r\n\r\nニコルが成長すれば、新たな「陣」を覚えることでしょう！",
        "official_en": "<text style=\"bold\">Formation: Assail</> - Increases the stagger power of all\r\nallies.\r\n<text style=\"bold\">Formation: Charge</> - Increases the critical hit rate of\r\nall allies.\r\n<text style=\"bold\">Formation: Bulwark</> - Increases physical and magic\r\ndefense of all allies.\r\n<text style=\"bold\">Tactic: Fluid Warfare</> - Grants an additional action\r\nafter using Formations.\r\n\r\nKeep in mind that Nichol will learn new Formations\r\nas he levels up!",
        "real_en": "<text style=\"bold\">Formation: Assail</> - Increases the Break damage of all\r\nallies.\r\n<text style=\"bold\">Formation: Charge</> - Increases the critical hit rate of\r\nall allies.\r\n<text style=\"bold\">Formation: Bulwark</> - Increases physical and magic\r\ndefense of all allies.\r\n<text style=\"bold\">Tactic: Fluid Warfare</> - Grants an additional action\r\nafter using Formations.\r\n\r\nNichol will learn new Formations as he grows stronger!"
      },
