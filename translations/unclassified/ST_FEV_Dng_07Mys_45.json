    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_050:527de95a",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_45",
        "key": "FEV_Dng_07Mys_45_050",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_050:527de95a",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_050:527de95a",
        "jp_sha256": "798f370b8084ab809ce970ecbc9401ef03e404af0dd24d0702c661d1e701f0bd",
        "official_en_sha256": "0be9cfb1c2da7bd4c0b2c19b70c64aea86f6a38eab3eb3004d195ec3059c39bd"
      },
      "text": {
        "jp": "その刃で己の実力を示すがいい。",
        "official_en": "Raise your blade and show your true worth on the battlefield.",
        "real_en": "Show what you're capable of with that blade."
      },
      "review": {
        "status": "CHANGE"
      },
