      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_005:26a39faf",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_45",
        "key": "FEV_Dng_07Mys_45_005",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_005:26a39faf",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_005:26a39faf",
        "jp_sha256": "ce914af8f394b2bcf149cbb26cd30943fd5eff2d56bc6dc76541569dd3e23f40",
        "official_en_sha256": "deef5395d66a300ecea38f0101e6442cf54fbac3dba10d12588f10ffc3d3e836"
      },
      "text": {
        "jp": "ソル様は、お優しい方だ。\r\nアルドールの連中にも憎しみを向けておられない。",
        "official_en": "Lord Sol’s kindness runs deep—he harbors no hatred even for the Aldorians.",
        "real_en": "Sol-sama is a kind person.\r\nHe bears no hatred even toward the people of Aldore."
      },
      "review": {
        "status": "CHANGE"
      },
