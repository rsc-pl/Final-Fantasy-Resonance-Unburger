    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_025:93485c80",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_45",
        "key": "FEV_Dng_07Mys_45_025",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_025:93485c80",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_025:93485c80",
        "jp_sha256": "4983df996583408eaa66522e5bbc8f69a0647c1781c50c31871487b0093cc527",
        "official_en_sha256": "65b49373153849d82f31a41d639e8c011138ca907d16eee967cb598b4492c88d"
      },
      "text": {
        "jp": "ごめんなさい……。\r\n私、戦うのが好きではなくて……。",
        "official_en": "I’m sorry, I...I detest fighting.",
        "real_en": "I'm sorry... I don't really like fighting..."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "game_text_unclassified",
