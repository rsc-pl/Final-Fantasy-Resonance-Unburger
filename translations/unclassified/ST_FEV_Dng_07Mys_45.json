    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_056:09f0a2fd",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_45",
        "key": "FEV_Dng_07Mys_45_056",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_056:09f0a2fd",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_056:09f0a2fd",
        "jp_sha256": "8ea3ce91968756adeb6f12b2d49fb2cc0fbdedb5efcf4fff9ec6eba55b61e36c",
        "official_en_sha256": "25a41211402d0ba7f381eda16a124becb2f58c726d5b21e4b66b425c1bb11bbb"
      },
      "text": {
        "jp": "でも、大切にしてくれてると思うと\r\nちょっと嬉しいんだ。\r\n私たちはたった二人の姉妹だからね。",
        "official_en": "Deep down, though, I’m happy she cares for me. We’re sisters, after all.",
        "real_en": "Still, it makes me a little happy to know she cares about me. There are only two of us, after all."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "game_text_unclassified",
