    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_030:cf5e165f",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_45",
        "key": "FEV_Dng_07Mys_45_030",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_030:cf5e165f",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_030:cf5e165f",
        "jp_sha256": "c5876613360065a6167d46bde5b3719041ce381315acdd23e41972ec91287b35",
        "official_en_sha256": "f7e28357fdaf5e3b3816139e60744123e6389a5ec4eb9e35565fac102f2f1131"
      },
      "text": {
        "jp": "この美しき空が、\r\n戦火に染まるのは見ていられん。",
        "official_en": "I will not suffer watching the flames of war engulf the beautiful skies.",
        "real_en": "I can't bear to see this beautiful sky stained by the fires of war."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "game_text_unclassified",
