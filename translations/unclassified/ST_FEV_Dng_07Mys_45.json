      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_040:00665288",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_45",
        "key": "FEV_Dng_07Mys_45_040",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_040:00665288",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_040:00665288",
        "jp_sha256": "e7710f26b80c0adce498781a576481f5ba1e0df550dcf1c349a9fbc5bfe11d20",
        "official_en_sha256": "0bdb0c00c4f7275a4b9c6c67f4fd7f630188df9e0be43eba73bf27a752543ddb"
      },
      "text": {
        "jp": "戦わずしての栄冠など俺の美学に反する。",
        "official_en": "I cannot call myself the victor without meeting her in battle. There is no honor in that.",
        "real_en": "Claiming victory without fighting goes against my principles."
