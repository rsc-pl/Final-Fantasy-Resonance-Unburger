          "runtime_character_id": null,
          "evidence_refs": []
        },
        "addressee": null,
        "branch_ref": null,
        "voice_ref": null
      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_031:12b6eed7",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_45",
        "key": "FEV_Dng_07Mys_45_031",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_031:12b6eed7",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_031:12b6eed7",
        "jp_sha256": "3b0c7d4337a512c75ef38ce53303f3430f4ca3491a98af4ebdf6a084e11acd98",
        "official_en_sha256": "206d51b27a2c3921ac15470f6c607573238a0c8c5f8ad5f410915c0af4067ab8"
      },
      "text": {
        "jp": "だからこそ、早く\r\nこの戦争を終わらせたいのだ。",
        "official_en": "It is the very reason why we must put an end to this conflict swiftly.",
        "real_en": "That's why I want to end this war as soon as possible."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "game_text_unclassified",
