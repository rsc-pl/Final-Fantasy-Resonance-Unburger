      }
    },
    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_026:bafd4622",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_45",
        "key": "FEV_Dng_07Mys_45_026",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_026:bafd4622",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_026:bafd4622",
        "jp_sha256": "d77e78f0992cbc06011f1afa4ec18b9b33b2f7e4e23a6b465d74f498e74c48af",
        "official_en_sha256": "79696c73b4333642643b0f4a5e0050751155e00e81078a6f58d4f1b2df5e686d"
      },
      "text": {
        "jp": "でも、戦場に立つ以上は、\r\n皆さんのご迷惑にならないよう、\r\n精一杯務めさせていただきます。",
        "official_en": "Yet, if I <text style=\"italic\">am</> to stand upon the battlefield and have no choice but to fight...I’ll do my best to not fail, for Aldore.",
        "real_en": "But now that I am going into battle,\r\nI will do everything I can\r\nnot to be a burden to any of you."
      },
      "review": {
        "status": "CHANGE"
      },
      "function": "game_text_unclassified",
      "context": {
        "scene_ref": null,
        "sequence": null,
        "speaker": {
