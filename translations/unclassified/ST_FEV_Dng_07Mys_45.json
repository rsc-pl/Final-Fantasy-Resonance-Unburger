    {
      "record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_020:944d54d3",
      "source": {
        "set": "set-02",
        "namespace": "ST_FEV_Dng_07Mys_45",
        "key": "FEV_Dng_07Mys_45_020",
        "jp_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_020:944d54d3",
        "official_en_record_id": "switch:locres:set-02:ST_FEV_Dng_07Mys_45:FEV_Dng_07Mys_45_020:944d54d3",
        "jp_sha256": "59868c0d3deb2a4ce8738f3fb171a6b942373512ddcda12598ddfc66c4821173",
        "official_en_sha256": "2c0bdc24a69719a278cca820b1102388578006a9b72165a8e49ee540b9841200"
      },
      "text": {
        "jp": "八盟傑の方々は、立派な方ばかりです。\r\nその信念に共鳴したからこそ\r\nこの命を懸けて戦場に立てるのです。",
        "official_en": "The Sworn Eight are noble souls, and we have chosen to stand by their conviction. It’s what drives us to fight this war, even at the cost of our lives.",
        "real_en": "The Sworn Eight are all admirable people. Their convictions resonate with me, and that's why I'm willing to risk my life on the battlefield."
      },
      "review": {
        "status": "CHANGE"
      },
